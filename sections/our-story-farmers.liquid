{% doc %}
  Renders the farmers spotlight section for the Our Story page.
{% enddoc %}

<section class="story-farmers" id="story-farmers" {{ section.shopify_attributes }}>
  <div class="story-container">
    <div class="story-header story-header--center" data-story-reveal>
      <span class="story-eyebrow">{{ section.settings.eyebrow | default: 'DIRECT FROM THE SOIL' }}</span>
      <h2 class="story-heading">{{ section.settings.heading | default: 'People Behind Your Food' }}</h2>
      <p class="story-subheading">
        {{ section.settings.subheading | default: 'We work closely with farmers and producers who care deeply about the food they grow.' }}
      </p>
    </div>

    <div class="story-farmers__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="story-farmer-card" data-story-reveal {{ block.shopify_attributes }}>
            <div class="story-farmer-card__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: class: 'story-farmer-card__img', loading: 'lazy', alt: block.settings.name | escape }}
              {% else %}
                <img src="{{ 'category-2.png.png' | asset_url }}" alt="{{ block.settings.name | escape }}" class="story-farmer-card__img" loading="lazy" width="600" height="600">
              {% endif %}
              <div class="story-farmer-card__badge">
                <span>📍 {{ block.settings.location | default: 'Surat, Gujarat' }}</span>
              </div>
            </div>
            <div class="story-farmer-card__content">
              <span class="story-farmer-card__crop">🌾 {{ block.settings.product | default: 'Khapli Wheat' }}</span>
              <h3 class="story-farmer-card__name">{{ block.settings.name | default: 'Ramesh Patel' }}</h3>
              <p class="story-farmer-card__story">{{ block.settings.story | default: 'Practicing natural organic farming for 15+ years without synthetic pesticides.' }}</p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Farmers -->
        <div class="story-farmer-card" data-story-reveal>
          <div class="story-farmer-card__media">
            <img src="{{ 'category-2.png.png' | asset_url }}" alt="Ramesh Patel" class="story-farmer-card__img" loading="lazy" width="600" height="600">
            <div class="story-farmer-card__badge">
              <span>📍 Surat, Gujarat</span>
            </div>
          </div>
          <div class="story-farmer-card__content">
            <span class="story-farmer-card__crop">🌾 Khapli Emmer Wheat</span>
            <h3 class="story-farmer-card__name">Ramesh Patel</h3>
            <p class="story-farmer-card__story">Nurturing heritage indigenous wheat seeds with traditional natural farming for over 15 years.</p>
          </div>
        </div>

        <div class="story-farmer-card" data-story-reveal>
          <div class="story-farmer-card__media">
            <img src="{{ 'category-3.png.png' | asset_url }}" alt="Savita Ben" class="story-farmer-card__img" loading="lazy" width="600" height="600">
            <div class="story-farmer-card__badge">
              <span>📍 Gir, Gujarat</span>
            </div>
          </div>
          <div class="story-farmer-card__content">
            <span class="story-farmer-card__crop">🥛 A2 Gir Cow Ghee</span>
            <h3 class="story-farmer-card__name">Savita Ben & Family</h3>
            <p class="story-farmer-card__story">Crafting pure A2 Bilona Ghee in small batches using traditional wood-fired curd churning.</p>
          </div>
        </div>

        <div class="story-farmer-card" data-story-reveal>
          <div class="story-farmer-card__media">
            <img src="{{ 'category-1.png.png' | asset_url }}" alt="Vikram Singh" class="story-farmer-card__img" loading="lazy" width="600" height="600">
            <div class="story-farmer-card__badge">
              <span>📍 Narmada, MP</span>
            </div>
          </div>
          <div class="story-farmer-card__content">
            <span class="story-farmer-card__crop">🌱 Cold-Pressed Oils & Pulses</span>
            <h3 class="story-farmer-card__name">Vikram Singh</h3>
            <p class="story-farmer-card__story">Growing native mustard and sesame seeds organically using rainwater harvesting.</p>
          </div>
        </div>
      {% endif %}
    </div>

    {% if section.settings.cta_text != blank %}
      <div class="story-farmers__cta-wrap" data-story-reveal>
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="story-btn story-btn--outline">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "People Behind Your Food",
  "tag": "section",
  "class": "section-our-story-farmers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DIRECT FROM THE SOIL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "People Behind Your Food"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We work closely with farmers and producers who care deeply about the food they grow."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Discover Our Farmers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "farmer",
      "name": "Farmer Profile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Farmer Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Farmer Name",
          "default": "Farmer Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Surat, Gujarat"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Crop / Product",
          "default": "Khapli Wheat"
        },
        {
          "type": "textarea",
          "id": "story",
          "label": "Short Story",
          "default": "Practicing natural organic farming for 15+ years."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "People Behind Your Food",
      "blocks": [
        {
          "type": "farmer",
          "settings": {
            "name": "Ramesh Patel",
            "location": "Surat, Gujarat",
            "product": "Khapli Emmer Wheat",
            "story": "Nurturing heritage indigenous wheat seeds with traditional natural farming for over 15 years."
          }
        },
        {
          "type": "farmer",
          "settings": {
            "name": "Savita Ben",
            "location": "Gir, Gujarat",
            "product": "A2 Gir Cow Ghee",
            "story": "Crafting pure A2 Bilona Ghee in small batches using traditional wood-fired curd churning."
          }
        },
        {
          "type": "farmer",
          "settings": {
            "name": "Vikram Singh",
            "location": "Narmada, MP",
            "product": "Cold-Pressed Oils",
            "story": "Growing native mustard and sesame seeds organically using rainwater harvesting."
          }
        }
      ]
    }
  ]
}
{% endschema %}
