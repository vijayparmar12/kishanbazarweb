<link rel="stylesheet" href="{{ 'section-video.css' | asset_url }}">
<script src="{{ 'section-video.js' | asset_url }}" defer="defer"></script>

{% style %}
  #VideoSection-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}');
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
    {% endif %}
  }

  {% if section.settings.background_image != blank and section.settings.overlay_opacity > 0 %}
    #VideoSection-{{ section.id }}::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
      pointer-events: none;
      z-index: 1;
    }
  {% endif %}

  #VideoSection-{{ section.id }} .home-video__head {
    margin-bottom: 0.25rem !important;
    margin-top: 0 !important;
    padding: 0 !important;
  }

  #VideoSection-{{ section.id }} .home-video__heading-banner-wrap {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
    height: {{ section.settings.heading_box_height_desktop | default: 180 }}px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 12px !important;
  }

  #VideoSection-{{ section.id }} .home-section__heading-picture {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 auto !important;
    padding: 0 !important;
  }

  #VideoSection-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.heading_box_bg_size | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
    margin: 0 auto !important;
    padding: 0 !important;
    border-radius: 12px !important;
    {% if section.settings.heading_image_flip %}
      transform: scaleX(-1) !important;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #VideoSection-{{ section.id }} .home-video__heading-banner-wrap {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 800 }}px !important;
      height: {{ section.settings.heading_box_height_mobile | default: 110 }}px !important;
    }
    #VideoSection-{{ section.id }} .home-section__heading-picture {
      width: 100% !important;
      height: 100% !important;
      margin: 0 auto !important;
    }
    #VideoSection-{{ section.id }} .home-section__heading-image {
      object-fit: {{ section.settings.heading_box_bg_size_mobile | default: 'cover' }} !important;
      margin: 0 auto !important;
    }
  }
{% endstyle %}

<section id="VideoSection-{{ section.id }}" class="home-section home-video" data-home-video>
  <div class="home-video__container">
    <!-- Header Section -->
    <div class="home-section__head home-video__head">
      {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
        <div class="home-video__heading-banner-wrap">
          <picture class="home-section__heading-picture">
            {% if section.settings.heading_image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
            {% endif %}
            {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
            {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
          </picture>
        </div>
      {% else %}
        <span class="home-video__eyebrow-pill">🌿 OUR FARM TO TABLE STORY</span>
        <h2 class="home-video__title">{{ section.settings.heading | default: "Meet the Farmers & Millers" }}</h2>
        {% if section.settings.description != blank %}
          <div class="home-video__subtitle">{{ section.settings.description }}</div>
        {% else %}
          <p class="home-video__subtitle">Take a closer look at the traditional stone-grinding practices and farm-fresh care behind every Kishan Bazar staple.</p>
        {% endif %}
      {% endif %}
    </div>

    <!-- Main Video Frame Container with Glowing Ripple Play Button & Badges -->
    <div class="home-video__frame-wrapper" data-video-frame-wrapper>
      <div class="home-video__frame">
        <!-- Floating Badges on Video -->
        <div class="home-video__badge home-video__badge--left">
          <span class="home-video__badge-dot"></span>
          📍 Direct from Surat & MP Farms
        </div>
        <div class="home-video__badge home-video__badge--right">
          ✨ 100% Traditional Stone Ground
        </div>

        <!-- Video Overlay Gradient & Animated Play Button Trigger -->
        <div class="home-video__overlay-trigger" data-video-trigger aria-label="Play Farm Story Video">
          <div class="home-video__play-ripple"></div>
          <button type="button" class="home-video__play-btn" aria-label="Play Video">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="#ffffff" stroke="none">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </button>
          <div class="home-video__overlay-caption">
            <span class="home-video__play-text">▶ Watch Farm Story Video (2 Min)</span>
          </div>
        </div>

        <!-- Video Media Element (Shopify Video, YouTube/Vimeo Iframe, or Poster Image) -->
        <div class="home-video__media-container" data-video-media-container>
          {% if section.settings.video != blank %}
            {{
              section.settings.video
              | video_tag:
                class: 'home-video__media',
                controls: true,
                autoplay: false,
                loop: section.settings.loop,
                muted: false,
                image_size: '1400x'
            }}
          {% elsif section.settings.video_url != blank %}
            {% if section.settings.video_url.type == 'youtube' %}
              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&autoplay=1"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                class="home-video__iframe"
                data-video-iframe
              ></iframe>
            {% else %}
              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                class="home-video__iframe"
                data-video-iframe
              ></iframe>
            {% endif %}
          {% elsif section.settings.poster != blank %}
            {{
              section.settings.poster
              | image_url: width: 1400
              | image_tag: class: 'home-video__poster', loading: 'lazy', widths: '600, 900, 1400', alt: section.settings.heading | escape
            }}
          {% else %}
            <img
              class="home-video__poster"
              src="{{ 'video-thumbnail.jpg.png' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              width="1400"
              height="788"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Video Lightbox Modal for Fullscreen Playback -->
  <div class="home-video__modal" data-video-modal aria-hidden="true">
    <div class="home-video__modal-backdrop" data-video-modal-close></div>
    <div class="home-video__modal-content">
      <button type="button" class="home-video__modal-close" data-video-modal-close aria-label="Close Video Modal">&times;</button>
      <div class="home-video__modal-body" data-video-modal-body></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Section",
  "tag": "section",
  "class": "section-video",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Section Background Image",
      "info": "Upload custom background image from Shopify."
    },
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Box Background Image (Desktop)", "info": "Upload graphic image to use as background for the Heading Box on Desktop" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Box Background Image (Mobile)", "info": "Upload graphic image to use as background for the Heading Box on Mobile" },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    { "type": "checkbox", "id": "heading_image_flip", "label": "Flip Heading Image Horizontally", "default": false },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Desktop Heading Box Fixed Height (px)", "min": 60, "max": 400, "step": 10, "default": 180, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Mobile Heading Box Fixed Height (px)", "min": 40, "max": 250, "step": 10, "default": 110, "unit": "px" },
    { "type": "range", "id": "heading_image_max_width", "label": "Desktop Heading Image Max Width (px)", "min": 200, "max": 1200, "step": 20, "default": 640, "unit": "px" },
    { "type": "range", "id": "heading_image_mobile_max_width", "label": "Mobile Heading Image Max Width (px)", "min": 150, "max": 800, "step": 10, "default": 360, "unit": "px" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Farmers & Millers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A closer look at the traditional stone-grinding practices and farm-fresh care behind every pantry staple.</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}
