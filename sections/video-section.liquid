<link rel="stylesheet" href="{{ 'section-video.css' | asset_url }}">
<script src="{{ 'section-video.js' | asset_url }}" defer="defer"></script>

{% style %}
  #VideoSection-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }} !important;
    background-image: none !important;
  }

  #VideoSection-{{ section.id }} .home-video__head {
    margin-bottom: 0.25rem !important;
    margin-top: 0 !important;
    padding: 0 !important;
  }

  {% assign text_align = section.settings.heading_text_align | default: 'left' %}
  {% assign align_items = 'flex-start' %}
  {% if text_align == 'center' %}
    {% assign align_items = 'center' %}
  {% elsif text_align == 'right' %}
    {% assign align_items = 'flex-end' %}
  {% endif %}

  #VideoSection-{{ section.id }} .home-video__heading-banner-wrap {
    display: flex !important;
    align-items: center !important;
    justify-content: {{ align_items }} !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
    min-height: {{ section.settings.heading_box_height_desktop | default: 180 }}px !important;
    height: auto !important;
    margin: 0 auto !important;
    padding: 0 2rem !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    box-sizing: border-box !important;
  }

  #VideoSection-{{ section.id }} .home-section__heading-picture {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 auto !important;
    padding: 0 !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  #VideoSection-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.heading_box_bg_size | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
    margin: 0 auto !important;
    padding: 0 !important;
    border-radius: 12px !important;
    {% if section.settings.heading_image_flip %}
      transform: scaleX(-1) !important;
    {% endif %}
  }

  #VideoSection-{{ section.id }} .home-video__heading-content {
    position: relative !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: {{ align_items }} !important;
    text-align: {{ text_align }} !important;
    max-width: {{ section.settings.heading_content_width_desktop | default: 80 }}% !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #VideoSection-{{ section.id }} .home-video__heading-title,
  #VideoSection-{{ section.id }} .home-video__head h2 {
    color: {{ section.settings.heading_color | default: '#1e3d20' }} !important;
    font-size: {{ section.settings.heading_font_size | default: 28 }}px !important;
    font-weight: 900 !important;
    font-family: 'Montserrat', sans-serif !important;
    margin: 0 !important;
    line-height: 1.25 !important;
    text-align: {{ text_align }} !important;
  }

  #VideoSection-{{ section.id }} .home-video__heading-eyebrow {
    font-size: {{ section.settings.subheading_font_size | default: 15 }}px !important;
    margin-bottom: 0.25rem !important;
    text-align: {{ text_align }} !important;
  }

  @media screen and (max-width: 749px) {
    #VideoSection-{{ section.id }} .home-video__heading-banner-wrap {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 800 }}px !important;
      min-height: {{ section.settings.heading_box_height_mobile | default: 110 }}px !important;
      height: auto !important;
      padding: 0 1rem !important;
      justify-content: {{ align_items }} !important;
      align-items: center !important;
    }
    #VideoSection-{{ section.id }} .home-section__heading-picture {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
    }
    #VideoSection-{{ section.id }} .home-section__heading-image {
      object-fit: {{ section.settings.heading_box_bg_size_mobile | default: 'cover' }} !important;
      height: 100% !important;
      width: 100% !important;
      margin: 0 auto !important;
    }
    #VideoSection-{{ section.id }} .home-video__heading-content {
      max-width: {{ section.settings.heading_content_width_mobile | default: 85 }}% !important;
      align-items: {{ align_items }} !important;
      text-align: {{ text_align }} !important;
      padding: 0 !important;
    }
    #VideoSection-{{ section.id }} .home-video__heading-title,
    #VideoSection-{{ section.id }} .home-video__head h2 {
      font-size: {{ section.settings.heading_font_size_mobile | default: 18 }}px !important;
      font-weight: 900 !important;
      line-height: 1.2 !important;
      text-align: {{ text_align }} !important;
    }
    #VideoSection-{{ section.id }} .home-video__heading-eyebrow {
      font-size: {{ section.settings.subheading_font_size_mobile | default: 12 }}px !important;
      margin-bottom: 0.15rem !important;
      text-align: {{ text_align }} !important;
    }
  }
{% endstyle %}

<section id="VideoSection-{{ section.id }}" class="home-section home-video" data-home-video>
  <div class="home-video__container">
    <!-- Header Section -->
    <div class="home-section__head home-video__head">
      {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
        <div class="home-video__heading-banner-wrap">
          <picture class="home-section__heading-picture">
            {% if section.settings.heading_image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
            {% endif %}
            {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
            {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
          </picture>
          {% if section.settings.heading != blank or section.settings.description != blank %}
            <div class="home-video__heading-content">
              <span class="home-video__eyebrow-pill home-video__heading-eyebrow">🌿 OUR FARM TO TABLE STORY</span>
              {% if section.settings.heading != blank %}
                <h2 class="home-video__title home-video__heading-title">{{ section.settings.heading }}</h2>
              {% endif %}
              {% if section.settings.description != blank %}
                <div class="home-video__subtitle" style="text-align: {{ text_align }}; margin: 0.15rem 0 0 0;">{{ section.settings.description }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div style="text-align: {{ text_align }};">
          <span class="home-video__eyebrow-pill" style="text-align: {{ text_align }};">🌿 OUR FARM TO TABLE STORY</span>
          <h2 class="home-video__title" style="text-align: {{ text_align }};">{{ section.settings.heading | default: "Meet the Farmers & Millers" }}</h2>
          {% if section.settings.description != blank %}
            <div class="home-video__subtitle" style="text-align: {{ text_align }};">{{ section.settings.description }}</div>
          {% else %}
            <p class="home-video__subtitle" style="text-align: {{ text_align }};">Take a closer look at the traditional stone-grinding practices and farm-fresh care behind every Kishan Bazar staple.</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Main Video Frame Container with Glowing Ripple Play Button & Badges -->
    <div class="home-video__frame-wrapper" data-video-frame-wrapper>
      <div class="home-video__frame">
        <!-- Floating Badges on Video -->
        <div class="home-video__badge home-video__badge--left">
          <span class="home-video__badge-dot"></span>
          📍 Direct from Surat & MP Farms
        </div>
        <div class="home-video__badge home-video__badge--right">
          ✨ 100% Traditional Stone Ground
        </div>

        <!-- Video Overlay Gradient & Animated Play Button Trigger -->
        <div class="home-video__overlay-trigger" data-video-trigger aria-label="Play Farm Story Video">
          <div class="home-video__play-ripple"></div>
          <button type="button" class="home-video__play-btn" aria-label="Play Video">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="#ffffff" stroke="none">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </button>
          <div class="home-video__overlay-caption">
            <span class="home-video__play-text">▶ Watch Farm Story Video (2 Min)</span>
          </div>
        </div>

        <!-- Video Media Element (Shopify Video, YouTube/Vimeo Iframe, or Poster Image) -->
        <div class="home-video__media-container" data-video-media-container>
          {% if section.settings.video != blank %}
            {{
              section.settings.video
              | video_tag:
                class: 'home-video__media',
                controls: true,
                autoplay: false,
                loop: section.settings.loop,
                muted: false,
                image_size: '1400x'
            }}
          {% elsif section.settings.video_url != blank %}
            {% if section.settings.video_url.type == 'youtube' %}
              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&autoplay=1"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                class="home-video__iframe"
                data-video-iframe
              ></iframe>
            {% else %}
              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                class="home-video__iframe"
                data-video-iframe
              ></iframe>
            {% endif %}
          {% elsif section.settings.poster != blank %}
            {{
              section.settings.poster
              | image_url: width: 1400
              | image_tag: class: 'home-video__poster', loading: 'lazy', widths: '600, 900, 1400', alt: section.settings.heading | escape
            }}
          {% else %}
            <img
              class="home-video__poster"
              src="{{ 'video-thumbnail.jpg.png' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              width="1400"
              height="788"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Video Lightbox Modal for Fullscreen Playback -->
  <div class="home-video__modal" data-video-modal aria-hidden="true">
    <div class="home-video__modal-backdrop" data-video-modal-close></div>
    <div class="home-video__modal-content">
      <button type="button" class="home-video__modal-close" data-video-modal-close aria-label="Close Video Modal">&times;</button>
      <div class="home-video__modal-body" data-video-modal-body></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Section",
  "tag": "section",
  "class": "section-video",
  "settings": [
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Box Background Image (Desktop)", "info": "Upload graphic image to use as background for the Heading Box on Desktop" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Box Background Image (Mobile)", "info": "Upload graphic image to use as background for the Heading Box on Mobile" },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    { "type": "checkbox", "id": "heading_image_flip", "label": "Flip Heading Image Horizontally", "default": false },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Desktop Heading Box Fixed Height (px)", "min": 60, "max": 400, "step": 10, "default": 180, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Mobile Heading Box Fixed Height (px)", "min": 40, "max": 250, "step": 10, "default": 110, "unit": "px" },
    { "type": "range", "id": "heading_image_max_width", "label": "Desktop Heading Image Max Width (px)", "min": 200, "max": 1200, "step": 20, "default": 640, "unit": "px" },
    { "type": "range", "id": "heading_image_mobile_max_width", "label": "Mobile Heading Image Max Width (px)", "min": 150, "max": 800, "step": 10, "default": 360, "unit": "px" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Farmers & Millers"
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Text Alignment",
      "options": [
        { "value": "left", "label": "Left (Recommended)" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "color", "id": "heading_color", "label": "Heading Text Color", "default": "#1e3d20" },
    { "type": "range", "id": "heading_font_size", "label": "Desktop Heading Font Size (px)", "min": 14, "max": 80, "step": 1, "default": 28, "unit": "px" },
    { "type": "range", "id": "heading_font_size_mobile", "label": "Mobile Heading Font Size (px)", "min": 10, "max": 50, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "subheading_font_size", "label": "Desktop Eyebrow Font Size (px)", "min": 10, "max": 30, "step": 1, "default": 15, "unit": "px" },
    { "type": "range", "id": "subheading_font_size_mobile", "label": "Mobile Eyebrow Font Size (px)", "min": 10, "max": 24, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "heading_content_width_desktop", "label": "Desktop Heading Content Width (%)", "min": 40, "max": 100, "step": 5, "default": 80, "unit": "%" },
    { "type": "range", "id": "heading_content_width_mobile", "label": "Mobile Heading Content Width (%)", "min": 40, "max": 100, "step": 5, "default": 85, "unit": "%" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A closer look at the traditional stone-grinding practices and farm-fresh care behind every pantry staple.</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Video Section"
    }
  ]
}
{% endschema %}
