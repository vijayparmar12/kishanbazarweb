<link rel="stylesheet" href="{{ 'section-video.css' | asset_url }}"><script src="{{ 'section-video.js' | asset_url }}" defer="defer"></script>
<section class="home-section home-video" data-home-video><div class="home-section__head home-section__head--center"><p class="home-section__eyebrow">From the farm</p><h2>{{ section.settings.heading }}</h2>{% if section.settings.description != blank %}<div>{{ section.settings.description }}</div>{% endif %}</div><div class="home-video__frame">{% if section.settings.video != blank %}{{ section.settings.video | video_tag: class: 'home-video__media', controls: true, autoplay: section.settings.autoplay, loop: section.settings.loop, muted: section.settings.muted, image_size: '1200x' }}{% elsif section.settings.video_url != blank %}{% if section.settings.video_url.type == 'youtube' %}<iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>{% else %}<iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>{% endif %}{% elsif section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1400 | image_tag: class: 'home-video__poster', loading: 'lazy', widths: '600, 900, 1400' }}{% else %}<img class="home-video__poster" src="{{ 'video-thumbnail.jpg.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1400" height="788" loading="lazy">{% endif %}</div></section>
{% schema %}{"name":"Video","tag":"section","class":"section-video","settings":[{"type":"text","id":"heading","label":"Heading","default":"Meet the makers"},{"type":"richtext","id":"description","label":"Description","default":"<p>A closer look at the people and practices behind every pantry staple.</p>"},{"type":"video","id":"video","label":"Shopify hosted video"},{"type":"video_url","id":"video_url","label":"Video URL","accept":["youtube","vimeo"]},{"type":"image_picker","id":"poster","label":"Poster image"},{"type":"checkbox","id":"autoplay","label":"Autoplay","default":false},{"type":"checkbox","id":"loop","label":"Loop","default":false},{"type":"checkbox","id":"muted","label":"Mute","default":true}],"presets":[{"name":"Video"}]}{% endschema %}
