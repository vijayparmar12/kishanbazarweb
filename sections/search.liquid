{% comment %}
  Search results for products, articles, and pages.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<link rel="stylesheet" href="{{ 'section-search.css' | asset_url }}">

<section class="search-page page-width">
  <div class="search-page__head">
    <h1>{{ 'search.title' | t }}</h1>

    <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        class="search-page__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button class="search-page__submit" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </div>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="search-page__empty">
        <h2>{{ 'search.no_results_html' | t: terms: search.terms }}</h2>
        <p>{{ 'search.empty_hint' | t }}</p>
        <a class="button" href="{{ routes.collections_url }}">{{ 'search.browse_collections' | t }}</a>
      </div>
    {% else %}
      <p class="search-page__summary">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {% liquid
        assign search_term = search.terms | downcase | strip
        assign matched_categories = 0
      %}

      {% capture category_cards %}
        {% for collection in collections %}
          {% unless collection.handle == 'all' %}
              {% liquid
                assign collection_title = collection.title | downcase
                assign collection_handle = collection.handle | downcase
                assign is_match = false

                if collection_title contains search_term
                  assign is_match = true
                endif

                if collection_handle contains search_term
                  assign is_match = true
                endif
              %}

              {% if is_match %}
                {% if collection.products_count > 0 %}
                  {% assign matched_categories = matched_categories | plus: 1 %}
                  {% liquid
                    assign card_image = collection.image
                    if card_image == blank
                      assign first_product = collection.products | first
                      if first_product != blank
                        assign card_image = first_product.featured_image
                      endif
                    endif
                  %}
                  <a class="search-category-card" href="{{ collection.url }}">
                    <span class="search-category-card__media">
                      {% if card_image != blank %}
                        {{ card_image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 180' }}
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag }}
                      {% endif %}
                    </span>
                    <span>
                      <span class="search-category-card__title">{{ collection.title }}</span>
                      <span class="search-category-card__subtitle">{{ 'search.category_products' | t: count: collection.products_count }}</span>
                    </span>
                  </a>
                {% endif %}
              {% endif %}
            {% endunless %}
          {% endfor %}
      {% endcapture %}

      {% if matched_categories > 0 %}
        <div class="search-categories">
          <h2 class="search-categories__heading">{{ 'search.categories_heading' | t }}</h2>
          <div class="search-categories__grid">
            {{ category_cards }}
          </div>
        </div>
      {% endif %}

      <div class="search-page__grid" role="list">
        {% paginate search.results by 20 %}
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              <div role="listitem">
                {% render 'product-card',
                  product: result,
                  show_vendor: true,
                  show_price: true,
                  show_compare_price: true,
                  show_rating: false,
                  show_badge: true,
                  show_wishlist: true,
                  show_quickview: true,
                  show_add_to_cart: true
                %}
              </div>
            {% else %}
              <article class="search-result-card">
                {% assign featured_image = result.featured_image | default: result.image %}
                {% if featured_image %}
                  {% render 'image', class: 'search-result-card__image', image: featured_image, url: result.url, width: 400 %}
                {% endif %}
                <div class="search-result-card__content">
                  <h3>{{ result.title | link_to: result.url }}</h3>
                </div>
              </article>
            {% endif %}
          {% endfor %}

          {% if paginate.pages > 1 %}
            <nav class="search-page__pagination" aria-label="Pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" rel="prev">{{ 'general.pagination.previous' | t }}</a>
              {% else %}
                <span aria-disabled="true">{{ 'general.pagination.previous' | t }}</span>
              {% endif %}

              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: page: part.title, pages: paginate.pages }}">{{ part.title }}</a>
                {% elsif part.title == paginate.current_page %}
                  <span aria-current="page">{{ part.title }}</span>
                {% else %}
                  <span>{{ part.title }}</span>
                {% endif %}
              {% endfor %}

              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" rel="next">{{ 'general.pagination.next' | t }}</a>
              {% else %}
                <span aria-disabled="true">{{ 'general.pagination.next' | t }}</span>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
