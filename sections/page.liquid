{% comment %}
  Standard Page Template section with Top Banner Image (Above Title), Mobile Reset Container & Auto-Boxer Horizontal Gallery
{% endcomment %}

<link rel="stylesheet" href="{{ 'section-our-story.css' | asset_url }}">

<div class="vedic-page-container section-{{ section.id }}-padding" style="width: 100%; max-width: 1100px; margin: 1.5rem auto; padding: 0 0.85rem; box-sizing: border-box; overflow-x: hidden;">
  
  <!-- 1. TOP HERO BANNER IMAGE ABOVE TITLE (Editable in Theme Editor & Page Metafields) -->
  {% liquid
    assign page_banner_desk = section.settings.banner_image_desktop | default: page.metafields.custom.banner_image.value | default: page.metafields.custom.banner_image
    assign page_banner_mob = section.settings.banner_image_mobile | default: page.metafields.custom.banner_mobile_image.value | default: page.metafields.custom.banner_mobile_image | default: page_banner_desk
  %}

  {% if page_banner_desk != blank %}
    <div class="vedic-story-banner-wrap" style="max-width: 1400px; margin: 0 auto 1.5rem; padding: 0; box-sizing: border-box; width: 100%;">
      <picture class="vedic-story-picture" style="display: block; width: 100%;">
        {% if page_banner_mob != blank and page_banner_mob != page_banner_desk %}
          <source media="(max-width: 768px)" srcset="{{ page_banner_mob | image_url: width: 1200 }}">
        {% endif %}
        <img
          src="{{ page_banner_desk | image_url: width: 2000 }}"
          alt="{{ page.title | escape }}"
          class="vedic-story-banner-image"
          loading="eager"
          style="width: 100%; height: auto; display: block; border-radius: {{ section.settings.banner_radius | default: 20 }}px; max-height: 480px; object-fit: cover; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);"
        >
      </picture>
    </div>
  {% endif %}

  <!-- 2. PAGE TITLE -->
  <h1 class="main-page-title page-title h0" style="color: #132D14; font-family: Georgia, serif; font-size: clamp(1.75rem, 4.5vw, 3.2rem); font-weight: 900; text-align: center; margin-bottom: 2rem; width: 100%; box-sizing: border-box;">
    {{ page.title }}
  </h1>

  <!-- 3. PAGE CONTENT AUTO-BOXER WRAPPER -->
  <div class="rte vedic-page-content-wrapper" data-auto-box-content style="width: 100%; box-sizing: border-box; overflow-x: hidden;">
    {{ page.content }}
  </div>
</div>

<!-- AUTO-BOXER SCRIPT FOR NUMBERED RECIPES, CHAPTERS, AND MULTIPLE IMAGE SCROLL GALLERY -->
<script>
  (function() {
    function initAutoBoxer() {
      var container = document.querySelector('[data-auto-box-content]');
      if (!container) return;

      var rawHTML = container.innerHTML;
      if (!rawHTML || rawHTML.trim() === '') return;

      var tempDiv = document.createElement('div');
      tempDiv.innerHTML = rawHTML;

      var children = Array.from(tempDiv.childNodes);
      var boxes = [];
      var currentBoxNodes = [];
      var numRegex = /^(\d+)[\.\:\)]\s+/; // Matches "1. Haldi Wala Dudh", "2. Khapli Wheat Roti"

      children.forEach(function(node) {
        var isHeading = false;
        var textContent = node.textContent ? node.textContent.trim() : '';

        if (node.nodeType === 1) { // Element node
          var tagName = node.tagName.toLowerCase();
          if (['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].indexOf(tagName) !== -1) {
            isHeading = true;
          } else if (numRegex.test(textContent) && textContent.length < 80) {
            isHeading = true;
          } else if (textContent.indexOf('Chapter') !== -1 && textContent.length < 80) {
            isHeading = true;
          } else if (textContent.indexOf('Title:') === 0 || textContent.indexOf('Farmer:') === 0 || textContent.indexOf('Name:') === 0 || textContent.indexOf('A Note from Our Founder') !== -1 || textContent.indexOf('Note from Our Founder') !== -1) {
            isHeading = true;
          } else if (textContent.indexOf('Bhai') !== -1 || textContent.indexOf('Farmer') !== -1) {
            if (textContent.length < 60) {
              isHeading = true;
            }
          }
        } else if (node.nodeType === 3) { // Text node
          if (numRegex.test(textContent) || textContent.indexOf('Chapter') !== -1 || textContent.indexOf('Title:') === 0 || textContent.indexOf('Farmer:') === 0 || textContent.indexOf('A Note from Our Founder') !== -1 || (textContent.indexOf('Bhai') !== -1 && textContent.length < 60)) {
            isHeading = true;
          }
        }

        if (isHeading && currentBoxNodes.length > 0) {
          boxes.push(currentBoxNodes);
          currentBoxNodes = [];
        }
        currentBoxNodes.push(node);
      });

      if (currentBoxNodes.length > 0) {
        boxes.push(currentBoxNodes);
      }

      if (boxes.length > 0) {
        var mainBoxes = [];
        var founderBox = null;

        boxes.forEach(function(nodes) {
          var boxEl = document.createElement('div');
          var textContent = '';
          nodes.forEach(function(n) {
            textContent += (n.textContent || '') + ' ';
          });

          var isFounder = (textContent.indexOf('A Note from Our Founder') !== -1 || textContent.indexOf('Note from Our Founder') !== -1);

          if (isFounder) {
            boxEl.className = 'vedic-content-box vedic-founder-box';
          } else {
            boxEl.className = 'vedic-content-box';
          }

          nodes.forEach(function(n) {
            boxEl.appendChild(n.cloneNode(true));
          });

          // Style formatting inside box
          var boxHTML = boxEl.innerHTML;
          boxHTML = boxHTML.replace(/Title:\s*([^<]+)/gi, '<h2 class="vedic-content-box__title">$1</h2>');
          boxHTML = boxHTML.replace(/Subtitle:\s*([^<]+)/gi, '<span class="vedic-content-box__subtitle">$1</span>');
          boxHTML = boxHTML.replace(/Content:\s*/gi, '');
          boxHTML = boxHTML.replace(/Button:\s*([^<]+)/gi, '<a class="vedic-content-box__btn" href="/collections/all">$1</a>');

          boxEl.innerHTML = boxHTML;

          // Convert multiple images inside a box into a horizontal left-to-right scroll gallery
          var imgs = Array.from(boxEl.querySelectorAll('img'));
          if (imgs.length >= 2) {
            var galleryWrap = document.createElement('div');
            galleryWrap.className = 'vedic-box-gallery';
            var galleryTrack = document.createElement('div');
            galleryTrack.className = 'vedic-box-gallery__track';

            imgs.forEach(function(img) {
              var slide = document.createElement('div');
              slide.className = 'vedic-box-gallery__slide';
              var imgClone = img.cloneNode(true);
              imgClone.removeAttribute('style');
              slide.appendChild(imgClone);
              galleryTrack.appendChild(slide);

              var parentP = img.closest('p, div, figure');
              if (parentP && parentP !== boxEl && parentP.querySelectorAll('img').length === 1 && parentP.textContent.trim() === '') {
                parentP.remove();
              } else {
                img.remove();
              }
            });

            // Enable Mouse Drag-to-Scroll on Desktop
            var isDown = false;
            var startX, scrollLeft;
            galleryTrack.addEventListener('mousedown', function(e) {
              isDown = true;
              galleryTrack.classList.add('is-dragging');
              startX = e.pageX - galleryTrack.offsetLeft;
              scrollLeft = galleryTrack.scrollLeft;
            });
            galleryTrack.addEventListener('mouseleave', function() { isDown = false; galleryTrack.classList.remove('is-dragging'); });
            galleryTrack.addEventListener('mouseup', function() { isDown = false; galleryTrack.classList.remove('is-dragging'); });
            galleryTrack.addEventListener('mousemove', function(e) {
              if (!isDown) return;
              e.preventDefault();
              var x = e.pageX - galleryTrack.offsetLeft;
              var walk = (x - startX) * 2;
              galleryTrack.scrollLeft = scrollLeft - walk;
            });

            galleryWrap.appendChild(galleryTrack);
            boxEl.appendChild(galleryWrap);
          }

          if (isFounder) {
            founderBox = boxEl;
          } else {
            mainBoxes.push(boxEl);
          }
        });

        container.innerHTML = '';
        mainBoxes.forEach(function(b) {
          container.appendChild(b);
        });

        // ALWAYS append Founder Box at the VERY END of the page!
        if (founderBox) {
          container.appendChild(founderBox);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoBoxer);
    } else {
      initAutoBoxer();
    }
  })();
</script>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "header",
      "content": "Top Banner Image Settings (Above Title)"
    },
    { "type": "image_picker", "id": "banner_image_desktop", "label": "Top Hero Banner Image (Desktop)" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Top Hero Banner Image (Mobile)" },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
