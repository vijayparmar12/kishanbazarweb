{% comment %}
  Standard Page Template section with Top Banner Image (Above Title) & Automatic Box CSS formatting for every Title/Heading
{% endcomment %}

<link rel="stylesheet" href="{{ 'section-our-story.css' | asset_url }}">

<div class="page-width page-width--narrow section-{{ section.id }}-padding" style="max-width: 1100px; margin: 2rem auto; padding: 0 1rem; box-sizing: border-box;">
  
  <!-- 1. TOP HERO BANNER IMAGE ABOVE TITLE (Editable in Theme Editor & Page Metafields) -->
  {% liquid
    assign page_banner_desk = section.settings.banner_image_desktop | default: page.metafields.custom.banner_image.value | default: page.metafields.custom.banner_image
    assign page_banner_mob = section.settings.banner_image_mobile | default: page.metafields.custom.banner_mobile_image.value | default: page.metafields.custom.banner_mobile_image | default: page_banner_desk
  %}

  {% if page_banner_desk != blank %}
    <div class="vedic-story-banner-wrap" style="max-width: 1400px; margin: 0 auto 2rem; padding: 0; box-sizing: border-box;">
      <picture class="vedic-story-picture">
        {% if page_banner_mob != blank and page_banner_mob != page_banner_desk %}
          <source media="(max-width: 768px)" srcset="{{ page_banner_mob | image_url: width: 1200 }}">
        {% endif %}
        <img
          src="{{ page_banner_desk | image_url: width: 2000 }}"
          alt="{{ page.title | escape }}"
          class="vedic-story-banner-image"
          loading="eager"
          style="width: 100%; height: auto; display: block; border-radius: {{ section.settings.banner_radius | default: 20 }}px; max-height: 480px; object-fit: cover; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);"
        >
      </picture>
    </div>
  {% endif %}

  <!-- 2. PAGE TITLE -->
  <h1 class="main-page-title page-title h0" style="color: #132D14; font-family: Georgia, serif; font-size: clamp(2rem, 4.5vw, 3.2rem); font-weight: 900; text-align: center; margin-bottom: 2.5rem;">
    {{ page.title }}
  </h1>

  <!-- 3. PAGE CONTENT AUTO-BOXER WRAPPER -->
  <div class="rte vedic-page-content-wrapper" data-auto-box-content>
    {{ page.content }}
  </div>
</div>

<script>
  (function() {
    function initAutoBoxer() {
      var container = document.querySelector('[data-auto-box-content]');
      if (!container) return;

      var rawHTML = container.innerHTML;
      if (!rawHTML || rawHTML.trim() === '') return;

      if (rawHTML.indexOf('Title:') !== -1 || rawHTML.indexOf('<h2') !== -1 || rawHTML.indexOf('<h3') !== -1 || rawHTML.indexOf('<h4') !== -1) {
        var tempDiv = document.createElement('div');
        tempDiv.innerHTML = rawHTML;

        var children = Array.from(tempDiv.childNodes);
        var boxes = [];
        var currentBoxNodes = [];

        children.forEach(function(node) {
          var isHeading = false;
          var textContent = node.textContent ? node.textContent.trim() : '';

          if (node.nodeType === 1) {
            var tagName = node.tagName.toLowerCase();
            if (['h1', 'h2', 'h3', 'h4'].indexOf(tagName) !== -1 || textContent.indexOf('Title:') === 0) {
              isHeading = true;
            }
          } else if (node.nodeType === 3 && textContent.indexOf('Title:') === 0) {
            isHeading = true;
          }

          if (isHeading && currentBoxNodes.length > 0) {
            boxes.push(currentBoxNodes);
            currentBoxNodes = [];
          }
          currentBoxNodes.push(node);
        });

        if (currentBoxNodes.length > 0) {
          boxes.push(currentBoxNodes);
        }

        if (boxes.length > 0) {
          container.innerHTML = '';
          boxes.forEach(function(nodes) {
            var boxEl = document.createElement('div');
            boxEl.className = 'vedic-content-box';
            
            nodes.forEach(function(n) {
              boxEl.appendChild(n.cloneNode(true));
            });

            var boxHTML = boxEl.innerHTML;
            boxHTML = boxHTML.replace(/Title:\s*([^<]+)/gi, '<h2 class="vedic-content-box__title">$1</h2>');
            boxHTML = boxHTML.replace(/Subtitle:\s*([^<]+)/gi, '<span class="vedic-content-box__subtitle">$1</span>');
            boxHTML = boxHTML.replace(/Content:\s*/gi, '');
            boxHTML = boxHTML.replace(/Button:\s*([^<]+)/gi, '<a class="vedic-content-box__btn" href="/collections/all">$1</a>');

            boxEl.innerHTML = boxHTML;
            container.appendChild(boxEl);
          });
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoBoxer);
    } else {
      initAutoBoxer();
    }
  })();
</script>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "header",
      "content": "Top Banner Image Settings (Above Title)"
    },
    { "type": "image_picker", "id": "banner_image_desktop", "label": "Top Hero Banner Image (Desktop)" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Top Hero Banner Image (Mobile)" },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
