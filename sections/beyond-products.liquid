<link rel="stylesheet" href="{{ 'section-beyond-products.css' | asset_url }}">
<script src="{{ 'section-beyond-products.js' | asset_url }}" defer="defer"></script>

{% style %}
  #BeyondProducts-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#F8F4EB' }} !important;
  }
  #BeyondProducts-{{ section.id }} .beyond-products__heading {
    color: {{ section.settings.heading_color | default: '#23421F' }} !important;
  }
  #BeyondProducts-{{ section.id }} .beyond-products__subheading {
    color: {{ section.settings.subheading_color | default: '#8B4513' }} !important;
  }
{% endstyle %}

<section id="BeyondProducts-{{ section.id }}" class="beyond-products" data-beyond-products>
  <div class="beyond-products__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="beyond-products__header">
        {% if section.settings.subheading != blank %}
          <p class="beyond-products__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="beyond-products__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="beyond-products__carousel" data-beyond-carousel>
      <div class="beyond-products__track" data-beyond-track>
        {% for block in section.blocks %}
          {% if block.type == 'story_card' %}
            <div class="beyond-products__slide" data-beyond-slide {{ block.shopify_attributes }}>
              <div class="beyond-products__card beyond-products__card--pos-{{ block.settings.text_position | default: 'top' }}">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="beyond-products__card-link" aria-label="{{ block.settings.title | default: 'Story Card' }}">
                {% endif %}

                <div class="beyond-products__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        class: 'beyond-products__img',
                        loading: 'lazy',
                        widths: '360, 480, 600, 800',
                        alt: block.settings.title | default: 'Beyond Our Products'
                    }}
                  {% else %}
                    <div class="beyond-products__placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'beyond-products__placeholder-svg' }}
                    </div>
                  {% endif %}
                </div>

                {% if block.settings.title != blank or block.settings.description != blank %}
                  <div class="beyond-products__content" style="color: {{ block.settings.text_color | default: '#166534' }};">
                    {% if block.settings.title != blank %}
                      <h3 class="beyond-products__card-title">{{ block.settings.title }}</h3>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <p class="beyond-products__card-desc">{{ block.settings.description }}</p>
                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% else %}
          <div class="beyond-products__slide" data-beyond-slide>
            <div class="beyond-products__card">
              <div class="beyond-products__media">
                <img src="{{ '1.png' | asset_url }}" alt="From Native Geographies" class="beyond-products__img" loading="lazy">
              </div>
              <div class="beyond-products__content">
                <h3 class="beyond-products__card-title">From Native Geographies to Ideal Growing Seasons</h3>
                <p class="beyond-products__card-desc">We take care of every factor when sourcing local ingredients.</p>
              </div>
            </div>
          </div>
          <div class="beyond-products__slide" data-beyond-slide>
            <div class="beyond-products__card">
              <div class="beyond-products__media">
                <img src="{{ '5.png' | asset_url }}" alt="What Do We Look For?" class="beyond-products__img" loading="lazy">
              </div>
              <div class="beyond-products__content">
                <h3 class="beyond-products__card-title">What Do We Look For?</h3>
                <p class="beyond-products__card-desc">Not high yield. Not lower cost. Just flavour, nutrition, and soul.</p>
              </div>
            </div>
          </div>
          <div class="beyond-products__slide" data-beyond-slide>
            <div class="beyond-products__card">
              <div class="beyond-products__media">
                <img src="{{ 'icon1.png' | asset_url }}" alt="Impurities Out" class="beyond-products__img" loading="lazy">
              </div>
              <div class="beyond-products__content">
                <h3 class="beyond-products__card-title">Impurities, Out. Goodness, In.</h3>
                <p class="beyond-products__card-desc">Only the best seeds & purest milk make the cut.</p>
              </div>
            </div>
          </div>
          <div class="beyond-products__slide" data-beyond-slide>
            <div class="beyond-products__card">
              <div class="beyond-products__media">
                <img src="{{ 'icon2.png' | asset_url }}" alt="Gir Cows" class="beyond-products__img" loading="lazy">
              </div>
              <div class="beyond-products__content">
                <h3 class="beyond-products__card-title">A2 Milk of Gir Cows & Native Seeds</h3>
                <p class="beyond-products__card-desc">We dare you to find better native ingredients.</p>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="beyond-products__dots" data-beyond-dots role="tablist"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beyond Our Products",
  "tag": "section",
  "class": "section-beyond-products",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Native Ingredients. No Substitutes."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beyond Our Products"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F8F4EB"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading text color",
      "default": "#8B4513"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text color",
      "default": "#23421F"
    }
  ],
  "blocks": [
    {
      "type": "story_card",
      "name": "Story Poster Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Overlay Title",
          "default": "From Native Geographies to Ideal Growing Seasons"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Overlay Description",
          "default": "We take care of every factor when sourcing local ingredients."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Overlay Text Color",
          "default": "#166534"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Overlay Text Position",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "top"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beyond Our Products",
      "blocks": [
        {
          "type": "story_card",
          "settings": {
            "title": "From Native Geographies to Ideal Growing Seasons",
            "description": "We take care of every factor when sourcing local ingredients."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "title": "What Do We Look For?",
            "description": "Not high yield. Not lower cost. Just flavour, nutrition, and soul."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "title": "Impurities, Out. Goodness, In.",
            "description": "Only the best seeds & purest milk make the cut."
          }
        },
        {
          "type": "story_card",
          "settings": {
            "title": "A2 Milk of Gir Cows & Native Seeds",
            "description": "We dare you to find better native ingredients."
          }
        }
      ]
    }
  ]
}
{% endschema %}
