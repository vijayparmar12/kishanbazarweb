<link rel="stylesheet" href="{{ 'section-features.css' | asset_url }}">
<section class="home-section features"><div class="home-section__head home-section__head--center"><h2>{{ section.settings.heading }}</h2></div><div class="features__grid">{% for block in section.blocks %}<article class="features__card" {{ block.shopify_attributes }}><span class="features__icon">{% render 'icon', name: block.settings.icon, size: 24 %}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></article>{% endfor %}</div></section>
{% schema %}{"name":"Features","tag":"section","class":"section-features","settings":[{"type":"text","id":"heading","label":"Heading","default":"The Kishan Bazar promise"}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"heart","label":"Heart"},{"value":"star","label":"Star"},{"value":"cart","label":"Cart"},{"value":"location","label":"Location"},{"value":"phone","label":"Phone"}],"default":"heart"},{"type":"text","id":"title","label":"Title","default":"Naturally good"},{"type":"textarea","id":"description","label":"Description","default":"Simple ingredients, chosen with care."}]}],"max_blocks":6,"presets":[{"name":"Features","blocks":[{"type":"feature"},{"type":"feature"},{"type":"feature"}]}]}{% endschema %}
