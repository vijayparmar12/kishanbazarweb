<link rel="stylesheet" href="{{ 'section-collections.css' | asset_url }}"><script src="{{ 'section-collections.js' | asset_url }}" defer="defer"></script>
<section class="home-section featured-collections" data-featured-collections><div class="home-section__head"><div><p class="home-section__eyebrow">Discover more</p><h2>{{ section.settings.heading }}</h2></div></div><div class="featured-collections__grid">{% if section.settings.collections != blank %}{% for collection in section.settings.collections limit: section.settings.maximum %}<a class="featured-collections__card" href="{{ collection.url }}">{% if collection.featured_image != blank %}{{ collection.featured_image | image_url: width: 800 | image_tag: class: 'featured-collections__image', loading: 'lazy', widths: '300, 500, 800' }}{% endif %}<div><h3>{{ collection.title }}</h3><span>{{ collection.products_count }} products</span></div></a>{% endfor %}{% endif %}</div></section>
{% schema %}{"name":"Featured collections","tag":"section","class":"section-collections","settings":[{"type":"text","id":"heading","label":"Heading","default":"Gather your favourites"},{"type":"collection_list","id":"collections","label":"Collections","limit":12},{"type":"range","id":"maximum","label":"Maximum collections","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collections"}]}{% endschema %}
