{% doc %}
  Renders the Sustainability & Commitment section for Our Story page.
{% enddoc %}

<section class="story-commitment" {{ section.shopify_attributes }}>
  <div class="story-container">
    <div class="story-commitment__grid">
      <!-- Text Content Column (Left on Desktop) -->
      <div class="story-commitment__content-col" data-story-reveal>
        <span class="story-eyebrow">{{ section.settings.eyebrow | default: 'SUSTAINABILITY & HARMONY' }}</span>
        <h2 class="story-heading">{{ section.settings.heading | default: 'Better Food. Better Farming. Better Future.' }}</h2>

        <div class="story-commitment__body">
          {% if section.settings.content != blank %}
            {{ section.settings.content }}
          {% else %}
            <p>
              True organic food isn't just about what is excluded from the plate—it's about what we give back to the soil, the ecosystem, and the farming communities.
            </p>
            <p>
              Through regenerative agriculture practices, crop rotation, and water-efficient irrigation, our partner farmers nourish the land for generations to come.
            </p>
            <p>
              We prioritize eco-friendly packaging, zero-waste processing, and direct fair-trade pricing to ensure our planet and producers thrive together.
            </p>
          {% endif %}
        </div>

        {% if section.settings.cta_text != blank %}
          <div class="story-commitment__action">
            <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="story-btn story-btn--primary">
              {{ section.settings.cta_text }}
            </a>
          </div>
        {% endif %}
      </div>

      <!-- Media Column (Right on Desktop) -->
      <div class="story-commitment__media-col" data-story-reveal>
        <div class="story-commitment__image-wrap">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'story-commitment__image',
                loading: 'lazy',
                widths: '480, 750, 900, 1200',
                alt: section.settings.heading | escape
            }}
          {% else %}
            <img
              class="story-commitment__image"
              src="{{ 'video-thumbnail.jpg.png' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              width="650"
              height="750"
              loading="lazy"
            >
          {% endif %}
          <div class="story-commitment__badge">
            <span>🌿 Regenerative &bull; Ethical &bull; Sustainable</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sustainability Commitment",
  "tag": "section",
  "class": "section-our-story-commitment",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SUSTAINABILITY & HARMONY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better Food. Better Farming. Better Future."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Learn About Our Commitment"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    }
  ],
  "presets": [
    {
      "name": "Sustainability Commitment"
    }
  ]
}
{% endschema %}
