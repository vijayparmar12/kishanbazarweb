<link rel="stylesheet" href="{{ 'section-scrolling-logos.css' | asset_url }}">
<script src="{{ 'section-scrolling-logos.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign enable_marquee = section.settings.enable_marquee
  assign speed = section.settings.speed | default: 45
  assign logo_shape = section.settings.logo_shape | default: 'circle'
  assign show_border = section.settings.show_border
  assign show_title = section.settings.show_title
  assign direction = section.settings.direction | default: 'left'
  assign pause_on_hover = section.settings.pause_on_hover

  # Ensure each track has at least 18-24 items so it comfortably exceeds any screen width with uniform gap spacing
  assign block_count = section.blocks.size
  assign repeat_count = 1
  if block_count > 0
    if block_count < 3
      assign repeat_count = 10
    elsif block_count < 5
      assign repeat_count = 6
    elsif block_count < 8
      assign repeat_count = 4
    elsif block_count < 12
      assign repeat_count = 3
    else
      assign repeat_count = 2
    endif
  endif
%}

<section
  id="shopify-section-{{ section.id }}"
  class="kb-scrolling-logos"
  data-pause-on-hover="{{ pause_on_hover }}"
  style="
    --kb-sl-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --kb-sl-pt: {{ section.settings.padding_top | default: 48 }}px;
    --kb-sl-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    --kb-sl-pt-mobile: {{ section.settings.padding_top_mobile | default: 36 }}px;
    --kb-sl-pb-mobile: {{ section.settings.padding_bottom_mobile | default: 36 }}px;
    --kb-sl-mt: {{ section.settings.margin_top | default: 0 }}px;
    --kb-sl-mb: {{ section.settings.margin_bottom | default: 0 }}px;
    --kb-sl-mt-mobile: {{ section.settings.margin_top_mobile | default: 0 }}px;
    --kb-sl-mb-mobile: {{ section.settings.margin_bottom_mobile | default: 0 }}px;
    --kb-sl-align: {{ section.settings.heading_text_align | default: section.settings.heading_alignment | default: 'center' }};
    --kb-sl-heading-size: {{ section.settings.heading_font_size | default: 28 }}px;
    --kb-sl-heading-size-mobile: {{ section.settings.heading_font_size_mobile | default: 20 }}px;
    --kb-sl-heading-weight: {{ section.settings.heading_font_weight | default: '700' }};
    --kb-sl-heading-color: {{ section.settings.heading_color | default: '#1b4317' }};
    --kb-sl-heading-mb: {{ section.settings.heading_margin_bottom | default: 32 }}px;
    --kb-sl-heading-mb-mobile: {{ section.settings.heading_margin_bottom_mobile | default: 24 }}px;
    --kb-sl-gap: {{ section.settings.gap | default: 44 }}px;
    --kb-sl-gap-mobile: {{ section.settings.gap_mobile | default: 28 }}px;
    --kb-sl-logo-size: {{ section.settings.logo_size | default: 85 }}px;
    --kb-sl-logo-size-mobile: {{ section.settings.logo_size_mobile | default: 68 }}px;
    --kb-sl-badge-bg: {{ section.settings.badge_bg_color | default: '#ffffff' }};
    --kb-sl-border-color: {{ section.settings.border_color | default: '#e2e8f0' }};
    --kb-sl-title-color: {{ section.settings.title_color | default: '#23421f' }};
    --kb-sl-speed: {{ speed }}s;
  "
  {{ section.shopify_attributes }}
>
  <div class="kb-scrolling-logos__container">
    {% if heading != blank or subheading != blank %}
      <div class="kb-scrolling-logos__header">
        {% if heading != blank %}
          <h2 class="kb-scrolling-logos__heading">{{ heading }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="kb-scrolling-logos__subheading">{{ subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% capture logo_items %}
        {% for r in (1..repeat_count) %}
          {% for block in section.blocks %}
            {% assign b_title = block.settings.title | default: 'Certification' %}
            {% assign b_title_lower = b_title | downcase %}
            
            <div class="kb-scrolling-logos__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="kb-scrolling-logos__link" aria-label="{{ b_title | escape }}">
              {% else %}
                <div class="kb-scrolling-logos__link">
              {% endif %}

                <div class="kb-scrolling-logos__badge-wrap kb-scrolling-logos__badge-wrap--{{ logo_shape }}{% if show_border %} kb-scrolling-logos__badge-wrap--has-border{% endif %}">
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 320 | image_tag: class: 'kb-scrolling-logos__img', alt: b_title, loading: 'lazy' }}
                  {% else %}
                    {%- comment -%} High-Resolution Vector Certification Badges {%- endcomment -%}
                    {% if b_title_lower contains '22000' %}
                      <!-- ISO 22000 Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#F4F8FA" stroke="#0072CE" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#0072CE" stroke-width="1.2" stroke-dasharray="2 2"/>
                        <path d="M50 14 A36 36 0 0 1 86 50" fill="none" stroke="#0072CE" stroke-width="1.5"/>
                        <path d="M50 86 A36 36 0 0 1 14 50" fill="none" stroke="#0072CE" stroke-width="1.5"/>
                        <!-- Central ISO text -->
                        <text x="50" y="44" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="20" fill="#0072CE" letter-spacing="1">ISO</text>
                        <rect x="24" y="49" width="52" height="15" rx="3" fill="#0072CE"/>
                        <text x="50" y="61" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="10.5" fill="#FFFFFF" letter-spacing="0.8">22000</text>
                        <text x="50" y="74" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="6.5" fill="#0072CE" letter-spacing="0.5">FOOD SAFETY</text>
                        <polygon points="50,20 51.5,24 56,24.5 52.5,27.5 53.5,32 50,29.5 46.5,32 47.5,27.5 44,24.5 48.5,24" fill="#0072CE"/>
                      </svg>
                    {% elsif b_title_lower contains '9001' %}
                      <!-- ISO 9001 Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#F0F6FD" stroke="#0B5CAD" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#0B5CAD" stroke-width="1.2"/>
                        <text x="50" y="44" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="20" fill="#0B5CAD" letter-spacing="1">ISO</text>
                        <rect x="25" y="49" width="50" height="15" rx="3" fill="#0B5CAD"/>
                        <text x="50" y="61" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="11" fill="#FFFFFF" letter-spacing="0.8">9001</text>
                        <text x="50" y="74" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="6.5" fill="#0B5CAD" letter-spacing="0.5">CERTIFIED</text>
                        <polygon points="50,20 51.5,24 56,24.5 52.5,27.5 53.5,32 50,29.5 46.5,32 47.5,27.5 44,24.5 48.5,24" fill="#0B5CAD"/>
                      </svg>
                    {% elsif b_title_lower contains 'fda' %}
                      <!-- FDA Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#FAFAFA" stroke="#222222" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#222222" stroke-width="1.2" stroke-dasharray="1.5 2"/>
                        <!-- Ribbon/Shield -->
                        <path d="M50 20 L66 26 C66 42 50 50 50 50 C50 50 34 42 34 26 Z" fill="#222222"/>
                        <text x="50" y="38" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="11" fill="#FFFFFF" letter-spacing="1">FDA</text>
                        <text x="50" y="65" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="14" fill="#222222" letter-spacing="0.8">FDA</text>
                        <text x="50" y="76" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="6.5" fill="#444444" letter-spacing="0.8">REGISTERED</text>
                      </svg>
                    {% elsif b_title_lower contains 'gmp' %}
                      <!-- GMP Certified Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#F0F9F2" stroke="#2E7D32" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#2E7D32" stroke-width="1.2"/>
                        <!-- Leaves border -->
                        <path d="M50 18 C58 18 64 22 66 28 C62 30 56 26 50 26 C44 26 38 30 34 28 C36 22 42 18 50 18 Z" fill="#2E7D32"/>
                        <text x="50" y="52" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="18" fill="#2E7D32" letter-spacing="1">GMP</text>
                        <rect x="22" y="58" width="56" height="13" rx="2.5" fill="#2E7D32"/>
                        <text x="50" y="67.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="8" fill="#FFFFFF" letter-spacing="0.6">CERTIFIED</text>
                        <text x="50" y="79" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="6" fill="#2E7D32" letter-spacing="0.5">PRACTICE</text>
                      </svg>
                    {% elsif b_title_lower contains 'organic' or b_title_lower contains 'jaivik' %}
                      <!-- 100% Organic Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#F4FAF3" stroke="#23421F" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#23421F" stroke-width="1.2" stroke-dasharray="2 2"/>
                        <!-- Sprout -->
                        <path d="M50 42 C48 30 36 26 32 30 C30 38 42 42 50 42 Z" fill="#4CAF50"/>
                        <path d="M50 42 C52 28 66 26 68 32 C68 40 56 42 50 42 Z" fill="#2E7D32"/>
                        <path d="M50 42 L50 52" stroke="#23421F" stroke-width="2" stroke-linecap="round"/>
                        <text x="50" y="64" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="12" fill="#23421F" letter-spacing="0.6">100%</text>
                        <text x="50" y="75" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="9" fill="#2E7D32" letter-spacing="0.8">ORGANIC</text>
                      </svg>
                    {% else %}
                      <!-- General Quality Guarantee Badge -->
                      <svg class="kb-scrolling-logos__placeholder-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="#FAFBF9" stroke="#23421F" stroke-width="2.5"/>
                        <circle cx="50" cy="50" r="42" fill="#FFFFFF" stroke="#C59B27" stroke-width="1.2"/>
                        <path d="M50 18 L53 26 L61 27 L55 33 L57 41 L50 36 L43 41 L45 33 L39 27 L47 26 Z" fill="#C59B27"/>
                        <text x="50" y="58" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="10" fill="#23421F" letter-spacing="0.5">{{ b_title | truncate: 12 }}</text>
                        <text x="50" y="72" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="7" fill="#666666" letter-spacing="0.8">VERIFIED</text>
                      </svg>
                    {% endif %}
                  {% endif %}
                </div>

                {% if show_title and b_title != blank %}
                  <span class="kb-scrolling-logos__title">{{ b_title }}</span>
                {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      {% endcapture %}

      <div class="kb-scrolling-logos__scroller{% unless enable_marquee %} kb-scrolling-logos__scroller--static{% endunless %}" data-kb-scroller>
        <div class="kb-scrolling-logos__track{% if enable_marquee %} kb-scrolling-logos__track--animate{% if direction == 'right' %} kb-scrolling-logos__track--reverse{% endif %}{% endif %}">
          {{ logo_items }}
        </div>
        {% if enable_marquee %}
          <div class="kb-scrolling-logos__track kb-scrolling-logos__track--animate{% if direction == 'right' %} kb-scrolling-logos__track--reverse{% endif %}" aria-hidden="true">
            {{ logo_items }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Scrolling logos / Badges",
  "tag": "section",
  "class": "section-scrolling-logos",
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Certification"
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Text Alignment",
      "options": [
        { "value": "left", "label": "Left (Recommended)" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size (Desktop)",
      "min": 16,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size (Mobile)",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1b4317"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Space below heading (Desktop)",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "label": "Space below heading (Mobile)",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Logo & badge appearance"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo badge size (Desktop)",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 85
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "label": "Logo badge size (Mobile)",
      "min": 30,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "select",
      "id": "logo_shape",
      "label": "Badge shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded square" },
        { "value": "natural", "label": "Natural (no crop)" }
      ],
      "default": "circle"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show subtle border & shadow around badges",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Badge border color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show badge title text under logo",
      "default": false
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Badge title text color",
      "default": "#23421f"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos (Desktop)",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between logos (Mobile)",
      "min": 12,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Scroll & marquee settings"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable continuous scrolling ticker (marquee)",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scrolling speed in seconds (higher = slower)",
      "min": 15,
      "max": 100,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Scroll left" },
        { "value": "right", "label": "Scroll right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause scrolling on hover / touch",
      "default": true
    },
    {
      "type": "header",
      "content": "Section background & spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Space above section (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Space below section (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Space above section (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Space below section (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (Mobile)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (Mobile)",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo / Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo or Badge image",
          "info": "Upload circular or transparent PNG/SVG badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title / Alt text",
          "default": "Certification"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling logos / Certifications",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "title": "ISO 22000"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "ISO 9001"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "FDA Registered"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "GMP Certified"
          }
        }
      ]
    }
  ]
}
{% endschema %}
