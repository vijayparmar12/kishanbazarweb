<link rel="stylesheet" href="{{ 'section-collection.css' | asset_url }}">
<section class="main-collection"><header><p class="home-section__eyebrow">Collection</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</header>{% paginate collection.products by section.settings.products_per_page %}<div class="main-collection__layout">{% if section.settings.enable_filtering %}<form class="main-collection__filters" aria-label="Product filters">{% for filter in collection.filters %}<details><summary>{{ filter.label }}</summary>{% case filter.type %}{% when 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 %}{% unless value.active %} disabled{% endunless %}{% endif %}> {{ value.label }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Min <input name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" type="number"></label><label>Max <input name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" type="number"></label>{% endcase %}</details>{% endfor %}<button class="button button--outline" type="submit">Apply filters</button></form>{% endif %}<div><div class="main-collection__toolbar"><p>{{ collection.products_count }} products</p><form><label for="sort-{{ section.id }}">Sort by</label><select id="sort-{{ section.id }}" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select><button type="submit">Sort</button></form></div><div class="main-collection__grid">{% for product in collection.products %}{% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, show_badge: section.settings.show_badges, show_wishlist: section.settings.show_wishlist, show_quickview: section.settings.show_quickview, show_add_to_cart: section.settings.show_add_to_cart %}{% endfor %}</div>{{ paginate | default_pagination }}</div></div>{% endpaginate %}</section>
{% schema %}{"name":"Collection","tag":"section","class":"section-collection","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":48,"step":4,"default":16},{"type":"checkbox","id":"enable_filtering","label":"Enable Shopify filters","default":true},{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},{"type":"checkbox","id":"show_rating","label":"Show rating","default":false},{"type":"checkbox","id":"show_badges","label":"Show badges","default":true},{"type":"checkbox","id":"show_wishlist","label":"Show wishlist","default":true},{"type":"checkbox","id":"show_quickview","label":"Show quick view","default":true},{"type":"checkbox","id":"show_add_to_cart","label":"Show add to cart","default":true}]}{% endschema %}
