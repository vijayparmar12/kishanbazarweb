{% doc %}
  Renders the Two Brothers style Contact Us page for Kishan Bazar.
  - Phone & WhatsApp Support card
  - Native Shopify "Send Us a Message" Contact Form
  - Google Map Embed Card placed BELOW the contact form/message card
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-contact-page.css' | asset_url }}">

<div class="contact-page" id="ContactPage-{{ section.id }}">
  <!-- PAGE TITLE HEADER -->
  <div class="contact-page__header">
    <h1 class="contact-page__title">{{ section.settings.page_title | default: "CONTACT US" }}</h1>
  </div>

  <div class="contact-page__container">
    <div class="contact-grid">
      
      <!-- LEFT COLUMN: PHONE & WHATSAPP SUPPORT CARD -->
      <div class="contact-cards-column">
        {% if section.settings.show_phone_card %}
          <div class="contact-card contact-card--support">
            <div class="contact-card__header">
              <span class="contact-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8b4513" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <h3 class="contact-card__title">{{ section.settings.phone_heading | default: "Phone & WhatsApp Support" }}</h3>
            </div>
            <div class="contact-card__body">
              <div class="contact-card__phone">{{ section.settings.phone_number | default: "+91 74067 53753" }}</div>
              <div class="contact-card__timing">{{ section.settings.phone_timing | default: "Monday to Saturday · 10:00 AM - 6:00 PM" }}</div>
              
              <div class="contact-card__actions">
                {% assign clean_phone = section.settings.phone_number | default: "+917406753753" | remove: " " | remove: "-" %}
                {% assign clean_wa = section.settings.whatsapp_number | default: clean_phone | remove: "+" | remove: " " %}
                <a href="tel:{{ clean_phone }}" class="contact-btn contact-btn--call">
                  {{ section.settings.call_button_text | default: "Call Now" }}
                </a>
                <a href="https://wa.me/{{ clean_wa }}" target="_blank" rel="noopener" class="contact-btn contact-btn--whatsapp">
                  {{ section.settings.whatsapp_button_text | default: "WhatsApp" }}
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- RIGHT COLUMN: CONTACT FORM ("Send Us a Message") -->
      <div class="contact-form-column">
        <div class="contact-form-card">
          <h2 class="contact-form__title">{{ section.settings.form_heading | default: "Send Us a Message" }}</h2>
          <p class="contact-form__subtitle">{{ section.settings.form_subheading | default: "Have a question? Fill in the form and our team will get back to you." }}</p>

          {% form 'contact', id: 'ContactForm-Page' %}
            {% if form.posted_successfully? %}
              <div class="contact-form__alert contact-form__alert--success" role="status">
                {{ section.settings.form_success_msg | default: "🌿 Thank you for reaching out! Your message has been received. Our team will contact you shortly." }}
              </div>
            {% elsif form.errors %}
              <div class="contact-form__alert contact-form__alert--error" role="alert">
                ⚠️ Please correct the errors below: {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="contact-form__grid">
              <div class="contact-form__field">
                <label for="ContactForm-FirstName" class="contact-form__label">First Name <span class="required">*</span></label>
                <input type="text" id="ContactForm-FirstName" name="contact[first_name]" class="contact-form__input" placeholder="e.g. Rahul" required>
              </div>

              <div class="contact-form__field">
                <label for="ContactForm-LastName" class="contact-form__label">Last Name</label>
                <input type="text" id="ContactForm-LastName" name="contact[last_name]" class="contact-form__input" placeholder="e.g. Sharma">
              </div>

              <div class="contact-form__field">
                <label for="ContactForm-Email" class="contact-form__label">Email Address <span class="required">*</span></label>
                <input type="email" id="ContactForm-Email" name="contact[email]" class="contact-form__input" placeholder="name@example.com" value="{{ form.email }}" required>
              </div>

              <div class="contact-form__field">
                <label for="ContactForm-Phone" class="contact-form__label">Phone Number</label>
                <input type="tel" id="ContactForm-Phone" name="contact[phone]" class="contact-form__input" placeholder="+91 98765 43210" value="{{ form.phone }}">
              </div>

              <div class="contact-form__field contact-form__field--full">
                <label for="ContactForm-Subject" class="contact-form__label">Subject <span class="required">*</span></label>
                <select id="ContactForm-Subject" name="contact[subject]" class="contact-form__select" required>
                  <option value="" disabled selected>Select a Subject</option>
                  <option value="Product Enquiry">Product Enquiry</option>
                  <option value="Order Related">Order Related</option>
                  <option value="Shipping & Delivery">Shipping & Delivery</option>
                  <option value="Return & Refund">Return & Refund</option>
                  <option value="Payment Issue">Payment Issue</option>
                  <option value="Feedback">Feedback</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="contact-form__field contact-form__field--full">
                <label for="ContactForm-Message" class="contact-form__label">Message <span class="required">*</span></label>
                <textarea id="ContactForm-Message" name="contact[body]" class="contact-form__textarea" placeholder="How can we help you today?" required>{{ form.body }}</textarea>
              </div>

              <button type="submit" class="contact-form__submit-btn">{{ section.settings.form_btn_text | default: "Send Message" }}</button>
            </div>
          {% endform %}
        </div>
      </div>

    </div>

    <!-- MAP CARD: POSITIONED BELOW THE MESSAGE / CONTACT FORM -->
    {% if section.settings.show_map %}
      <div class="contact-map-wrapper">
        <div class="contact-card contact-card--map">
          <div class="contact-map__overlay">
            <a href="{{ section.settings.map_external_url | default: 'https://maps.google.com' }}" target="_blank" rel="noopener" class="contact-map__btn">
              {{ section.settings.map_btn_text | default: "Open in Maps" }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
          <iframe
            src="{{ section.settings.map_iframe_url | default: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d119066.41709511116!2d72.74109865045437!3d21.161026848206806!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be04e59411d1563%3A0xfe4558290938b042!2sSurat%2C%20Gujarat!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin' }}"
            class="contact-map__iframe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Location Map"
          ></iframe>
        </div>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Contact Us Page",
  "settings": [
    {
      "type": "header",
      "content": "Page Header Settings"
    },
    { "type": "text", "id": "page_title", "label": "Page Main Heading", "default": "CONTACT US" },
    {
      "type": "header",
      "content": "Phone & WhatsApp Support Card"
    },
    { "type": "checkbox", "id": "show_phone_card", "label": "Show Phone & WhatsApp Card", "default": true },
    { "type": "text", "id": "phone_heading", "label": "Card Heading", "default": "Phone & WhatsApp Support" },
    { "type": "text", "id": "phone_number", "label": "Phone Number Display", "default": "+91 74067 53753" },
    { "type": "text", "id": "phone_timing", "label": "Support Hours Text", "default": "Monday to Saturday · 10:00 AM - 6:00 PM" },
    { "type": "text", "id": "call_button_text", "label": "Call Now Button Text", "default": "Call Now" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp Phone (With Country Code e.g. 917406753753)", "default": "917406753753" },
    { "type": "text", "id": "whatsapp_button_text", "label": "WhatsApp Button Text", "default": "WhatsApp" },
    {
      "type": "header",
      "content": "Google Map Embed Card"
    },
    { "type": "checkbox", "id": "show_map", "label": "Show Map Embed Card", "default": true },
    { "type": "text", "id": "map_btn_text", "label": "Open in Maps Button Label", "default": "Open in Maps" },
    { "type": "url", "id": "map_external_url", "label": "Open in Maps Button Link" },
    { "type": "textarea", "id": "map_iframe_url", "label": "Google Maps Iframe Embed Source URL" },
    {
      "type": "header",
      "content": "Contact Form Settings"
    },
    { "type": "text", "id": "form_heading", "label": "Form Heading", "default": "Send Us a Message" },
    { "type": "textarea", "id": "form_subheading", "label": "Form Subheading", "default": "Have a question? Fill in the form and our team will get back to you." },
    { "type": "text", "id": "form_btn_text", "label": "Form Submit Button Text", "default": "Send Message" },
    { "type": "textarea", "id": "form_success_msg", "label": "Form Success Message", "default": "🌿 Thank you for reaching out! Your message has been received. Our team will contact you shortly." }
  ],
  "presets": [
    {
      "name": "Default Contact Us Page"
    }
  ]
}
{% endschema %}
