{% doc %}
  Renders the Two Brothers style Contact Us page for Kisan Bazar.
  - Phone, WhatsApp, & Email support card
  - Location & Address card (displays 100% complete address typed in Theme Editor without truncation)
  - Google Map Embed Card placed BELOW the contact form with "Open in Maps ↗" button
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-contact-page.css' | asset_url }}">

{% liquid
  assign raw_place_url = section.settings.map_external_url | default: section.settings.map_iframe_url
  assign display_address = section.settings.address_text | strip

  if display_address == blank and raw_place_url contains 'maps/place/'
    assign place_part = raw_place_url | split: 'maps/place/' | last | split: '/' | first
    assign display_address = place_part | replace: '+', ' ' | url_decode
  endif

  if display_address == blank
    assign display_address = "G-14, Bhagwati Ashish Complex, City Light Town, Athwa, Surat, Gujarat 395007, India"
  endif

  # Generate Direct Google Maps Place Location Link
  if section.settings.map_external_url != blank
    assign map_target_link = section.settings.map_external_url
  elsif raw_place_url contains 'google.com/maps' or raw_place_url contains 'maps.app.goo.gl'
    assign map_target_link = raw_place_url
  else
    assign encoded_dest = display_address | url_encode
    assign map_target_link = 'https://www.google.com/maps/search/?api=1&query=' | append: encoded_dest
  endif
%}

<div class="contact-page" id="ContactPage-{{ section.id }}">
  <!-- PAGE TITLE HEADER -->
  <div class="contact-page__header">
    <h1 class="contact-page__title">{{ section.settings.page_title | default: "CONTACT US" }}</h1>
  </div>

  <div class="contact-page__container">
    <div class="contact-grid">
      
      <!-- LEFT COLUMN: CONTACT INFO CARDS -->
      <div class="contact-cards-column">
        
        <!-- CARD 1: PHONE, WHATSAPP & EMAIL SUPPORT -->
        {% if section.settings.show_phone_card %}
          <div class="contact-card contact-card--support">
            <div class="contact-card__header">
              <span class="contact-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8b4513" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </span>
              <h3 class="contact-card__title">{{ section.settings.phone_heading | default: "Phone & WhatsApp Support" }}</h3>
            </div>
            <div class="contact-card__body">
              <div class="contact-card__phone">{{ section.settings.phone_number | default: "+91 93773 41042" }}</div>
              
              {% if section.settings.email_address != blank %}
                <div class="contact-card__email-line">
                  <span class="contact-card__email-label">Email:</span>
                  <a href="mailto:{{ section.settings.email_address }}" class="contact-card__email">{{ section.settings.email_address }}</a>
                </div>
              {% endif %}

              <div class="contact-card__timing">{{ section.settings.phone_timing | default: "Monday to Saturday · 10:00 AM - 6:00 PM" }}</div>
              
              <div class="contact-card__actions">
                {% assign clean_phone = section.settings.phone_number | default: "+919377341042" | remove: " " | remove: "-" %}
                {% assign clean_wa = section.settings.whatsapp_number | default: clean_phone | remove: "+" | remove: " " %}
                <a href="tel:{{ clean_phone }}" class="contact-btn contact-btn--call">
                  {{ section.settings.call_button_text | default: "Call Now" }}
                </a>
                <a href="https://wa.me/{{ clean_wa }}" target="_blank" rel="noopener" class="contact-btn contact-btn--whatsapp">
                  {{ section.settings.whatsapp_button_text | default: "WhatsApp" }}
                </a>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- CARD 2: LOCATION & ADDRESS CARD -->
        {% if section.settings.show_address_card %}
          <div class="contact-card contact-card--address">
            <div class="contact-card__header">
              <span class="contact-card__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <h3 class="contact-card__title">{{ section.settings.address_heading | default: "Our Location & Address" }}</h3>
            </div>
            <div class="contact-card__body">
              <div class="contact-card__address" data-address-text>{{ display_address }}</div>
            </div>
          </div>
        {% endif %}

      </div>

      <!-- RIGHT COLUMN: CONTACT FORM ("Send Us a Message") -->
      <div class="contact-form-column">
        <div class="contact-form-card">
          <h2 class="contact-form__title">{{ section.settings.form_heading | default: "Send Us a Message" }}</h2>
          <p class="contact-form__subtitle">{{ section.settings.form_subheading | default: "Have a question? Fill in the form and our team will get back to you." }}</p>

          {% form 'contact', id: 'ContactForm-Page' %}
            <input type="hidden" name="contact[tags]" value="Contact Form">
            {% if form.posted_successfully? %}
              <div class="contact-form__alert contact-form__alert--success" role="status">
                {{ section.settings.form_success_msg | default: "🌿 Thank you for reaching out! Your message has been received. Our team will contact you shortly." }}
              </div>
            {% elsif form.errors %}
              <div class="contact-form__alert contact-form__alert--error" role="alert">
                ⚠️ Please correct the errors below: {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="contact-form__grid">
              <div class="contact-form__field contact-form__field--full">
                <label for="ContactForm-Name" class="contact-form__label">Full Name <span class="required">*</span></label>
                <input type="text" id="ContactForm-Name" name="contact[Name]" class="contact-form__input" placeholder="e.g. Rahul Sharma" required>
              </div>

              <div class="contact-form__field">
                <label for="ContactForm-Email" class="contact-form__label">Email Address <span class="required">*</span></label>
                <input type="email" id="ContactForm-Email" name="contact[email]" class="contact-form__input" placeholder="name@example.com" value="{{ form.email }}" required>
              </div>

              <div class="contact-form__field">
                <label for="ContactForm-Phone" class="contact-form__label">Phone Number</label>
                <input type="tel" id="ContactForm-Phone" name="contact[phone]" class="contact-form__input" placeholder="+91 98765 43210" value="{{ form.phone }}">
              </div>

              <div class="contact-form__field contact-form__field--full">
                <label for="ContactForm-Subject" class="contact-form__label">Subject <span class="required">*</span></label>
                <select id="ContactForm-Subject" name="contact[Subject]" class="contact-form__select" required>
                  <option value="" disabled selected>Select a Subject</option>
                  <option value="Product Enquiry">Product Enquiry</option>
                  <option value="Order Related">Order Related</option>
                  <option value="Shipping & Delivery">Shipping & Delivery</option>
                  <option value="Return & Refund">Return & Refund</option>
                  <option value="Payment Issue">Payment Issue</option>
                  <option value="Feedback">Feedback</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="contact-form__field contact-form__field--full">
                <label for="ContactForm-Message" class="contact-form__label">Message <span class="required">*</span></label>
                <textarea id="ContactForm-Message" name="contact[body]" class="contact-form__textarea" placeholder="How can we help you today?" required>{{ form.body }}</textarea>
              </div>

              <button type="submit" class="contact-form__submit-btn">{{ section.settings.form_btn_text | default: "Send Message" }}</button>
            </div>
          {% endform %}
        </div>
      </div>

    </div>

    <!-- MAP CARD: POSITIONED BELOW THE MESSAGE / CONTACT FORM -->
    {% if section.settings.show_map %}
      <div class="contact-map-wrapper">
        <div class="contact-card contact-card--map">
          <div class="contact-map__overlay">
            <a href="{{ map_target_link }}" target="_blank" rel="noopener" class="contact-map__btn" data-map-target-link>
              {{ section.settings.map_btn_text | default: "Open in Maps" }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
          {% assign default_embed = 'https://maps.google.com/maps?q=G-14,+Bhagwati+Ashish+Complex,+City+Light+Town,+Athwa,+Surat,+Gujarat+395007,+India&t=&z=15&ie=UTF8&iwloc=&output=embed' %}
          <iframe
            src="{{ default_embed }}"
            class="contact-map__iframe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Location Map"
          ></iframe>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<script>
  (function() {
    function sanitizeGoogleMapUrl(url) {
      var addressEl = document.querySelector('[data-address-text]');
      var addr = (addressEl && addressEl.textContent.trim()) || "G-14, Bhagwati Ashish Complex, City Light Town, Athwa, Surat, Gujarat 395007, India";
      return 'https://maps.google.com/maps?q=' + encodeURIComponent(addr) + '&t=&z=15&ie=UTF8&iwloc=&output=embed';
    }

    var iframe = document.querySelector('.contact-map__iframe');
    if (iframe) {
      var rawSrc = iframe.getAttribute('src');
      var cleanSrc = sanitizeGoogleMapUrl(rawSrc);
      if (cleanSrc) {
        iframe.src = cleanSrc;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Contact Us Page",
  "settings": [
    {
      "type": "header",
      "content": "Page Header Settings"
    },
    { "type": "text", "id": "page_title", "label": "Page Main Heading", "default": "CONTACT US" },
    {
      "type": "header",
      "content": "Phone, WhatsApp & Email Support Card"
    },
    { "type": "checkbox", "id": "show_phone_card", "label": "Show Phone & Support Card", "default": true },
    { "type": "text", "id": "phone_heading", "label": "Card Heading", "default": "Phone & WhatsApp Support" },
    { "type": "text", "id": "phone_number", "label": "Phone Number Display", "default": "+91 93773 41042" },
    { "type": "text", "id": "email_address", "label": "Support Email Address", "default": "support@kishanbazar.com" },
    { "type": "text", "id": "phone_timing", "label": "Support Timing", "default": "Monday to Saturday · 10:00 AM - 6:00 PM" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp Phone Number (with Country Code e.g. +919377341042)", "default": "+919377341042" },
    { "type": "text", "id": "call_button_text", "label": "Call Button Label", "default": "Call Now" },
    { "type": "text", "id": "whatsapp_button_text", "label": "WhatsApp Button Label", "default": "WhatsApp" },
    {
      "type": "header",
      "content": "Location & Address Card"
    },
    { "type": "checkbox", "id": "show_address_card", "label": "Show Address Card", "default": true },
    { "type": "text", "id": "address_heading", "label": "Card Heading", "default": "Our Location & Address" },
    { "type": "textarea", "id": "address_text", "label": "Complete Store Address", "default": "G-14, Bhagwati Ashish Complex, City Light Town, Athwa, Surat, Gujarat 395007, India" },
    {
      "type": "header",
      "content": "Send Us a Message Form Card"
    },
    { "type": "text", "id": "form_heading", "label": "Form Heading", "default": "Send Us a Message" },
    { "type": "text", "id": "form_subheading", "label": "Form Subheading", "default": "Have a question? Fill in the form and our team will get back to you." },
    { "type": "text", "id": "form_btn_text", "label": "Submit Button Text", "default": "Send Message" },
    { "type": "text", "id": "form_success_msg", "label": "Success Message", "default": "🌿 Thank you for reaching out! Your message has been received. Our team will contact you shortly." },
    {
      "type": "header",
      "content": "Google Map Embed Settings"
    },
    { "type": "checkbox", "id": "show_map", "label": "Show Map Section Below Form", "default": true },
    { "type": "text", "id": "map_btn_text", "label": "Map Button Text", "default": "Open in Maps" },
    { "type": "text", "id": "map_external_url", "label": "Direct Google Maps Location Link (Opens on button click)", "default": "https://maps.app.goo.gl/9Z3f..." },
    { "type": "textarea", "id": "map_iframe_url", "label": "Google Maps Embed URL", "default": "https://maps.google.com/maps?q=G-14,+Bhagwati+Ashish+Complex,+City+Light+Town,+Athwa,+Surat,+Gujarat+395007,+India&t=&z=15&ie=UTF8&iwloc=&output=embed" }
  ],
  "presets": [
    {
      "name": "Contact Us Page"
    }
  ]
}
{% endschema %}
