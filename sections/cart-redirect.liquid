{% doc %}
  Redirects the /cart page to the homepage so the storefront uses the cart drawer only.
{% enddoc %}

{% unless request.design_mode %}
  <noscript>
    <meta http-equiv="refresh" content="0; url={{ routes.root_url }}?open_cart=true">
  </noscript>

  <script>
    if (!window.Shopify || !window.Shopify.designMode) {
      window.location.replace({{ routes.root_url | append: '?open_cart=true' | json }});
    }
  </script>
{% endunless %}

{% schema %}
{
  "name": "Cart redirect",
  "settings": []
}
{% endschema %}