<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<script src="{{ 'section-best-sellers.js' | asset_url }}" defer="defer"></script>

{% assign displayed_collection = section.settings.collection %}
{% if displayed_collection == blank %}
  {% assign displayed_collection = collections['best-sellers'] %}
{% endif %}
{% if displayed_collection == blank or displayed_collection.products_count == 0 %}
  {% assign displayed_collection = collections['all'] %}
{% endif %}

{% style %}
  #BestSellers-{{ section.id }} {
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}') !important;
      background-size: cover !important;
      background-position: center top !important;
      background-repeat: no-repeat !important;
    {% elsif section.settings.background_color != blank and section.settings.background_color != '#F8F4EB' and section.settings.background_color != '#f8f4eb' %}
      background-color: {{ section.settings.background_color }} !important;
    {% else %}
      background: #ffffff !important;
      background-color: #ffffff !important;
      background-image: none !important;
    {% endif %}
  }

  #BestSellers-{{ section.id }} .best-sellers__head {
    margin-bottom: 0.25rem !important;
    margin-top: 0 !important;
    padding: 0 !important;
  }

  #BestSellers-{{ section.id }} .best-sellers__heading-banner-wrap {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
    height: {{ section.settings.heading_box_height_desktop | default: 180 }}px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 12px !important;
  }

  #BestSellers-{{ section.id }} .home-section__heading-picture {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 auto !important;
    padding: 0 !important;
  }

  #BestSellers-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.heading_box_bg_size | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
    margin: 0 auto !important;
    padding: 0 !important;
    border-radius: 12px !important;
    {% if section.settings.heading_image_flip %}
      transform: scaleX(-1) !important;
    {% endif %}
  }

  #BestSellers-{{ section.id }} .best-sellers__cta-container {
    display: flex !important;
    justify-content: flex-end !important;
    align-items: center !important;
    text-align: right !important;
    width: 100% !important;
    margin-top: 0.35rem !important;
    margin-bottom: 0.65rem !important;
    clear: both !important;
    position: relative !important;
    z-index: 5 !important;
  }

  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn,
  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:link,
  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:visited {
    margin-left: auto !important;
    margin-right: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.4rem !important;
    background-color: {{ section.settings.cta_bg_color | default: '#1b4317' }} !important;
    color: {{ section.settings.cta_text_color | default: '#ffffff' }} !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em !important;
    padding: 0.45rem 1.15rem !important;
    border-radius: 999px !important;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(27, 67, 23, 0.22) !important;
    transition: all 220ms ease !important;
    line-height: 1.2 !important;
  }

  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:hover,
  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:focus {
    background-color: #143511 !important;
    color: #ffffff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 16px rgba(27, 67, 23, 0.32) !important;
    text-decoration: none !important;
  }

  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn .cta-arrow {
    display: inline-block !important;
    transition: transform 200ms ease !important;
  }

  #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:hover .cta-arrow {
    transform: translateX(4px) !important;
  }

  @media screen and (max-width: 749px) {
    #BestSellers-{{ section.id }} {
      {% if section.settings.background_image_mobile != blank %}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: 1200 }}') !important;
        background-size: cover !important;
        background-position: center top !important;
      {% endif %}
    }
    #BestSellers-{{ section.id }} .best-sellers__heading-banner-wrap {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 800 }}px !important;
      height: {{ section.settings.heading_box_height_mobile | default: 110 }}px !important;
    }
    #BestSellers-{{ section.id }} .home-section__heading-picture {
      width: 100% !important;
      height: 100% !important;
      margin: 0 auto !important;
    }
    #BestSellers-{{ section.id }} .home-section__heading-image {
      object-fit: {{ section.settings.heading_box_bg_size_mobile | default: 'cover' }} !important;
      margin: 0 auto !important;
    }
    #BestSellers-{{ section.id }} .best-sellers__cta-container {
      margin-top: 0.1rem !important;
      margin-bottom: 0.25rem !important;
    }
    #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn,
    #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:link,
    #BestSellers-{{ section.id }} .best-sellers__cta-container .best-sellers__shop-more-btn:visited {
      font-size: 0.58rem !important;
      padding: 0.15rem 0.5rem !important;
      gap: 0.2rem !important;
      border-radius: 999px !important;
      box-shadow: 0 2px 5px rgba(27, 67, 23, 0.16) !important;
    }
  }

  {% assign active_color = section.settings.tab_active_color | default: '#1b4317' %}
  {% assign icon_sz = section.settings.tab_icon_size | default: 76 %}
  #BestSellers-{{ section.id }} .best-sellers__tab-icon {
    width: {{ icon_sz }}px !important;
    height: {{ icon_sz }}px !important;
  }
  #BestSellers-{{ section.id }} .best-sellers__tab-img {
    width: {{ icon_sz | minus: 8 }}px !important;
    height: {{ icon_sz | minus: 8 }}px !important;
  }
  #BestSellers-{{ section.id }} .best-sellers__tab-svg {
    width: {{ icon_sz | minus: 20 }}px !important;
    height: {{ icon_sz | minus: 20 }}px !important;
  }
  #BestSellers-{{ section.id }} .best-sellers__tab.is-active,
  #BestSellers-{{ section.id }} .best-sellers__tab:hover {
    color: {{ active_color }} !important;
    border-bottom-color: {{ active_color }} !important;
  }
  #BestSellers-{{ section.id }} .best-sellers__tab.is-active .best-sellers__tab-icon,
  #BestSellers-{{ section.id }} .best-sellers__tab:hover .best-sellers__tab-icon,
  #BestSellers-{{ section.id }} .best-sellers__tab.is-active .best-sellers__tab-svg,
  #BestSellers-{{ section.id }} .best-sellers__tab:hover .best-sellers__tab-svg,
  #BestSellers-{{ section.id }} .best-sellers__tab.is-active .svg-fill-target,
  #BestSellers-{{ section.id }} .best-sellers__tab:hover .svg-fill-target,
  #BestSellers-{{ section.id }} .best-sellers__tab.is-active .best-sellers__tab-label,
  #BestSellers-{{ section.id }} .best-sellers__tab:hover .best-sellers__tab-label {
    color: {{ active_color }} !important;
  }

  {% if section.settings.tab_inactive_color != blank %}
    #BestSellers-{{ section.id }} .best-sellers__tab:not(.is-active) {
      color: {{ section.settings.tab_inactive_color }} !important;
    }
    #BestSellers-{{ section.id }} .best-sellers__tab-icon,
    #BestSellers-{{ section.id }} .best-sellers__tab-svg,
    #BestSellers-{{ section.id }} .best-sellers__tab-label {
      color: {{ section.settings.tab_inactive_color }} !important;
    }
  {% endif %}
{% endstyle %}

<section id="BestSellers-{{ section.id }}" class="home-section best-sellers{% if section.settings.show_tabs %} best-sellers--with-tabs{% endif %}" data-best-sellers>
  <div class="best-sellers__illustration-bg" aria-hidden="true">
    <svg viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 120C240 70 480 150 720 100C960 50 1200 130 1440 90V180H0V120Z" fill="rgba(35, 66, 31, 0.03)"/>
      <path d="M0 140C360 90 720 160 1080 120C1260 100 1380 130 1440 140V180H0V140Z" fill="rgba(35, 66, 31, 0.02)"/>
    </svg>
  </div>

  <div class="home-section__head best-sellers__head best-sellers__head--card-box">
    {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
      <div class="best-sellers__heading-banner-wrap">
        <picture class="home-section__heading-picture">
          {% if section.settings.heading_image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
          {% endif %}
          {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
          {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
        </picture>
      </div>
    {% else %}
      <div class="best-sellers__title-wrap">
        {% if section.settings.eyebrow != blank %}
          <p class="home-section__eyebrow" style="color: #166534; font-size: 1.05rem; font-weight: 800; margin-bottom: 0.35rem; font-family: 'Montserrat', sans-serif;">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="color: #1e3d20; font-size: clamp(1.6rem, 3.5vw, 2.65rem); font-weight: 900; font-family: 'Montserrat', sans-serif; margin: 0;">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% comment %} Shop More button removed {% endcomment %}

  {% assign category_blocks = section.blocks | where: 'type', 'category_tab' %}
  {% if section.settings.show_tabs or category_blocks.size > 0 %}
    <div class="best-sellers__tabs-wrapper">
      <div class="best-sellers__tabs" role="tablist" aria-label="Filter products by category">
        {% if section.settings.show_all_tab %}
          <button class="best-sellers__tab is-active" type="button" role="tab" data-best-sellers-tab data-category-filter="all">
            <span class="best-sellers__tab-icon">
              {% if section.settings.all_tab_icon != blank %}
                {{ section.settings.all_tab_icon | image_url: width: 100 | image_tag: class: 'best-sellers__tab-img', loading: 'lazy' }}
              {% else %}
                <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/></svg>
              {% endif %}
            </span>
            <span class="best-sellers__tab-label">{{ section.settings.all_tab_label | default: "All" }}</span>
          </button>
        {% endif %}

        {% if category_blocks.size > 0 %}
          {% for block in category_blocks %}
            {% capture filter_terms %}
              {{ block.settings.title | downcase }}
              {% if block.settings.collection != blank %}
                {{ block.settings.collection.title | downcase }}
                {{ block.settings.collection.handle | downcase }}
              {% endif %}
            {% endcapture %}
            <button class="best-sellers__tab{% if forloop.first and section.settings.show_all_tab == false %} is-active{% endif %}" type="button" role="tab" data-best-sellers-tab data-category-filter="{{ filter_terms | strip | escape }}" {{ block.shopify_attributes }}>
              <span class="best-sellers__tab-icon">
                {% if block.settings.active_icon_image != blank and block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 100 | image_tag: class: 'best-sellers__tab-img best-sellers__tab-img--normal', loading: 'lazy', alt: block.settings.title }}
                  {{ block.settings.active_icon_image | image_url: width: 100 | image_tag: class: 'best-sellers__tab-img best-sellers__tab-img--active', loading: 'lazy', alt: block.settings.title }}
                {% elsif block.settings.active_icon_image != blank %}
                  {{ block.settings.active_icon_image | image_url: width: 100 | image_tag: class: 'best-sellers__tab-img best-sellers__tab-img--always', loading: 'lazy', alt: block.settings.title }}
                {% elsif block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 100 | image_tag: class: 'best-sellers__tab-img best-sellers__tab-img--always', loading: 'lazy', alt: block.settings.title }}
                {% elsif block.settings.icon_type == 'ghee' or block.settings.title contains 'Ghee' or block.settings.title contains 'ghee' %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path d="M12 2v4M6 6h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6V6z" fill="none" stroke="currentColor" stroke-width="2"/><path class="svg-fill-target" d="M5 21h14v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2z" fill="currentColor"/></svg>
                {% elsif block.settings.icon_type == 'oil' or block.settings.title contains 'Oil' or block.settings.title contains 'oil' %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path d="M12 2.5S6.5 9.25 6.5 13.5a5.5 5.5 0 0 0 11 0C17.5 9.25 12 2.5 12 2.5z" class="svg-fill-target" fill="currentColor"/></svg>
                {% elsif block.settings.icon_type == 'atta' or block.settings.title contains 'Atta' or block.settings.title contains 'Flour' %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path class="svg-fill-target" d="M6 3h12l1.8 17.5A1.5 1.5 0 0 1 18.3 22H5.7a1.5 1.5 0 0 1-1.5-1.5L6 3z" fill="currentColor"/><path d="M6 8h12M12 11v7M9.5 14.5L12 12l2.5 2.5" stroke="#FFFFFF" stroke-width="1.8" fill="none"/></svg>
                {% elsif block.settings.icon_type == 'combos' or block.settings.title contains 'Combo' or block.settings.title contains 'Pack' %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><rect class="svg-fill-target" x="3" y="8" width="18" height="13" rx="2" fill="currentColor"/><path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                {% elsif block.settings.icon_type == 'deal' or block.settings.title contains 'Deal' or block.settings.title contains 'Offer' %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><rect class="svg-fill-target" x="2" y="5" width="20" height="14" rx="2.5" fill="currentColor"/><circle cx="12" cy="12" r="3.5" fill="#FFFFFF"/></svg>
                {% else %}
                  <svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path class="svg-fill-target" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="currentColor"/></svg>
                {% endif %}
              </span>
              <span class="best-sellers__tab-label">{{ block.settings.title }}</span>
            </button>
          {% endfor %}
        {% else %}
          <button class="best-sellers__tab is-active" type="button" role="tab" data-best-sellers-tab data-category-filter="Ghee">
            <span class="best-sellers__tab-icon"><svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path d="M12 2v4M6 6h12v3a6 6 0 0 1-6 6 6 6 0 0 1-6-6V6z" fill="none" stroke="currentColor" stroke-width="2"/><path class="svg-fill-target" d="M5 21h14v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2z" fill="currentColor"/></svg></span>
            <span class="best-sellers__tab-label">Ghee</span>
          </button>
          <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Oils">
            <span class="best-sellers__tab-icon"><svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path d="M12 2.5S6.5 9.25 6.5 13.5a5.5 5.5 0 0 0 11 0C17.5 9.25 12 2.5 12 2.5z" class="svg-fill-target" fill="currentColor"/></svg></span>
            <span class="best-sellers__tab-label">Oils</span>
          </button>
          <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Atta">
            <span class="best-sellers__tab-icon"><svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><path class="svg-fill-target" d="M6 3h12l1.8 17.5A1.5 1.5 0 0 1 18.3 22H5.7a1.5 1.5 0 0 1-1.5-1.5L6 3z" fill="currentColor"/><path d="M6 8h12M12 11v7M9.5 14.5L12 12l2.5 2.5" stroke="#FFFFFF" stroke-width="1.8" fill="none"/></svg></span>
            <span class="best-sellers__tab-label">Atta</span>
          </button>
          <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Combos">
            <span class="best-sellers__tab-icon"><svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><rect class="svg-fill-target" x="3" y="8" width="18" height="13" rx="2" fill="currentColor"/><path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
            <span class="best-sellers__tab-label">Combos</span>
          </button>
          <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Deal">
            <span class="best-sellers__tab-icon"><svg class="best-sellers__tab-svg" width="34" height="34" viewBox="0 0 24 24"><rect class="svg-fill-target" x="2" y="5" width="20" height="14" rx="2.5" fill="currentColor"/><circle cx="12" cy="12" r="3.5" fill="#FFFFFF"/></svg></span>
            <span class="best-sellers__tab-label">Deal</span>
          </button>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% assign promo_blocks = section.blocks | where: 'type', 'promo_text' %}
  {% for promo in promo_blocks %}
    <div class="best-sellers__promo-banner" style="background-color: {{ promo.settings.bg_color }}; color: {{ promo.settings.text_color }}; text-align: center; padding: 0.6rem 1rem; border-radius: 8px; margin: 0.75rem 1rem 1rem; font-weight: 600; font-size: 0.88rem;" {{ promo.shopify_attributes }}>
      {{ promo.settings.text }}
    </div>
  {% endfor %}

  {% if displayed_collection != blank and displayed_collection.products_count > 0 %}
    <div class="best-sellers__carousel-wrapper">
      <button type="button" class="best-sellers__arrow best-sellers__arrow--prev" data-best-sellers-prev aria-label="Previous products">
        {% render 'icon', name: 'arrow', size: 18 %}
      </button>

      <div class="best-sellers__track" data-best-sellers-track>
        {% assign category_blocks = section.blocks | where: 'type', 'category_tab' %}
        {% assign rendered_handles_str = '' %}

        {% comment %} 1. Render products from Category Tab Collections first {% endcomment %}
        {% for block in category_blocks %}
          {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
            {% for product in block.settings.collection.products limit: 12 %}
              {% assign handles_arr = rendered_handles_str | split: '|' %}
              {% unless handles_arr contains product.handle %}
                {% assign rendered_handles_str = rendered_handles_str | append: product.handle | append: '|' %}

                {% capture prod_cat_str %}
                  {{ product.title | downcase }}
                  {{ product.type | downcase }}
                  {{ block.settings.title | downcase }}
                  {{ block.settings.collection.title | downcase }}
                  {{ block.settings.collection.handle | downcase }}
                  {% for tag in product.tags %}{{ tag | downcase }} {% endfor %}
                  {% for col in product.collections %}{{ col.title | downcase }} {{ col.handle | downcase }} {% endfor %}
                {% endcapture %}

                <div class="best-sellers__slide" data-best-sellers-slide data-product-categories="{{ prod_cat_str | escape }}">
                  {% render 'product-card',
                    product: product,
                    card_blocks: section.blocks,
                    show_badge: section.settings.show_badge,
                    show_wishlist: section.settings.show_wishlist,
                    show_subtitle: section.settings.show_subtitle,
                    show_rating: section.settings.show_rating,
                    show_benefit_icons: section.settings.show_benefit_icons,
                    show_variant_selector: section.settings.show_variant_selector,
                    show_add_to_cart: section.settings.show_add_to_cart
                  %}
                </div>
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endfor %}

        {% comment %} 2. Render remaining products from main collection {% endcomment %}
        {% assign main_products = displayed_collection.products %}
        {% if main_products == blank or main_products.size == 0 %}
          {% assign main_products = collections['all'].products %}
        {% endif %}

        {% for product in main_products limit: section.settings.maximum %}
          {% assign handles_arr = rendered_handles_str | split: '|' %}
          {% unless handles_arr contains product.handle %}
            {% assign rendered_handles_str = rendered_handles_str | append: product.handle | append: '|' %}

            {% capture prod_cat_str %}
              {{ product.title | downcase }}
              {{ product.type | downcase }}
              {% for tag in product.tags %}{{ tag | downcase }} {% endfor %}
              {% for col in product.collections %}{{ col.title | downcase }} {{ col.handle | downcase }} {% endfor %}
            {% endcapture %}

            <div class="best-sellers__slide" data-best-sellers-slide data-product-categories="{{ prod_cat_str | escape }}">
              {% render 'product-card',
                product: product,
                card_blocks: section.blocks,
                show_badge: section.settings.show_badge,
                show_wishlist: section.settings.show_wishlist,
                show_subtitle: section.settings.show_subtitle,
                show_rating: section.settings.show_rating,
                show_benefit_icons: section.settings.show_benefit_icons,
                show_variant_selector: section.settings.show_variant_selector,
                show_add_to_cart: section.settings.show_add_to_cart
              %}
            </div>
          {% endunless %}
        {% endfor %}

        <!-- End of Track "More" Circle Card (Matching Google Deals / User Reference Image) -->
        <div class="best-sellers__slide best-sellers__slide--more-card">
          <a href="{{ section.settings.cta_url | default: displayed_collection.url | default: routes.all_products_collection_url }}" class="best-sellers__more-card-link" aria-label="View all products">
            <div class="best-sellers__more-card-circle">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
            <span class="best-sellers__more-card-text">More</span>
          </a>
        </div>
      </div>

      <button type="button" class="best-sellers__arrow best-sellers__arrow--next" data-best-sellers-next aria-label="Next products">
        {% render 'icon', name: 'arrow', size: 18 %}
      </button>
    </div>
  {% else %}
    <p class="home-section__empty">Products will appear here after they are published to the Online Store.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "header",
      "content": "Section Title & Background"
    },
    { "type": "text", "id": "eyebrow", "label": "Small eyebrow label (optional text over background image)" },
    { "type": "text", "id": "heading", "label": "Heading text (optional text over background image)" },
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Box Background Image (Desktop)", "info": "Upload graphic image to use as background for the Heading Box on Desktop" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Box Background Image (Mobile)", "info": "Upload graphic image to use as background for the Heading Box on Mobile" },
    { "type": "checkbox", "id": "heading_image_flip", "label": "Flip Heading Image Horizontally", "default": false },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "contain", "label": "Contain (Fit full image without cropping)" },
        { "value": "cover", "label": "Cover (Fill entire box)" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "contain", "label": "Contain (Fit full image without cropping)" },
        { "value": "cover", "label": "Cover (Fill entire box)" }
      ],
      "default": "contain"
    },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Desktop Heading Box Fixed Height (px)", "min": 60, "max": 400, "step": 10, "default": 180, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Mobile Heading Box Fixed Height (px)", "min": 40, "max": 250, "step": 10, "default": 110, "unit": "px" },
    { "type": "range", "id": "heading_image_max_width", "label": "Desktop Heading Image Max Width (px)", "min": 200, "max": 1200, "step": 20, "default": 640, "unit": "px" },
    { "type": "range", "id": "heading_image_mobile_max_width", "label": "Mobile Heading Image Max Width (px)", "min": 150, "max": 800, "step": 10, "default": 360, "unit": "px" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "background_image", "label": "Custom Background Image" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Custom Mobile Background Image (Optional)" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "range", "id": "maximum", "label": "Maximum products", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category filter tabs (Ghee, Oil, Atta, etc.)", "default": true },
    { "type": "checkbox", "id": "show_cta_btn", "label": "Show 'Shop More' button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button text label", "default": "Shop More" },
    { "type": "url", "id": "cta_url", "label": "Button link URL" },
    { "type": "color", "id": "cta_bg_color", "label": "Button Background Color", "default": "#1b4317" },
    { "type": "color", "id": "cta_text_color", "label": "Button Text Color", "default": "#ffffff" },
    {
      "type": "header",
      "content": "Product Card Customization & Toggles"
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show product badge", "default": true },
    { "type": "text", "id": "custom_badge_text", "label": "Custom badge text (optional)", "info": "e.g. MOST LOVED, BESTSELLER, HOT, NEW" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist heart icon", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_subtitle", "label": "Show description subtitle", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating and review stars", "default": true },
    { "type": "checkbox", "id": "show_benefit_icons", "label": "Show benefit icons (below rating)", "default": true },
    { "type": "checkbox", "id": "show_variant_selector", "label": "Show variant dropdown", "default": true },
    { "type": "checkbox", "id": "show_add_to_cart", "label": "Show Add to Cart button", "default": true },
    { "type": "text", "id": "cart_button_text", "label": "Add to Cart button text", "default": "ADD TO CART" },
    {
      "type": "header",
      "content": "Product Card Colors & Styling"
    },
    { "type": "color", "id": "title_color", "label": "Product Title text color", "default": "#23421F" },
    { "type": "color", "id": "price_color", "label": "Product Price color", "default": "#23421F" },
    { "type": "color", "id": "compare_price_color", "label": "Compare-at MRP price color", "default": "#8D8D8D" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle description text color", "default": "#6B7280" },
    { "type": "color", "id": "rating_stars_color", "label": "Rating stars color", "default": "#E5A800" },
    { "type": "color", "id": "badge_bg", "label": "Badge background color", "default": "#23421F" },
    { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#FFFFFF" },
    { "type": "color", "id": "wishlist_bg", "label": "Wishlist button background", "default": "#FFFFFF" },
    { "type": "color", "id": "wishlist_color", "label": "Wishlist icon color", "default": "#23421F" },
    { "type": "color", "id": "cart_button_bg", "label": "Add to Cart button background", "default": "#23421F" },
    { "type": "color", "id": "cart_button_color", "label": "Add to Cart button text color", "default": "#FFFFFF" },
    {
      "type": "header",
      "content": "Category Filter Tabs Colors & Size"
    },
    { "type": "range", "id": "tab_icon_size", "label": "Category Tab Icon Size (px)", "min": 40, "max": 140, "step": 2, "default": 76, "unit": "px" },
    { "type": "color", "id": "tab_active_color", "label": "Active Tab & Icon Highlight Color", "default": "#1b4317", "info": "Pick active category tab icon color directly in Theme Editor" },
    { "type": "color", "id": "tab_inactive_color", "label": "Inactive Tab Icon & Text Color", "default": "#64748b" }
  ],
  "blocks": [
    {
      "type": "card_title_price",
      "name": "Card Title & Price",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "title_color", "label": "Title text color", "default": "#23421F" },
        { "type": "color", "id": "price_color", "label": "Price color", "default": "#23421F" },
        { "type": "color", "id": "compare_price_color", "label": "Compare price color", "default": "#8D8D8D" }
      ]
    },
    {
      "type": "card_subtitle",
      "name": "Card Subtitle Description",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#6B7280" }
      ]
    },
    {
      "type": "card_rating",
      "name": "Card Star Rating",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "rating_stars_color", "label": "Star rating color", "default": "#E5A800" }
      ]
    },
    {
      "type": "card_benefit_icons",
      "name": "Card Benefit Badges",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_benefit_icons", "label": "Show benefit circle icons", "default": true },
        { "type": "range", "id": "icon_size", "label": "Benefit Icon Size (px)", "min": 36, "max": 120, "step": 2, "default": 72, "unit": "px" },
        { "type": "image_picker", "id": "benefit_image_1", "label": "Benefit Icon 1 Image" },
        { "type": "image_picker", "id": "benefit_image_2", "label": "Benefit Icon 2 Image" },
        { "type": "image_picker", "id": "benefit_image_3", "label": "Benefit Icon 3 Image" },
        { "type": "image_picker", "id": "benefit_image_4", "label": "Benefit Icon 4 Image" }
      ]
    },
    {
      "type": "card_variant_selector",
      "name": "Card Variant Dropdown",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "border_color", "label": "Dropdown border color", "default": "#1F1F1F" },
        { "type": "color", "id": "bg_color", "label": "Dropdown background color", "default": "#FFFFFF" },
        { "type": "color", "id": "text_color", "label": "Dropdown text color", "default": "#1F1F1F" }
      ]
    },
    {
      "type": "card_buy_button",
      "name": "Card Add to Cart Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_to_cart_text", "label": "Button text", "default": "ADD TO CART" },
        { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#23421F" },
        { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#FFFFFF" }
      ]
    },
    {
      "type": "card_custom_text",
      "name": "Card Custom Text Line",
      "settings": [
        { "type": "text", "id": "text", "label": "Custom text", "default": "🚚 Free Shipping on orders over ₹499" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#23421F" },
        { "type": "select", "id": "font_weight", "label": "Font weight", "options": [{ "value": "normal", "label": "Normal" }, { "value": "bold", "label": "Bold" }], "default": "bold" }
      ]
    },
    {
      "type": "custom_badge_block",
      "name": "Custom Card Badge",
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "SPECIAL OFFER" },
        { "type": "color", "id": "badge_bg", "label": "Badge background color", "default": "#E06535" },
        { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#FFFFFF" }
      ]
    },
    {
      "type": "category_tab",
      "name": "Category Filter Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Label",
          "default": "Ghee"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Normal / Inactive Icon Image"
        },
        {
          "type": "image_picker",
          "id": "active_icon_image",
          "label": "Active / Filled Color Icon Image"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Built-in Icon Type",
          "options": [
            { "value": "ghee", "label": "Ghee Bowl" },
            { "value": "oil", "label": "Oil Bottle" },
            { "value": "atta", "label": "Atta Sack" },
            { "value": "combos", "label": "Combos Jar" },
            { "value": "deal", "label": "Deal Note" },
            { "value": "leaf", "label": "Superfoods Leaf" }
          ],
          "default": "ghee"
        }
      ]
    },
    {
      "type": "promo_text",
      "name": "Custom Promo Banner",
      "settings": [
        { "type": "text", "id": "text", "label": "Promo text", "default": "🚚 Free Shipping on orders over ₹499 • 100% Certified Organic" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#23421F" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category Showcase",
      "blocks": [
        { "type": "category_tab", "settings": { "title": "Ghee", "icon_type": "ghee" } },
        { "type": "category_tab", "settings": { "title": "Oils", "icon_type": "oil" } },
        { "type": "category_tab", "settings": { "title": "Atta", "icon_type": "atta" } },
        { "type": "category_tab", "settings": { "title": "Combos", "icon_type": "combos" } },
        { "type": "category_tab", "settings": { "title": "Deal", "icon_type": "deal" } },
        { "type": "card_title_price" },
        { "type": "card_subtitle" },
        { "type": "card_rating" },
        { "type": "card_buy_button" }
      ]
    }
  ]
}
{% endschema %}
