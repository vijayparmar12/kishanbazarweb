<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<script src="{{ 'section-best-sellers.js' | asset_url }}" defer="defer"></script>

{% assign displayed_collection = section.settings.collection %}
{% if displayed_collection == blank %}
  {% assign displayed_collection = collections['best-sellers'] %}
{% endif %}
{% if displayed_collection == blank or displayed_collection.products_count == 0 %}
  {% assign displayed_collection = collections['all'] %}
{% endif %}

{% style %}
  #BestSellers-{{ section.id }} {
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}') !important;
    {% elsif section.settings.heading contains 'Loved' or section.settings.eyebrow contains 'Loved' %}
      background-image: url('{{ "3.png" | asset_url }}') !important;
      background-color: #F7F5EC !important;
    {% else %}
      background-image: url('{{ "4-web.png" | asset_url }}') !important;
      background-color: #F8F4EB !important;
    {% endif %}
    background-size: cover !important;
    background-position: center top !important;
    background-repeat: no-repeat !important;
  }
  @media (max-width: 48rem) {
    #BestSellers-{{ section.id }} {
      {% if section.settings.background_image == blank %}
        {% unless section.settings.heading contains 'Loved' or section.settings.eyebrow contains 'Loved' %}
          background-image: url('{{ "4-mob.jpeg" | asset_url }}') !important;
          background-color: #F8F4EB !important;
        {% endunless %}
      {% endif %}
      background-size: 100% auto !important;
      background-position: bottom center !important;
      background-repeat: no-repeat !important;
    }
  }
{% endstyle %}

<section id="BestSellers-{{ section.id }}" class="home-section best-sellers{% if section.settings.show_tabs %} best-sellers--with-tabs{% endif %}" data-best-sellers>
  {% if section.settings.heading contains 'Loved' or section.settings.eyebrow contains 'Loved' %}
    <!-- Decorative Farm Artworks -->
    <div class="best-sellers__decor-home" aria-hidden="true">
      <img src="{{ 'home.png' | asset_url }}" alt="Organic Cottage" width="70" height="70" loading="lazy">
    </div>
    <div class="best-sellers__decor-cow" aria-hidden="true">
      <img src="{{ 'cow.png' | asset_url }}" alt="Gir Cow" width="65" height="65" loading="lazy">
    </div>
  {% endif %}

  <div class="best-sellers__illustration-bg" aria-hidden="true">
    <svg viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 120C240 70 480 150 720 100C960 50 1200 130 1440 90V180H0V120Z" fill="rgba(35, 66, 31, 0.03)"/>
      <path d="M0 140C360 90 720 160 1080 120C1260 100 1380 130 1440 140V180H0V140Z" fill="rgba(35, 66, 31, 0.02)"/>
    </svg>
  </div>

  <div class="home-section__head best-sellers__head">
    <div class="best-sellers__title-wrap">
      <div class="best-sellers__decor" aria-hidden="true">
        <img src="{{ 'grains.png' | asset_url }}" alt="Organic Grains" class="best-sellers__bird-img" width="56" height="42" loading="lazy">
      </div>

      <p class="home-section__eyebrow">{{ section.settings.eyebrow | default: "Loved by Thousands ❤️" }}</p>
      <h2>{{ section.settings.heading | default: "Our most-loved picks" }}</h2>
    </div>

    {% if displayed_collection != blank %}
      <a class="best-sellers__link" href="{{ displayed_collection.url }}">
        {{ section.settings.cta_label | default: "Shop Now →" }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.show_tabs %}
    <div class="best-sellers__tabs" role="tablist" aria-label="Filter products by category">
      <button class="best-sellers__tab is-active" type="button" role="tab" data-best-sellers-tab data-category-filter="Ghee">Ghee</button>
      <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Oil">Oil</button>
      <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Atta">Atta</button>
      <button class="best-sellers__tab" type="button" role="tab" data-best-sellers-tab data-category-filter="Newly Launched">Newly Launched</button>
    </div>
  {% endif %}

  {% if displayed_collection != blank and displayed_collection.products_count > 0 %}
    <div class="best-sellers__carousel-wrapper">
      <button type="button" class="best-sellers__arrow best-sellers__arrow--prev" data-best-sellers-prev aria-label="Previous products">
        {% render 'icon', name: 'arrow', size: 18 %}
      </button>

      <div class="best-sellers__track" data-best-sellers-track>
        {% assign best_selling_products = displayed_collection.products | sort: 'best-selling' %}
        {% if best_selling_products.size == 0 %}
          {% assign best_selling_products = displayed_collection.products %}
        {% endif %}

        {% for product in best_selling_products limit: section.settings.maximum %}
          <div class="best-sellers__slide">
            {% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, show_badge: true, show_wishlist: true, show_quickview: false %}
          </div>
        {% endfor %}
      </div>

      <button type="button" class="best-sellers__arrow best-sellers__arrow--next" data-best-sellers-next aria-label="Next products">
        {% render 'icon', name: 'arrow', size: 18 %}
      </button>
    </div>
  {% else %}
    <p class="home-section__empty">Products will appear here after they are published to the Online Store.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Section Background Image",
      "info": "Upload custom background image from Shopify for Best Sellers Section."
    },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Loved by Thousands ❤️" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our most-loved picks" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Now →" },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category filter tabs (Ghee, Oil, Atta, etc.)", "default": false },
    { "type": "range", "id": "maximum", "label": "Maximum products", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating placeholder", "default": true }
  ],
  "presets": [
    { "name": "Best sellers" }
  ]
}
{% endschema %}
