<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}"><script src="{{ 'section-best-sellers.js' | asset_url }}" defer="defer"></script>
<section class="home-section best-sellers" data-best-sellers><div class="home-section__head"><div><p class="home-section__eyebrow">Loved by customers</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.collection != blank %}<a class="best-sellers__link" href="{{ section.settings.collection.url }}">View collection {% render 'icon', name: 'arrow', size: 16 %}</a>{% endif %}</div>{% if section.settings.collection != blank %}<div class="best-sellers__grid best-sellers__grid--{{ section.settings.columns }}">{% for product in section.settings.collection.products limit: section.settings.maximum %}{% render 'product-card', product: product, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating, show_badge: true, show_wishlist: true, show_quickview: true %}{% endfor %}</div>{% else %}<p class="home-section__empty">Choose a collection to display products.</p>{% endif %}</section>
{% schema %}{"name":"Best sellers","tag":"section","class":"section-best-sellers","settings":[{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"columns","label":"Products per row","options":[{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},{"type":"range","id":"maximum","label":"Maximum products","min":2,"max":12,"step":1,"default":4},{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"checkbox","id":"show_rating","label":"Show rating placeholder","default":true}],"presets":[{"name":"Best sellers"}]}{% endschema %}
