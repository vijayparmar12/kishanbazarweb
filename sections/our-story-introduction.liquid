{% doc %}
  Renders the introduction storytelling section for Our Story.
{% enddoc %}

<section class="story-intro" {{ section.shopify_attributes }}>
  <div class="story-container">
    <div class="story-intro__grid">
      <!-- Image Column (Left on Desktop, Top on Mobile) -->
      <div class="story-intro__media-col" data-story-reveal>
        <div class="story-intro__image-wrap">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'story-intro__image',
                loading: 'lazy',
                widths: '480, 750, 900, 1200',
                alt: section.settings.heading | escape
            }}
          {% else %}
            <img
              class="story-intro__image"
              src="{{ 'category-1.png.png' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              width="650"
              height="750"
              loading="lazy"
            >
          {% endif %}
          <div class="story-intro__image-badge">
            <span class="story-intro__badge-icon">🌿</span>
            <span class="story-intro__badge-text">100% Native Organic</span>
          </div>
        </div>
      </div>

      <!-- Text Content Column (Right on Desktop, Bottom on Mobile) -->
      <div class="story-intro__content-col" data-story-reveal>
        <span class="story-eyebrow">{{ section.settings.eyebrow | default: 'OUR PHILOSOPHY' }}</span>
        <h2 class="story-heading">{{ section.settings.heading | default: 'Why We Started' }}</h2>
        
        <div class="story-intro__body">
          {% if section.settings.content != blank %}
            {{ section.settings.content }}
          {% else %}
            <p>
              Kishan Bazar was born out of a deep reverence for India's rich agricultural heritage and a growing concern over processed, chemically treated foods dominating modern pantries.
            </p>
            <p>
              We realized that somewhere between industrial mass production and urban convenience, the true essence of wholesome nutrition was lost. We set out to change that—reconnecting families with authentic, stone-ground, farm-fresh staples.
            </p>
            <p>
              By partnering directly with smallholder organic farmers in Surat and Madhya Pradesh, we ensure fair compensation for growers while delivering unadulterated goodness to your kitchen table.
            </p>
          {% endif %}
        </div>

        <blockquote class="story-intro__quote">
          <p>"{{ section.settings.quote | default: 'Food should be simple, honest and close to its roots.' }}"</p>
        </blockquote>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Story Introduction",
  "tag": "section",
  "class": "section-our-story-intro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Started"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content Paragraphs"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Highlighted Statement",
      "default": "Food should be simple, honest and close to its roots."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Introduction Image"
    }
  ],
  "presets": [
    {
      "name": "Our Story Introduction"
    }
  ]
}
{% endschema %}
