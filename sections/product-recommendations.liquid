{% comment %}
  Kishan Bazar / KishanVeda - Recommended Products Section
  Editable via Shopify Theme Editor
  - Dynamic Shopify Search & Discovery App Recommendations
  - Supports Complementary and Related intents
  - Smooth horizontal snap slider with navigation arrows
{% endcomment %}
<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-product-card.css' | asset_url }}">

{% style %}
  .section-product-recommendations {
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    border-top: 1px solid #EFE8DA;
  }
  .product-recommendations__carousel-wrapper {
    position: relative;
    width: 100%;
  }
  .product-recommendations__track {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 0.75rem !important;
    overflow-x: auto !important;
    padding: 0.5rem 0 1rem !important;
    scroll-behavior: smooth !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch;
    align-items: stretch !important;
  }
  .product-recommendations__track::-webkit-scrollbar {
    display: none !important;
  }
  .product-recommendations__slide {
    flex: 0 0 calc((100% - 4rem) / 5) !important;
    min-width: 200px !important;
    max-width: 220px !important;
    scroll-snap-align: start !important;
  }
  @media screen and (min-width: 769px) and (max-width: 1200px) {
    .product-recommendations__slide {
      flex: 0 0 200px !important;
      min-width: 190px !important;
      max-width: 200px !important;
    }
  }
  @media screen and (max-width: 768px) {
    .product-recommendations__track {
      gap: 0.85rem !important;
    }
    .product-recommendations__slide {
      flex: 0 0 calc((100% - 0.85rem) / 2) !important;
      width: calc((100% - 0.85rem) / 2) !important;
      max-width: calc((100% - 0.85rem) / 2) !important;
      min-width: calc((100% - 0.85rem) / 2) !important;
      box-sizing: border-box !important;
      scroll-snap-align: start !important;
    }
  }

  .product-recommendations__slide .product-card,
  .product-recommendations__slide .product-card-wrapper,
  .product-recommendations__slide [data-product-card] {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    box-sizing: border-box !important;
  }

  .section-product-recommendations,
  .product-recommendations-section {
    padding-bottom: 3.5rem !important;
  }
  .section-product-recommendations .product-card__image-wrapper,
  .product-recommendations-section .product-card__image-wrapper,
  .section-product-recommendations .product-card__media,
  .product-recommendations-section .product-card__media {
    max-height: none !important;
    aspect-ratio: 1 / 1 !important;
    width: 100% !important;
    overflow: hidden !important;
    border-top-left-radius: 16px !important;
    border-top-right-radius: 16px !important;
    background: #ffffff !important;
    position: relative !important;
  }
  .section-product-recommendations .product-card__image,
  .product-recommendations-section .product-card__image {
    max-height: none !important;
    height: 100% !important;
    width: 100% !important;
    object-fit: cover !important;
    padding: 0 !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    display: block !important;
  }
  .section-product-recommendations .product-card,
  .product-recommendations-section .product-card {
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 16px !important;
    border: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }
  .section-product-recommendations .product-card__wave-divider,
  .product-recommendations-section .product-card__wave-divider {
    display: none !important;
  }
  .section-product-recommendations .product-card__content,
  .product-recommendations-section .product-card__content {
    padding: 0.65rem 0.65rem 0.75rem !important;
  }
  .section-product-recommendations .product-card__title,
  .product-recommendations-section .product-card__title {
    font-size: 0.80rem !important;
    line-height: 1.25 !important;
    margin-bottom: 0.25rem !important;
    min-height: 2.1rem !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    font-weight: 600 !important;
  }
  .section-product-recommendations .product-card__price,
  .product-recommendations-section .product-card__price,
  .section-product-recommendations .product-card__price-current,
  .product-recommendations-section .product-card__price-current {
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    margin-bottom: 0.25rem !important;
  }
  .section-product-recommendations .product-card__subtitle,
  .product-recommendations-section .product-card__subtitle,
  .section-product-recommendations .product-card__circle-features,
  .product-recommendations-section .product-card__circle-features,
  .section-product-recommendations .product-card__cart-icon,
  .product-recommendations-section .product-card__cart-icon,
  .product-recommendations-eyebrow,
  .product-recommendations-nav-btns {
    display: none !important;
  }

  .product-recommendations__slide--more {
    display: none !important;
  }

  .product-recommendations__cta-container {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    width: 100% !important;
    margin-top: 1.5rem !important;
  }
  .product-recommendations__shop-more-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.4rem !important;
    background-color: #1b4317 !important;
    color: #ffffff !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;
    padding: 0.45rem 1.35rem !important;
    border-radius: 999px !important;
    text-decoration: none !important;
    box-shadow: 0 4px 12px rgba(27, 67, 23, 0.22) !important;
    transition: all 220ms ease !important;
  }
  .product-recommendations__shop-more-btn:hover {
    background-color: #133010 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 16px rgba(27, 67, 23, 0.3) !important;
  }
{% endstyle %}

<div class="product-recommendations-section" data-sticky-end-boundary data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_limit | default: 8 }}" data-intent="{{ section.settings.intent | default: 'complementary' }}">
  <div class="product-page-container" style="max-width: 2000px; margin: 0 auto; padding-left: clamp(0.75rem, 3vw, 1.25rem); padding-right: clamp(0.75rem, 3vw, 1.25rem); box-sizing: border-box;">
    {% liquid
      assign selected_coll = section.settings.collection
      assign rec_products = nil

      if selected_coll != blank and selected_coll.products != blank
        assign rec_products = selected_coll.products
      elsif recommendations.performed and recommendations.products_count > 0
        assign rec_products = recommendations.products
      elsif collections.all.products != blank
        assign rec_products = collections.all.products
      endif

      assign rec_count = 0
      if rec_products != blank
        assign rec_count = rec_products.size | default: 0 | plus: 0
      endif
    %}

    {% if rec_count > 0 %}
      {% assign text_align = section.settings.heading_text_align | default: 'center' %}
      {% assign align_items = 'center' %}
      {% if text_align == 'left' %}
        {% assign align_items = 'flex-start' %}
      {% elsif text_align == 'right' %}
        {% assign align_items = 'flex-end' %}
      {% endif %}

      <div class="product-recommendations-head" style="display: flex; justify-content: {{ align_items }}; align-items: center; margin-bottom: 1.25rem; text-align: {{ text_align }};">
        <h2 class="product-recommendations-title" style="color: {{ section.settings.heading_color | default: '#1B4317' }}; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0; text-align: {{ text_align }}; width: 100%;">
          {{ section.settings.heading | default: 'RECOMMENDED' }}
        </h2>
      </div>

      <div class="product-recommendations__carousel-wrapper">
        <div class="product-recommendations__track" data-rec-track>
          {% assign count = 0 %}
          {% assign max_limit = section.settings.products_limit | default: 8 %}

          {% for rec_item in rec_products %}
            {% unless rec_item.id == product.id %}
              {% if count < max_limit %}
                {% assign count = count | plus: 1 %}
                <div class="product-recommendations__slide">
                  {% render 'product-card', product: rec_item, card_blocks: section.blocks, show_badge: true, show_rating: true, show_wishlist: true, show_benefit_icons: true, show_subtitle: true, show_variant_selector: true, show_add_to_cart: true %}
                </div>
              {% endif %}
            {% endunless %}
          {% endfor %}
        </div>
      </div>

      <div class="product-recommendations__cta-container">
        <a href="/collections/all" class="product-recommendations__shop-more-btn">
          <span>SHOP MORE</span>
          <span class="cta-arrow" style="font-size: 0.95rem; line-height: 1;">&rarr;</span>
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    function setupNav(container) {
      var track = container.querySelector('[data-rec-track]');
      var prevBtn = container.querySelector('[data-rec-prev]');
      var nextBtn = container.querySelector('[data-rec-next]');
      if (track && prevBtn && nextBtn) {
        prevBtn.onclick = function() {
          track.scrollBy({ left: -240, behavior: 'smooth' });
        };
        nextBtn.onclick = function() {
          track.scrollBy({ left: 240, behavior: 'smooth' });
        };
      }
    }

    function initRecommendations() {
      var sectionContainer = document.querySelector('.product-recommendations-section');
      if (!sectionContainer) return;
      var baseUrl = sectionContainer.getAttribute('data-url');
      if (!baseUrl) return;
      var preferredIntent = sectionContainer.getAttribute('data-intent') || 'complementary';

      var fetchIntent = function(targetIntent, fallbackIntent) {
        var requestUrl = baseUrl + '&intent=' + targetIntent;
        fetch(requestUrl)
          .then(function(response) {
            return response.text();
          })
          .then(function(html) {
            var parser = new DOMParser();
            var responseDoc = parser.parseFromString(html, 'text/html');
            var newSection = responseDoc.querySelector('.product-recommendations-section');
            var slides = newSection ? newSection.querySelectorAll('.product-recommendations__slide') : [];

            if (slides && slides.length > 0) {
              sectionContainer.innerHTML = newSection.innerHTML;
              sectionContainer.style.display = 'block';
              setupNav(sectionContainer);
            } else if (fallbackIntent) {
              fetchIntent(fallbackIntent, null);
            } else {
              var currentSlides = sectionContainer.querySelectorAll('.product-recommendations__slide');
              if (!currentSlides || currentSlides.length === 0) {
                sectionContainer.style.display = 'none';
              } else {
                setupNav(sectionContainer);
              }
            }
          })
          .catch(function(error) {
            console.error('Error fetching Shopify recommendations:', error);
            setupNav(sectionContainer);
          });
      };

      var primaryIntent = preferredIntent;
      var secondaryIntent = (primaryIntent === 'complementary') ? 'related' : 'complementary';
      fetchIntent(primaryIntent, secondaryIntent);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecommendations);
    } else {
      initRecommendations();
    }
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Text Alignment",
      "options": [
        { "value": "left", "label": "Left (Recommended)" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HANDPICKED ORGANIC STAPLES"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation Type",
      "options": [
        { "value": "complementary", "label": "Complementary Products (Search & Discovery)" },
        { "value": "related", "label": "Related Products (Search & Discovery)" }
      ],
      "default": "complementary",
      "info": "Choose whether to prioritize Complementary or Related products set in Shopify Search & Discovery App."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Custom Collection (Optional)",
      "info": "Select a specific collection to display. If left blank, dynamic recommendations set in Search & Discovery will be used."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1B4317"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#D97706"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "card_title",
      "name": "Card Title",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "title_color", "label": "Title text color", "default": "#23421F" },
        { "type": "range", "id": "font_size", "label": "Title Font Size (px)", "min": 12, "max": 32, "step": 1, "default": 17, "unit": "px" },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Title Font Weight",
          "options": [
            { "value": "normal", "label": "Normal (400)" },
            { "value": "600", "label": "Semi-Bold (600)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "800", "label": "Extra Bold (800)" }
          ],
          "default": "bold"
        }
      ]
    },
    {
      "type": "card_price",
      "name": "Card Price",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "price_color", "label": "Price color", "default": "#23421F" },
        { "type": "color", "id": "compare_price_color", "label": "Compare price color", "default": "#8D8D8D" },
        { "type": "range", "id": "price_font_size", "label": "Price Font Size (px)", "min": 12, "max": 36, "step": 1, "default": 19, "unit": "px" },
        {
          "type": "select",
          "id": "price_font_weight",
          "label": "Price Font Weight",
          "options": [
            { "value": "600", "label": "Semi-Bold (600)" },
            { "value": "700", "label": "Bold (700)" },
            { "value": "800", "label": "Extra Bold (800)" },
            { "value": "900", "label": "Black (900)" }
          ],
          "default": "800"
        }
      ]
    },
    {
      "type": "card_title_price",
      "name": "Card Title & Price",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "title_color", "label": "Title text color", "default": "#23421F" },
        { "type": "color", "id": "price_color", "label": "Price color", "default": "#23421F" },
        { "type": "color", "id": "compare_price_color", "label": "Compare price color", "default": "#8D8D8D" }
      ]
    },
    {
      "type": "card_subtitle",
      "name": "Card Subtitle Description",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#6B7280" }
      ]
    },
    {
      "type": "card_rating",
      "name": "Card Star Rating",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "rating_stars_color", "label": "Star rating color", "default": "#E5A800" }
      ]
    },
    {
      "type": "card_benefit_icons",
      "name": "Card Benefit Badges",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_benefit_icons", "label": "Show benefit circle icons", "default": true },
        { "type": "range", "id": "icon_size", "label": "Benefit Icon Size (px)", "min": 36, "max": 120, "step": 2, "default": 72, "unit": "px" },
        { "type": "image_picker", "id": "benefit_image_1", "label": "Benefit Icon 1 Image" },
        { "type": "image_picker", "id": "benefit_image_2", "label": "Benefit Icon 2 Image" },
        { "type": "image_picker", "id": "benefit_image_3", "label": "Benefit Icon 3 Image" },
        { "type": "image_picker", "id": "benefit_image_4", "label": "Benefit Icon 4 Image" }
      ]
    },
    {
      "type": "card_variant_selector",
      "name": "Card Variant Dropdown",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "border_color", "label": "Dropdown border color", "default": "#1F1F1F" },
        { "type": "color", "id": "bg_color", "label": "Dropdown background color", "default": "#FFFFFF" },
        { "type": "color", "id": "text_color", "label": "Dropdown text color", "default": "#1F1F1F" }
      ]
    },
    {
      "type": "card_buy_button",
      "name": "Card Add to Cart Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_to_cart_text", "label": "Button text", "default": "ADD TO CART" },
        { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#23421F" },
        { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#FFFFFF" }
      ]
    },
    {
      "type": "card_custom_text",
      "name": "Card Custom Text Line",
      "settings": [
        { "type": "text", "id": "text", "label": "Custom text", "default": "🚚 Free Shipping on orders over ₹499" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#23421F" },
        { "type": "select", "id": "font_weight", "label": "Font weight", "options": [{ "value": "normal", "label": "Normal" }, { "value": "bold", "label": "Bold" }], "default": "bold" }
      ]
    },
    {
      "type": "custom_badge_block",
      "name": "Custom Card Badge",
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "SPECIAL OFFER" },
        { "type": "color", "id": "badge_bg", "label": "Badge background color", "default": "#E06535" },
        { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product recommendations",
      "blocks": [
        { "type": "card_title_price" },
        { "type": "card_subtitle" },
        { "type": "card_rating" },
        { "type": "card_benefit_icons" },
        { "type": "card_variant_selector" },
        { "type": "card_buy_button" }
      ]
    }
  ]
}
{% endschema %}
