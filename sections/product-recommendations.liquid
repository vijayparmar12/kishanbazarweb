{% comment %}
  Kishan Bazar / KishanVeda - Recommended Products Section
  Editable via Shopify Theme Editor
  - Horizontal snap slider with left/right navigation arrows
  - Clean Green Circle [ → ] More Arrow (No Box / No Box Hover)
{% endcomment %}
<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-product-card.css' | asset_url }}">

{% style %}
  .section-product-recommendations {
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    border-top: 1px solid #EFE8DA;
  }
  .product-recommendations__carousel-wrapper {
    position: relative;
    width: 100%;
  }
  .product-recommendations__track {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 0.5rem !important;
    overflow-x: auto !important;
    padding: 0.5rem 0 1rem !important;
    scroll-behavior: smooth !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch;
    align-items: stretch !important;
  }
  .product-recommendations__track::-webkit-scrollbar {
    display: none !important;
  }
  .product-recommendations__slide {
    flex: 0 0 calc((100% - 4rem) / 5) !important;
    min-width: 200px !important;
    max-width: 220px !important;
    scroll-snap-align: start !important;
  }
  @media screen and (min-width: 769px) and (max-width: 1200px) {
    .product-recommendations__slide {
      flex: 0 0 200px !important;
      min-width: 190px !important;
      max-width: 200px !important;
    }
  }
  @media screen and (max-width: 768px) {
    .product-recommendations__track {
      gap: 0.85rem !important;
    }
    .product-recommendations__slide {
      flex: 0 0 calc((100% - 0.85rem) / 2) !important;
      width: calc((100% - 0.85rem) / 2) !important;
      max-width: calc((100% - 0.85rem) / 2) !important;
      min-width: calc((100% - 0.85rem) / 2) !important;
      box-sizing: border-box !important;
      scroll-snap-align: start !important;
    }
  }

  .product-recommendations__slide .product-card,
  .product-recommendations__slide .product-card-wrapper,
  .product-recommendations__slide [data-product-card] {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Compact Card Styling inside Recommendation Section */
  .section-product-recommendations,
  .product-recommendations-section {
    padding-bottom: 4.5rem !important;
  }
  .section-product-recommendations .product-card__image-wrapper,
  .product-recommendations-section .product-card__image-wrapper {
    max-height: 140px !important;
    height: 140px !important;
  }
  .section-product-recommendations .product-card__image,
  .product-recommendations-section .product-card__image {
    max-height: 130px !important;
    height: 130px !important;
    object-fit: contain !important;
  }
  .section-product-recommendations .product-card,
  .product-recommendations-section .product-card {
    padding: 0.5rem !important;
    border-radius: 14px !important;
    border: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
  }
  .section-product-recommendations .product-card__title,
  .product-recommendations-section .product-card__title {
    font-size: 0.88rem !important;
    line-height: 1.25 !important;
    margin-bottom: 0.25rem !important;
    min-height: 2.3rem !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }
  .section-product-recommendations .product-card__price,
  .product-recommendations-section .product-card__price {
    font-size: 0.95rem !important;
    margin-bottom: 0.25rem !important;
  }
  .section-product-recommendations .product-card__subtitle,
  .product-recommendations-section .product-card__subtitle,
  .section-product-recommendations .product-card__circle-features,
  .product-recommendations-section .product-card__circle-features,
  .section-product-recommendations .product-card__cart-icon,
  .product-recommendations-section .product-card__cart-icon {
    display: none !important;
  }

  .product-recommendations__slide--more {
    display: none !important;
  }
{% endstyle %}

<div class="product-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=2" data-intent="{{ section.settings.intent | default: 'complementary' }}">
  <div class="product-page-container" style="max-width: 2000px; margin: 0 auto; padding-left: clamp(0.75rem, 3vw, 1.25rem); padding-right: clamp(0.75rem, 3vw, 1.25rem); box-sizing: border-box;">
    {% liquid
      assign ghee_prod = collections['ghee'].products.first
      if ghee_prod == blank
        assign ghee_prod = collections['a2-bilona-ghee'].products.first
      endif
      if ghee_prod == blank
        assign ghee_prod = all_products['a2-desi-cow-vedic-bilona-ghee-देसी-वैदिक-बिलोना-घी']
      endif
      if ghee_prod == blank
        assign ghee_prod = all_products['gir-a2-bilona-ghee-1kg']
      endif
      if ghee_prod == blank
        assign ghee_prod = all_products['gir-a2-bilona-ghee-500g']
      endif
      if ghee_prod == blank
        for p in collections.all.products
          assign p_title_lower = p.title | downcase
          if p_title_lower contains 'ghee'
            assign ghee_prod = p
            break
          endif
        endfor
      endif

      assign selected_coll = section.settings.collection
      if selected_coll != blank and selected_coll.products.size > 0
        assign rec_products = selected_coll.products
      else
        assign rec_products = recommendations.products
        if recommendations.performed == false or rec_products.size == 0
          assign rec_products = product.collections.first.products
          if rec_products == blank or rec_products.size == 0
            assign rec_products = collections.all.products | default: collections['all'].products
          endif
        endif
      endif
    %}

    {% if rec_products.size > 0 or ghee_prod != blank %}
      <div class="product-recommendations-head" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.25rem;">
        <div>
          {% if section.settings.eyebrow != blank %}
            <span class="product-recommendations-eyebrow" style="color: {{ section.settings.eyebrow_color | default: '#D97706' }}; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.25rem;">
              {{ section.settings.eyebrow }}
            </span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="product-recommendations-title" style="color: {{ section.settings.heading_color | default: '#1B4317' }}; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0;">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>
      </div>

      <div class="product-recommendations__carousel-wrapper">
        <div class="product-recommendations__track" data-rec-track>
          {% assign count = 0 %}
          {% assign max_limit = 2 %}
          {% assign ghee_rendered = false %}

          {% if ghee_prod != blank and product.id != ghee_prod.id %}
            {% assign count = count | plus: 1 %}
            {% assign ghee_rendered = true %}
            <div class="product-recommendations__slide" data-ghee-featured>
              {% render 'product-card', product: ghee_prod, show_badge: true, show_rating: true, show_wishlist: true, show_quickview: false, hide_benefit_icons: true, hide_cart_icon: true %}
            </div>
          {% endif %}

          {% for rec_item in rec_products %}
            {% unless rec_item.id == product.id or (ghee_rendered and rec_item.id == ghee_prod.id) %}
              {% if count < max_limit %}
                {% assign count = count | plus: 1 %}
                <div class="product-recommendations__slide">
                  {% render 'product-card', product: rec_item, show_badge: true, show_rating: true, show_wishlist: true, show_quickview: false, hide_benefit_icons: true, hide_cart_icon: true %}
                </div>
              {% endif %}
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    function initRecommendations() {
      var sectionContainer = document.querySelector('.product-recommendations-section');
      if (!sectionContainer) return;
      var baseUrl = sectionContainer.getAttribute('data-url');
      if (!baseUrl) return;
      var preferredIntent = sectionContainer.getAttribute('data-intent') || 'related';

      var fetchIntent = function(targetIntent, fallbackIntent) {
        var requestUrl = baseUrl + '&intent=' + targetIntent;
        fetch(requestUrl)
          .then(function(response) {
            return response.text();
          })
          .then(function(html) {
            var parser = new DOMParser();
            var responseDoc = parser.parseFromString(html, 'text/html');
            var newSection = responseDoc.querySelector('.product-recommendations-section');
            var slides = newSection ? newSection.querySelectorAll('.product-recommendations__slide:not(.product-recommendations__slide--more)') : [];
            if (slides && slides.length > 0) {
              var gheeCard = sectionContainer.querySelector('[data-ghee-featured]');
              var newTrack = newSection.querySelector('[data-rec-track]');
              if (gheeCard && newTrack) {
                var hasGhee = newSection.querySelector('[data-ghee-featured]');
                if (!hasGhee) {
                  newTrack.insertBefore(gheeCard.cloneNode(true), newTrack.firstChild);
                }
              }
              var allSlides = newTrack ? newTrack.querySelectorAll('.product-recommendations__slide') : [];
              if (allSlides.length > 2) {
                for (var i = 2; i < allSlides.length; i++) {
                  allSlides[i].remove();
                }
              }
              sectionContainer.innerHTML = newSection.innerHTML;
            } else if (fallbackIntent) {
              fetchIntent(fallbackIntent, null);
            }
          })
          .catch(function(error) {
            console.error('Error fetching Shopify recommendations:', error);
            if (fallbackIntent) {
              fetchIntent(fallbackIntent, null);
            }
          });
      };

      var primaryIntent = preferredIntent;
      var secondaryIntent = (primaryIntent === 'complementary') ? 'related' : 'complementary';
      fetchIntent(primaryIntent, secondaryIntent);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecommendations);
    } else {
      initRecommendations();
    }
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HANDPICKED ORGANIC STAPLES"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation Type",
      "options": [
        { "value": "related", "label": "Related Products (Search & Discovery)" },
        { "value": "complementary", "label": "Complementary Products (Search & Discovery)" }
      ],
      "default": "complementary",
      "info": "Choose whether to prioritize Related or Complementary products set in Shopify Search & Discovery App."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Custom Collection (Optional)",
      "info": "Select a specific collection to display. If left blank, dynamic recommendations will be used."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1B4317"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#D97706"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
