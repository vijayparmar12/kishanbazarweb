{% comment %}
  Kishan Bazar / KishanVeda - Recommended Products Section
  Editable via Shopify Theme Editor
  - Horizontal snap slider with left/right navigation arrows
  - Clean Green Circle [ → ] More Arrow (No Box / No Box Hover)
{% endcomment %}
<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-product-card.css' | asset_url }}">

{% style %}
  .section-product-recommendations {
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    border-top: 1px solid #EFE8DA;
  }
  .product-recommendations__carousel-wrapper {
    position: relative;
    width: 100%;
  }
  .product-recommendations__track {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 1.25rem !important;
    overflow-x: auto !important;
    padding: 0.5rem 0.25rem 1.25rem !important;
    scroll-behavior: smooth !important;
    scroll-snap-type: x mandatory !important;
    scrollbar-width: thin !important;
    -webkit-overflow-scrolling: touch;
    align-items: stretch !important;
  }
  .product-recommendations__slide {
    flex: 0 0 280px !important;
    max-width: 280px !important;
    scroll-snap-align: start !important;
  }
  @media screen and (max-width: 768px) {
    .product-recommendations__slide {
      flex: 0 0 220px !important;
      max-width: 220px !important;
    }
  }
  .product-recommendations__slide--more {
    flex: 0 0 120px !important;
    max-width: 120px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    scroll-snap-align: start !important;
  }
  .product-recommendations__more-link {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.65rem !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 200px !important;
    text-decoration: none !important;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    cursor: pointer !important;
    transition: transform 220ms ease !important;
  }
  .product-recommendations__more-link:hover {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    transform: translateY(-2px) !important;
  }
  .product-recommendations__more-circle {
    width: 56px !important;
    height: 56px !important;
    border-radius: 50% !important;
    background-color: #1b4317 !important;
    color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 4px 14px rgba(27, 67, 23, 0.28) !important;
    transition: transform 220ms ease, background-color 220ms ease !important;
  }
  .product-recommendations__more-link:hover .product-recommendations__more-circle {
    transform: scale(1.12) !important;
    background-color: #143311 !important;
  }
  .product-recommendations__more-text {
    font-size: 0.92rem !important;
    font-weight: 800 !important;
    color: #1b4317 !important;
    letter-spacing: 0.02em !important;
    transition: color 220ms ease !important;
  }
  .product-recommendations__more-link:hover .product-recommendations__more-text {
    color: #143311 !important;
  }
{% endstyle %}

<div class="product-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_limit | default: 8 }}">
  <div class="product-page-container" style="max-width: 2000px; margin: 0 auto; padding-left: clamp(0.75rem, 3vw, 1.25rem); padding-right: clamp(0.75rem, 3vw, 1.25rem); box-sizing: border-box;">
    {% liquid
      assign selected_coll = section.settings.collection
      if selected_coll != blank and selected_coll.products.size > 0
        assign rec_products = selected_coll.products
      else
        assign rec_products = recommendations.products
        if recommendations.performed == false or rec_products.size == 0
          assign rec_products = product.collections.first.products
          if rec_products == blank or rec_products.size == 0
            assign rec_products = collections.all.products | default: collections['all'].products
          endif
        endif
      endif

      assign more_url = routes.all_products_collection_url
    %}

    {% if rec_products.size > 0 %}
      <div class="product-recommendations-head" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.25rem;">
        <div>
          {% if section.settings.eyebrow != blank %}
            <span class="product-recommendations-eyebrow" style="color: {{ section.settings.eyebrow_color | default: '#D97706' }}; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.25rem;">
              {{ section.settings.eyebrow }}
            </span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="product-recommendations-title" style="color: {{ section.settings.heading_color | default: '#1B4317' }}; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0;">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>

        <div class="product-recommendations-nav-btns" style="display: flex; gap: 0.5rem;">
          <button type="button" class="product-recommendations-nav-btn" data-rec-prev aria-label="Previous recommended products" style="width: 42px; height: 42px; border-radius: 50%; background: #ffffff; border: 1px solid #e5e7eb; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #374151;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="product-recommendations-nav-btn" data-rec-next aria-label="Next recommended products" style="width: 42px; height: 42px; border-radius: 50%; background: #ffffff; border: 1px solid #e5e7eb; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #374151;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="product-recommendations__carousel-wrapper">
        <div class="product-recommendations__track" data-rec-track>
          {% assign count = 0 %}
          {% for rec_item in rec_products %}
            {% unless rec_item.id == product.id %}
              {% assign count = count | plus: 1 %}
              {% if count <= section.settings.products_limit %}
                <div class="product-recommendations__slide">
                  {% render 'product-card', product: rec_item, show_badge: true, show_rating: true, show_wishlist: true, show_quickview: false, hide_benefit_icons: true %}
                </div>
              {% endif %}
            {% endunless %}
          {% endfor %}

          <!-- CLEAN GREEN CIRCLE [ → ] MORE ARROW (NO BOX / NO BOX HOVER) -->
          <div class="product-recommendations__slide product-recommendations__slide--more">
            <a href="{{ more_url }}" class="product-recommendations__more-link" aria-label="View all products">
              <div class="product-recommendations__more-circle">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
              <span class="product-recommendations__more-text">More</span>
            </a>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      var section = document.querySelector('.product-recommendations-section');
      if (!section) return;
      var track = section.querySelector('[data-rec-track]');
      var prevBtn = section.querySelector('[data-rec-prev]');
      var nextBtn = section.querySelector('[data-rec-next]');

      if (track && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -300, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: 300, behavior: 'smooth' });
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HANDPICKED ORGANIC STAPLES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Custom Collection (Optional)",
      "info": "Select a specific collection to display. If left blank, dynamic recommendations will be used."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1B4317"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#D97706"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
