{% comment %}
  Kishan Bazar / KishanVeda - Recommended Products Section
  Editable via Shopify Theme Editor
{% endcomment %}
<link rel="stylesheet" href="{{ 'section-best-sellers.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-product-card.css' | asset_url }}">

{% style %}
  .section-product-recommendations {
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    border-top: 1px solid #EFE8DA;
  }
  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }
  @media screen and (max-width: 990px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }
  @media screen and (max-width: 640px) {
    .product-recommendations__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr);
      gap: 0.75rem;
    }
  }
{% endstyle %}

<div class="product-recommendations-section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_limit | default: 4 }}">
  <div class="product-page-container" style="max-width: 2000px; margin: 0 auto; padding-left: clamp(0.75rem, 3vw, 1.25rem); padding-right: clamp(0.75rem, 3vw, 1.25rem); box-sizing: border-box;">
    {% liquid
      assign selected_coll = section.settings.collection
      if selected_coll != blank and selected_coll.products.size > 0
        assign rec_products = selected_coll.products
      else
        assign rec_products = recommendations.products
        if recommendations.performed == false or rec_products.size == 0
          assign rec_products = product.collections.first.products
          if rec_products == blank or rec_products.size == 0
            assign rec_products = collections.all.products | default: collections['all'].products
          endif
        endif
      endif
    %}

    {% if rec_products.size > 0 %}
      <div class="product-recommendations-head" style="text-align: center; margin-bottom: 1.25rem;">
        {% if section.settings.eyebrow != blank %}
          <span class="product-recommendations-eyebrow" style="color: {{ section.settings.eyebrow_color | default: '#D97706' }}; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.25rem;">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="product-recommendations-title" style="color: {{ section.settings.heading_color | default: '#1B4317' }}; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0;">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      <div class="product-recommendations__grid">
        {% assign count = 0 %}
        {% for rec_item in rec_products %}
          {% unless rec_item.id == product.id %}
            {% assign count = count | plus: 1 %}
            {% if count <= section.settings.products_limit %}
              {% render 'product-card', product: rec_item, show_badge: true, show_rating: true, show_wishlist: true, show_quickview: false %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HANDPICKED ORGANIC STAPLES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Custom Collection (Optional)",
      "info": "Select a specific collection to display. If left blank, dynamic recommendations will be used."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1B4317"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#D97706"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
