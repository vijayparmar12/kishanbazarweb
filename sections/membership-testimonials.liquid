{% doc %}
  Renders Member Testimonials section.
{% enddoc %}

<section class="kb-membership-testimonials" data-membership-testimonials>
  <div class="kb-membership-testimonials__container">
    <div class="kb-membership-section-header">
      <span class="eyebrow">MEMBER STORIES</span>
      <h2 class="title">Loved by 15,000+ Health-Conscious Families</h2>
      <p class="subtitle">Read real reviews from members who enjoy pure organic food delivered to their homes.</p>
    </div>

    <div class="kb-membership-testimonials__grid">
      <figure class="kb-member-review-card">
        <div class="kb-member-review-card__header">
          <div class="avatar">V</div>
          <div>
            <strong class="name">Vaibhavi Raut</strong>
            <span class="plan-tag">Elite Member (12 Mo)</span>
          </div>
        </div>
        <div class="kb-member-review-card__rating">★★★★★</div>
        <blockquote class="kb-member-review-card__quote">
          "The 10% extra discount and free shipping on Khapli Atta and Gir Ghee saved our family over ₹4,200 last year alone. The quality is unmatched!"
        </blockquote>
      </figure>

      <figure class="kb-member-review-card">
        <div class="kb-member-review-card__header">
          <div class="avatar">R</div>
          <div>
            <strong class="name">Rajesh Patel</strong>
            <span class="plan-tag">Premium Member (6 Mo)</span>
          </div>
        </div>
        <div class="kb-member-review-card__rating">★★★★★</div>
        <blockquote class="kb-member-review-card__quote">
          "Getting early harvest access to unadulterated wood-pressed oils before stocks run out is worth every rupee of the membership fee."
        </blockquote>
      </figure>

      <figure class="kb-member-review-card">
        <div class="kb-member-review-card__header">
          <div class="avatar">P</div>
          <div>
            <strong class="name">Pooja Sharma</strong>
            <span class="plan-tag">Elite Member (12 Mo)</span>
          </div>
        </div>
        <div class="kb-member-review-card__rating">★★★★★</div>
        <blockquote class="kb-member-review-card__quote">
          "The birthday gift box arrived with authentic organic jaggery and spices. Incredible personal touch from the Kishan Bazar team!"
        </blockquote>
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Membership Testimonials",
  "tag": "section",
  "class": "section-membership-testimonials",
  "settings": [],
  "presets": [
    {
      "name": "Membership Testimonials"
    }
  ]
}
{% endschema %}
