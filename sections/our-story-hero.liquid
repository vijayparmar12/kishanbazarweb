{% doc %}
  Renders the Hero Banner and Page Content for Our Story page.
  Features:
  - Top Hero Banner Image (Desktop & Mobile, editable in Theme Editor)
  - Page Title below Banner
  - Page Content below Title with Automatic Box CSS for every heading, section, & image (e.g. A Note from Our Founder, My Personal Invitation, In News)!
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-our-story.css' | asset_url }}">

<section class="story-hero-section" id="StoryHero-{{ section.id }}" style="padding: 0 1rem; max-width: 1400px; margin: 1rem auto 2rem; box-sizing: border-box;" {{ section.shopify_attributes }}>
  <!-- 1. TOP HERO BANNER IMAGE (Editable in Theme Editor) -->
  {% if section.settings.desktop_image != blank or section.settings.mobile_image != blank %}
    <div class="story-hero__banner-wrap" style="position: relative; width: 100%; border-radius: {{ section.settings.banner_radius | default: 20 }}px; overflow: hidden; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);">
      <picture class="story-hero__picture" style="display: block; width: 100%;">
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1200 }}">
        {% endif %}
        {% assign banner_img = section.settings.desktop_image | default: section.settings.mobile_image %}
        <img
          src="{{ banner_img | image_url: width: 2200 }}"
          alt="{{ section.settings.heading | default: page.title | escape }}"
          class="story-hero__banner-img"
          loading="eager"
          fetchpriority="high"
          style="width: 100%; height: auto; display: block; object-fit: contain; max-height: 550px;"
        >
      </picture>

      {% if section.settings.show_text_overlay and section.settings.heading != blank %}
        <div class="story-hero__overlay-content" style="position: absolute; inset: 0; background: rgba(15, 33, 17, {{ section.settings.overlay_opacity | divided_by: 100.0 }}); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem 1.5rem; color: #ffffff;">
          {% if section.settings.label != blank %}
            <span class="story-hero__label" style="background: rgba(255,255,255,0.2); color: #F59E0B; padding: 0.35rem 1rem; border-radius: 999px; font-size: 0.82rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem; display: inline-block;">
              {{ section.settings.label }}
            </span>
          {% endif %}
          <h1 class="story-hero__heading" style="color: #ffffff; font-family: Georgia, serif; font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 900; margin: 0 0 1rem; line-height: 1.15;">
            {{ section.settings.heading }}
          </h1>
          {% if section.settings.subheading != blank %}
            <p class="story-hero__subheading" style="color: #E5E7EB; font-size: clamp(1rem, 1.8vw, 1.2rem); max-width: 700px; margin: 0 0 1.5rem; line-height: 1.6;">
              {{ section.settings.subheading }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <!-- 2. PAGE TITLE BELOW BANNER -->
  <div style="max-width: 1100px; margin: 2.5rem auto 1.5rem; text-align: center;">
    <h1 class="main-page-title page-title h0" style="color: #132D14; font-family: Georgia, serif; font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 900; margin: 0 0 0.5rem;">
      {{ page.title }}
    </h1>
  </div>

  <!-- 3. PAGE CONTENT BELOW TITLE (Auto-boxed into separate Card Boxes!) -->
  {% if page.content != blank %}
    <div style="max-width: 1100px; margin: 0 auto;">
      <div class="rte vedic-page-content-wrapper" data-auto-box-content>
        {{ page.content }}
      </div>
    </div>
  {% endif %}
</section>

<!-- AUTO-BOXER SCRIPT FOR PAGE CONTENT SECTIONS & IMAGES -->
<script>
  (function() {
    function initAutoBoxer() {
      var container = document.querySelector('[data-auto-box-content]');
      if (!container) return;

      var rawHTML = container.innerHTML;
      if (!rawHTML || rawHTML.trim() === '') return;

      var tempDiv = document.createElement('div');
      tempDiv.innerHTML = rawHTML;

      var children = Array.from(tempDiv.childNodes);
      var boxes = [];
      var currentBoxNodes = [];

      children.forEach(function(node) {
        var isHeading = false;
        var isImageOnly = false;
        var textContent = node.textContent ? node.textContent.trim() : '';

        if (node.nodeType === 1) { // Element node
          var tagName = node.tagName.toLowerCase();
          if (['h1', 'h2', 'h3', 'h4', 'h5'].indexOf(tagName) !== -1) {
            isHeading = true;
          } else if (node.querySelector && node.querySelector('img')) {
            // Paragraph or container with image
            if (textContent === '' || textContent.length < 20) {
              isImageOnly = true;
            }
          } else if (textContent.indexOf('Title:') === 0 || textContent.indexOf('A Note from Our Founder') !== -1 || textContent.indexOf('My Personal Invitation') !== -1 || textContent.indexOf('IN NEWS') !== -1) {
            isHeading = true;
          }
        } else if (node.nodeType === 3 && (textContent.indexOf('Title:') === 0 || textContent.indexOf('A Note from Our Founder') !== -1 || textContent.indexOf('My Personal Invitation') !== -1 || textContent.indexOf('IN NEWS') !== -1)) {
          isHeading = true;
        }

        if ((isHeading || isImageOnly) && currentBoxNodes.length > 0) {
          boxes.push(currentBoxNodes);
          currentBoxNodes = [];
        }
        currentBoxNodes.push(node);
      });

      if (currentBoxNodes.length > 0) {
        boxes.push(currentBoxNodes);
      }

      if (boxes.length > 0) {
        container.innerHTML = '';
        boxes.forEach(function(nodes) {
          var boxEl = document.createElement('div');
          boxEl.className = 'vedic-content-box';
          
          nodes.forEach(function(n) {
            boxEl.appendChild(n.cloneNode(true));
          });

          // Style formatting inside box
          var boxHTML = boxEl.innerHTML;
          boxHTML = boxHTML.replace(/Title:\s*([^<]+)/gi, '<h2 class="vedic-content-box__title">$1</h2>');
          boxHTML = boxHTML.replace(/Subtitle:\s*([^<]+)/gi, '<span class="vedic-content-box__subtitle">$1</span>');
          boxHTML = boxHTML.replace(/Content:\s*/gi, '');
          boxHTML = boxHTML.replace(/Button:\s*([^<]+)/gi, '<a class="vedic-content-box__btn" href="/collections/all">$1</a>');

          boxEl.innerHTML = boxHTML;
          container.appendChild(boxEl);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoBoxer);
    } else {
      initAutoBoxer();
    }
  })();
</script>

{% schema %}
{
  "name": "Our Story Hero & Content",
  "tag": "section",
  "class": "section-our-story-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner Image Settings"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Hero Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Hero Image"
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text Overlay Settings (Optional)"
    },
    {
      "type": "checkbox",
      "id": "show_text_overlay",
      "label": "Show Text Overlay on top of Banner Image",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 35
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading Text"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Text"
    }
  ],
  "presets": [
    {
      "name": "Our Story Hero & Content"
    }
  ]
}
{% endschema %}
