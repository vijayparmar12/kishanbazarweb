{% doc %}
  Renders customizable policy page sections.
  Supports BOTH:
  1. Direct editing from Shopify Admin > Pages (page.content rich text box) for instant easy editing
  2. Theme Editor blocks (Highlight boxes, Policy Clauses, Contact cards)
  3. Option to show or remove top title header banner
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-policy-page.css' | asset_url }}">

<section id="PolicyPage-{{ section.id }}" class="policy-page-section" data-section-id="{{ section.id }}">
  <div class="policy-page__container">
    
    <!-- TOP TITLE HEADER BANNER (Disabled by default per user request) -->
    {% if section.settings.show_header %}
      <div class="policy-page__header">
        {% if section.settings.eyebrow != blank %}
          <span class="policy-page__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h1 class="policy-page__heading">{{ page.title | default: section.settings.heading | default: 'Store Policy' }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="policy-page__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="policy-page__body">
      <!-- 1. EDITABLE FROM SHOPIFY ADMIN > PAGES -->
      {% if page.content != blank %}
        <div class="policy-clause-card default-page-content">
          <div class="policy-clause__content rte">
            {{ page.content }}
          </div>
        </div>
      {% endif %}

      <!-- 2. THEME EDITOR BLOCKS -->
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'policy_clause' %}
            <article class="policy-clause-card" {{ block.shopify_attributes }}>
              {% assign clean_icon = block.settings.icon | strip %}
              {% if block.settings.title != blank or clean_icon != blank %}
                <div class="policy-clause__header">
                  {% if clean_icon != blank %}
                    <span class="policy-clause__icon">{{ clean_icon }}</span>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h2 class="policy-clause__title">{{ block.settings.title }}</h2>
                  {% endif %}
                </div>
              {% endif %}
              {% if block.settings.content != blank %}
                <div class="policy-clause__content rte">
                  {{ block.settings.content }}
                </div>
              {% endif %}
            </article>

          {% when 'policy_highlight' %}
            <aside class="policy-highlight-card" style="background-color: {{ block.settings.bg_color | default: '#F0FDF4' }}; border-color: {{ block.settings.border_color | default: '#BBF7D0' }};" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="policy-highlight__title" style="color: {{ block.settings.text_color | default: '#166534' }};">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.content != blank %}
                <p class="policy-highlight__content" style="color: {{ block.settings.text_color | default: '#1E3D20' }};">{{ block.settings.content }}</p>
              {% endif %}
            </aside>

          {% when 'policy_contact' %}
            <div class="policy-contact-card" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="policy-contact__title">{{ block.settings.title }}</h3>
              {% endif %}
              <div class="policy-contact__details">
                {% if block.settings.email != blank %}
                  <span class="policy-contact__item">
                    <span>📧 Email:</span>
                    <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                  </span>
                {% endif %}
                {% if block.settings.phone != blank %}
                  <span class="policy-contact__item">
                    <span>📞 Phone:</span>
                    <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
                  </span>
                {% endif %}
              </div>
              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_url | default: '/pages/contact' }}" class="policy-contact__btn">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy Page Content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Top Title Header Banner",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Badge",
      "default": "KISAN BAZAR POLICIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading (Leave blank to use Shopify Page Title)",
      "default": ""
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Last Updated",
      "default": "Last updated: August 2026 • Please read carefully."
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show content from Shopify Admin > Pages text box",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "policy_clause",
      "name": "Policy Clause / Section",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Clause Icon (Optional Emoji/Text)",
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": "Clause Title",
          "default": ""
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Clause Content",
          "default": "<p>Welcome to Kisan Bazar. By accessing or using our website, purchasing our organic farm staples, or interacting with our services, you agree to be bound by these policies.</p>"
        }
      ]
    },
    {
      "type": "policy_highlight",
      "name": "Highlight Box",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Box Title",
          "default": "⚡ Quick Summary"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Box Content",
          "default": "All products are 100% natural, farm-fresh, and packaged with care."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#F0FDF4"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "#BBF7D0"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#166534"
        }
      ]
    },
    {
      "type": "policy_contact",
      "name": "Contact & Support Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Questions About Our Policy?"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support Email",
          "default": "support@kishanbazar.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Support Phone",
          "default": "+91 98765 43210"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "Contact Support"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Default Policy Page"
    }
  ]
}
{% endschema %}
