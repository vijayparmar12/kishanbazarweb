<link rel="stylesheet" href="{{ 'section-hero.css' | asset_url }}">
<script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>

<section class="home-hero-split" data-home-hero>
  <div class="home-hero-split__container">
    <!-- Left Side Banner (70% Width) -->
    <div class="home-hero-split__item home-hero-split__item--left">
      <a href="{{ section.settings.left_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Left Banner">
        {% if section.settings.left_image != blank %}
          {{
            section.settings.left_image
            | image_url: width: 1800
            | image_tag:
              class: 'home-hero-split__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1400, 1800'
          }}
        {% else %}
          <img
            class="home-hero-split__image"
            src="{{ 'hero-banner.jpg.png' | asset_url }}"
            alt="Kishan Bazar Organic Kitchen"
            width="1400"
            height="700"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </a>
    </div>

    <!-- Right Side Banner (30% Width) -->
    <div class="home-hero-split__item home-hero-split__item--right">
      <a href="{{ section.settings.right_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Right Banner">
        {% if section.settings.right_image != blank %}
          {{
            section.settings.right_image
            | image_url: width: 900
            | image_tag:
              class: 'home-hero-split__image',
              loading: 'eager',
              widths: '480, 750, 900'
          }}
        {% else %}
          <img
            class="home-hero-split__image"
            src="{{ 'hero-mobile.jpg.png' | asset_url }}"
            alt="Kishan Bazar Organic Products"
            width="600"
            height="700"
            loading="eager"
          >
        {% endif %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Left Banner (70% Width)"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image (70%)"
    },
    {
      "type": "url",
      "id": "left_link",
      "label": "Left Banner Link"
    },
    {
      "type": "header",
      "content": "Right Banner (30% Width)"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image (30%)"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Right Banner Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
