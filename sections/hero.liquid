<link rel="stylesheet" href="{{ 'section-hero.css' | asset_url }}">
<script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>

<section class="home-hero home-hero--{{ section.settings.text_alignment }}" data-home-hero>
  <div class="home-hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'home-hero__image home-hero__image--desktop',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1600, 2400'
      }}
    {% else %}
      <img
        class="home-hero__image home-hero__image--desktop"
        src="{{ 'hero-banner.jpg.png' | asset_url }}"
        alt="Fresh organic groceries from Kishan Bazar"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 900
        | image_tag:
          class: 'home-hero__image home-hero__image--mobile',
          loading: 'eager',
          widths: '480, 750, 900'
      }}
    {% else %}
      <img
        class="home-hero__image home-hero__image--mobile"
        src="{{ 'hero-mobile.jpg.png' | asset_url }}"
        alt="Fresh organic groceries from Kishan Bazar"
        width="900"
        height="1200"
        loading="eager"
      >
    {% endif %}
  </div>

  <div class="home-hero__shade home-hero__shade--{{ section.settings.overlay_opacity }}"></div>

  <div class="home-hero__content">
    <div>
      {% if section.settings.badge != blank %}
        <p class="home-hero__badge">{{ section.settings.badge }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="home-hero__text">{{ section.settings.subheading }}</div>
      {% endif %}

      <div class="home-hero__buttons">
        {% if section.settings.primary_label != blank %}
          {% render 'button', text: section.settings.primary_label, url: section.settings.primary_link, size: 'large' %}
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          {% render 'button', text: section.settings.secondary_label, url: section.settings.secondary_link, variant: 'outline', size: 'large' %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Grown with care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good food, from good soil."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Thoughtfully sourced pantry staples for your everyday table.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop essentials"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "select",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "medium", "label": "Medium" },
        { "value": "strong", "label": "Strong" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
