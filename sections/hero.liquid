<link rel="stylesheet" href="{{ 'section-hero.css' | asset_url }}">
<script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>

{% assign slide_blocks = section.blocks | where: 'type', 'slide' %}
{% if slide_blocks.size == 0 %}
  {% assign slide_blocks = section.blocks | where: 'type', 'right_top_slide' %}
{% endif %}

{% assign mobile_slides = section.blocks | where: 'type', 'mobile_hero_slide' %}
{% if mobile_slides.size == 0 %}
  {% assign mobile_slides = slide_blocks %}
{% endif %}

{% comment %} Mobile & Desktop Responsive LCP Image Preloading {% endcomment %}
{% assign first_mob_block = mobile_slides | first %}
{% assign first_mob_img = first_mob_block.settings.mobile_image | default: first_mob_block.settings.image | default: section.settings.left_image %}
{% if first_mob_img != blank %}
  <link rel="preload" as="image" href="{{ first_mob_img | image_url: width: 600 }}" imagesrcset="{{ first_mob_img | image_url: width: 360 }} 360w, {{ first_mob_img | image_url: width: 480 }} 480w, {{ first_mob_img | image_url: width: 600 }} 600w, {{ first_mob_img | image_url: width: 750 }} 750w" imagesizes="100vw" fetchpriority="high" media="(max-width: 768px)">
{% endif %}

{% assign first_desk_block = slide_blocks | first %}
{% assign first_desk_img = first_desk_block.settings.image | default: first_desk_block.settings.desktop_image %}
{% if first_desk_img != blank %}
  <link rel="preload" as="image" href="{{ first_desk_img | image_url: width: 1400 }}" imagesrcset="{{ first_desk_img | image_url: width: 1100 }} 1100w, {{ first_desk_img | image_url: width: 1400 }} 1400w, {{ first_desk_img | image_url: width: 1800 }} 1800w, {{ first_desk_img | image_url: width: 2200 }} 2200w" imagesizes="100vw" fetchpriority="high" media="(min-width: 769px)">
{% endif %}

<section class="home-hero-split" data-home-hero style="--hero-height-desktop: {{ section.settings.desktop_hero_height | default: 650 }}px; --container-width: {{ section.settings.desktop_max_width | default: 1920 }}px;">

  <!-- Wide Main Hero Banner (Full Width Desktop Auto Slider, Rounded Corners) -->
  <div class="home-hero-split__container">
    <div class="home-hero-split__item home-hero-split__item--main" data-hero-top-slider>
      <div class="home-hero-split__slider">
        {% if slide_blocks.size > 0 %}
          {% for block in slide_blocks %}
            {% assign desktop_img = block.settings.image | default: block.settings.desktop_image %}
            <div class="home-hero-split__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Slide {{ forloop.index }}">
                {% if desktop_img != blank %}
                  {% assign img_loading = 'lazy' %}
                  {% assign img_priority = 'auto' %}
                  {{
                    desktop_img
                    | image_url: width: 2200
                    | image_tag:
                      class: 'home-hero-split__image',
                      loading: img_loading,
                      fetchpriority: img_priority,
                      decoding: 'async',
                      widths: '750, 1100, 1400, 1800, 2200'
                  }}
                {% else %}
                  <img class="home-hero-split__image" src="{{ 'hero-banner.jpg.png' | asset_url }}" alt="Hero Slide {{ forloop.index }}" width="1400" height="700" loading="lazy" decoding="async">
                {% endif %}
              </a>
            </div>
          {% endfor %}
        {% else %}
          <!-- Default Fallback Desktop Slides if no blocks added -->
          <div class="home-hero-split__slide is-active" data-hero-slide>
            <a href="{{ section.settings.left_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Banner 1">
              {% if section.settings.left_image != blank %}
                {{ section.settings.left_image | image_url: width: 2200 | image_tag: class: 'home-hero-split__image', loading: 'lazy', decoding: 'async', widths: '750, 1100, 1400, 1800, 2200' }}
              {% else %}
                <img class="home-hero-split__image" src="{{ 'hero-banner.jpg.png' | asset_url }}" alt="Kishan Bazar Organic Kitchen" width="1400" height="700" loading="lazy" decoding="async">
              {% endif %}
            </a>
          </div>

          {% if section.settings.right_top_image != blank %}
            <div class="home-hero-split__slide" data-hero-slide>
              <a href="{{ section.settings.right_top_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Banner 2">
                {{ section.settings.right_top_image | image_url: width: 2200 | image_tag: class: 'home-hero-split__image', loading: 'lazy', widths: '750, 1100, 1400, 1800, 2200' }}
              </a>
            </div>
          {% endif %}

          {% if section.settings.right_top_image_2 != blank %}
            <div class="home-hero-split__slide" data-hero-slide>
              <a href="{{ section.settings.right_top_link_2 | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Banner 3">
                {{ section.settings.right_top_image_2 | image_url: width: 2200 | image_tag: class: 'home-hero-split__image', loading: 'lazy', widths: '750, 1100, 1400, 1800, 2200' }}
              </a>
            </div>
          {% endif %}

          {% if section.settings.right_top_image_3 != blank %}
            <div class="home-hero-split__slide" data-hero-slide>
              <a href="{{ section.settings.right_top_link_3 | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Banner 4">
                {{ section.settings.right_top_image_3 | image_url: width: 2200 | image_tag: class: 'home-hero-split__image', loading: 'lazy', widths: '750, 1100, 1400, 1800, 2200' }}
              </a>
            </div>
          {% endif %}

          {% if section.settings.right_bottom_image != blank %}
            <div class="home-hero-split__slide" data-hero-slide>
              <a href="{% if section.settings.right_bottom_link != blank %}{{ section.settings.right_bottom_link }}{% else %}/pages/our-story{% endif %}" class="home-hero-split__link" aria-label="Hero Banner 5">
                {{ section.settings.right_bottom_image | image_url: width: 2200 | image_tag: class: 'home-hero-split__image', loading: 'lazy', widths: '750, 1100, 1400, 1800, 2200' }}
              </a>
            </div>
          {% endif %}
        {% endif %}
      </div>

      <!-- Centered Bottom Dot Navigation Indicators -->
      <div class="home-hero-split__dots" role="tablist" aria-label="Desktop Wide Hero Slides">
        {% if slide_blocks.size > 0 %}
          {% for block in slide_blocks %}
            <button type="button" class="home-hero-split__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot data-hero-dot-index="{{ forloop.index0 }}" aria-label="Go to Slide {{ forloop.index }}" role="tab"></button>
          {% endfor %}
        {% else %}
          <button type="button" class="home-hero-split__dot is-active" data-hero-dot data-hero-dot-index="0" aria-label="Go to Slide 1" role="tab"></button>
          {% if section.settings.right_top_image != blank %}
            <button type="button" class="home-hero-split__dot" data-hero-dot data-hero-dot-index="1" aria-label="Go to Slide 2" role="tab"></button>
          {% endif %}
          {% if section.settings.right_top_image_2 != blank %}
            <button type="button" class="home-hero-split__dot" data-hero-dot data-hero-dot-index="2" aria-label="Go to Slide 3" role="tab"></button>
          {% endif %}
          {% if section.settings.right_top_image_3 != blank %}
            <button type="button" class="home-hero-split__dot" data-hero-dot data-hero-dot-index="3" aria-label="Go to Slide 4" role="tab"></button>
          {% endif %}
          {% if section.settings.right_bottom_image != blank %}
            <button type="button" class="home-hero-split__dot" data-hero-dot data-hero-dot-index="4" aria-label="Go to Slide 5" role="tab"></button>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Mobile Dedicated All-Image Auto-Play Slider (Mobile View Only) -->
  <div class="home-hero-split__mobile-slider" data-hero-mobile-slider style="--kb-mobile-hero-aspect: {{ section.settings.mobile_aspect_ratio | default: '3 / 2' }};">
    <div class="home-hero-split__mobile-slides-track">
      {% if mobile_slides.size > 0 %}
        {% for block in mobile_slides %}
          {% assign mob_img = block.settings.mobile_image | default: block.settings.image %}
          {% assign mob_loading = 'lazy' %}
          {% assign mob_priority = 'auto' %}
          {% if forloop.first %}
            {% assign mob_loading = 'eager' %}
            {% assign mob_priority = 'high' %}
          {% endif %}
          <div class="home-hero-split__mobile-slide{% if forloop.first %} is-active{% endif %}" data-hero-mobile-slide {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Mobile Hero Slide {{ forloop.index }}">
              {% if mob_img != blank %}
                {{
                  mob_img
                  | image_url: width: 750
                  | image_tag:
                    class: 'home-hero-split__image',
                    loading: mob_loading,
                    fetchpriority: mob_priority,
                    decoding: 'async',
                    widths: '360, 480, 600, 750, 900',
                    sizes: '100vw',
                    alt: 'Mobile Hero Slide ' | append: forloop.index
                }}
              {% elsif section.settings.left_image != blank and forloop.first %}
                {{
                  section.settings.left_image
                  | image_url: width: 750
                  | image_tag:
                    class: 'home-hero-split__image',
                    loading: mob_loading,
                    fetchpriority: mob_priority,
                    decoding: 'async',
                    widths: '360, 480, 600, 750, 900',
                    sizes: '100vw',
                    alt: 'Mobile Hero Slide 1'
                }}
              {% else %}
                <img class="home-hero-split__image" src="{{ 'hero-banner.jpg.png' | asset_url }}" alt="Mobile Banner {{ forloop.index }}" width="750" height="420" loading="{{ mob_loading }}" fetchpriority="{{ mob_priority }}" decoding="async">
              {% endif %}
            </a>
          </div>
        {% endfor %}
      {% else %}
        <!-- Mobile Slide Fallbacks -->
        <div class="home-hero-split__mobile-slide is-active" data-hero-mobile-slide>
          <a href="{{ section.settings.left_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Slide 1">
            {% if section.settings.left_image != blank %}
              {{ section.settings.left_image | image_url: width: 1000 | image_tag: class: 'home-hero-split__image', loading: 'lazy', decoding: 'async' }}
            {% else %}
              <img class="home-hero-split__image" src="{{ 'hero-banner.jpg.png' | asset_url }}" alt="Kishan Bazar Organic Kitchen" width="800" height="450" loading="lazy" decoding="async">
            {% endif %}
          </a>
        </div>
        {% if section.settings.right_top_image != blank %}
          <div class="home-hero-split__mobile-slide" data-hero-mobile-slide>
            <a href="{{ section.settings.right_top_link | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Slide 2">
              {{ section.settings.right_top_image | image_url: width: 1000 | image_tag: class: 'home-hero-split__image', loading: 'lazy' }}
            </a>
          </div>
        {% endif %}
        {% if section.settings.right_top_image_2 != blank %}
          <div class="home-hero-split__mobile-slide" data-hero-mobile-slide>
            <a href="{{ section.settings.right_top_link_2 | default: routes.all_products_collection_url }}" class="home-hero-split__link" aria-label="Hero Slide 3">
              {{ section.settings.right_top_image_2 | image_url: width: 1000 | image_tag: class: 'home-hero-split__image', loading: 'lazy' }}
            </a>
          </div>
        {% endif %}
      {% endif %}
    </div>

    <!-- Mobile Navigation Dots -->
    <div class="home-hero-split__mobile-dots" role="tablist" aria-label="Mobile Hero Slides">
      {% if mobile_slides.size > 0 %}
        {% for block in mobile_slides %}
          <button type="button" class="home-hero-split__mobile-dot{% if forloop.first %} is-active{% endif %}" data-hero-mobile-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      {% else %}
        <button type="button" class="home-hero-split__mobile-dot is-active" data-hero-mobile-dot="0" aria-label="Go to slide 1"></button>
        {% if section.settings.right_top_image != blank %}
          <button type="button" class="home-hero-split__mobile-dot" data-hero-mobile-dot="1" aria-label="Go to slide 2"></button>
        {% endif %}
        {% if section.settings.right_top_image_2 != blank %}
          <button type="button" class="home-hero-split__mobile-dot" data-hero-mobile-dot="2" aria-label="Go to slide 3"></button>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner Carousel Settings"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-play Speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "range",
      "id": "desktop_hero_height",
      "label": "Desktop Web View Banner Height (px)",
      "min": 400,
      "max": 900,
      "step": 10,
      "default": 650,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desktop_max_width",
      "label": "Desktop Banner Max Width (px)",
      "min": 1200,
      "max": 2000,
      "step": 10,
      "default": 1920,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile View Settings"
    },
    {
      "type": "select",
      "id": "mobile_aspect_ratio",
      "label": "Mobile Slide Aspect Ratio",
      "options": [
        { "value": "3 / 2", "label": "3:2 (Landscape Banner - Recommended)" },
        { "value": "1 / 1", "label": "1:1 (Square)" },
        { "value": "4 / 3", "label": "4:3 (Standard)" },
        { "value": "16 / 9", "label": "16:9 (Wide)" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "3 / 2"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Slide Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Slide Image (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        }
      ]
    },
    {
      "type": "right_top_slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        }
      ]
    },
    {
      "type": "mobile_hero_slide",
      "name": "Mobile Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Mobile Slide Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
