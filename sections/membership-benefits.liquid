{% doc %}
  Renders the Membership Benefits grid section.
{% enddoc %}

<section class="kb-membership-benefits" id="benefits" data-membership-benefits>
  <div class="kb-membership-benefits__container">
    <div class="kb-membership-section-header">
      <span class="eyebrow">MEMBER EXCLUSIVES</span>
      <h2 class="title">Why Join the Collective?</h2>
      <p class="subtitle">Enjoy uncompromised organic quality paired with unparalleled member privileges.</p>
    </div>

    <div class="kb-membership-benefits__grid">
      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">🏷️</span>
        </div>
        <h3 class="kb-benefit-card__title">Extra 10% Off Every Order</h3>
        <p class="kb-benefit-card__desc">Automatic savings applied on every single order with zero minimum spend required.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">🌾</span>
        </div>
        <h3 class="kb-benefit-card__title">Early Harvest Access</h3>
        <p class="kb-benefit-card__desc">Be first in line for limited seasonal batches like A2 Gir Bilona Ghee and Khapli Wheat Atta.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">🚚</span>
        </div>
        <h3 class="kb-benefit-card__title">Free Shipping Threshold</h3>
        <p class="kb-benefit-card__desc">Enjoy zero shipping fee on all orders above ₹499 delivered right to your doorstep.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">🎁</span>
        </div>
        <h3 class="kb-benefit-card__title">Surprise Birthday Gifts</h3>
        <p class="kb-benefit-card__desc">Receive a special complimentary organic gift box delivered on your birthday month.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">⚡</span>
        </div>
        <h3 class="kb-benefit-card__title">Flash Member Deals</h3>
        <p class="kb-benefit-card__desc">Unlock hidden discounts and buy-1-get-1 offers visible exclusively to active members.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">💎</span>
        </div>
        <h3 class="kb-benefit-card__title">2X Loyalty Rewards</h3>
        <p class="kb-benefit-card__desc">Earn double reward points on every purchase redeemable for cash discounts on future orders.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">📞</span>
        </div>
        <h3 class="kb-benefit-card__title">Priority Support Line</h3>
        <p class="kb-benefit-card__desc">Direct access to our dedicated customer care team for instant order tracking and assistance.</p>
      </div>

      <div class="kb-benefit-card">
        <div class="kb-benefit-card__icon-wrap">
          <span class="icon">🌱</span>
        </div>
        <h3 class="kb-benefit-card__title">Farm Tour Invitations</h3>
        <p class="kb-benefit-card__desc">Exclusive invitations to visit our organic gaushalas and sustainable farmland with your family.</p>
      </div>
    </div>
  </div>
</section>

