{{ 'cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<section class="kb-cart-page" data-main-cart data-cart-section-id="{{ section.id }}">
  <nav class="kb-cart-page__breadcrumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">/</span>
    <span class="kb-cart-page__breadcrumb-current">Shopping Cart</span>
  </nav>

  <header class="kb-cart-page__header">
    <div class="kb-cart-page__header-title-wrap">
      <h1 class="kb-cart-page__title">Shopping Cart</h1>
      <span class="kb-cart-page__count-badge">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
    </div>
    <p class="kb-cart-page__subtitle">Pure, farm-fresh organic staples delivered directly to your doorstep.</p>
  </header>

  {% if cart.item_count > 0 %}
    <div class="kb-cart-page__layout">
      <div class="kb-cart-page__items">
        {% for item in cart.items %}
          {% render 'cart-item', item: item, line_index: forloop.index %}
        {% endfor %}
      </div>

      <div class="kb-cart-page__summary">
        {% assign free_thresh = settings.cart_free_shipping_threshold | default: section.settings.free_shipping_threshold | default: 1499 %}
        {% render 'cart-summary', cart: cart, free_shipping_threshold: free_thresh, checkout_url: routes.checkout_url %}
      </div>
    </div>
  {% else %}
    <div class="kb-cart-page__empty">
      <div class="kb-cart-page__empty-card">
        <div class="kb-cart-empty__icon-circle">🛒</div>
        <h2>Your Cart is Empty</h2>
        <p>Discover pure, unadulterated organic staples handcrafted with traditional care.</p>
        <a class="kb-cart-empty__btn" href="{{ routes.collections_url }}">Start Shopping</a>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.main_cart.title",
  "settings": [
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 0,
      "max": 9900,
      "step": 100,
      "unit": "₹",
      "default": 5000
    }
  ]
}
{% endschema %}