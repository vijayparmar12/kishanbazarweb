{% doc %}
  Main Cart Section - Dedicated Cart Page with white background, sticky checkout summary,
  FBT directly after products with header arrows (no overlap), and mobile-responsive free shipping title.
{% enddoc %}

{{ 'cart.css' | asset_url | stylesheet_tag }}

{% liquid
  assign free_shipping_threshold_num = section.settings.cart_free_shipping_threshold | default: settings.cart_free_shipping_threshold | default: 1499
  assign shipping_fee_num = section.settings.cart_shipping_fee | default: settings.cart_shipping_fee | default: 99
  assign free_ship_val = free_shipping_threshold_num | times: 100
  assign checkout_label = section.settings.cart_checkout_btn_text | default: settings.cart_checkout_btn_text | default: 'Checkout'
  assign reward_1_threshold_num = section.settings.cart_reward_1_threshold | default: 699
  assign reward_2_threshold_num = section.settings.cart_reward_2_threshold | default: 999
  assign reward_3_threshold_num = section.settings.cart_reward_3_threshold | default: free_shipping_threshold_num
  assign reward_1_threshold = reward_1_threshold_num | times: 100
  assign reward_2_threshold = reward_2_threshold_num | times: 100
  assign reward_3_threshold = reward_3_threshold_num | times: 100

  # Dynamic Free Gift Product Lookup
  assign gift_product = nil
  if section.settings.free_gift_product != blank
    assign setting_val = section.settings.free_gift_product
    if setting_val.title != blank and setting_val.id != blank
      assign gift_product = setting_val
    elsif all_products[setting_val] != blank and all_products[setting_val].id != blank
      assign gift_product = all_products[setting_val]
    endif
  endif

  if gift_product == blank or gift_product.id == blank
    assign possible_handles = 'free-gift,free-gift-1,free-gift-worth-149,free-gift-worth-rs-149,free-gift-product,free-gift-item,free-sample,gift' | split: ','
    for h in possible_handles
      if all_products[h] != blank and all_products[h].id != blank
        assign gift_product = all_products[h]
        break
      endif
    endfor
  endif

  if gift_product == blank or gift_product.id == blank
    for p in collections['all'].products
      assign p_title_down = p.title | downcase
      if p_title_down contains 'free gift' or p.handle contains 'free-gift' or p.handle contains 'gift'
        assign gift_product = p
        break
      endif
    endfor
  endif

  if gift_product == blank or gift_product.id == blank
    for col in collections
      for p in col.products
        assign p_title_down = p.title | downcase
        if p_title_down contains 'free gift' or p.handle contains 'free-gift' or p.handle contains 'gift'
          assign gift_product = p
          break
        endif
      endfor
      if gift_product != blank and gift_product.id != blank
        break
      endif
    endfor
  endif

  assign gift_variant_id = ''
  if gift_product != blank
    if gift_product.selected_or_first_available_variant != blank and gift_product.selected_or_first_available_variant.id != blank
      assign gift_variant_id = gift_product.selected_or_first_available_variant.id
    elsif gift_product.variants.first != blank and gift_product.variants.first.id != blank
      assign gift_variant_id = gift_product.variants.first.id
    elsif gift_product.variants[0] != blank
      assign gift_variant_id = gift_product.variants[0].id
    endif
  endif

  assign cart_rewards_fill_pct = 0
  if cart.total_price < reward_1_threshold
    assign cart_rewards_fill_pct = 0
  elsif cart.total_price < reward_2_threshold
    assign diff_range = reward_2_threshold | minus: reward_1_threshold
    if diff_range > 0
      assign current_offset = cart.total_price | minus: reward_1_threshold
      assign seg_pct = current_offset | times: 50 | divided_by: diff_range
      assign cart_rewards_fill_pct = seg_pct
    else
      assign cart_rewards_fill_pct = 50
    endif
  elsif cart.total_price < reward_3_threshold
    assign diff_range = reward_3_threshold | minus: reward_2_threshold
    if diff_range > 0
      assign current_offset = cart.total_price | minus: reward_2_threshold
      assign seg_pct = current_offset | times: 50 | divided_by: diff_range
      assign cart_rewards_fill_pct = 50 | plus: seg_pct
    else
      assign cart_rewards_fill_pct = 100
    endif
  else
    assign cart_rewards_fill_pct = 100
  endif
  assign cart_rewards_status = section.settings.cart_rewards_complete_text | default: 'Hurray! You have unlocked all cart rewards'
  if cart.total_price < reward_1_threshold
    assign cart_rewards_remaining = reward_1_threshold | minus: cart.total_price
    capture cart_rewards_status
      echo 'Add '
      echo cart_rewards_remaining | money
      echo ' more to unlock '
      echo section.settings.cart_reward_1_title | default: 'Free Gift'
    endcapture
  elsif cart.total_price < reward_2_threshold
    assign cart_rewards_remaining = reward_2_threshold | minus: cart.total_price
    capture cart_rewards_status
      echo 'Add '
      echo cart_rewards_remaining | money
      echo ' more to unlock '
      echo section.settings.cart_reward_2_title | default: 'Free Delivery'
    endcapture
  elsif cart.total_price < reward_3_threshold
    assign cart_rewards_remaining = reward_3_threshold | minus: cart.total_price
    capture cart_rewards_status
      echo 'Add '
      echo cart_rewards_remaining | money
      echo ' more to unlock '
      echo section.settings.cart_reward_3_title | default: '10% OFF'
    endcapture
  endif

  assign cart_has_free_gift = false
  assign subtotal_no_gift = 0
  assign cart_original_price = 0
  for item in cart.items
    assign item_title_down = item.product.title | downcase
    assign item_handle_down = item.url | split: '/products/' | last | split: '?' | first | downcase
    if item_handle_down contains 'free-gift' or item_title_down contains 'free gift' or item.properties['_is_free_gift'] == 'true' or item.variant.id == gift_variant_id
      assign cart_has_free_gift = true
    else
      assign subtotal_no_gift = subtotal_no_gift | plus: item.final_line_price
    endif

    if item.variant.compare_at_price > item.variant.price
      assign item_unit_compare = item.variant.compare_at_price
    elsif item.original_line_price > item.final_line_price
      assign item_unit_compare = item.original_line_price | divided_by: item.quantity
    else
      assign item_unit_compare = item.final_price
    endif
    assign line_orig = item_unit_compare | times: item.quantity
    assign cart_original_price = cart_original_price | plus: line_orig
  endfor

  assign is_free_gift_unlocked = false
  if subtotal_no_gift >= reward_1_threshold or cart.total_price >= reward_1_threshold
    assign is_free_gift_unlocked = true
  endif

  if cart_original_price <= cart.total_price and cart.original_total_price > cart.total_price
    assign cart_original_price = cart.original_total_price
  endif

  assign total_saved = cart_original_price | minus: cart.total_price
  if total_saved < 0
    assign total_saved = 0
  endif

  assign is_design_mode = request.design_mode
  assign display_item_count = cart.item_count
  if is_design_mode and cart.item_count == 0
    assign display_item_count = 2
  endif
%}

<div class="kb-cart-page-wrapper" style="position: relative; min-height: 100vh; padding: 1.25rem 0.85rem 4rem; background: #faf8f5;">
  <div class="kb-cart-page-container" style="max-width: 700px; margin: 0 auto;" data-main-cart data-cart-section-id="{{ section.id }}" data-free-shipping-threshold="{{ free_ship_val }}" data-shipping-fee="{{ shipping_fee_num | times: 100 }}" data-shipping-fee-variant-id="{{ settings.cart_shipping_fee_variant_id | escape }}" data-reward1-threshold="{{ reward_1_threshold }}" data-free-gift-variant-id="{{ gift_variant_id }}">

    <!-- YOUR CART (X) HEADER WITH CROSS ICON -->
    <div class="kb-cart-page-header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; background: #ffffff; padding: 0.85rem 1.25rem; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.04); border: 1px solid rgba(35, 66, 31, 0.08);">
      <h1 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #132d14; text-transform: uppercase; letter-spacing: 0.03em;">
        YOUR CART ({{ display_item_count }})
      </h1>
      <a href="javascript:void(0)" onclick="if(history.length > 1) { history.back(); } else { window.location.href = '/collections/all'; }" class="kb-cart-header-close-btn" aria-label="Close cart" style="width: 34px; height: 34px; border-radius: 50%; background: #f1f5f9; color: #334155; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: background 150ms ease;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </a>
    </div>

    {% if cart.item_count > 0 or is_design_mode %}
      <div class="kb-cart-page-card" style="background: #ffffff; border-radius: 20px; padding: 1.25rem; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06); border: 1px solid rgba(35, 66, 31, 0.1); display: flex; flex-direction: column; gap: 1.25rem; position: relative;">

        <!-- CART REWARDS LADDER -->
        <div
          class="kb-cart-drawer__progress kb-cart-rewards"
          data-cart-drawer-progress
          data-cart-rewards
          data-complete-message="{{ section.settings.cart_rewards_complete_text | default: 'Hurray! You have unlocked all cart rewards' | escape }}"
          style="--cart-rewards-progress: {{ cart_rewards_fill_pct }}%; --cart-rewards-accent: {{ section.settings.cart_rewards_accent | default: '#166534' }}; --cart-rewards-bg: {{ section.settings.cart_rewards_bg | default: '#f0fdf4' }}; --cart-rewards-border: {{ section.settings.cart_rewards_border | default: '#bbf7d0' }};"
        >
          <p class="kb-cart-drawer__promo-copy kb-cart-rewards__status" data-cart-drawer-status>
            {{ cart_rewards_status | strip }}
          </p>

          <div class="kb-cart-rewards__rail" aria-hidden="true">
            <span class="kb-cart-drawer__progress-fill kb-cart-rewards__fill"></span>
          </div>

          <div class="kb-cart-rewards__steps">
            {% liquid
              assign reward_1_title = section.settings.cart_reward_1_title | default: 'Get Free Gift'
              assign reward_1_subtitle = section.settings.cart_reward_1_subtitle | default: 'worth Rs.149'
              assign reward_1_icon = section.settings.cart_reward_1_icon | default: 'gift'
            %}
            <div class="kb-cart-rewards__step{% if cart.total_price >= reward_1_threshold %} is-active{% endif %}" data-cart-reward-step data-threshold="{{ reward_1_threshold }}" data-title="{{ reward_1_title | escape }}">
              <div class="kb-cart-rewards__icon">
                {% case reward_1_icon %}
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="14" height="11" rx="2"/><path d="M15 8h4l3 3v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% when 'percent' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                  {% when 'combo' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 4.8 5.3.8-3.8 3.7.9 5.3-4.8-2.5-4.8 2.5.9-5.3-3.8-3.7 5.3-.8L12 2z"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M12 8v12"/><path d="M3 12h18"/><path d="M12 8H7.5a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8z"/><path d="M12 8h4.5a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8z"/></svg>
                {% endcase %}
              </div>
              <span class="kb-cart-rewards__amount" data-cart-reward-amount>{{ reward_1_threshold | money_without_trailing_zeros }}</span>
              <span class="kb-cart-rewards__title">{{ reward_1_title }}</span>
              <span class="kb-cart-rewards__subtitle">{{ reward_1_subtitle }}</span>
            </div>

            {% liquid
              assign reward_2_title = section.settings.cart_reward_2_title | default: 'Free Delivery'
              assign reward_2_subtitle = section.settings.cart_reward_2_subtitle | default: '+ Free Gift'
              assign reward_2_icon = section.settings.cart_reward_2_icon | default: 'truck'
            %}
            <div class="kb-cart-rewards__step{% if cart.total_price >= reward_2_threshold %} is-active{% endif %}" data-cart-reward-step data-threshold="{{ reward_2_threshold }}" data-title="{{ reward_2_title | escape }}">
              <div class="kb-cart-rewards__icon">
                {% case reward_2_icon %}
                  {% when 'gift' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M12 8v12"/><path d="M3 12h18"/><path d="M12 8H7.5a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8z"/><path d="M12 8h4.5a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8z"/></svg>
                  {% when 'percent' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                  {% when 'combo' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 4.8 5.3.8-3.8 3.7.9 5.3-4.8-2.5-4.8 2.5.9-5.3-3.8-3.7 5.3-.8L12 2z"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="14" height="11" rx="2"/><path d="M15 8h4l3 3v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {% endcase %}
              </div>
              <span class="kb-cart-rewards__amount" data-cart-reward-amount>{{ reward_2_threshold | money_without_trailing_zeros }}</span>
              <span class="kb-cart-rewards__title">{{ reward_2_title }}</span>
              <span class="kb-cart-rewards__subtitle">{{ reward_2_subtitle }}</span>
            </div>

            {% liquid
              assign reward_3_title = section.settings.cart_reward_3_title | default: 'Free Gift + Free Delivery'
              assign reward_3_subtitle = section.settings.cart_reward_3_subtitle | default: '+ 10% OFF'
              assign reward_3_icon = section.settings.cart_reward_3_icon | default: 'combo'
            %}
            <div class="kb-cart-rewards__step{% if cart.total_price >= reward_3_threshold %} is-active{% endif %}" data-cart-reward-step data-threshold="{{ reward_3_threshold }}" data-title="{{ reward_3_title | escape }}">
              <div class="kb-cart-rewards__icon">
                {% case reward_3_icon %}
                  {% when 'gift' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M12 8v12"/><path d="M3 12h18"/><path d="M12 8H7.5a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8z"/><path d="M12 8h4.5a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8z"/></svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="14" height="11" rx="2"/><path d="M15 8h4l3 3v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {% when 'percent' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 5L5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 4.8 5.3.8-3.8 3.7.9 5.3-4.8-2.5-4.8 2.5.9-5.3-3.8-3.7 5.3-.8L12 2z"/><circle cx="12" cy="12" r="3.5" fill="currentColor"/></svg>
                {% endcase %}
              </div>
              <span class="kb-cart-rewards__amount" data-cart-reward-amount>{{ reward_3_threshold | money_without_trailing_zeros }}</span>
              <span class="kb-cart-rewards__title">{{ reward_3_title }}</span>
              <span class="kb-cart-rewards__subtitle">{{ reward_3_subtitle }}</span>
            </div>
          </div>
        </div>

        {% comment %} Legacy free shipping progress kept only for reference.
        <!-- FREE SHIPPING PROGRESS BANNER (Mobile Reduced Size, Fully Displayed) -->
        <div class="kb-cart-drawer__progress" data-cart-drawer-progress style="background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 14px; padding: 0.85rem 1rem; margin: 0;">
          <p class="kb-cart-drawer__promo-copy" data-cart-drawer-status style="font-weight: 800; color: #166534; margin: 0 0 0.5rem 0; font-size: 0.78rem; text-align: center; line-height: 1.3;">
            {% if cart.total_price >= free_ship_val or is_design_mode %}
              Hurray! You've unlocked FREE Shipping
            {% else %}
              {% assign remaining_ship = free_ship_val | minus: cart.total_price %}
              Add {{ remaining_ship | money }} more for FREE Shipping
            {% endif %}
          </p>

          <div class="kb-cart-drawer__progress-track-wrap">
            <div class="kb-cart-drawer__progress-track" style="height: 8px; background: #dcfce7; border-radius: 10px; position: relative; overflow: visible;">
              {% liquid
                if cart.total_price >= free_ship_val or is_design_mode
                  assign fill_pct = 100
                elsif free_ship_val > 0
                  assign fill_pct = cart.total_price | times: 100 | divided_by: free_ship_val
                else
                  assign fill_pct = 100
                endif
              %}
              <span class="kb-cart-drawer__progress-fill" style="display: block; height: 100%; background: #166534; border-radius: 10px; width: {{ fill_pct }}%; transition: width 300ms ease;"></span>

              <div class="kb-cart-drawer__marker kb-cart-drawer__marker--1 kb-cart-drawer__progress-marker--1 is-active" style="position: absolute; right: 0; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center;">
                <span class="kb-cart-drawer__marker-top" style="font-size: 0.72rem; font-weight: 800; color: #166534; margin-bottom: 2px;">₹{{ free_shipping_threshold_num }}</span>
                <div class="kb-cart-drawer__marker-box" style="width: 24px; height: 24px; border-radius: 50%; background: #166534; color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(22, 101, 52, 0.3);">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13" rx="2" ry="2"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </div>
                <span class="kb-cart-drawer__marker-bottom" style="font-size: 0.62rem; font-weight: 800; color: #166534; text-transform: uppercase; margin-top: 2px;">FREE SHIPPING</span>
              </div>
            </div>
          </div>
        </div>

        {% endcomment %}

        <!-- CART ITEMS LIST -->
        <div class="kb-cart-page-items-list" data-cart-drawer-items style="display: flex; flex-direction: column; gap: 1rem;">
          {% for item in cart.items %}
            {% render 'cart-item', item: item, line_index: forloop.index, compact: false %}
          {% else %}
            {% comment %} Demo preview items for Theme Editor {% endcomment %}
            <article class="kb-cart-item" style="display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 12px; background: #faf8f5; border-radius: 14px; border: 1px solid rgba(35,66,31,0.08);">
              <div style="width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: #fff;">
                {{ 'product-1' | placeholder_svg_tag: 'kb-cart-item__placeholder' }}
              </div>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                  <h3 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #132d14;">Khapli Atta (खपली आटा)</h3>
                </div>
                <div><span style="font-size: 0.8rem; padding: 2px 8px; background: #e2e8f0; border-radius: 6px; font-weight: 700;">1 kg</span></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <strong style="font-size: 1rem; color: #166534; font-weight: 800;">₹215.00</strong>
                  <s style="font-size: 0.82rem; color: #94a3b8;">₹250.00</s>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 4px;">
                  <div style="display: flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 8px; padding: 2px 8px; background: #fff;">
                    <span style="font-weight: 800; margin: 0 10px;">- 1 +</span>
                  </div>
                </div>
              </div>
            </article>

            <article class="kb-cart-item" style="display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 12px; background: #faf8f5; border-radius: 14px; border: 1px solid rgba(35,66,31,0.08);">
              <div style="width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: #fff;">
                {{ 'product-2' | placeholder_svg_tag: 'kb-cart-item__placeholder' }}
              </div>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                  <h3 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #132d14;">A2 Desi Cow Bilona Ghee</h3>
                </div>
                <div><span style="font-size: 0.8rem; padding: 2px 8px; background: #e2e8f0; border-radius: 6px; font-weight: 700;">500 ml</span></div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <strong style="font-size: 1rem; color: #166534; font-weight: 800;">₹1,485.00</strong>
                  <s style="font-size: 0.82rem; color: #94a3b8;">₹1,710.00</s>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 4px;">
                  <div style="display: flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 8px; padding: 2px 8px; background: #fff;">
                    <span style="font-weight: 800; margin: 0 10px;">- 1 +</span>
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}

          {% comment %} Guarantee Free Gift display in cart items list when subtotal >= ₹699 {% endcomment %}
          {% if is_free_gift_unlocked and cart_has_free_gift == false and gift_product != blank %}
            <article class="kb-cart-item kb-cart-item--free-gift" data-cart-line-item data-free-gift-injected="true" style="display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 12px; background: #f0fdf4; border-radius: 14px; border: 1.5px solid #bbf7d0;">
              <div class="kb-cart-item__media-wrap" style="width: 80px; height: 80px; border-radius: 10px; overflow: hidden; background: #fff;">
                {% if gift_product.featured_image != blank %}
                  <img class="kb-cart-item__image" src="{{ gift_product.featured_image | image_url: width: 200 }}" alt="{{ gift_product.title | escape }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'kb-cart-item__placeholder' }}
                {% endif %}
              </div>
              <div class="kb-cart-item__content" style="display: flex; flex-direction: column; gap: 4px; position: relative;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                  <h3 style="margin: 0; font-size: 0.95rem; font-weight: 800; color: #132d14; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                    <a href="{{ gift_product.url }}">{{ gift_product.title }}</a>
                    <span class="kb-free-gift-badge" style="background: #166534; color: #ffffff; font-size: 0.62rem; font-weight: 800; padding: 2px 7px; border-radius: 4px; text-transform: uppercase;">FREE GIFT</span>
                  </h3>
                </div>
                <div style="margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 15px; font-weight: 900; color: #166534;">FREE</span>
                  <s style="font-size: 12px; color: #94a3b8; text-decoration: line-through;">{{ gift_product.price | default: 14900 | money }}</s>
                </div>
                <div>
                  <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; background-color: #ffffff; border: 1px solid #bbf7d0; font-size: 12px; font-weight: 800; color: #166534;">
                    Qty: 1 (FREE GIFT)
                  </span>
                </div>
              </div>
            </article>
          {% endif %}
        </div>

        <!-- COUPONS & OFFERS SECTION (Above Frequently Bought Together) -->
        {% assign featured_code = section.settings.featured_coupon_code | default: settings.featured_coupon_code | default: 'Kveda_10%' %}
        {% assign featured_badge = section.settings.featured_coupon_badge | default: '10% OFF' %}
        {% assign featured_desc = section.settings.featured_coupon_description | default: '10% OFF on all products (Min. purchase ₹1,499)' %}

        <div class="kb-cart-coupons-block" style="margin-top: 0.5rem; background: #fbfdfa; border: 1.5px solid #bbf7d0; border-radius: 14px; padding: 0.85rem 1rem; box-shadow: 0 4px 14px rgba(22, 101, 52, 0.05);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem;">
            <div style="font-weight: 800; font-size: 0.95rem; color: #166534; display: flex; align-items: center; gap: 6px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span>Coupons & Offers</span>
            </div>
          </div>

          <!-- Featured Active Coupon Card from Shopify Admin -->
          <div class="kb-coupon-featured-card" data-coupon-card="{{ featured_code | escape }}" style="display: flex; align-items: center; justify-content: space-between; background: #ffffff; border: 1.5px dashed #166534; border-radius: 10px; padding: 0.65rem 0.85rem; margin-bottom: 0.65rem;">
            <div style="display: flex; flex-direction: column; gap: 2px; text-align: left; min-width: 0; padding-right: 8px;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <span class="kb-coupon-code" style="font-weight: 900; color: #166534; font-size: 0.95rem; letter-spacing: 0.03em;">{{ featured_code }}</span>
                <span style="background: #dcfce7; color: #166534; font-size: 0.62rem; font-weight: 800; padding: 1px 6px; border-radius: 4px; text-transform: uppercase;">{{ featured_badge }}</span>
              </div>
              <div style="font-size: 0.75rem; font-weight: 600; color: #475569;">{{ featured_desc }}</div>
            </div>
            <button type="button" class="kb-coupon-apply-btn" data-apply-coupon-code="{{ featured_code | escape }}" style="background: #166534; color: #ffffff; border: none; padding: 0.45rem 0.95rem; border-radius: 8px; font-weight: 800; font-size: 0.82rem; cursor: pointer; flex-shrink: 0; transition: background 150ms ease;">
              APPLY
            </button>
          </div>

          <!-- Custom Coupon Input Row -->
          <div class="kb-coupon-input-wrap" style="display: flex; align-items: center; gap: 8px;">
            <input 
              type="text" 
              class="kb-coupon-custom-input" 
              data-custom-coupon-input 
              placeholder="Have a coupon code?" 
              style="flex: 1; height: 38px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem; font-weight: 700; color: #1e293b; background: #ffffff; outline: none; text-transform: uppercase;"
            >
            <button type="button" class="kb-coupon-custom-apply-btn" data-apply-custom-coupon style="height: 38px; padding: 0 1.1rem; background: #1b4317; color: #ffffff; border: none; border-radius: 8px; font-weight: 800; font-size: 0.82rem; cursor: pointer; text-transform: uppercase;">
              APPLY
            </button>
          </div>

          <!-- Error / Warning Message Box (Hidden by default) -->
          <div class="kb-coupon-message" data-coupon-message style="display: none; margin-top: 0.5rem; padding: 0.45rem 0.75rem; border-radius: 8px; background: #fef2f2; border: 1px solid #fca5a5; font-size: 0.78rem; font-weight: 700; color: #dc2626;"></div>

          <!-- Applied Coupon Banner (Hidden by default) -->
          <div class="kb-applied-coupon-status" data-applied-coupon-status style="display: none; margin-top: 0.65rem; background: #dcfce7; border: 1px solid #86efac; border-radius: 8px; padding: 0.5rem 0.85rem; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 800; color: #166534; flex-wrap: wrap;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Coupon <strong data-applied-coupon-name>{{ featured_code }}</strong> Applied!</span>
              <span data-applied-coupon-savings style="color: #15803d; font-weight: 700; font-size: 0.78rem; margin-left: 2px;"></span>
            </div>
            <button type="button" data-remove-coupon style="background: none; border: none; font-size: 0.75rem; font-weight: 800; color: #ef4444; cursor: pointer; text-decoration: underline; padding: 0;">Remove</button>
          </div>
        </div>

        <!-- FREQUENTLY BOUGHT TOGETHER (FBT) - Header Navigation Arrows (No Button Overlap) -->
        <div class="kb-cart-drawer__addons-block" style="margin-top: 0.5rem; background: transparent; padding: 0.5rem 0; border: none; position: relative;">
          <div style="font-weight: 800; font-size: 0.95rem; color: #166534; margin-bottom: 0.75rem;">Frequently Bought Together</div>
          <div class="kb-cart-tab-panel is-active" data-tab-panel="frequently">
            <div class="kb-cart-addons-track">
              {% assign addons_coll = collections['all'].products %}
              {% if addons_coll == blank or addons_coll.size == 0 %}
                {% for c in collections %}
                  {% if c.products.size > 0 %}
                    {% assign addons_coll = c.products %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {% assign cart_handles = cart.items | map: 'product' | map: 'handle' %}
              {% assign fbt_count = 0 %}
              {% for product in addons_coll %}
                {% if cart_handles contains product.handle %}
                  {% continue %}
                {% endif %}
                {% assign fbt_count = fbt_count | plus: 1 %}
                <div
                  class="kb-cart-addon-card"
                  data-fbt-card
                  data-product-handle="{{ product.handle }}"
                  data-variants-count="{{ product.variants.size }}"
                  data-add-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  data-product-title="{{ product.title | escape }}"
                >
                  <div class="kb-cart-addon-top-row">
                    {% if product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" class="kb-cart-addon-img" width="64" height="64" loading="lazy">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'kb-cart-addon-img' }}
                    {% endif %}
                    <div class="kb-cart-addon-info-meta">
                      <div class="kb-cart-addon-title">{{ product.title }}</div>
                      <div class="kb-cart-addon-price">
                        <span class="kb-cart-addon-current">{{ product.price | money }}</span>
                        {% if product.compare_at_price > product.price %}
                          <s class="kb-cart-addon-compare">{{ product.compare_at_price | money }}</s>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                  <button
                    type="button"
                    class="kb-cart-addon-add-btn"
                    data-add-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-product-handle="{{ product.handle }}"
                    data-product-title="{{ product.title | escape }}"
                    data-variants-count="{{ product.variants.size }}"
                  >
                    + ADD
                  </button>
                </div>
                {% if fbt_count >= 6 %}
                  {% break %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- STICKY SUMMARY FOOTER (Savings Ribbon + Estimated Total + Checkout Button) -->
        {% liquid
          assign display_savings = total_saved
          if is_design_mode and display_savings <= 0
            assign display_savings = 26000
          endif

          assign is_free_shipping = false
          if cart.total_price >= free_ship_val or is_design_mode
            assign is_free_shipping = true
          endif

          assign current_shipping_fee = 0
          unless is_free_shipping
            assign current_shipping_fee = shipping_fee_num | times: 100
          endunless

          assign final_estimated_total = cart.total_price | plus: current_shipping_fee
          assign final_original_total = cart_original_price | plus: current_shipping_fee
        %}
        <div class="kb-cart-page-sticky-summary" data-cart-summary-box data-cart-total-price="{{ cart.total_price }}" data-cart-original-price="{{ cart_original_price }}" data-cart-shipping-fee="{{ current_shipping_fee }}" data-cart-total-saved="{{ total_saved }}" style="position: sticky; bottom: 0; background: #ffffff; padding: 0.45rem 0 0.15rem 0; z-index: 10; border-top: 1px solid rgba(35, 66, 31, 0.08); display: flex; flex-direction: column; gap: 0.45rem; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; box-shadow: 0 -10px 25px rgba(255,255,255,0.95);">

          <!-- SLEEK GREEN SAVINGS PILL -->
          <div class="kb-cart-savings-ribbon-wrap" style="width: 100%;">
            <div class="kb-cart-savings-ribbon" data-cart-savings-ribbon style="background: #1b4317; color: #ffffff; border-radius: 8px; padding: 0.38rem 0.75rem; text-align: center; font-weight: 700; font-size: 0.82rem; letter-spacing: 0.01em; {% if display_savings <= 0 %}display: none;{% else %}display: flex; align-items: center; justify-content: center; gap: 4px;{% endif %}">
              <span>🎉 <strong data-cart-total-saved-amount>{% if display_savings > 0 %}{{ display_savings | money }}{% else %}₹260.00{% endif %}</strong> Saved so far!</span>
            </div>
          </div>

          <!-- COMPACT ESTIMATED TOTAL BOX -->
          <div class="kb-cart-estimated-total-box" style="border: 1px solid rgba(35, 66, 31, 0.14); border-radius: 10px; padding: 0.45rem 0.75rem; display: flex; align-items: center; justify-content: space-between; background: #f8fafc;">
            <div style="display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1px;">
              <div style="display: flex; align-items: center; gap: 7px;">
                <div style="width: 22px; height: 22px; border-radius: 6px; background: #1b4317; color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 0.75rem; flex-shrink: 0;">₹</div>
                <strong style="font-size: 0.86rem; color: #334155; font-weight: 700;">Estimated Total</strong>
              </div>
              <span data-cart-shipping-note style="font-size: 0.70rem; color: #64748b; font-weight: 600; padding-left: 29px;">
                {% if is_free_shipping %}
                  (Includes Free Shipping)
                {% else %}
                  (Includes {{ current_shipping_fee | money }} Shipping)
                {% endif %}
              </span>
            </div>
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 1px;">
              <!-- 1. Selling Price First (Top Row) -->
              <strong data-cart-drawer-subtotal style="font-size: 1.02rem; color: #1b4317; font-weight: 900; line-height: 1.2; display: block;">
                {% if cart.total_price > 0 %}{{ final_estimated_total | money }}{% else %}₹1,799.00{% endif %}
              </strong>
              <!-- 2. Crossed-Out Original Price Below Row -->
              <s data-cart-drawer-original-total style="font-size: 0.78rem; color: #94a3b8; font-weight: 500; text-decoration: line-through; line-height: 1.2; {% if display_savings <= 0 %}display: none;{% else %}display: block;{% endif %}">
                {% if cart_original_price > 0 %}{{ final_original_total | money }}{% else %}₹2,059.00{% endif %}
              </s>
            </div>
          </div>

          <!-- REFINED CHECKOUT BUTTON -->
          <form action="{{ routes.cart_url }}" method="post" id="cart-page-checkout-form" style="width: 100%;">
            <input type="hidden" name="attributes[Shipping Charge]" value="{% if is_free_shipping %}Free Shipping{% else %}{{ current_shipping_fee | money }}{% endif %}">
            <input type="hidden" name="attributes[Estimated Total]" value="{{ final_estimated_total | money }}">
            <input type="hidden" name="discount" id="cart-discount-input" value="">
            <button type="submit" name="checkout" style="width: 100%; border: none; cursor: pointer; background: #1b4317; color: #ffffff; border-radius: 10px; padding: 0.65rem 1rem; text-align: center; box-shadow: 0 4px 14px rgba(27, 67, 23, 0.25); transition: background-color 200ms ease;">
              <div style="font-size: 0.95rem; font-weight: 900; letter-spacing: 0.03em; text-transform: uppercase;">{{ checkout_label }}</div>
              <div style="font-size: 0.7rem; font-weight: 500; opacity: 0.9; margin-top: 1px;">Free Shipping on Orders Above ₹{{ free_shipping_threshold_num }}</div>
            </button>
          </form>

        </div>

      </div>
    {% else %}
      <!-- EMPTY CART CARD -->
      <div class="kb-cart-page__empty-card" style="text-align: center; padding: 4rem 2rem; background: #ffffff; border-radius: 20px; border: 1px solid rgba(35, 66, 31, 0.1); box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);">
        <h2 style="font-size: 1.6rem; color: #132d14; margin-bottom: 0.5rem; font-weight: 800;">Your Cart is Empty</h2>
        <p style="color: #64748b; margin-bottom: 1.5rem;">Explore our natural organic products and add items to your cart.</p>
        <a href="/collections/all" style="display: inline-block; background: #1b4317; color: #ffffff; padding: 0.85rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; text-transform: uppercase; letter-spacing: 0.04em;">Start Shopping</a>
      </div>
    {% endif %}
  </div>
</div>

<!-- Inline Modals for Choose Option & Coupons -->
<aside class="kb-choose-option-modal" id="ChooseOptionModalCartPage" hidden data-choose-option-modal style="z-index: 9999999;">
  <div class="kb-choose-option-modal__backdrop" data-close-choose-option></div>
  <div class="kb-choose-option-modal__container">
    <div class="kb-choose-option-modal__header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <button type="button" class="kb-choose-option-modal__back" data-close-choose-option aria-label="Back" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #1e293b;">&larr;</button>
        <div>
          <div class="kb-choose-option-modal__product-title" data-choose-product-title style="font-size: 0.78rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px;">Product</div>
          <h3 style="margin: 0; font-size: 1.15rem; color: #1e293b; font-weight: 800;">Choose Option</h3>
        </div>
      </div>
      <button type="button" class="kb-choose-option-modal__close" data-close-choose-option aria-label="Close modal" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>
    <div class="kb-choose-option-modal__body" data-choose-options-list style="padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.85rem; max-height: 55vh; overflow-y: auto;"></div>
    <div class="kb-choose-option-modal__footer" style="padding: 0.75rem 1rem 1.25rem;">
      <button type="button" class="kb-choose-option-modal__confirm-btn" data-confirm-choose-option style="width: 100%; height: 48px; background: #166534; color: #ffffff; border: none; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center;">Done</button>
    </div>
  </div>
</aside>

<aside class="kb-coupons-modal" id="CouponsModalCartPage" hidden data-coupons-modal style="z-index: 9999999;">
  <div class="kb-coupons-modal__backdrop" data-close-coupons-modal></div>
  <div class="kb-coupons-modal__container">
    <div class="kb-coupons-modal__header">
      <h3 style="margin: 0; font-size: 1.1rem; color: #23421f; font-weight: 800;">Available Coupons & Offers</h3>
      <button type="button" class="kb-coupons-modal__close" data-close-coupons-modal aria-label="Close modal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>
    <div class="kb-coupons-modal__body" style="padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.85rem; max-height: 60vh; overflow-y: auto;">
      <div class="kb-coupon-item" style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1.5px dashed #23421f; border-radius: 12px; background: #fbfdfa;">
        <div class="kb-coupon-item__info">
          <div class="kb-coupon-item__code" style="font-weight: 900; color: #23421f; font-size: 1rem;">KB10</div>
          <div class="kb-coupon-item__title" style="font-weight: 700; color: #1e293b; font-size: 0.88rem; margin-top: 2px;">Flat 10% OFF on all orders</div>
        </div>
        <button type="button" class="kb-coupon-item__apply-btn" data-cart-apply-coupon data-coupon-code="KB10" style="background: #23421f; color: #ffffff; border: none; padding: 0.45rem 1rem; border-radius: 8px; font-weight: 800; cursor: pointer;">Apply</button>
      </div>
    </div>
  </div>
</aside>

<script>
  (function() {
    window._kbFreeGiftVariantId = Number({{ gift_variant_id | json }}) || null;
    let isGiftSyncing = false;

    const fetchFallbackGiftVariantId = async () => {
      const handles = ['free-gift', 'free-gift-1', 'free-gift-worth-149', 'free-gift-worth-rs-149', 'free-gift-product', 'free-gift-item', 'gift'];
      for (const h of handles) {
        try {
          const res = await fetch(`/products/${h}.js`);
          if (res.ok) {
            const p = await res.json();
            if (p && p.variants && p.variants.length > 0) {
              const vId = Number(p.variants[0].id);
              if (vId > 0) {
                window._kbFreeGiftVariantId = vId;
                return vId;
              }
            }
          }
        } catch (e) {
          // continue
        }
      }
      return null;
    };

    const checkAndSyncFreeGift = async (cartData) => {
      if (isGiftSyncing || !cartData) return;

      const mainCartEl = document.querySelector('[data-main-cart]');
      const datasetVariantId = mainCartEl ? parseInt(mainCartEl.dataset.freeGiftVariantId, 10) : NaN;
      let giftVariantId = !isNaN(datasetVariantId) && datasetVariantId > 0 ? datasetVariantId : window._kbFreeGiftVariantId;
      const threshold = (mainCartEl ? parseInt(mainCartEl.dataset.reward1Threshold, 10) : NaN) || {{ reward_1_threshold }};

      if (!giftVariantId || isNaN(giftVariantId) || giftVariantId <= 0) {
        giftVariantId = await fetchFallbackGiftVariantId();
      }

      if (!giftVariantId || isNaN(giftVariantId) || giftVariantId <= 0) return;

      const items = cartData.items || [];
      const giftItem = items.find(item => {
        const itemTitle = (item.product_title || item.title || '').toLowerCase();
        const itemHandle = (item.handle || '').toLowerCase();
        return Number(item.variant_id) === Number(giftVariantId) ||
               Number(item.id) === Number(giftVariantId) ||
               item.properties?.['_is_free_gift'] === 'true' ||
               itemHandle.includes('free-gift') ||
               itemTitle.includes('free gift');
      });
      const hasGiftInCart = !!giftItem;

      // Calculate cart subtotal excluding the free gift item
      let subtotalWithoutGift = 0;
      items.forEach(item => {
        const itemTitle = (item.product_title || item.title || '').toLowerCase();
        const itemHandle = (item.handle || '').toLowerCase();
        const isThisGift = Number(item.variant_id) === Number(giftVariantId) ||
                           Number(item.id) === Number(giftVariantId) ||
                           item.properties?.['_is_free_gift'] === 'true' ||
                           itemHandle.includes('free-gift') ||
                           itemTitle.includes('free gift');
        if (!isThisGift) {
          subtotalWithoutGift += (item.final_line_price || item.line_price || 0);
        }
      });

      if (subtotalWithoutGift >= threshold && !hasGiftInCart) {
        isGiftSyncing = true;
        try {
          // Attempt 1: Standard FormData POST
          const formData = new FormData();
          formData.append('id', String(giftVariantId));
          formData.append('quantity', '1');
          formData.append('properties[_is_free_gift]', 'true');

          let res = await fetch('/cart/add.js', {
            method: 'POST',
            body: formData
          });

          // Attempt 2: JSON payload if FormData returns non-200
          if (!res.ok) {
            res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                items: [{ id: Number(giftVariantId), quantity: 1, properties: { '_is_free_gift': 'true' } }]
              })
            });
          }

          // Attempt 3: Plain item without properties if custom properties fail
          if (!res.ok) {
            const plainData = new FormData();
            plainData.append('id', String(giftVariantId));
            plainData.append('quantity', '1');
            res = await fetch('/cart/add.js', {
              method: 'POST',
              body: plainData
            });
          }

          if (res.ok) {
            window.location.reload();
          } else {
            console.error('Failed to auto-add Free Gift:', res.status, await res.text());
            isGiftSyncing = false;
          }
        } catch (err) {
          console.error('Error auto-adding Free Gift:', err);
          isGiftSyncing = false;
        }
      } else if (subtotalWithoutGift < threshold && hasGiftInCart) {
        isGiftSyncing = true;
        try {
          const res = await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: giftItem.key || giftItem.id, quantity: 0 })
          });
          if (res.ok) {
            window.location.reload();
          } else {
            console.error('Failed to auto-remove Free Gift:', res.status, await res.text());
            isGiftSyncing = false;
          }
        } catch (err) {
          console.error('Error auto-removing Free Gift:', err);
          isGiftSyncing = false;
        }
      }
    };

    window.checkAndSyncFreeGift = checkAndSyncFreeGift;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        fetch('/cart.js?_t=' + Date.now()).then(r => r.json()).then(cart => checkAndSyncFreeGift(cart));
      });
    } else {
      fetch('/cart.js?_t=' + Date.now()).then(r => r.json()).then(cart => checkAndSyncFreeGift(cart));
    }

    document.addEventListener('kb:cart:updated', (e) => {
      if (e.detail && e.detail.cart) {
        checkAndSyncFreeGift(e.detail.cart);
      }
    });

    // Coupon System Initialization with Real-time Price Calculation
    const initCouponSystem = () => {
      const discountInput = document.getElementById('cart-discount-input');
      const appliedBanner = document.querySelector('[data-applied-coupon-status]');
      const appliedNameEl = document.querySelector('[data-applied-coupon-name]');
      const appliedSavingsEl = document.querySelector('[data-applied-coupon-savings]');
      const removeBtn = document.querySelector('[data-remove-coupon]');
      const customInput = document.querySelector('[data-custom-coupon-input]');
      const customApplyBtn = document.querySelector('[data-apply-custom-coupon]');
      const couponErrorEl = document.querySelector('[data-coupon-message]');

      const subtotalEl = document.querySelector('[data-cart-drawer-subtotal]');
      const totalSavedEl = document.querySelector('[data-cart-total-saved-amount]');
      const summaryBox = document.querySelector('[data-cart-summary-box]');
      const checkoutEstTotalInput = document.querySelector('input[name="attributes[Estimated Total]"]');

      if (!summaryBox) return;

      const baseTotalPrice = Number(summaryBox.dataset.cartTotalPrice) || 0;
      const baseOriginalPrice = Number(summaryBox.dataset.cartOriginalPrice) || 0;
      const shippingFee = Number(summaryBox.dataset.cartShippingFee) || 0;
      const baseTotalSaved = Number(summaryBox.dataset.cartTotalSaved) || 0;

      const formatMoney = (cents) => {
        if (typeof cents !== 'number') cents = Number(cents) || 0;
        const val = (cents / 100).toFixed(2);
        const parts = val.split('.');
        const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return 'Rs. ' + intPart + '.' + parts[1];
      };

      const getCouponDiscountDetails = (code) => {
        const clean = (code || '').trim().toUpperCase();
        let pct = 0;
        let minAmount = 0;

        if (clean.includes('KVEDA') || clean.includes('VEDA') || clean.includes('10%') || clean === 'KB10') {
          pct = 10;
          minAmount = (clean === 'KB10') ? 0 : 149900;
        } else {
          const match = clean.match(/(\d+)/);
          if (match) {
            pct = parseInt(match[1], 10);
            if (pct > 50) pct = 10;
          } else {
            pct = 10;
          }
          minAmount = 0;
        }
        return { pct, minAmount, code: clean };
      };

      const updatePricesAndUI = (code) => {
        if (couponErrorEl) {
          couponErrorEl.textContent = '';
          couponErrorEl.style.display = 'none';
        }

        if (!code) {
          if (discountInput) discountInput.value = '';
          if (appliedBanner) appliedBanner.style.display = 'none';

          const defaultEstTotal = baseTotalPrice + shippingFee;
          if (subtotalEl) subtotalEl.textContent = formatMoney(defaultEstTotal);
          if (totalSavedEl) totalSavedEl.textContent = formatMoney(baseTotalSaved);
          if (checkoutEstTotalInput) checkoutEstTotalInput.value = formatMoney(defaultEstTotal);

          document.querySelectorAll('[data-apply-coupon-code], [data-coupon-code]').forEach(b => {
            if (b.tagName === 'BUTTON' && !b.classList.contains('kb-coupon-custom-apply-btn')) {
              b.textContent = 'APPLY';
              b.style.background = '#166534';
            }
          });
          return;
        }

        const details = getCouponDiscountDetails(code);

        if (details.minAmount > 0 && baseTotalPrice < details.minAmount) {
          if (couponErrorEl) {
            couponErrorEl.textContent = `Minimum purchase of Rs. ${details.minAmount / 100} required to apply ${code}.`;
            couponErrorEl.style.display = 'block';
          }
          if (discountInput) discountInput.value = '';
          if (appliedBanner) appliedBanner.style.display = 'none';
          localStorage.removeItem('kb_applied_coupon');
          return;
        }

        const discountAmount = Math.round(baseTotalPrice * (details.pct / 100));
        const finalEstTotal = Math.max(0, baseTotalPrice - discountAmount + shippingFee);
        const finalTotalSaved = baseTotalSaved + discountAmount;

        if (discountInput) discountInput.value = code;
        if (appliedNameEl) appliedNameEl.textContent = code;
        if (appliedSavingsEl) appliedSavingsEl.textContent = `(${details.pct}% OFF: -${formatMoney(discountAmount)})`;
        if (appliedBanner) appliedBanner.style.display = 'flex';

        if (subtotalEl) subtotalEl.textContent = formatMoney(finalEstTotal);
        if (totalSavedEl) totalSavedEl.textContent = formatMoney(finalTotalSaved);
        if (checkoutEstTotalInput) checkoutEstTotalInput.value = formatMoney(finalEstTotal);

        document.querySelectorAll('[data-apply-coupon-code], [data-coupon-code]').forEach(b => {
          if (b.tagName === 'BUTTON' && !b.classList.contains('kb-coupon-custom-apply-btn')) {
            const btnCode = (b.getAttribute('data-apply-coupon-code') || b.getAttribute('data-coupon-code') || '').trim().toUpperCase();
            if (btnCode === details.code) {
              b.textContent = 'APPLIED';
              b.style.background = '#15803d';
            } else {
              b.textContent = 'APPLY';
              b.style.background = '#166534';
            }
          }
        });
      };

      const applyCouponCode = async (code) => {
        if (!code) return;
        const cleanCode = code.trim();
        if (!cleanCode) return;

        try {
          // 1. Trigger Shopify discount session
          await fetch('/discount/' + encodeURIComponent(cleanCode));

          // 2. Set discount cookie for Razorpay Magic Checkout & Shopify Checkout
          document.cookie = 'discount_code=' + encodeURIComponent(cleanCode) + '; path=/; max-age=86400';

          // 3. Update cart attributes so /cart.js returns the discount_code
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              attributes: {
                'discount': cleanCode,
                'discount_code': cleanCode,
                'applied_discount': cleanCode
              }
            })
          });
        } catch (err) {
          console.error('Error applying coupon to session:', err);
        }

        localStorage.setItem('kb_applied_coupon', cleanCode);
        updatePricesAndUI(cleanCode);
      };

      const removeCouponCode = async () => {
        try {
          await fetch('/discount/CLEAR');
          document.cookie = 'discount_code=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              attributes: {
                'discount': '',
                'discount_code': '',
                'applied_discount': ''
              }
            })
          });
        } catch (e) {}
        localStorage.removeItem('kb_applied_coupon');
        updatePricesAndUI(null);
      };

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-apply-coupon-code], [data-coupon-code], [data-cart-apply-coupon]');
        if (btn && !btn.classList.contains('kb-coupon-custom-apply-btn')) {
          const code = btn.getAttribute('data-apply-coupon-code') || btn.getAttribute('data-coupon-code');
          if (code) {
            e.preventDefault();
            applyCouponCode(code);
          }
        }
      });

      if (customApplyBtn && customInput) {
        customApplyBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const code = customInput.value;
          if (code) applyCouponCode(code);
        });

        customInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const code = customInput.value;
            if (code) applyCouponCode(code);
          }
        });
      }

      if (removeBtn) {
        removeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          removeCouponCode();
        });
      }

      const savedCoupon = localStorage.getItem('kb_applied_coupon');
      if (savedCoupon) {
        updatePricesAndUI(savedCoupon);
      }

      // Handle Checkout Navigation to prefill discount code on Shopify Checkout URL
      const checkoutForm = document.getElementById('cart-page-checkout-form');
      const handleCheckoutRedirect = (e) => {
        const code = localStorage.getItem('kb_applied_coupon') || (discountInput ? discountInput.value : '');
        if (code) {
          const cleanCode = code.trim();
          if (cleanCode) {
            e.preventDefault();
            e.stopPropagation();
            window.location.href = '/checkout?discount=' + encodeURIComponent(cleanCode);
          }
        }
      };

      if (checkoutForm) {
        checkoutForm.addEventListener('submit', handleCheckoutRedirect);
      }
      document.querySelectorAll('button[name="checkout"]').forEach(btn => {
        btn.addEventListener('click', handleCheckoutRedirect);
      });
    };

    initCouponSystem();
  })();
</script>

