{% doc %}
  Redirects /cart page to open the slide-out Cart Drawer directly.
{% enddoc %}

<noscript>
  <meta http-equiv="refresh" content="0; url={{ routes.root_url }}?open_cart=true">
</noscript>

<script>
  if (!window.Shopify || !window.Shopify.designMode) {
    window.location.replace({{ routes.root_url | append: '?open_cart=true' | json }});
  }
</script>

{{ 'cart.css' | asset_url | stylesheet_tag }}

<div class="kb-main-cart-fallback-wrap" style="max-width: 540px; margin: 2rem auto; padding: 0 1rem;">
  {% render 'cart-drawer' %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
