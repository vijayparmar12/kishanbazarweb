{% style %}
  #CollectionBanner-{{ section.id }} {
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.banner_max_width | default: 2000 }}px !important;
    height: {{ section.settings.banner_height_desktop | default: 380 }}px !important;
    min-height: {{ section.settings.banner_height_desktop | default: 380 }}px !important;
    margin: 0 auto 16px auto !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: {{ section.settings.vertical_alignment | default: 'center' }} !important;
    justify-content: {{ section.settings.horizontal_alignment | default: 'center' }} !important;
    text-align: {{ section.settings.text_align | default: 'center' }} !important;
    background-color: {{ section.settings.bg_color | default: '#1b4317' }} !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__picture {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 1 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.image_fit_desktop | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__overlay {
    position: absolute !important;
    inset: 0 !important;
    background-color: {{ section.settings.overlay_color | default: '#000000' }} !important;
    opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }} !important;
    z-index: 2 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__content {
    position: relative !important;
    z-index: 3 !important;
    width: 100% !important;
    max-width: 1200px !important;
    padding: 1.5rem 1rem !important;
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__title {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: {{ section.settings.title_size_desktop | default: 42 }}px !important;
    font-weight: 800 !important;
    line-height: 1.15 !important;
    margin: 0.3rem 0 !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  #CollectionBanner-{{ section.id }} .collection-banner__subheading {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: 1.05rem !important;
    opacity: 0.95 !important;
    margin-top: 0.25rem !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__description {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: 0.95rem !important;
    opacity: 0.9 !important;
    max-width: 700px !important;
    margin: 0.4rem auto 0 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__content,
  #CollectionBanner-{{ section.id }} .breadcrumb,
  #CollectionBanner-{{ section.id }} h1,
  #CollectionBanner-{{ section.id }} .collection-banner__title,
  #CollectionBanner-{{ section.id }} .collection-banner__overlay {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    #CollectionBanner-{{ section.id }} {
      height: {{ section.settings.banner_height_mobile | default: 220 }}px !important;
      min-height: {{ section.settings.banner_height_mobile | default: 220 }}px !important;
    }
    #CollectionBanner-{{ section.id }} .collection-banner__img {
      object-fit: {{ section.settings.image_fit_mobile | default: 'cover' }} !important;
    }
  }
{% endstyle %}

{% comment %} 1. Check Collection Metafields (Shopify Admin > Custom Data > Collections) {% endcomment %}
{% assign mf_img = nil %}
{% if collection.metafields.custom.banner_image != blank %}
  {% assign mf_img = collection.metafields.custom.banner_image.value | default: collection.metafields.custom.banner_image %}
{% elsif collection.metafields.custom.banner != blank %}
  {% assign mf_img = collection.metafields.custom.banner.value | default: collection.metafields.custom.banner %}
{% elsif collection.metafields.custom.desktop_banner != blank %}
  {% assign mf_img = collection.metafields.custom.desktop_banner.value | default: collection.metafields.custom.desktop_banner %}
{% elsif collection.metafields.custom.collection_banner != blank %}
  {% assign mf_img = collection.metafields.custom.collection_banner.value | default: collection.metafields.custom.collection_banner %}
{% elsif collection.metafields.custom.banner_img != blank %}
  {% assign mf_img = collection.metafields.custom.banner_img.value | default: collection.metafields.custom.banner_img %}
{% endif %}

{% assign mf_mobile_img = nil %}
{% if collection.metafields.custom.banner_mobile != blank %}
  {% assign mf_mobile_img = collection.metafields.custom.banner_mobile.value | default: collection.metafields.custom.banner_mobile %}
{% elsif collection.metafields.custom.mobile_banner != blank %}
  {% assign mf_mobile_img = collection.metafields.custom.mobile_banner.value | default: collection.metafields.custom.mobile_banner %}
{% endif %}

{% comment %} 7-Stage Failsafe URL Resolution for Desktop Metafield Image {% endcomment %}
{% assign mf_img_resolved_url = nil %}
{% if mf_img != nil and mf_img != blank %}
  {% if mf_img.url != blank and mf_img.url contains '/' %}
    {% assign mf_img_resolved_url = mf_img.url %}
  {% elsif mf_img.preview_image != blank %}
    {% assign mf_img_resolved_url = mf_img.preview_image | image_url: width: 2200 %}
  {% elsif mf_img.image != blank %}
    {% assign mf_img_resolved_url = mf_img.image | image_url: width: 2200 %}
  {% elsif mf_img.src != blank %}
    {% assign mf_img_resolved_url = mf_img.src | image_url: width: 2200 %}
  {% else %}
    {% assign try_img = mf_img | image_url: width: 2200 %}
    {% if try_img != blank and try_img contains 'shopify' %}
      {% assign mf_img_resolved_url = try_img %}
    {% else %}
      {% assign try_file_img = mf_img | file_img_url: '2048x2048' %}
      {% if try_file_img != blank and try_file_img contains 'shopify' %}
        {% assign mf_img_resolved_url = try_file_img %}
      {% else %}
        {% assign try_file = mf_img | file_url %}
        {% if try_file != blank and try_file contains 'shopify' %}
          {% assign mf_img_resolved_url = try_file %}
        {% elsif mf_img contains 'http' or mf_img contains 'shopify' %}
          {% assign mf_img_resolved_url = mf_img %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %} 7-Stage Failsafe URL Resolution for Mobile Metafield Image {% endcomment %}
{% assign mf_mobile_resolved_url = nil %}
{% if mf_mobile_img != nil and mf_mobile_img != blank %}
  {% if mf_mobile_img.url != blank and mf_mobile_img.url contains '/' %}
    {% assign mf_mobile_resolved_url = mf_mobile_img.url %}
  {% elsif mf_mobile_img.preview_image != blank %}
    {% assign mf_mobile_resolved_url = mf_mobile_img.preview_image | image_url: width: 1200 %}
  {% elsif mf_mobile_img.image != blank %}
    {% assign mf_mobile_resolved_url = mf_mobile_img.image | image_url: width: 1200 %}
  {% elsif mf_mobile_img.src != blank %}
    {% assign mf_mobile_resolved_url = mf_mobile_img.src | image_url: width: 1200 %}
  {% else %}
    {% assign try_mob_img = mf_mobile_img | image_url: width: 1200 %}
    {% if try_mob_img != blank and try_mob_img contains 'shopify' %}
      {% assign mf_mobile_resolved_url = try_mob_img %}
    {% else %}
      {% assign try_mob_file = mf_mobile_img | file_img_url: '1200x' %}
      {% if try_mob_file != blank and try_mob_file contains 'shopify' %}
        {% assign mf_mobile_resolved_url = try_mob_file %}
      {% else %}
        {% assign mf_mobile_resolved_url = mf_mobile_img | file_url %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %} 2. Check Theme Editor Block match for this collection {% endcomment %}
{% assign matched_block = nil %}
{% for block in section.blocks %}
  {% if block.settings.target_collection != blank %}
    {% if block.settings.target_collection.handle == collection.handle or block.settings.target_collection == collection.handle %}
      {% assign matched_block = block %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}

{% comment %} 3. Resolve Banner Images by Priority {% endcomment %}
{% assign final_banner_desktop_url = nil %}
{% assign final_banner_mobile_url = nil %}

{% if mf_img_resolved_url != blank %}
  {% assign final_banner_desktop_url = mf_img_resolved_url %}
  {% assign final_banner_mobile_url = mf_mobile_resolved_url | default: mf_img_resolved_url %}
{% elsif collection.image != blank %}
  {% assign final_banner_desktop_url = collection.image | image_url: width: 2200 %}
  {% assign final_banner_mobile_url = collection.image | image_url: width: 1200 %}
{% elsif matched_block != nil and matched_block.settings.image_desktop != blank %}
  {% assign final_banner_desktop_url = matched_block.settings.image_desktop | image_url: width: 2200 %}
  {% assign mob_block_img = matched_block.settings.image_mobile | default: matched_block.settings.image_desktop %}
  {% assign final_banner_mobile_url = mob_block_img | image_url: width: 1200 %}
{% elsif section.settings.custom_image_desktop != blank %}
  {% assign final_banner_desktop_url = section.settings.custom_image_desktop | image_url: width: 2200 %}
  {% assign mob_sec_img = section.settings.custom_image_mobile | default: section.settings.custom_image_desktop %}
  {% assign final_banner_mobile_url = mob_sec_img | image_url: width: 1200 %}
{% endif %}

<section id="CollectionBanner-{{ section.id }}" class="collection-banner" {% if matched_block != nil %}{{ matched_block.shopify_attributes }}{% endif %}>
  {% if section.settings.show_image and final_banner_desktop_url != blank %}
    <picture class="collection-banner__picture">
      {% if final_banner_mobile_url != blank and final_banner_mobile_url != final_banner_desktop_url %}
        <source media="(max-width: 749px)" srcset="{{ final_banner_mobile_url }}">
      {% endif %}
      <img src="{{ final_banner_desktop_url }}" alt="{{ collection.title | escape }}" class="collection-banner__img" loading="eager" fetchpriority="high">
    </picture>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "header", "content": "Banner Height & Layout" },
    { "type": "range", "id": "banner_height_desktop", "label": "Desktop Banner Height (px)", "min": 150, "max": 650, "step": 10, "default": 380, "unit": "px" },
    { "type": "range", "id": "banner_height_mobile", "label": "Mobile Banner Height (px)", "min": 100, "max": 450, "step": 10, "default": 220, "unit": "px" },
    { "type": "range", "id": "banner_max_width", "label": "Banner Max Width (px)", "min": 800, "max": 2200, "step": 50, "default": 2000, "unit": "px" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Default / Fallback Banner Images" },
    { "type": "checkbox", "id": "show_image", "label": "Show Background Image", "default": true },
    { "type": "image_picker", "id": "custom_image_desktop", "label": "Fallback Desktop Banner Image", "info": "Used if no specific collection image or collection block is set" },
    { "type": "image_picker", "id": "custom_image_mobile", "label": "Fallback Mobile Banner Image", "info": "Used if no specific collection image or collection block is set" },
    {
      "type": "select",
      "id": "image_fit_desktop",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire banner)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire banner)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    { "type": "header", "content": "Overlay Tint & Colors" },
    { "type": "checkbox", "id": "enable_overlay", "label": "Enable Dark/Tint Overlay", "default": false },
    { "type": "color", "id": "overlay_color", "label": "Overlay Tint Color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay Opacity (%)", "min": 0, "max": 100, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "bg_color", "label": "Fallback Background Color", "default": "#1b4317" },
    { "type": "color", "id": "text_color", "label": "Title & Text Color", "default": "#ffffff" },
    { "type": "color", "id": "breadcrumb_color", "label": "Breadcrumb Color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "collection_banner",
      "name": "Collection Specific Banner",
      "settings": [
        {
          "type": "collection",
          "id": "target_collection",
          "label": "Select Collection",
          "info": "Choose the collection this custom banner belongs to (e.g. Ghee, Atta, Oils)"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Banner Image",
          "info": "Upload custom desktop graphic banner for this collection"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Banner Image",
          "info": "Upload custom mobile graphic banner for this collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
