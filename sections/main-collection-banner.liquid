{% style %}
  #CollectionBanner-{{ section.id }} {
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.banner_max_width | default: 2000 }}px !important;
    height: {{ section.settings.banner_height_desktop | default: 380 }}px !important;
    min-height: {{ section.settings.banner_height_desktop | default: 380 }}px !important;
    margin: 0 auto 16px auto !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: {{ section.settings.vertical_alignment | default: 'center' }} !important;
    justify-content: {{ section.settings.horizontal_alignment | default: 'center' }} !important;
    text-align: {{ section.settings.text_align | default: 'center' }} !important;
    background-color: {{ section.settings.bg_color | default: '#1b4317' }} !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__picture {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 1 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.image_fit_desktop | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__overlay {
    position: absolute !important;
    inset: 0 !important;
    background-color: {{ section.settings.overlay_color | default: '#000000' }} !important;
    opacity: {{ section.settings.overlay_opacity | default: 30 | divided_by: 100.0 }} !important;
    z-index: 2 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__content {
    position: relative !important;
    z-index: 3 !important;
    width: 100% !important;
    max-width: 1200px !important;
    padding: 1.5rem 1rem !important;
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__title {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: {{ section.settings.title_size_desktop | default: 42 }}px !important;
    font-weight: 800 !important;
    line-height: 1.15 !important;
    margin: 0.3rem 0 !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  #CollectionBanner-{{ section.id }} .collection-banner__subheading {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: 1.05rem !important;
    opacity: 0.95 !important;
    margin-top: 0.25rem !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__description {
    color: {{ section.settings.text_color | default: '#ffffff' }} !important;
    font-size: 0.95rem !important;
    opacity: 0.9 !important;
    max-width: 700px !important;
    margin: 0.4rem auto 0 !important;
  }

  #CollectionBanner-{{ section.id }} .collection-banner__content,
  #CollectionBanner-{{ section.id }} .breadcrumb,
  #CollectionBanner-{{ section.id }} h1,
  #CollectionBanner-{{ section.id }} .collection-banner__title,
  #CollectionBanner-{{ section.id }} .collection-banner__overlay {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    #CollectionBanner-{{ section.id }} {
      height: {{ section.settings.banner_height_mobile | default: 220 }}px !important;
      min-height: {{ section.settings.banner_height_mobile | default: 220 }}px !important;
    }
    #CollectionBanner-{{ section.id }} .collection-banner__img {
      object-fit: {{ section.settings.image_fit_mobile | default: 'cover' }} !important;
    }
  }
{% endstyle %}

{% comment %} 1. Check Collection Metafields (Shopify Admin > Custom Data > Collections) {% endcomment %}
{% assign mf_img = nil %}
{% if collection.metafields.custom.banner_image.value != blank %}
  {% assign mf_img = collection.metafields.custom.banner_image.value %}
{% elsif collection.metafields.custom.banner_image != blank and collection.metafields.custom.banner_image.value == nil and collection.metafields.custom.banner_image.type == nil %}
  {% assign mf_img = collection.metafields.custom.banner_image %}
{% elsif collection.metafields.custom.banner.value != blank %}
  {% assign mf_img = collection.metafields.custom.banner.value %}
{% elsif collection.metafields.custom.desktop_banner.value != blank %}
  {% assign mf_img = collection.metafields.custom.desktop_banner.value %}
{% elsif collection.metafields.custom.collection_banner.value != blank %}
  {% assign mf_img = collection.metafields.custom.collection_banner.value %}
{% endif %}

{% assign mf_mobile_img = nil %}
{% if collection.metafields.custom.banner_mobile.value != blank %}
  {% assign mf_mobile_img = collection.metafields.custom.banner_mobile.value %}
{% elsif collection.metafields.custom.mobile_banner.value != blank %}
  {% assign mf_mobile_img = collection.metafields.custom.mobile_banner.value %}
{% endif %}

{% comment %} 2. Check Theme Editor Block match for this collection {% endcomment %}
{% assign matched_block = nil %}
{% for block in section.blocks %}
  {% if block.settings.target_collection != blank and block.settings.target_collection.handle == collection.handle %}
    {% assign matched_block = block %}
    {% break %}
  {% endif %}
{% endfor %}

{% comment %} 3. Resolve Banner Images by Priority {% endcomment %}
{% assign banner_img_desktop = nil %}
{% assign banner_img_mobile = nil %}

{% if mf_img != nil and mf_img != blank %}
  {% assign banner_img_desktop = mf_img %}
  {% assign banner_img_mobile = mf_mobile_img | default: mf_img %}
{% elsif matched_block != nil and matched_block.settings.image_desktop != blank %}
  {% assign banner_img_desktop = matched_block.settings.image_desktop %}
  {% assign banner_img_mobile = matched_block.settings.image_mobile | default: matched_block.settings.image_desktop %}
{% elsif collection.image != blank %}
  {% assign banner_img_desktop = collection.image %}
  {% assign banner_img_mobile = collection.image %}
{% elsif section.settings.custom_image_desktop != blank %}
  {% assign banner_img_desktop = section.settings.custom_image_desktop %}
  {% assign banner_img_mobile = section.settings.custom_image_mobile | default: section.settings.custom_image_desktop %}
{% elsif collection.products.first.featured_image != blank %}
  {% assign banner_img_desktop = collection.products.first.featured_image %}
  {% assign banner_img_mobile = collection.products.first.featured_image %}
{% endif %}

<section id="CollectionBanner-{{ section.id }}" class="collection-banner" {% if matched_block != nil %}{{ matched_block.shopify_attributes }}{% endif %}>
  {% if section.settings.show_image and banner_img_desktop != blank %}
    <picture class="collection-banner__picture">
      {% if banner_img_mobile != blank %}
        <source media="(max-width: 749px)" srcset="{{ banner_img_mobile | image_url: width: 1200 }}">
      {% endif %}
      {{ banner_img_desktop | image_url: width: 2200 | image_tag: class: 'collection-banner__img', alt: collection.title, loading: 'eager', fetchpriority: 'high' }}
    </picture>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "header", "content": "Banner Height & Layout" },
    { "type": "range", "id": "banner_height_desktop", "label": "Desktop Banner Height (px)", "min": 150, "max": 650, "step": 10, "default": 380, "unit": "px" },
    { "type": "range", "id": "banner_height_mobile", "label": "Mobile Banner Height (px)", "min": 100, "max": 450, "step": 10, "default": 220, "unit": "px" },
    { "type": "range", "id": "banner_max_width", "label": "Banner Max Width (px)", "min": 800, "max": 2200, "step": 50, "default": 2000, "unit": "px" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Default / Fallback Banner Images" },
    { "type": "checkbox", "id": "show_image", "label": "Show Background Image", "default": true },
    { "type": "image_picker", "id": "custom_image_desktop", "label": "Fallback Desktop Banner Image", "info": "Used if no specific collection image or collection block is set" },
    { "type": "image_picker", "id": "custom_image_mobile", "label": "Fallback Mobile Banner Image", "info": "Used if no specific collection image or collection block is set" },
    {
      "type": "select",
      "id": "image_fit_desktop",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire banner)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire banner)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    { "type": "header", "content": "Overlay Tint & Colors" },
    { "type": "checkbox", "id": "enable_overlay", "label": "Enable Dark/Tint Overlay", "default": false },
    { "type": "color", "id": "overlay_color", "label": "Overlay Tint Color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay Opacity (%)", "min": 0, "max": 100, "step": 5, "default": 0, "unit": "%" },
    { "type": "color", "id": "bg_color", "label": "Fallback Background Color", "default": "#1b4317" },
    { "type": "color", "id": "text_color", "label": "Title & Text Color", "default": "#ffffff" },
    { "type": "color", "id": "breadcrumb_color", "label": "Breadcrumb Color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "collection_banner",
      "name": "Collection Specific Banner",
      "settings": [
        {
          "type": "collection",
          "id": "target_collection",
          "label": "Select Collection",
          "info": "Choose the collection this custom banner belongs to (e.g. Ghee, Atta, Oils)"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Banner Image",
          "info": "Upload custom desktop graphic banner for this collection"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Banner Image",
          "info": "Upload custom mobile graphic banner for this collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
