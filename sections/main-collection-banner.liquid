{% doc %}
  Renders the Collection Banner & Title section matching the reference design:
  - Top full-width Collection Hero Banner Image
  - Priority:
    1. collection.metafields.custom.banner_image (Specific collection metafield image if uploaded)
    2. section.settings.custom_banner_desktop / default_banner_image (Global Default Banner Image uploaded in Theme Editor)
    3. collection.image / collection.featured_image
  - Prominent Collection Title below banner (e.g. STONE GROUND CHAKKI ATTA) with alignment, size, and style controls
{% enddoc %}

{% liquid
  # 1. Custom Metafield on Collection
  assign meta_desk_raw = collection.metafields.custom.banner_image
  assign meta_desk = meta_desk_raw.value | default: meta_desk_raw

  assign meta_mob_raw = collection.metafields.custom.banner_mobile_image
  assign meta_mob = meta_mob_raw.value | default: meta_mob_raw

  # 2. Section Settings (Theme Editor Image Uploads)
  assign sett_desk_raw = section.settings.custom_banner_desktop
  assign sett_desk = sett_desk_raw.value | default: sett_desk_raw

  assign sett_default_raw = section.settings.default_banner_image
  assign sett_default = sett_default_raw.value | default: sett_default_raw

  assign sett_mob_raw = section.settings.custom_banner_mobile
  assign sett_mob = sett_mob_raw.value | default: sett_mob_raw

  # Verify image objects actually contain image data
  assign valid_meta_desk = blank
  if meta_desk.width != blank or meta_desk.src != blank or meta_desk.preview_image != blank
    assign valid_meta_desk = meta_desk.preview_image | default: meta_desk
  endif

  assign valid_sett_desk = blank
  if sett_desk.width != blank or sett_desk.src != blank or sett_desk.preview_image != blank
    assign valid_sett_desk = sett_desk.preview_image | default: sett_desk
  endif

  assign valid_sett_default = blank
  if sett_default.width != blank or sett_default.src != blank or sett_default.preview_image != blank
    assign valid_sett_default = sett_default.preview_image | default: sett_default
  endif

  assign valid_coll_img = blank
  if collection.image.width != blank or collection.image.src != blank
    assign valid_coll_img = collection.image
  elsif collection.featured_image.width != blank or collection.featured_image.src != blank
    assign valid_coll_img = collection.featured_image
  endif

  # Resolve final desktop banner image:
  assign banner_img = valid_meta_desk | default: valid_sett_desk | default: valid_sett_default | default: valid_coll_img

  # Mobile resolution
  assign valid_meta_mob = blank
  if meta_mob.width != blank or meta_mob.src != blank or meta_mob.preview_image != blank
    assign valid_meta_mob = meta_mob.preview_image | default: meta_mob
  endif

  assign valid_sett_mob = blank
  if sett_mob.width != blank or sett_mob.src != blank or sett_mob.preview_image != blank
    assign valid_sett_mob = sett_mob.preview_image | default: sett_mob
  endif

  assign banner_mobile_img = valid_meta_mob | default: valid_sett_mob | default: banner_img
%}

<div class="collection-hero" id="CollectionHero-{{ section.id }}" style="--hero-radius: {{ section.settings.banner_border_radius | default: 24 }}px; --title-size-desktop: {{ section.settings.title_font_size | default: 32 }}px; --title-color: {{ section.settings.title_color | default: '#1b4317' }};">
  <div class="collection-hero__container">
    
    <!-- 1. COLLECTION BANNER IMAGE -->
    {% if section.settings.show_collection_image and banner_img != blank %}
      <div class="collection-hero__banner-wrap">
        <picture class="collection-hero__picture">
          {% if banner_mobile_img != blank and banner_mobile_img != banner_img %}
            <source media="(max-width: 768px)" srcset="{{ banner_mobile_img | image_url: width: 1200 }}">
          {% endif %}
          <img
            src="{{ banner_img | image_url: width: 2000 }}"
            alt="{{ collection.title | escape }}"
            class="collection-hero__image"
            loading="eager"
            width="{{ banner_img.width | default: 1600 }}"
            height="{{ banner_img.height | default: 600 }}"
          >
        </picture>
      </div>
    {% elsif section.settings.show_collection_image %}
      <!-- Fallback placeholder banner if no banner image uploaded yet -->
      <div class="collection-hero__banner-wrap collection-hero__banner-wrap--placeholder">
        <div class="collection-hero__placeholder-content">
          <span class="collection-hero__placeholder-badge">{{ collection.title | upcase }}</span>
        </div>
      </div>
    {% endif %}

    <!-- 2. COLLECTION TITLE BELOW BANNER -->
    {% if section.settings.show_collection_title %}
      <div class="collection-hero__header collection-hero__header--{{ section.settings.title_alignment | default: 'center' }}">
        <h1 class="collection-hero__title" style="text-transform: {{ section.settings.title_text_transform | default: 'uppercase' }}; font-weight: {{ section.settings.title_font_weight | default: '800' }};">
          {{ collection.title }}
        </h1>
        
        {% if section.settings.show_description and collection.description != blank %}
          <div class="collection-hero__description">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Collection Hero Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner Image Settings"
    },
    { "type": "checkbox", "id": "show_collection_image", "label": "Show Collection Banner Image", "default": true },
    { "type": "image_picker", "id": "default_banner_image", "label": "Global Default Desktop Banner (Shown when collection has no custom banner)" },
    { "type": "image_picker", "id": "custom_banner_desktop", "label": "Custom Desktop Banner Image Override" },
    { "type": "image_picker", "id": "custom_banner_mobile", "label": "Custom Mobile Banner Image Override" },
    {
      "type": "range",
      "id": "banner_border_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Collection Title Settings (Below Banner)"
    },
    { "type": "checkbox", "id": "show_collection_title", "label": "Show Collection Title Below Banner", "default": true },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Title Text Transform",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "none", "label": "As Typed" }
      ]
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Desktop Title Font Size (px)",
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Text Color",
      "default": "#1b4317"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "default": "800",
      "options": [
        { "value": "500", "label": "500 - Medium" },
        { "value": "600", "label": "600 - SemiBold" },
        { "value": "700", "label": "700 - Bold" },
        { "value": "800", "label": "800 - ExtraBold" },
        { "value": "900", "label": "900 - Black" }
      ]
    },
    {
      "type": "header",
      "content": "Collection Description Settings"
    },
    { "type": "checkbox", "id": "show_description", "label": "Show Collection Description", "default": false }
  ],
  "presets": [
    {
      "name": "Collection Hero Banner"
    }
  ]
}
{% endschema %}
