{% doc %}
  Renders the Collection Banner & Title section:
  - Dynamic Resolution Priority:
    1. collection.metafields.custom.banner_image (Specific collection custom metafield image e.g. oil.png)
    2. collection.image (Collection main image from Shopify Admin > Collections)
    3. Fallback Desktop & Mobile Banner Images from Theme Editor (Shown when collection has no custom image)
    4. Fallback product featured image
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-our-story.css' | asset_url }}">

{% liquid
  # 1. Custom Metafields on Collection (Highest Priority - Supports MediaImage, GenericFile, FileReference e.g. oil.png)
  assign meta_desk = collection.metafields.custom.banner_image | default: collection.metafields.custom.banner | default: collection.metafields.custom.collection_banner
  assign meta_mob = collection.metafields.custom.banner_mobile_image | default: collection.metafields.custom.mobile_banner

  assign banner_img_src = blank
  
  if meta_desk != blank
    assign m_val = meta_desk.value | default: meta_desk
    
    # Try all Shopify Liquid image/file filters
    assign img_from_val = m_val.preview_image | default: m_val
    assign banner_img_src = img_from_val | image_url: width: 2000 | default: blank
    
    if banner_img_src == blank or banner_img_src contains 'no-image' or banner_img_src contains 'assets/no-image'
      if m_val.url != blank
        assign banner_img_src = m_val.url
      elsif m_val.src != blank
        assign banner_img_src = m_val.src
      else
        assign banner_img_src = m_val | file_url
      endif
    endif
  endif

  assign banner_mob_src = blank
  if meta_mob != blank
    assign m_mob_val = meta_mob.value | default: meta_mob
    assign mob_from_val = m_mob_val.preview_image | default: m_mob_val
    assign banner_mob_src = mob_from_val | image_url: width: 1200 | default: blank
    
    if banner_mob_src == blank or banner_mob_src contains 'no-image' or banner_mob_src contains 'assets/no-image'
      if m_mob_val.url != blank
        assign banner_mob_src = m_mob_val.url
      elsif m_mob_val.src != blank
        assign banner_mob_src = m_mob_val.src
      else
        assign banner_mob_src = m_mob_val | file_url
      endif
    endif
  endif

  # 2. Dynamic Collection Main Image (Shopify Admin > Collections > Collection Image)
  if banner_img_src == blank
    if collection.image != blank
      assign banner_img_src = collection.image | image_url: width: 2000
    elsif collection.featured_image != blank
      assign banner_img_src = collection.featured_image | image_url: width: 2000
    endif
  endif

  # 3. Fallback Desktop & Mobile Banner Images from Theme Editor Section Card
  if banner_img_src == blank
    assign fallback_desk_raw = section.settings.fallback_banner_desktop | default: section.settings.default_banner_image | default: section.settings.custom_banner_desktop
    assign fallback_desk = fallback_desk_raw.value | default: fallback_desk_raw
    if fallback_desk != blank
      assign fallback_img = fallback_desk.preview_image | default: fallback_desk
      assign banner_img_src = fallback_img | image_url: width: 2000
    endif
  endif

  if banner_mob_src == blank
    assign fallback_mob_raw = section.settings.fallback_banner_mobile | default: section.settings.default_banner_mobile | default: section.settings.custom_banner_mobile
    assign fallback_mob = fallback_mob_raw.value | default: fallback_mob_raw
    if fallback_mob != blank
      assign fallback_mob_img = fallback_mob.preview_image | default: fallback_mob
      assign banner_mob_src = fallback_mob_img | image_url: width: 1200
    endif
  endif

  # 4. Fallback Product Image
  if banner_img_src == blank
    if collection.products.first.featured_image != blank
      assign banner_img_src = collection.products.first.featured_image | image_url: width: 2000
    elsif collections.all.products.first.featured_image != blank
      assign banner_img_src = collections.all.products.first.featured_image | image_url: width: 2000
    endif
  endif

  if banner_mob_src == blank
    assign banner_mob_src = banner_img_src
  endif

  # Ensure protocol is prepended on relative CDN URLs
  if banner_img_src != blank and banner_img_src contains '//' == false and banner_img_src contains 'http' == false
    assign banner_img_src = banner_img_src | prepend: 'https:'
  endif
  if banner_mob_src != blank and banner_mob_src contains '//' == false and banner_mob_src contains 'http' == false
    assign banner_mob_src = banner_mob_src | prepend: 'https:'
  endif
%}

<div class="collection-hero" id="CollectionHero-{{ section.id }}" style="width: 100%; max-width: 1400px; margin: 1rem auto 1.5rem; padding: 0 1rem; box-sizing: border-box; --hero-radius: {{ section.settings.banner_border_radius | default: 24 }}px; --title-size-desktop: {{ section.settings.title_font_size | default: 32 }}px; --title-color: {{ section.settings.title_color | default: '#1b4317' }};">
  <div class="collection-hero__container" style="width: 100%;">
    
    <!-- 1. COLLECTION BANNER IMAGE (DYNAMIC PER COLLECTION & FALLBACK FROM THEME EDITOR) -->
    {% if section.settings.show_collection_image and banner_img_src != blank %}
      <div class="collection-hero__banner-wrap" style="width: 100%; border-radius: {{ section.settings.banner_border_radius | default: 24 }}px; overflow: hidden; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);">
        <picture class="collection-hero__picture" style="display: block; width: 100%;">
          {% if banner_mob_src != blank and banner_mob_src != banner_img_src %}
            <source media="(max-width: 768px)" srcset="{{ banner_mob_src }}">
          {% endif %}
          <img
            src="{{ banner_img_src }}"
            alt="{{ collection.title | default: 'All Products' | escape }}"
            class="collection-hero__image"
            loading="eager"
            style="width: 100%; height: auto; max-height: 480px; object-fit: cover; display: block; border-radius: {{ section.settings.banner_border_radius | default: 24 }}px;"
          >
        </picture>
      </div>
    {% endif %}

    <!-- 2. COLLECTION TITLE BELOW BANNER -->
    {% if section.settings.show_collection_title %}
      <div class="collection-hero__header collection-hero__header--{{ section.settings.title_alignment | default: 'center' }}" style="text-align: {{ section.settings.title_alignment | default: 'center' }}; margin-top: 1.5rem; margin-bottom: 1rem;">
        <h1 class="collection-hero__title" style="color: {{ section.settings.title_color | default: '#1b4317' }}; font-family: Georgia, serif; font-size: clamp(1.6rem, 3.5vw, 2.5rem); text-transform: {{ section.settings.title_text_transform | default: 'uppercase' }}; font-weight: {{ section.settings.title_font_weight | default: '800' }}; margin: 0 0 0.5rem;">
          {{ collection.title | default: 'All Products' }}
        </h1>
        
        {% if section.settings.show_description and collection.description != blank %}
          <div class="collection-hero__description" style="color: #4b5563; font-size: 1rem; max-width: 750px; margin: 0 auto; line-height: 1.6;">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Collection Hero Banner",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner Image Settings"
    },
    { "type": "checkbox", "id": "show_collection_image", "label": "Show Collection Banner Image", "default": true },
    { "type": "image_picker", "id": "fallback_banner_desktop", "label": "Fallback Desktop Banner Image (Shown when collection has no custom image)" },
    { "type": "image_picker", "id": "fallback_banner_mobile", "label": "Fallback Mobile Banner Image (Optional Mobile Fallback)" },
    { "type": "image_picker", "id": "default_banner_image", "label": "Global Default Desktop Banner" },
    { "type": "image_picker", "id": "default_banner_mobile", "label": "Global Default Mobile Banner" },
    { "type": "image_picker", "id": "custom_banner_desktop", "label": "Custom Desktop Banner Image Override" },
    { "type": "image_picker", "id": "custom_banner_mobile", "label": "Custom Mobile Banner Image Override" },
    {
      "type": "range",
      "id": "banner_border_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Collection Title Settings (Below Banner)"
    },
    { "type": "checkbox", "id": "show_collection_title", "label": "Show Collection Title Below Banner", "default": true },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Title Text Transform",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "none", "label": "As Typed" }
      ]
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Desktop Title Font Size (px)",
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Text Color",
      "default": "#1b4317"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "default": "800",
      "options": [
        { "value": "500", "label": "500 - Medium" },
        { "value": "600", "label": "600 - SemiBold" },
        { "value": "700", "label": "700 - Bold" },
        { "value": "800", "label": "800 - ExtraBold" },
        { "value": "900", "label": "900 - Black" }
      ]
    },
    {
      "type": "header",
      "content": "Collection Description Settings"
    },
    { "type": "checkbox", "id": "show_description", "label": "Show Collection Description", "default": false }
  ],
  "presets": [
    {
      "name": "Collection Hero Banner"
    }
  ]
}
{% endschema %}
