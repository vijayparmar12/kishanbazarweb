<link rel="stylesheet" href="{{ 'section-offer-banner.css' | asset_url }}"><script src="{{ 'section-offer-banner.js' | asset_url }}" defer="defer"></script>
<section class="offer-banner" data-offer-banner>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2000 | image_tag: class: 'offer-banner__image', loading: 'lazy', widths: '750, 1200, 1600, 2000' }}{% else %}<img class="offer-banner__image" src="{{ 'offer-banner.jpg.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="2000" height="800" loading="lazy">{% endif %}<div class="offer-banner__shade"></div><div class="offer-banner__content">{% if section.settings.badge != blank %}<p class="offer-banner__badge">{{ section.settings.badge }}</p>{% endif %}<h2>{{ section.settings.heading }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}{% if section.settings.button_text != blank %}{% render 'button', text: section.settings.button_text, url: section.settings.button_link, size: 'large' %}{% endif %}</div></section>
{% schema %}{"name":"Offer banner","tag":"section","class":"section-offer-banner","settings":[{"type":"image_picker","id":"image","label":"Banner image"},{"type":"text","id":"badge","label":"Offer badge","default":"Seasonal offer"},{"type":"text","id":"heading","label":"Heading","default":"A little more goodness in every order."},{"type":"text","id":"subheading","label":"Subheading","default":"Discover pantry staples made for slow, nourishing meals."},{"type":"text","id":"button_text","label":"Button text","default":"Shop the offer"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Offer banner"}]}{% endschema %}
