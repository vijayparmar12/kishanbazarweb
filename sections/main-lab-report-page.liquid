{% doc %}
  Renders the Lab Report page containing:
  - Top Hero Banner Image (Editable in Theme Editor)
  - Hero Badge, Title, Subtitle
  - Clean 3-element Lab Report cards:
    1. Report / Product Image
    2. Product Name
    3. PDF Link / Download Button
  Fully editable via Shopify Theme Editor blocks and Product Metafields.

  @example
  {% section 'main-lab-report-page' %}
{% enddoc %}

{{ 'section-lab-report.css' | asset_url | stylesheet_tag }}

<section class="lab-report-page" id="LabReport-{{ section.id }}">
  <!-- Top Banner Image (Editable in Theme Editor) -->
  {% if section.settings.banner_image_desktop != blank or section.settings.banner_image_mobile != blank %}
    <div class="lab-report-banner-wrap" style="max-width: 1400px; margin: 1rem auto 1.5rem; padding: 0 1rem; box-sizing: border-box;">
      <picture class="lab-report-picture">
        {% if section.settings.banner_image_mobile != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.banner_image_mobile | image_url: width: 1200 }}">
        {% endif %}
        {% assign banner_img = section.settings.banner_image_desktop | default: section.settings.banner_image_mobile %}
        <img
          src="{{ banner_img | image_url: width: 2000 }}"
          alt="{{ section.settings.heading | default: 'Lab Testing & Quality Reports' | escape }}"
          class="lab-report-banner-image"
          loading="eager"
          style="width: 100%; height: auto; display: block; border-radius: {{ section.settings.banner_radius | default: 20 }}px; max-height: 450px; object-fit: cover; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);"
        >
      </picture>
    </div>
  {% endif %}

  <!-- Hero Header -->
  <div class="lab-report-hero">
    <div class="lab-report-hero__inner">
      {% if section.settings.badge != blank %}
        <span class="lab-report-hero__badge">
          <span>🛡️</span> {{ section.settings.badge }}
        </span>
      {% endif %}
      {% assign hero_title = page.title | default: section.settings.heading %}
      {% if hero_title != blank %}
        <h1 class="lab-report-hero__heading">{{ hero_title }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="lab-report-hero__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  </div>

  <div class="lab-report-container">
    {% assign report_blocks = section.blocks | where: 'type', 'lab_report' %}
    {% assign pillar_blocks = section.blocks | where: 'type', 'quality_pillar' %}

    {% if section.settings.grid_heading != blank %}
      <div class="lab-report-section-title">
        <h2>{{ section.settings.grid_heading }}</h2>
        {% if section.settings.grid_subheading != blank %}
          <p>{{ section.settings.grid_subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="lab-report-grid">
      {% if report_blocks.size > 0 %}
        <!-- 1. Render Theme Editor Lab Report Blocks -->
        {% for block in report_blocks %}
          {% liquid
            assign report_img = block.settings.report_image
            assign prod_name = block.settings.product_title
            assign pdf_url = block.settings.report_url
          %}
          <article class="lab-report-card" {{ block.shopify_attributes }}>
            <!-- Element 1: Image -->
            <div class="lab-report-card__media">
              {% if report_img != blank %}
                {{ report_img | image_url: width: 600 | image_tag: alt: prod_name, loading: 'lazy', class: 'lab-report-card__image' }}
              {% else %}
                <div class="lab-report-card__placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#23421f" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {% endif %}
            </div>

            <div class="lab-report-card__body">
              <!-- Element 2: Product Name -->
              {% if prod_name != blank %}
                <h3 class="lab-report-card__title">{{ prod_name }}</h3>
              {% endif %}

              <!-- Element 3: PDF Link -->
              {% if pdf_url != blank %}
                <a class="lab-report-card__btn" href="{{ pdf_url }}" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                  <span>{{ block.settings.button_text | default: "View / Download PDF Report ↓" }}</span>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}

      {% else %}
        <!-- 2. Auto-fetch Products with Metafield Lab Reports -->
        {% for product in collections.all.products %}
          {% liquid
            assign meta_pdf = product.metafields.custom.lab_report.value | default: product.metafields.custom.lab_report | default: product.metafields.custom.lab_report_pdf.value | default: product.metafields.custom.lab_report_pdf
            assign pdf_url = meta_pdf.url | default: meta_pdf
            assign meta_img = product.metafields.custom.lab_report_image.value | default: product.metafields.custom.lab_report_image | default: product.featured_image
          %}
          {% if pdf_url != blank %}
            <article class="lab-report-card">
              <!-- Element 1: Image -->
              <div class="lab-report-card__media">
                {% if meta_img != blank %}
                  {{ meta_img | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy', class: 'lab-report-card__image' }}
                {% endif %}
              </div>

              <div class="lab-report-card__body">
                <!-- Element 2: Product Name -->
                <h3 class="lab-report-card__title">{{ product.title }}</h3>

                <!-- Element 3: PDF Link -->
                <a class="lab-report-card__btn" href="{{ pdf_url }}" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                  </svg>
                  <span>View / Download PDF Report ↓</span>
                </a>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

    <!-- Quality Assurance Pillars (Optional) -->
    {% if pillar_blocks.size > 0 %}
      <div class="lab-report-pillars">
        <div class="lab-report-section-title" style="margin-bottom: 2rem;">
          <h2>{{ section.settings.pillars_heading | default: "Our Quality Guarantee" }}</h2>
        </div>

        <div class="lab-report-pillars__grid">
          {% for block in pillar_blocks %}
            <div class="lab-report-pillar" {{ block.shopify_attributes }}>
              <div class="lab-report-pillar__icon">{{ block.settings.icon | default: "🔬" }}</div>
              <h3 class="lab-report-pillar__title">{{ block.settings.title }}</h3>
              <p class="lab-report-pillar__desc">{{ block.settings.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Lab report page",
  "tag": "section",
  "class": "section-main-lab-report-page",
  "settings": [
    {
      "type": "header",
      "content": "Top Banner Image Settings"
    },
    {
      "type": "image_picker",
      "id": "banner_image_desktop",
      "label": "Top Hero Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Top Hero Banner Image (Mobile)"
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hero Title & Description Settings"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Hero badge text",
      "default": "100% CERTIFIED & TESTED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lab Testing & Quality Reports"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading description",
      "default": "Transparency is our promise. View and download NABL-accredited laboratory test reports for all Kishan Bazar organic products."
    },
    {
      "type": "header",
      "content": "Report Grid Section"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading (optional, leave blank to hide)"
    },
    {
      "type": "text",
      "id": "grid_subheading",
      "label": "Grid subheading",
      "default": "Click on any report below to view or download the full laboratory analysis certificate."
    }
  ],
  "blocks": [
    {
      "type": "lab_report",
      "name": "Lab Report Card",
      "settings": [
        { "type": "image_picker", "id": "report_image", "label": "1. Report / Product Image" },
        { "type": "text", "id": "product_title", "label": "2. Product Name" },
        { "type": "url", "id": "report_url", "label": "3. PDF Link / File URL" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "View / Download PDF Report ↓" }
      ]
    },
    {
      "type": "quality_pillar",
      "name": "Quality Pillar Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🔬" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lab Report Page Showcase"
    }
  ]
}
{% endschema %}
