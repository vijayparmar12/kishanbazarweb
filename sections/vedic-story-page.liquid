{% doc %}
  Renders custom story pages (Our Story, The Farmers, The Gaushala, Ancient Kitchen & Recipes, Vedic Food Wisdom).
  Features:
  - Top Hero Banner Image (Desktop & Mobile, editable in Theme Editor)
  - Hero Badge, Title, Subtitle
  - Story Cards with IMAGE ON TOP -> CONTENT BELOW IMAGE (Title, Eyebrow, Text, Quote, Button)
  - Feature Pillars Grid (Icon, Title, Description)
  - Bottom Call-to-Action Banner (Heading, Subheading, Action Button)
{% enddoc %}

<link rel="stylesheet" href="{{ 'section-our-story.css' | asset_url }}">

<div class="vedic-story-page" id="VedicStory-{{ section.id }}">
  <!-- 1. TOP HERO BANNER IMAGE (Editable in Theme Editor) -->
  {% if section.settings.banner_image_desktop != blank or section.settings.banner_image_mobile != blank %}
    <div class="vedic-story-banner-wrap" style="max-width: 1400px; margin: 1rem auto 1.5rem; padding: 0 1rem; box-sizing: border-box;">
      <picture class="vedic-story-picture">
        {% if section.settings.banner_image_mobile != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.banner_image_mobile | image_url: width: 1200 }}">
        {% endif %}
        {% assign banner_img = section.settings.banner_image_desktop | default: section.settings.banner_image_mobile %}
        <img
          src="{{ banner_img | image_url: width: 2000 }}"
          alt="{{ section.settings.hero_title | default: page.title | escape }}"
          class="vedic-story-banner-image"
          loading="eager"
          style="width: 100%; height: auto; display: block; border-radius: {{ section.settings.banner_radius | default: 20 }}px; max-height: 480px; object-fit: cover; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.08);"
        >
      </picture>
    </div>
  {% endif %}

  <!-- 2. HERO HEADER -->
  <header class="our-story-hero" style="min-height: auto; padding: 2.5rem 1rem; text-align: center; background: linear-gradient(180deg, #F4F8F0 0%, #FDFBF7 100%);">
    <div class="our-story-hero__inner" style="max-width: 850px; margin: 0 auto;">
      {% if section.settings.hero_badge != blank %}
        <span class="our-story-hero__label" style="background: #EAF2E5; color: #23421F; border: 1px solid rgba(35, 66, 31, 0.15); font-size: 0.82rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.4rem 1.25rem; border-radius: 999px; display: inline-block; margin-bottom: 1rem;">
          {{ section.settings.hero_badge }}
        </span>
      {% endif %}
      <h1 class="our-story-hero__heading" style="color: #132D14; font-family: Georgia, serif; font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 900; margin: 0 0 1rem;">
        {{ section.settings.hero_title | default: page.title }}
      </h1>
      {% if section.settings.hero_subtitle != blank %}
        <p class="our-story-hero__subheading" style="color: #4B5563; font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.6; margin: 0 auto; max-width: 720px;">
          {{ section.settings.hero_subtitle }}
        </p>
      {% endif %}
    </div>
  </header>

  <!-- 3. STORY CARDS: IMAGE ON TOP -> CONTENT BELOW IMAGE -->
  {% assign story_blocks = section.blocks | where: 'type', 'story_card' %}
  {% if story_blocks.size > 0 %}
    <section class="vedic-story-cards-section" style="padding: 3rem 1rem; max-width: 1240px; margin: 0 auto;">
      <div class="vedic-story-cards-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        {% for block in story_blocks %}
          <article class="vedic-story-card" style="background: #FFFFFF; border: 1px solid rgba(35, 66, 31, 0.12); border-radius: 20px; overflow: hidden; box-shadow: 0 8px 24px rgba(35, 66, 31, 0.06); display: flex; flex-direction: column;" {{ block.shopify_attributes }}>
            
            <!-- IMAGE ON TOP -->
            <div class="vedic-story-card__media" style="position: relative; width: 100%; height: auto; min-height: 240px; background: #F4F8F0; overflow: hidden; border-bottom: 1px solid rgba(35, 66, 31, 0.08); display: flex; align-items: center; justify-content: center; padding: 0.75rem; box-sizing: border-box;">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, loading: 'lazy', style: 'width: 100%; height: auto; max-height: 380px; object-fit: contain; display: block; margin: 0 auto;' }}
              {% else %}
                <div style="padding: 3rem 1rem; text-align: center; color: #23421f;">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {% endif %}
            </div>

            <!-- CONTENT BELOW IMAGE -->
            <div class="vedic-story-card__content" style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
              <div>
                {% if block.settings.eyebrow != blank %}
                  <span class="story-eyebrow" style="color: #7CB342; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; display: block; margin-bottom: 0.5rem;">
                    {{ block.settings.eyebrow }}
                  </span>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h2 class="story-heading" style="color: #132D14; font-family: Georgia, serif; font-size: 1.35rem; font-weight: 800; margin: 0 0 0.85rem; line-height: 1.3;">
                    {{ block.settings.title }}
                  </h2>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="vedic-story-card__text" style="color: #374151; font-size: 0.98rem; line-height: 1.65; margin-bottom: 1rem;">
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.quote != blank %}
                  <blockquote style="background: #F8F7F3; border-left: 4px solid #2E5D34; border-radius: 0 12px 12px 0; margin: 1rem 0; padding: 0.85rem 1.15rem; color: #1F4224; font-style: italic; font-size: 0.95rem; font-weight: 600;">
                    "{{ block.settings.quote }}"
                  </blockquote>
                {% endif %}
              </div>

              {% if block.settings.button_text != blank and block.settings.button_url != blank %}
                <a class="story-btn story-btn--primary" href="{{ block.settings.button_url }}" style="margin-top: 1rem; align-self: flex-start;">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>

          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- 4. FEATURE PILLARS GRID -->
  {% assign pillar_blocks = section.blocks | where: 'type', 'feature_pillar' %}
  {% if pillar_blocks.size > 0 %}
    <section class="story-values" style="padding: 3.5rem 1rem; background-color: #F8F7F3;">
      <div class="story-container">
        {% if section.settings.pillars_heading != blank %}
          <div class="story-header story-header--center" style="margin-bottom: 2.5rem; text-align: center;">
            <h2 class="story-heading" style="font-family: Georgia, serif; color: #132D14;">{{ section.settings.pillars_heading }}</h2>
          </div>
        {% endif %}

        <div class="story-values__grid">
          {% for block in pillar_blocks %}
            <div class="story-value-card" {{ block.shopify_attributes }}>
              <div class="story-value-card__icon-wrap">
                <span class="story-value-card__icon">{{ block.settings.icon | default: "🌿" }}</span>
              </div>
              {% if block.settings.title != blank %}
                <h3 class="story-value-card__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="story-value-card__desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <!-- 5. BOTTOM CTA BANNER -->
  {% if section.settings.cta_heading != blank %}
    <section class="story-container" style="margin: 3.5rem auto;">
      <div class="our-story-cta" style="background: linear-gradient(135deg, #1b4317 0%, #2e5d34 100%); padding: 3rem 1.5rem; border-radius: 24px; text-align: center; color: #ffffff;">
        <h2 class="our-story-cta__title" style="color: #ffffff; font-family: Georgia, serif; font-size: clamp(1.6rem, 3.5vw, 2.5rem); margin: 0 0 1rem;">
          {{ section.settings.cta_heading }}
        </h2>
        {% if section.settings.cta_subheading != blank %}
          <p style="color: #e5e7eb; max-width: 650px; margin: 0 auto 1.5rem; font-size: 1.05rem;">{{ section.settings.cta_subheading }}</p>
        {% endif %}
        {% if section.settings.cta_button_text != blank %}
          <a href="{{ section.settings.cta_button_url | default: routes.all_products_collection_url }}" class="story-btn story-btn--gold">
            {{ section.settings.cta_button_text }}
          </a>
        {% endif %}
      </div>
    </section>
  {% endif %}
</div>

{% schema %}
{
  "name": "Vedic Story Page",
  "tag": "section",
  "class": "section-vedic-story-page",
  "settings": [
    {
      "type": "header",
      "content": "Top Banner Image Settings"
    },
    { "type": "image_picker", "id": "banner_image_desktop", "label": "Top Hero Banner Image (Desktop)" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Top Hero Banner Image (Mobile)" },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner Border Radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hero Title & Description Settings"
    },
    { "type": "text", "id": "hero_badge", "label": "Hero Badge Text", "default": "🌿 KISHANVEDA • THE VEDIC WAY" },
    { "type": "text", "id": "hero_title", "label": "Hero Page Title", "default": "Our Story — Rooted in Pure Organic Farming" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero Subtitle Description", "default": "Discover how KishanVeda connects native farmers directly to your kitchen with ancient Vedic wisdom and stone-ground purity." },
    {
      "type": "header",
      "content": "Pillars Section Settings"
    },
    { "type": "text", "id": "pillars_heading", "label": "Pillars Heading", "default": "Our Core Vedic Pillars" },
    {
      "type": "header",
      "content": "Bottom Call-To-Action Settings"
    },
    { "type": "text", "id": "cta_heading", "label": "CTA Heading", "default": "Taste the Difference of Pure Organic Staples" },
    { "type": "textarea", "id": "cta_subheading", "label": "CTA Subheading", "default": "Experience true farm-fresh quality with our Khapli Atta, A2 Gir Ghee, and native spices." },
    { "type": "text", "id": "cta_button_text", "label": "CTA Button Label", "default": "SHOP ORGANIC ESSENTIALS" },
    { "type": "url", "id": "cta_button_url", "label": "CTA Button Link" }
  ],
  "blocks": [
    {
      "type": "story_card",
      "name": "Story Card (Image Top)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "1. Story Image (Top)" },
        { "type": "text", "id": "eyebrow", "label": "2. Tag / Eyebrow Text", "default": "TRADITIONAL WISDOM" },
        { "type": "text", "id": "title", "label": "3. Card Title", "default": "Preserving Ancient Cold Stone Milling" },
        { "type": "richtext", "id": "text", "label": "4. Story Paragraphs / Content", "default": "<p>Slow stone-ground milling retains essential wheat germ oils, rich aroma, and natural dietary fiber.</p>" },
        { "type": "text", "id": "quote", "label": "5. Highlight Quote (Optional)", "default": "Pure food as nature intended, crafted with ancient Vedic care." },
        { "type": "text", "id": "button_text", "label": "6. Button Text (Optional)" },
        { "type": "url", "id": "button_url", "label": "6. Button Link (Optional)" }
      ]
    },
    {
      "type": "feature_pillar",
      "name": "Feature Pillar",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🌱" },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Organic Sourcing" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Grown naturally without chemical pesticides or artificial fertilizers." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vedic Story Page Showcase"
    }
  ]
}
{% endschema %}
