{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos.js' | asset_url }}" defer></script>

{% style %}
  #ShoppableVideos-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#FBF7F0' }} !important;
  }
  #ShoppableVideos-{{ section.id }} .shoppable-videos__heading {
    color: {{ section.settings.heading_color | default: '#23421F' }} !important;
  }
{% endstyle %}

<section
  id="ShoppableVideos-{{ section.id }}"
  class="shoppable-videos"
  data-shoppable-videos
  aria-labelledby="ShoppableVideosHeading-{{ section.id }}"
>
  <div class="shoppable-videos__inner">
    
    <!-- Section Header -->
    <header class="shoppable-videos__header">
      {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
        <div class="shoppable-videos__heading-banner-wrap">
          <picture class="home-section__heading-picture">
            {% if section.settings.heading_image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
            {% endif %}
            {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
            {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
          </picture>
        </div>
      {% else %}
        {% if section.settings.heading != blank %}
          <h2 id="ShoppableVideosHeading-{{ section.id }}" class="shoppable-videos__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="shoppable-videos__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      {% endif %}
    </header>

    <!-- Carousel Container -->
    <div class="shoppable-videos__carousel">
      <button type="button" class="shoppable-videos__arrow shoppable-videos__arrow--prev" aria-label="Previous videos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="shoppable-videos__viewport">
        <ul class="shoppable-videos__track">
          {% for block in section.blocks %}
            {% if block.type != 'video' %}
              {% continue %}
            {% endif %}

            {% assign block_product = block.settings.product %}
            {% assign hosted_vid = block.settings.video %}
            {% assign mp4_url = block.settings.video_url %}

            {% render 'shoppable-video-card',
              card_product: block_product,
              hosted_video: hosted_vid,
              mp4_url: mp4_url,
              poster: block.settings.poster,
              block: block,
              shopify_attributes: block.shopify_attributes
            %}
          {% endfor %}
        </ul>
      </div>

      <button type="button" class="shoppable-videos__arrow shoppable-videos__arrow--next" aria-label="Next videos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Shoppable Videos",
  "tag": "section",
  "class": "section-shoppable-videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Us on Instagram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap, shop, and explore authentic stories from our customers and creators."
    },
    {
      "type": "image_picker",
      "id": "heading_image_desktop",
      "label": "Heading Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "heading_image_mobile",
      "label": "Heading Banner Image (Mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FBF7F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#23421F"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Reel",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Linked Product"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video File"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External MP4 Video URL"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video Poster Thumbnail Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle Name (e.g. @kisanveda)",
          "default": "@kisanveda"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Videos Reel",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
