{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos.js' | asset_url }}" type="module"></script>

{% style %}
  #ShoppableVideos-{{ section.id }} {
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}') !important;
    {% else %}
      background-image: url('{{ "2.png" | asset_url }}') !important;
    {% endif %}
    background-size: cover !important;
    background-position: center top !important;
    background-repeat: no-repeat !important;
  }
  @media (max-width: 48rem) {
    #ShoppableVideos-{{ section.id }} {
      background-size: 100% auto !important;
      background-position: bottom center !important;
      background-repeat: no-repeat !important;
    }
  }
{% endstyle %}

{% liquid
  assign demo_video_url = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4'
  assign csv_lines = section.settings.bulk_video_csv | newline_to_br | split: '<br />'
  assign slides_rendered = 0

  if section.settings.show_demo_video
    assign slides_rendered = slides_rendered | plus: 1
  endif

  for block in section.blocks
    if block.type != 'video'
      continue
    endif

    if block.settings.video != blank or block.settings.video_url != blank
      assign slides_rendered = slides_rendered | plus: 1
    elsif request.design_mode
      assign slides_rendered = slides_rendered | plus: 1
    endif
  endfor

  for line in csv_lines
    assign line_stripped = line | strip
    if line_stripped == blank
      continue
    endif

    assign first_char = line_stripped | slice: 0, 1
    if first_char == '#'
      continue
    endif

    assign parts = line_stripped | split: ','
    assign csv_video_url = ''
    if parts[0] contains 'http'
      assign csv_video_url = parts[0] | strip
    elsif parts.size > 1
      assign csv_video_url = parts[1] | strip
    endif

    if csv_video_url contains 'http'
      assign slides_rendered = slides_rendered | plus: 1
    endif
  endfor
%}

<section
  id="ShoppableVideos-{{ section.id }}"
  class="shoppable-videos"
  data-shoppable-videos
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-loop="{{ section.settings.loop }}"
  data-infinite-loop="{{ section.settings.infinite_loop }}"
  style="
    --shoppable-videos-bg: {{ section.settings.background_color }};
    --shoppable-videos-heading-color: {{ section.settings.heading_color }};
  "
  aria-labelledby="ShoppableVideosHeading-{{ section.id }}"
>
  <div class="shoppable-videos__bg-illustration" aria-hidden="true">
    <img src="{{ 'kisan.png' | asset_url }}" alt="Kisan Farmer" class="shoppable-videos__decor-kisan" width="70" height="70" loading="lazy">
    <img src="{{ 'badal.png' | asset_url }}" alt="Clouds" class="shoppable-videos__decor-badal" width="85" height="42" loading="lazy">
    <svg class="shoppable-videos__trees-top" viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60C120 40 240 70 360 45C480 20 600 65 720 35C840 5 960 55 1080 30C1200 5 1320 45 1440 25V0H0V60Z" fill="#356b36" opacity="0.12"/>
      <circle cx="120" cy="25" r="18" fill="#356b36" opacity="0.1"/>
      <circle cx="1320" cy="20" r="24" fill="#356b36" opacity="0.1"/>
    </svg>
  </div>

  <div class="shoppable-videos__inner">
    {% if request.design_mode %}
      <aside class="shoppable-videos__guide" aria-label="{{ 'sections.shoppable_videos.guide_title' | t }}">
        <p class="shoppable-videos__guide-title">{{ 'sections.shoppable_videos.guide_title' | t }}</p>
        <ol class="shoppable-videos__guide-list">
          <li>{{ 'sections.shoppable_videos.guide_step_1' | t }}</li>
          <li>{{ 'sections.shoppable_videos.guide_step_2' | t }}</li>
          <li>{{ 'sections.shoppable_videos.guide_step_3' | t }}</li>
        </ol>
      </aside>
    {% endif %}

    <header class="shoppable-videos__header">
      {% if section.settings.subheading != blank %}
        <p class="shoppable-videos__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 id="ShoppableVideosHeading-{{ section.id }}" class="shoppable-videos__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </header>

    {% if slides_rendered > 0 %}
      <div class="shoppable-videos__carousel" data-carousel>
        {% if section.settings.show_arrows %}
          <button
            type="button"
            class="shoppable-videos__arrow shoppable-videos__arrow--prev"
            data-carousel-prev
            aria-label="{{ 'sections.shoppable_videos.previous' | t }}"
            disabled
          >
            <span class="shoppable-videos__arrow-icon" aria-hidden="true">{% render 'icon', name: 'arrow', size: 22 %}</span>
          </button>
        {% endif %}

        <div
          class="shoppable-videos__viewport"
          data-carousel-viewport
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ 'sections.shoppable_videos.carousel_label' | t }}"
        >
          <ul class="shoppable-videos__track" data-carousel-track role="list">
            {% if section.settings.show_demo_video and collections.all.products.size > 0 %}
              {% assign demo_product = collections.all.products | first %}
              {% render 'shoppable-video-card',
                card_product: demo_product,
                mp4_url: demo_video_url,
                section: section,
                is_demo: true,
                video_label: 'Demo'
              %}
            {% elsif section.settings.show_demo_video %}
              {% render 'shoppable-video-card',
                mp4_url: demo_video_url,
                section: section,
                is_demo: true,
                video_label: 'Demo'
              %}
            {% endif %}

            {% for block in section.blocks %}
              {% if block.type != 'video' %}
                {% continue %}
              {% endif %}

              {% assign has_video = false %}
              {% if block.settings.video != blank or block.settings.video_url != blank %}
                {% assign has_video = true %}
              {% endif %}

              {% unless has_video %}
                {% unless request.design_mode %}
                  {% continue %}
                {% endunless %}
              {% endunless %}

              {% assign block_product = block.settings.product %}
              {% assign card_product = block_product %}
              {% assign is_block_preview = false %}
              {% if card_product == blank %}
                {% if request.design_mode and collections.all.products.size > 0 %}
                  {% assign card_product = collections.all.products[forloop.index0] %}
                  {% assign is_block_preview = true %}
                {% endif %}
              {% endif %}

              {% assign block_label = block.settings.video_label %}
              {% if block_label == blank and card_product != blank %}
                {% assign block_label = card_product.title %}
              {% endif %}
              {% if block_label == blank %}
                {% assign block_label = 'Video' %}
              {% endif %}

              {% render 'shoppable-video-card',
                card_product: card_product,
                hosted_video: block.settings.video,
                mp4_url: block.settings.video_url,
                poster: block.settings.poster,
                video_label: block_label,
                button_text: block.settings.button_text,
                section: section,
                is_preview: is_block_preview,
                shopify_attributes: block.shopify_attributes
              %}
            {% endfor %}

            {% for line in csv_lines %}
              {% assign line_stripped = line | strip %}
              {% if line_stripped == blank %}
                {% continue %}
              {% endif %}

              {% assign first_char = line_stripped | slice: 0, 1 %}
              {% if first_char == '#' %}
                {% continue %}
              {% endif %}

              {% assign parts = line_stripped | split: ',' %}
              {% assign csv_video_url = '' %}
              {% assign csv_label = 'Video' %}
              {% assign csv_product = blank %}
              {% if parts[0] contains 'http' %}
                {% assign csv_video_url = parts[0] | strip %}
                {% if parts[1] != blank %}
                  {% unless parts[1] contains 'http' %}
                    {% assign csv_label = parts[1] | strip %}
                  {% endunless %}
                {% endif %}
              {% elsif parts.size > 1 and parts[1] contains 'http' %}
                {% assign csv_handle = parts[0] | strip %}
                {% assign csv_video_url = parts[1] | strip %}
                {% assign csv_product = all_products[csv_handle] %}
                {% if parts[2] != blank %}
                  {% assign csv_label = parts[2] | strip %}
                {% elsif csv_product != blank %}
                  {% assign csv_label = csv_product.title %}
                {% endif %}
              {% endif %}

              {% unless csv_video_url contains 'http' %}
                {% continue %}
              {% endunless %}

              {% render 'shoppable-video-card',
                card_product: csv_product,
                mp4_url: csv_video_url,
                video_label: csv_label,
                section: section
              %}
            {% endfor %}
          </ul>
        </div>

        {% if section.settings.show_arrows %}
          <button
            type="button"
            class="shoppable-videos__arrow shoppable-videos__arrow--next"
            data-carousel-next
            aria-label="{{ 'sections.shoppable_videos.next' | t }}"
          >
            <span class="shoppable-videos__arrow-icon" aria-hidden="true">{% render 'icon', name: 'arrow', size: 22 %}</span>
          </button>
        {% endif %}
      </div>
    {% elsif section.blocks.size > 0 or section.settings.bulk_video_csv != blank %}
      <p class="shoppable-videos__empty">{{ 'sections.shoppable_videos.configure_blocks' | t }}</p>
    {% else %}
      <p class="shoppable-videos__empty">{{ 'sections.shoppable_videos.empty' | t }}</p>
    {% endif %}
  </div>

  <script type="application/json" data-shoppable-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "t:sections.shoppable_videos.name",
  "tag": "section",
  "class": "section-shoppable-videos",
  "max_blocks": 20,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.shoppable_videos.settings.intro.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shoppable_videos.settings.heading.label",
      "default": "From our farms to your kitchen"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.shoppable_videos.settings.subheading.label",
      "default": "Shop by videos"
    },
    {
      "type": "checkbox",
      "id": "show_demo_video",
      "label": "t:sections.shoppable_videos.settings.show_demo_video.label",
      "info": "t:sections.shoppable_videos.settings.show_demo_video.info",
      "default": true
    },
    {
      "type": "textarea",
      "id": "bulk_video_csv",
      "label": "t:sections.shoppable_videos.settings.bulk_video_csv.label",
      "info": "t:sections.shoppable_videos.settings.bulk_video_csv.info",
      "placeholder": "t:sections.shoppable_videos.settings.bulk_video_csv.placeholder"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Section Background Image",
      "info": "Upload custom background image from Shopify for Shoppable Videos Section."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.shoppable_videos.settings.background_color.label",
      "default": "#eef2e4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.shoppable_videos.settings.heading_color.label",
      "default": "#2e5d34"
    },
    {
      "type": "text",
      "id": "default_button_text",
      "label": "t:sections.shoppable_videos.settings.default_button_text.label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.shoppable_videos.settings.autoplay.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:sections.shoppable_videos.settings.loop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:sections.shoppable_videos.settings.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "t:sections.shoppable_videos.settings.infinite_loop.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "t:sections.shoppable_videos.blocks.video.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shoppable_videos.blocks.video.settings.product.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.shoppable_videos.blocks.video.settings.video.label"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "t:sections.shoppable_videos.blocks.video.settings.video_url.label",
          "info": "t:sections.shoppable_videos.blocks.video.settings.video_url.info"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "t:sections.shoppable_videos.blocks.video.settings.poster.label"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.shoppable_videos.blocks.video.settings.button_text.label"
        },
        {
          "type": "text",
          "id": "video_label",
          "label": "t:sections.shoppable_videos.blocks.video.settings.video_label.label",
          "info": "t:sections.shoppable_videos.blocks.video.settings.video_label.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shoppable_videos.name",
      "settings": {
        "show_demo_video": true
      },
      "blocks": [
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
