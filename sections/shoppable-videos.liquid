{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos.js' | asset_url }}" type="module"></script>

<section
  id="ShoppableVideos-{{ section.id }}"
  class="shoppable-videos"
  data-shoppable-videos
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-loop="{{ section.settings.loop }}"
  data-infinite-loop="{{ section.settings.infinite_loop }}"
  style="
    --shoppable-videos-bg: {{ section.settings.background_color }};
    --shoppable-videos-heading-color: {{ section.settings.heading_color }};
  "
  aria-labelledby="ShoppableVideosHeading-{{ section.id }}"
>
  <div class="shoppable-videos__inner">
    <header class="shoppable-videos__header">
      {% if section.settings.subheading != blank %}
        <p class="shoppable-videos__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 id="ShoppableVideosHeading-{{ section.id }}" class="shoppable-videos__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </header>

    {% assign slides_rendered = 0 %}
    {% for block in section.blocks %}
      {% if block.type != 'video' %}
        {% continue %}
      {% endif %}
      {% assign count_product = block.settings.product %}
      {% if count_product == blank %}
        {% if request.design_mode and collections.all.products.size > 0 %}
          {% assign count_product = collections.all.products[forloop.index0] %}
        {% endif %}
      {% endif %}
      {% if count_product != blank %}
        {% assign slides_rendered = slides_rendered | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if slides_rendered > 0 %}
      <div class="shoppable-videos__carousel" data-carousel>
        {% if section.settings.show_arrows %}
          <button
            type="button"
            class="shoppable-videos__arrow shoppable-videos__arrow--prev"
            data-carousel-prev
            aria-label="{{ 'sections.shoppable_videos.previous' | t }}"
            disabled
          >
            <span class="shoppable-videos__arrow-icon" aria-hidden="true">{% render 'icon', name: 'arrow', size: 22 %}</span>
          </button>
        {% endif %}

        <div
          class="shoppable-videos__viewport"
          data-carousel-viewport
          tabindex="0"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ 'sections.shoppable_videos.carousel_label' | t }}"
        >
          <ul class="shoppable-videos__track" data-carousel-track role="list">
            {% for block in section.blocks %}
              {% if block.type != 'video' %}
                {% continue %}
              {% endif %}

              {% assign block_product = block.settings.product %}
              {% assign card_product = block_product %}
              {% assign is_block_preview = false %}
              {% if card_product == blank %}
                {% if request.design_mode and collections.all.products.size > 0 %}
                  {% assign card_product = collections.all.products[forloop.index0] %}
                  {% assign is_block_preview = true %}
                {% endif %}
              {% endif %}
              {% if card_product == blank %}
                {% continue %}
              {% endif %}

              {% assign variant = card_product.selected_or_first_available_variant %}
              {% assign on_sale = false %}
              {% assign discount_percent = 0 %}
              {% if variant.compare_at_price > variant.price %}
                {% assign on_sale = true %}
                {% assign saving = variant.compare_at_price | minus: variant.price %}
                {% assign discount_percent = saving | times: 100 | divided_by: variant.compare_at_price %}
              {% endif %}

              {% assign button_label = block.settings.button_text | default: section.settings.default_button_text %}
              {% if button_label == blank %}
                {% assign button_label = 'sections.shoppable_videos.add_to_cart' | t %}
              {% endif %}

              <li
                class="shoppable-videos__slide"
                data-carousel-slide
                {{ block.shopify_attributes }}
              >
                <article
                  class="shoppable-videos__card{% if is_block_preview %} shoppable-videos__card--preview{% endif %}"
                  data-shoppable-card
                  data-variant-id="{{ variant.id }}"
                >
                  <div class="shoppable-videos__media-wrap">
                    {% if block.settings.video != blank %}
                      {{
                        block.settings.video
                        | video_tag:
                          class: 'shoppable-videos__video',
                          autoplay: false,
                          loop: section.settings.loop,
                          muted: true,
                          playsinline: true,
                          preload: 'none',
                          controls: false,
                          image_size: '720x'
                      }}
                    {% elsif block.settings.video_url != blank %}
                      <video
                        class="shoppable-videos__video"
                        muted
                        playsinline
                        preload="none"
                        {% if section.settings.loop %}loop{% endif %}
                        poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 720 }}{% elsif card_product.featured_image %}{{ card_product.featured_image | image_url: width: 720 }}{% endif %}"
                      >
                        <source src="{{ block.settings.video_url }}" type="video/mp4">
                      </video>
                    {% else %}
                      <div class="shoppable-videos__video shoppable-videos__video--placeholder">
                        {% if card_product.featured_image != blank %}
                          {{
                            card_product.featured_image
                            | image_url: width: 720
                            | image_tag:
                              class: 'shoppable-videos__poster',
                              loading: 'lazy',
                              widths: '360, 480, 720',
                              alt: card_product.title
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'shoppable-videos__poster' }}
                        {% endif %}
                      </div>
                    {% endif %}

                    <button
                      type="button"
                      class="shoppable-videos__play"
                      data-video-play
                      aria-label="{{ 'sections.shoppable_videos.play_video' | t: title: card_product.title }}"
                    >
                      <span class="shoppable-videos__play-icon" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </span>
                    </button>

                    <div class="shoppable-videos__product-panel">
                      <div class="shoppable-videos__product-card">
                        {% if block.settings.custom_badge != blank %}
                          <span class="shoppable-videos__badge">{{ block.settings.custom_badge }}</span>
                        {% elsif on_sale and block.settings.show_compare_price %}
                          <span class="shoppable-videos__badge">
                            {{ 'sections.shoppable_videos.save_percent' | t: percent: discount_percent }}
                          </span>
                        {% endif %}

                        <a
                          class="shoppable-videos__product-link"
                          href="{{ card_product.url }}"
                          aria-label="{{ 'sections.shoppable_videos.view_product' | t: title: card_product.title }}"
                        >
                          {% if block.settings.show_product_image and card_product.featured_image != blank %}
                            {{
                              card_product.featured_image
                              | image_url: width: 120
                              | image_tag:
                                class: 'shoppable-videos__product-thumb',
                                loading: 'lazy',
                                widths: '60, 80, 120',
                                alt: ''
                            }}
                          {% endif %}

                          <span class="shoppable-videos__product-copy">
                            <span class="shoppable-videos__product-title">{{ card_product.title }}</span>
                            {% if block.settings.show_price %}
                              <span class="shoppable-videos__product-price-row">
                                <span class="shoppable-videos__product-price">{{ variant.price | money }}</span>
                                {% if on_sale and block.settings.show_compare_price %}
                                  <s class="shoppable-videos__product-compare">{{ variant.compare_at_price | money }}</s>
                                {% endif %}
                              </span>
                            {% endif %}
                            <span class="shoppable-videos__stock">
                              {% if card_product.available %}
                                {{ 'sections.shoppable_videos.in_stock' | t }}
                              {% else %}
                                {{ 'sections.shoppable_videos.sold_out' | t }}
                              {% endif %}
                            </span>
                          </span>
                        </a>

                        <a
                          class="shoppable-videos__external"
                          href="{{ card_product.url }}"
                          aria-label="{{ 'sections.shoppable_videos.open_product' | t: title: card_product.title }}"
                        >
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                            <path d="M15 3h6v6"/>
                            <path d="M10 14 21 3"/>
                          </svg>
                        </a>
                      </div>

                      <div class="shoppable-videos__actions">
                        {% if is_block_preview %}
                          <p class="shoppable-videos__preview-hint">{{ 'sections.shoppable_videos.select_product_hint' | t }}</p>
                        {% endif %}
                        <button
                          type="button"
                          class="shoppable-videos__add"
                          data-add-to-cart
                          data-variant-id="{{ variant.id }}"
                          {% if is_block_preview %}disabled{% elsif card_product.available == false %}disabled{% endif %}
                        >
                          <span class="shoppable-videos__add-label" data-add-label>
                            {% if is_block_preview %}
                              {{ button_label }}
                            {% elsif card_product.available %}
                              {{ button_label }}
                            {% else %}
                              {{ 'sections.shoppable_videos.sold_out' | t }}
                            {% endif %}
                          </span>
                          <span class="shoppable-videos__add-spinner" data-add-spinner hidden aria-hidden="true"></span>
                          <span class="shoppable-videos__add-success" data-add-success hidden aria-hidden="true">
                            {% render 'icon', name: 'star', size: 18 %}
                          </span>
                        </button>
                        <a
                          class="shoppable-videos__cart-icon"
                          href="{{ routes.cart_url }}"
                          aria-label="{{ 'sections.shoppable_videos.view_cart' | t }}"
                        >
                          {% render 'icon', name: 'cart', size: 22 %}
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
              </li>
            {% endfor %}
          </ul>
        </div>

        {% if section.settings.show_arrows %}
          <button
            type="button"
            class="shoppable-videos__arrow shoppable-videos__arrow--next"
            data-carousel-next
            aria-label="{{ 'sections.shoppable_videos.next' | t }}"
          >
            <span class="shoppable-videos__arrow-icon" aria-hidden="true">{% render 'icon', name: 'arrow', size: 22 %}</span>
          </button>
        {% endif %}
      </div>
    {% elsif section.blocks.size > 0 %}
      <p class="shoppable-videos__empty">{{ 'sections.shoppable_videos.configure_blocks' | t }}</p>
    {% else %}
      <p class="shoppable-videos__empty">{{ 'sections.shoppable_videos.empty' | t }}</p>
    {% endif %}
  </div>

  <script type="application/json" data-shoppable-config>
    {
      "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
      "cartUrl": {{ routes.cart_url | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "t:sections.shoppable_videos.name",
  "tag": "section",
  "class": "section-shoppable-videos",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shoppable_videos.settings.heading.label",
      "default": "From our farms to your kitchen"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.shoppable_videos.settings.subheading.label",
      "default": "Shop by videos"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.shoppable_videos.settings.background_color.label",
      "default": "#eef2e4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.shoppable_videos.settings.heading_color.label",
      "default": "#2e5d34"
    },
    {
      "type": "text",
      "id": "default_button_text",
      "label": "t:sections.shoppable_videos.settings.default_button_text.label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.shoppable_videos.settings.autoplay.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:sections.shoppable_videos.settings.loop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:sections.shoppable_videos.settings.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "t:sections.shoppable_videos.settings.infinite_loop.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "t:sections.shoppable_videos.blocks.video.name",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.shoppable_videos.blocks.video.settings.video.label"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "t:sections.shoppable_videos.blocks.video.settings.video_url.label",
          "info": "t:sections.shoppable_videos.blocks.video.settings.video_url.info"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "t:sections.shoppable_videos.blocks.video.settings.poster.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shoppable_videos.blocks.video.settings.product.label"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "t:sections.shoppable_videos.blocks.video.settings.custom_badge.label"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.shoppable_videos.blocks.video.settings.button_text.label"
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "t:sections.shoppable_videos.blocks.video.settings.show_price.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_compare_price",
          "label": "t:sections.shoppable_videos.blocks.video.settings.show_compare_price.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_product_image",
          "label": "t:sections.shoppable_videos.blocks.video.settings.show_product_image.label",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shoppable_videos.name",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
