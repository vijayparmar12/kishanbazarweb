{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos.js' | asset_url }}" defer></script>

{% style %}
  #ShoppableVideos-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#FBF7F0' }} !important;
  }
  #ShoppableVideos-{{ section.id }} .shoppable-videos__heading {
    color: {{ section.settings.heading_color | default: '#23421F' }} !important;
    font-size: {{ section.settings.heading_font_size | default: 28 }}px !important;
    font-weight: 900 !important;
    line-height: 1.25 !important;
  }
  #ShoppableVideos-{{ section.id }} .shoppable-videos__subheading {
    font-size: {{ section.settings.subheading_font_size | default: 14 }}px !important;
  }
  #ShoppableVideos-{{ section.id }} .shoppable-videos__heading-content {
    max-width: {{ section.settings.heading_content_width_desktop | default: 80 }}% !important;
    width: 100% !important;
  }
  #ShoppableVideos-{{ section.id }} .shoppable-videos__heading-banner-wrap {
    min-height: {{ section.settings.heading_box_height_desktop | default: 140 }}px !important;
    height: auto !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
  }
  @media (max-width: 749px) {
    #ShoppableVideos-{{ section.id }} .shoppable-videos__heading {
      font-size: {{ section.settings.heading_font_size_mobile | default: 18 }}px !important;
      line-height: 1.2 !important;
    }
    #ShoppableVideos-{{ section.id }} .shoppable-videos__subheading {
      font-size: {{ section.settings.subheading_font_size_mobile | default: 12 }}px !important;
    }
    #ShoppableVideos-{{ section.id }} .shoppable-videos__heading-content {
      max-width: {{ section.settings.heading_content_width_mobile | default: 85 }}% !important;
      width: 100% !important;
    }
    #ShoppableVideos-{{ section.id }} .shoppable-videos__heading-banner-wrap {
      min-height: {{ section.settings.heading_box_height_mobile | default: 90 }}px !important;
      height: auto !important;
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 500 }}px !important;
    }
  }
{% endstyle %}

<section
  id="ShoppableVideos-{{ section.id }}"
  class="shoppable-videos"
  data-shoppable-videos
  aria-labelledby="ShoppableVideosHeading-{{ section.id }}"
>
  <div class="shoppable-videos__inner">
    
    <!-- Section Header -->
    <header class="shoppable-videos__header">
      {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
        <div class="shoppable-videos__heading-banner-wrap">
          <picture class="home-section__heading-picture">
            {% if section.settings.heading_image_mobile != blank %}
              <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
            {% endif %}
            {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
            {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
          </picture>
          {% if section.settings.heading != blank or section.settings.subheading != blank %}
            <div class="shoppable-videos__heading-content">
              {% if section.settings.heading != blank %}
                <h2 id="ShoppableVideosHeading-{{ section.id }}" class="shoppable-videos__heading">
                  {{ section.settings.heading }}
                </h2>
              {% endif %}
              {% if section.settings.subheading != blank %}
                <p class="shoppable-videos__subheading">{{ section.settings.subheading }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% else %}
        <div style="text-align: left;">
          {% if section.settings.heading != blank %}
            <h2 id="ShoppableVideosHeading-{{ section.id }}" class="shoppable-videos__heading" style="text-align: left;">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="shoppable-videos__subheading" style="text-align: left;">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <!-- Carousel Container -->
    <div class="shoppable-videos__carousel">
      <button type="button" class="shoppable-videos__arrow shoppable-videos__arrow--prev" aria-label="Previous videos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="shoppable-videos__viewport">
        <ul class="shoppable-videos__track">
          {% for block in section.blocks %}
            {% if block.type != 'video' %}
              {% continue %}
            {% endif %}

            {% assign block_product = block.settings.product %}
            {% assign hosted_vid = block.settings.video %}
            {% assign mp4_url = block.settings.video_url %}

            {% render 'shoppable-video-card',
              card_product: block_product,
              hosted_video: hosted_vid,
              mp4_url: mp4_url,
              poster: block.settings.poster,
              block: block,
              shopify_attributes: block.shopify_attributes
            %}
          {% endfor %}
        </ul>
      </div>

      <button type="button" class="shoppable-videos__arrow shoppable-videos__arrow--next" aria-label="Next videos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

  </div>

  <!-- Video Player Modal Overlay with Dark Blur Backdrop -->
  <div class="shoppable-videos__modal" id="ShoppableVideoModal" aria-hidden="true" role="dialog">
    <div class="shoppable-videos__modal-overlay" data-close-modal></div>
    <div class="shoppable-videos__modal-dialog">
      
      <!-- Top Close Button -->
      <button type="button" class="shoppable-videos__modal-close" data-close-modal aria-label="Close Video Modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <!-- Modal Video Container -->
      <div class="shoppable-videos__modal-video-wrap">
        <video class="shoppable-videos__modal-video" loop playsinline controls autoplay></video>
      </div>

      <!-- Modal Floating Product Link Overlay -->
      <a href="#" class="shoppable-videos__modal-product-pill">
        <img src="" alt="" class="shoppable-videos__modal-product-thumb" style="display: none;">
        <div class="shoppable-videos__modal-product-info">
          <h4 class="shoppable-videos__modal-product-title"></h4>
          <span class="shoppable-videos__modal-product-price"></span>
        </div>
      </a>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shoppable Videos",
  "tag": "section",
  "class": "section-shoppable-videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Us on Instagram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap, shop, and explore authentic stories from our customers and creators."
    },
    {
      "type": "image_picker",
      "id": "heading_image_desktop",
      "label": "Heading Banner Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "heading_image_mobile",
      "label": "Heading Banner Image (Mobile)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FBF7F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#23421F"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop Heading Font Size (px)",
      "min": 14,
      "max": 80,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Mobile Heading Font Size (px)",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Desktop Subheading Font Size (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "label": "Mobile Subheading Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_content_width_desktop",
      "label": "Desktop Heading Content Width (%)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "heading_content_width_mobile",
      "label": "Mobile Heading Content Width (%)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 85,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "heading_box_height_desktop",
      "label": "Desktop Heading Box Fixed Height (px)",
      "min": 60,
      "max": 400,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_box_height_mobile",
      "label": "Mobile Heading Box Fixed Height (px)",
      "min": 40,
      "max": 250,
      "step": 10,
      "default": 90,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_image_max_width",
      "label": "Desktop Heading Image Max Width (px)",
      "min": 200,
      "max": 1400,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_image_mobile_max_width",
      "label": "Mobile Heading Image Max Width (px)",
      "min": 150,
      "max": 800,
      "step": 10,
      "default": 500,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Reel",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Linked Product"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video File"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External MP4 Video URL"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video Poster Thumbnail Image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Videos Reel",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
