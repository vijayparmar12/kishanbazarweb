{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="standard-404-container" data-standard-404>
  <h1>{{ '404.title' | t }}</h1>

  <p>
    {{ '404.not_found' | t }}
  </p>

  <a href="{{ routes.all_products_collection_url }}">
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

<div id="OurStoryPageFallback" class="our-story-fallback-wrapper" style="display: none;">
  {% render 'our-story-page' %}
</div>

<script>
  (function() {
    function handle404Routes() {
      var path = window.location.pathname;
      var href = window.location.href;

      if (href.indexOf('our-story') !== -1 || path.indexOf('our-story') !== -1) {
        var fallbackEl = document.getElementById('OurStoryPageFallback');
        var std404El = document.querySelector('[data-standard-404]');
        if (std404El) {
          std404El.style.display = 'none';
        }
        if (fallbackEl) {
          fallbackEl.style.display = 'block';
        }
        return;
      }

      if (path.indexOf('/products/') === -1) return;

      try {
        var currentPathDecoded = decodeURIComponent(path).toLowerCase();
        var currentHandle = currentPathDecoded.split('/products/')[1];
        if (currentHandle) {
          currentHandle = currentHandle.split('?')[0].split('#')[0].replace(/\/$/, '');
        }

        var productGroups = [
          {
            triggers: ['khapli', 'emmer', 'atta'],
            candidates: [
              'khapli-atta-खपली-आटा',
              'khapli-atta-500g',
              'khapli-atta-1kg',
              'khapli-atta-2kg',
              'khapli-atta-5kg',
              'khapli-atta-10kg',
              'khapli-atta'
            ]
          },
          {
            triggers: ['ghee', 'bilona', 'desi-cow', 'vedic', 'gir'],
            candidates: [
              'a2-desi-cow-vedic-bilona-ghee-देसी-वैदिक-बिलोना-घी',
              'a2-desi-cow-vedic-bilona-ghee-देशी-वैदिक-बिलोना-घी',
              'gir-a2-bilona-ghee-500g',
              'gir-a2-bilona-ghee-1kg',
              'gir-a2-bilona-ghee-2kg',
              'gir-a2-bilona-ghee-5kg',
              'gir-a2-bilona-ghee-10kg',
              'a2-bilona-ghee'
            ]
          },
          {
            triggers: ['groundnut', 'peanut'],
            candidates: [
              'groundnut-oil-मूंगफली-का-तेल',
              'groundnut-oil-500g',
              'groundnut-oil-1kg',
              'groundnut-oil-2kg',
              'groundnut-oil-5kg',
              'groundnut-oil'
            ]
          },
          {
            triggers: ['mishri', 'dhaga'],
            candidates: [
              'dhaga-mishri-धागा-मिश्री',
              'dhaga-mishri-500g',
              'dhaga-mishri-1kg',
              'dhaga-mishri'
            ]
          },
          {
            triggers: ['turmeric', 'haldi'],
            candidates: [
              'turmeric-हल्दी',
              'turmeric-500g',
              'turmeric-1kg',
              'turmeric'
            ]
          },
          {
            triggers: ['olive'],
            candidates: [
              'olive-oil-जैतून-का-तेल',
              'olive-oil-500g',
              'olive-oil-1kg',
              'olive-oil'
            ]
          },
          {
            triggers: ['noodle', 'millet', 'foxtail'],
            candidates: [
              'foxtail-millet-noodles-कंगनी-बाजरे-के-नूडल्स',
              'foxtail-millet-noodles'
            ]
          }
        ];

        var matchedGroup = null;
        for (var i = 0; i < productGroups.length; i++) {
          var group = productGroups[i];
          for (var t = 0; t < group.triggers.length; t++) {
            if (currentPathDecoded.indexOf(group.triggers[t]) !== -1) {
              matchedGroup = group;
              break;
            }
          }
          if (matchedGroup) break;
        }

        if (!matchedGroup) return;

        var candidatesToTest = matchedGroup.candidates;
        var testIndex = 0;

        function testNextCandidate() {
          if (testIndex >= candidatesToTest.length) return;
          var cand = candidatesToTest[testIndex];
          testIndex++;

          if (cand.toLowerCase() === currentHandle) {
            testNextCandidate();
            return;
          }

          var testUrl = '/products/' + encodeURIComponent(cand) + '.js';
          fetch(testUrl)
            .then(function(res) {
              if (res.ok) {
                window.location.replace('/products/' + encodeURIComponent(cand));
              } else {
                testNextCandidate();
              }
            })
            .catch(function() {
              testNextCandidate();
            });
        }

        testNextCandidate();

      } catch (e) {
        console.error('404 handle auto-recovery error:', e);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', handle404Routes);
    } else {
      handle404Routes();
    }
  })();
</script>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
