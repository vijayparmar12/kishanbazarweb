{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="standard-404-container" data-standard-404>
  <h1>{{ '404.title' | t }}</h1>

  <p>
    {{ '404.not_found' | t }}
  </p>

  <a href="{{ routes.all_products_collection_url }}">
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

<div id="OurStoryPageFallback" class="our-story-fallback-wrapper" style="display: none;">
  {% render 'our-story-page' %}
</div>

<script>
  (function() {
    function handle404Routes() {
      var path = window.location.pathname;
      var href = window.location.href;

      if (href.indexOf('our-story') !== -1 || path.indexOf('our-story') !== -1) {
        var fallbackEl = document.getElementById('OurStoryPageFallback');
        var std404El = document.querySelector('[data-standard-404]');
        if (std404El) {
          std404El.style.display = 'none';
        }
        if (fallbackEl) {
          fallbackEl.style.display = 'block';
        }
        return;
      }

      if (path.indexOf('/products/') !== -1) {
        try {
          var decodedPath = decodeURIComponent(path);
          if (
            decodedPath.indexOf('bilona-ghee') !== -1 ||
            decodedPath.indexOf('ghee') !== -1 ||
            decodedPath.indexOf('desi-cow') !== -1 ||
            decodedPath.indexOf('वैदिक') !== -1 ||
            decodedPath.indexOf('बिलोना') !== -1 ||
            decodedPath.indexOf('घी') !== -1
          ) {
            window.location.replace('/products/a2-desi-cow-vedic-bilona-ghee-%E0%A4%A6%E0%A5%87%E0%A4%B8%E0%A5%80-%E0%A4%B5%E0%A5%8D%E0%A4%AF%E0%A4%A6%E0%A4%BF%E0%A4%95-%E0%A4%AC%E0%A4%BF%E0%A4%B2%E0%A5%8B%E0%A4%A8%E0%A4%BE-%E0%A4%98%E0%A5%80');
            return;
          }
          if (decodedPath.indexOf('khapli') !== -1) {
            window.location.replace('/products/khapli-atta');
            return;
          }
        } catch (e) {
          console.error('404 redirect handler error:', e);
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', handle404Routes);
    } else {
      handle404Routes();
    }
  })();
</script>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
