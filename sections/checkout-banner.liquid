{{ 'section-checkout.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-checkout.js' | asset_url }}" defer="defer"></script>

<section class="kb-checkout-banner" data-checkout-banner data-section-id="{{ section.id }}">
  <div class="kb-checkout-banner__shell">
    <header class="kb-checkout-banner__header">
      <p class="kb-checkout-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="kb-checkout-banner__title">{{ section.settings.title }}</h1>
      <p class="kb-checkout-banner__text">{{ section.settings.description }}</p>
    </header>

    {% render 'checkout-progress', current_step: 'payment' %}

    <div class="kb-checkout-banner__grid">
      <div class="kb-checkout-banner__main">
        <section class="kb-checkout-banner__card">
          <h2>{{ 'checkout.shipping_address' | t }}</h2>
          <div class="kb-checkout-banner__form-grid">
            <label><span>{{ 'checkout.full_name' | t }}</span><input type="text" autocomplete="name" placeholder="{{ 'checkout.full_name' | t }}"></label>
            <label><span>{{ 'checkout.mobile' | t }}</span><input type="tel" autocomplete="tel" placeholder="{{ 'checkout.mobile' | t }}"></label>
            <label class="kb-checkout-banner__full"><span>{{ 'checkout.email' | t }}</span><input type="email" autocomplete="email" placeholder="{{ 'checkout.email' | t }}"></label>
            <label class="kb-checkout-banner__full"><span>{{ 'checkout.address' | t }}</span><input type="text" autocomplete="street-address" placeholder="{{ 'checkout.address' | t }}"></label>
            <label><span>{{ 'checkout.city' | t }}</span><input type="text" autocomplete="address-level2" placeholder="{{ 'checkout.city' | t }}"></label>
            <label><span>{{ 'checkout.state' | t }}</span><input type="text" autocomplete="address-level1" placeholder="{{ 'checkout.state' | t }}"></label>
            <label><span>{{ 'checkout.pin_code' | t }}</span><input type="text" autocomplete="postal-code" placeholder="{{ 'checkout.pin_code' | t }}"></label>
            <label><span>{{ 'checkout.country' | t }}</span><input type="text" autocomplete="country-name" placeholder="{{ 'checkout.country' | t }}"></label>
          </div>
        </section>

        <section class="kb-checkout-banner__card">
          <h2>{{ 'checkout.delivery_options' | t }}</h2>
          <div class="kb-checkout-banner__choices" data-payment-choice-group>
            <button class="kb-checkout-banner__choice is-active" type="button" data-payment-choice="express">{{ 'checkout.express_delivery' | t }}</button>
            <button class="kb-checkout-banner__choice" type="button" data-payment-choice="standard">{{ 'checkout.standard_delivery' | t }}</button>
            <button class="kb-checkout-banner__choice" type="button" data-payment-choice="same-day">{{ 'checkout.same_day_delivery' | t }}</button>
          </div>
        </section>

        <section class="kb-checkout-banner__card">
          <h2>{{ 'checkout.payment_methods' | t }}</h2>
          <div class="kb-checkout-banner__payments" data-payment-choice-group>
            <button class="kb-checkout-banner__payment is-active" type="button" data-payment-method="card">
              {% render 'icon', name: 'credit-card', size: 20 %}
              <span>{{ 'checkout.cards' | t }}</span>
            </button>
            <button class="kb-checkout-banner__payment" type="button" data-payment-method="upi">
              {% render 'icon', name: 'bank', size: 20 %}
              <span>{{ 'checkout.upi' | t }}</span>
            </button>
            <button class="kb-checkout-banner__payment" type="button" data-payment-method="wallet">
              {% render 'icon', name: 'wallet', size: 20 %}
              <span>{{ 'checkout.wallet' | t }}</span>
            </button>
            <button class="kb-checkout-banner__payment" type="button" data-payment-method="cod">
              {% render 'icon', name: 'cash', size: 20 %}
              <span>{{ 'checkout.cash_on_delivery' | t }}</span>
            </button>
          </div>
          <p class="kb-checkout-banner__note">{{ 'checkout.payment_note' | t }}</p>
        </section>
      </div>

      <aside class="kb-checkout-banner__summary">
        {% render 'cart-summary', cart: cart, free_shipping_threshold: section.settings.free_shipping_threshold, checkout_url: routes.checkout_url %}
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.checkout_banner.title",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Checkout"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Review shipping, payment, and order details before you continue."
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "min": 0,
      "max": 9900,
      "step": 100,
      "unit": "₹",
      "default": 5000
    }
  ]
}
{% endschema %}