{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu-category.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu-category.js' | asset_url }}" defer="defer"></script>

<header
  class="kb-header{% if section.settings.enable_sticky_header %} kb-header--sticky{% endif %}{% unless template.name == 'index' %} kb-header--inner-page{% endunless %}"
  data-premium-header
  style="
    --kb-announcement-bg: {{ section.settings.announcement_background }};
    --kb-announcement-text: {{ section.settings.announcement_text_color }};
    --kb-header-bg: {{ section.settings.header_background }};
    --kb-nav-text: {{ section.settings.nav_text_color }};
    --kb-accent: {{ section.settings.accent_color }};
    --kb-feature-bg: {{ section.settings.feature_row_background }};
    --kb-logo-width: {{ section.settings.logo_width }}px;
    --kb-mega-bg: {{ section.settings.mega_background }};
    --kb-mega-text: {{ section.settings.mega_text_color }};
    --kb-mega-hover: {{ section.settings.mega_hover_color }};
    --kb-mega-wave: {{ section.settings.mega_wave_color }};
  "
>
  {% liquid
    assign ghee_link = section.settings.ghee_url
    if ghee_link == blank
      if collections.ghee != blank and collections.ghee.url != blank
        assign ghee_link = collections.ghee.url
      else
        for c in collections
          assign c_title = c.title | downcase
          if c_title contains 'ghee'
            assign ghee_link = c.url
            break
          endif
        endfor
      endif
      if ghee_link == blank
        assign ghee_link = routes.collections_url | append: '/ghee'
      endif
    endif

    assign atta_link = section.settings.atta_url
    if atta_link == blank
      if collections.atta != blank and collections.atta.url != blank
        assign atta_link = collections.atta.url
      elsif collections.aatta != blank and collections.aatta.url != blank
        assign atta_link = collections.aatta.url
      elsif collections['aatta'] != blank and collections['aatta'].url != blank
        assign atta_link = collections['aatta'].url
      elsif collections['flour-atta'] != blank and collections['flour-atta'].url != blank
        assign atta_link = collections['flour-atta'].url
      else
        for c in collections
          assign c_title = c.title | downcase
          if c_title contains 'atta' or c_title contains 'aatta' or c_title contains 'flour'
            assign atta_link = c.url
            break
          endif
        endfor
      endif

      if atta_link == blank
        assign atta_link = routes.all_products_collection_url | append: '/Atta'
      endif
    endif
  %}

  {% if section.settings.show_announcement %}
    <div class="kb-header__announcement" role="region" aria-label="Store announcement">
      <div class="kb-header__announcement-viewport">
        <p class="kb-header__announcement-text">
          <span class="kb-header__announcement-set">
            {% if section.settings.announcement_text != blank %}<span>{{ section.settings.announcement_text }}</span>{% endif %}
            {% if section.settings.announcement_text_2 != blank %}<span>{{ section.settings.announcement_text_2 }}</span>{% endif %}
            {% if section.settings.announcement_text_3 != blank %}<span>{{ section.settings.announcement_text_3 }}</span>{% endif %}
          </span>
          <span class="kb-header__announcement-set" aria-hidden="true">
            {% if section.settings.announcement_text != blank %}<span>{{ section.settings.announcement_text }}</span>{% endif %}
            {% if section.settings.announcement_text_2 != blank %}<span>{{ section.settings.announcement_text_2 }}</span>{% endif %}
            {% if section.settings.announcement_text_3 != blank %}<span>{{ section.settings.announcement_text_3 }}</span>{% endif %}
          </span>
        </p>
      </div>
    </div>
  {% endif %}

  <!-- HEADER 1: SEARCH, LOGO, PROFILE, WISHLIST, CART (ALWAYS STICKY AT TOP) -->
  <header class="kb-header1" data-header1>
    <div class="kb-header__main-grid">
      <button class="kb-header__menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="kb-mobile-menu-{{ section.id }}" data-menu-toggle>
        {% render 'icon', name: 'menu', size: 24 %}
      </button>

      {% if section.settings.show_search %}
        <form class="kb-header__search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="kb-header-search-{{ section.id }}"></label>
          <span class="kb-header__search-icon" aria-hidden="true">{% render 'icon', name: 'search', size: 22 %}</span>
          <input
            id="kb-header-search-{{ section.id }}"
            class="kb-header__search-input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_fallback_placeholder | escape }}"
            autocomplete="off"
            data-typing-search
          >
          <button class="kb-header__search-submit" type="submit" aria-label="Submit search">{% render 'icon', name: 'search', size: 20 %}</button>
          <button class="kb-header__search-clear" type="button" aria-label="Clear search" data-search-clear>{% render 'icon', name: 'close', size: 24 %}</button>
        </form>
        <script type="application/json" data-placeholder-source>{{ section.settings.search_placeholders | json }}</script>
      {% endif %}

      <a class="kb-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'kb-header__logo-image', alt: shop.name, widths: '120, 160, 200, 240, 320', loading: 'eager', fetchpriority: 'high' }}
        {% else %}
          <img class="kb-header__logo-image" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo_width }}" height="80" loading="eager" fetchpriority="high">
        {% endif %}
      </a>

      <div class="kb-header__actions" aria-label="Header actions">
        {% if section.settings.show_account %}
          <a class="kb-header__action" href="{{ routes.account_url }}" aria-label="Account" data-customer-login-trigger>{% render 'icon', name: 'user', size: 25 %}</a>
        {% endif %}
        {% if section.settings.show_wishlist %}
          <button class="kb-header__action kb-header__action--wishlist" type="button" aria-label="Wishlist" data-wishlist-drawer-trigger>
            {% render 'icon', name: 'heart', size: 25 %}<span class="kb-header__badge" aria-hidden="true" data-wishlist-count-badge>0</span>
          </button>
        {% endif %}
        {% if section.settings.show_cart %}
          <button class="kb-header__action kb-header__action--cart" type="button" aria-label="Cart, {{ cart.item_count }} items" aria-controls="CartDrawer" data-cart-drawer-trigger>
            {% render 'icon', name: 'cart', size: 26 %}<span class="kb-header__badge kb-header__badge--cart" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
          </button>
        {% endif %}
      </div>
    </div>
  </header>
  <div class="kb-header1-placeholder" data-header1-placeholder style="display: none; height: 70px;"></div>

  <!-- HEADER 2: NAVIGATION LINKS & FEATURES (SCROLLS NATURALLY BELOW HEADER 1) -->
  <div class="kb-header2" data-header2>
    <nav class="kb-header__nav" aria-label="Main navigation">
      <ul class="kb-header__nav-list" role="list">
        <li class="kb-header__nav-item"><a class="kb-header__nav-link" href="{{ ghee_link }}">{{ section.settings.ghee_title }}</a></li>
        <li class="kb-header__nav-item"><a class="kb-header__nav-link" href="{{ atta_link }}">{{ section.settings.atta_title }}</a></li>
        <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
          <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-category-{{ section.id }}" data-mega-trigger>{{ section.settings.category_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
          {% render 'mega-menu', section: section, menu_type: 'category' %}
        </li>
        <li class="kb-header__nav-item"><a class="kb-header__nav-link" href="/pages/membership" data-membership-trigger>{{ section.settings.collective_title }}</a></li>
        <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
          <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-concern-{{ section.id }}" data-mega-trigger>{{ section.settings.concern_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
          {% render 'mega-menu', section: section, menu_type: 'concern' %}
        </li>
        <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
          <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-farm-{{ section.id }}" data-mega-trigger>{{ section.settings.farm_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
          {% render 'mega-menu', section: section, menu_type: 'farm' %}
        </li>
        <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
          <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-customers-{{ section.id }}" data-mega-trigger>{{ section.settings.customers_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
          {% render 'mega-menu', section: section, menu_type: 'customers' %}
        </li>
      </ul>
    </nav>
  </div>

  <nav class="kb-header__mobile-menu" id="kb-mobile-menu-{{ section.id }}" aria-label="Mobile navigation" hidden data-mobile-menu>
    <div class="kb-header__mobile-backdrop" data-menu-close></div>
    <div class="kb-header__mobile-panel">
      <div class="kb-header__mobile-panel-top">
        <span class="kb-header__mobile-title">Menu</span>
        <button class="kb-header__mobile-close" type="button" aria-label="Close menu" data-menu-close>{% render 'icon', name: 'close', size: 24 %}</button>
      </div>
      <ul class="kb-header__mobile-list" role="list">
        <li><a class="kb-header__mobile-link" href="{{ ghee_link }}">{{ section.settings.ghee_title }}</a></li>
        <li><a class="kb-header__mobile-link" href="{{ atta_link }}">{{ section.settings.atta_title }}</a></li>
        <li>{% render 'mega-menu', section: section, menu_type: 'category', mobile: true %}</li>
        <li><a class="kb-header__mobile-link" href="/pages/membership" data-membership-trigger>{{ section.settings.collective_title }}</a></li>
        <li>{% render 'mega-menu', section: section, menu_type: 'concern', mobile: true %}</li>
        <li>{% render 'mega-menu', section: section, menu_type: 'farm', mobile: true %}</li>
        <li>{% render 'mega-menu', section: section, menu_type: 'customers', mobile: true %}</li>
      </ul>
      <div class="kb-header__mobile-account-wrap">
        <button type="button" class="kb-header__mobile-account-btn" data-customer-login-trigger>
          {% render 'icon', name: 'user', size: 22 %}
          <span data-mobile-account-text>My Profile / Login</span>
        </button>
      </div>
    </div>
  </nav>

  <section class="kb-header__features" aria-label="Featured shopping links">
    <div class="kb-header__features-inner">
      {% assign feature_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'feature_icon' %}
          {% assign feature_count = feature_count | plus: 1 %}
          {% assign default_feature_url = routes.all_products_collection_url %}
          {% if block.settings.title contains 'Membership' or block.settings.title contains 'Collective' %}
            {% assign default_feature_url = '/pages/membership' %}
          {% endif %}
          <a class="kb-header__feature" href="{{ block.settings.link | default: default_feature_url }}" {% if block.settings.title contains 'Membership' or block.settings.title contains 'Collective' %}data-membership-trigger{% endif %} style="--kb-feature-icon-bg: {{ block.settings.icon_background }}; --kb-feature-icon-color: {{ block.settings.icon_color }};" {{ block.shopify_attributes }}>
            <span class="kb-header__feature-icon" aria-hidden="true">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', widths: '48, 72, 96', loading: 'lazy', class: 'kb-header__feature-image' }}
              {% elsif block.settings.icon == 'Gift' %}
                <span class="kb-header__feature-icon-art kb-header__feature-icon--gift"></span>
              {% elsif block.settings.icon == 'Rain' %}
                <span class="kb-header__feature-icon-art kb-header__feature-icon--monsoon"></span>
              {% elsif block.settings.icon == 'Box' %}
                <span class="kb-header__feature-icon-art kb-header__feature-icon--box"></span>
              {% elsif block.settings.icon == 'Jar' %}
                <span class="kb-header__feature-icon-art kb-header__feature-icon--jar"></span>
              {% elsif block.settings.icon == 'Save' %}
                <span class="kb-header__feature-icon-art kb-header__feature-icon--save"></span>
              {% else %}
                {{ block.settings.icon }}
              {% endif %}
            </span>
            <span class="kb-header__feature-title">{{ block.settings.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
      {% if feature_count == 0 %}
        <a class="kb-header__feature kb-header__feature--gift" href="/pages/membership" data-membership-trigger>
          <span class="kb-header__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="9" width="18" height="11" rx="2"/>
              <path d="M12 9v11"/>
              <path d="M3 13h18"/>
              <path d="M7.5 9c-2 0-3-1.8-1.5-3.2S9.5 7 12 9c2.5-2 4.5-4.6 6-3.2S16.5 9 14.5 9"/>
            </svg>
          </span>
          <span class="kb-header__feature-title">Membership Deals</span>
        </a>
        <a class="kb-header__feature kb-header__feature--monsoon" href="{{ routes.all_products_collection_url }}">
          <span class="kb-header__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 15.6A4.5 4.5 0 0 0 16.5 7h-1.8A7 7 0 1 0 4 14.3"/>
              <path d="M8 15v4"/>
              <path d="M12 15v4"/>
              <path d="M16 15v4"/>
              <path d="M10 11l.01-.01"/>
              <path d="M14 10l.01-.01"/>
            </svg>
          </span>
          <span class="kb-header__feature-title">Monsoon Special</span>
        </a>
        <a class="kb-header__feature kb-header__feature--new" href="{{ routes.all_products_collection_url }}">
          <span class="kb-header__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3L2 8l10 5 10-5-10-5z"/>
              <path d="M2 13l10 5 10-5"/>
              <path d="M2 18l10 5 10-5"/>
            </svg>
          </span>
          <span class="kb-header__feature-title">New Launches</span>
        </a>
        <a class="kb-header__feature kb-header__feature--all" href="{{ routes.all_products_collection_url }}">
          <span class="kb-header__feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="9" width="9" height="11" rx="2"/>
              <path d="M6 5h5v4H6z"/>
              <rect x="15" y="12" width="5" height="8" rx="1"/>
              <path d="M16.5 9h2v3h-2z"/>
            </svg>
          </span>
          <span class="kb-header__feature-title">All Products</span>
        </a>
        <a class="kb-header__feature kb-header__feature--save" href="{{ routes.all_products_collection_url }}">
          <span class="kb-header__feature-icon kb-header__feature-icon--text" aria-hidden="true">
            <span class="kb-header__feature-text-badge">Under<br>₹999</span>
          </span>
          <span class="kb-header__feature-title">Under ₹999</span>
        </a>
      {% endif %}
    </div>
  </section>
</header>

{% schema %}
{
  "name": "Premium custom header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Announcement text 1", "default": "Big Savings Alert! Get 10% OFF on orders above Rs.3000 | Use code: TBOF10" },
    { "type": "text", "id": "announcement_text_2", "label": "Announcement text 2", "default": "Enjoy free shipping on orders above Rs.1499 | Shop now" },
    { "type": "text", "id": "announcement_text_3", "label": "Announcement text 3", "default": "Farm-fresh staples delivered to your doorstep" },
    { "type": "color", "id": "announcement_background", "label": "Announcement background", "default": "#23421F" },
    { "type": "color", "id": "announcement_text_color", "label": "Announcement text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Header" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 90, "max": 320, "step": 10, "unit": "px", "default": 220 },
    { "type": "checkbox", "id": "enable_sticky_header", "label": "Enable sticky header", "default": true },
    { "type": "color", "id": "header_background", "label": "Header background", "default": "#FFFFFF" },
    { "type": "color", "id": "nav_text_color", "label": "Navigation text", "default": "#23421F" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#23421F" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_fallback_placeholder", "label": "Fallback placeholder", "default": "Search For Jaggery" },
    { "type": "textarea", "id": "search_placeholders", "label": "Animated placeholder list", "info": "Add one placeholder per line.", "default": "Search For Jaggery\nSearch for Ghee\nSearch for Atta\nSearch for Oil\nSearch for Rice" },
    { "type": "header", "content": "Navigation titles and links" },
    { "type": "text", "id": "ghee_title", "label": "Ghee title", "default": "Ghee" },
    { "type": "url", "id": "ghee_url", "label": "Ghee link" },
    { "type": "text", "id": "atta_title", "label": "Atta title", "default": "Atta" },
    { "type": "url", "id": "atta_url", "label": "Atta link" },
    { "type": "text", "id": "category_title", "label": "Shop by category title", "default": "Shop By Category" },
    { "type": "text", "id": "collective_title", "label": "Join Collective title", "default": "Join Collective" },
    { "type": "url", "id": "collective_url", "label": "Join Collective link" },
    { "type": "text", "id": "concern_title", "label": "Shop by concern title", "default": "Shop By Concern" },
    { "type": "text", "id": "farm_title", "label": "Farm Life title", "default": "Farm Life" },
    { "type": "text", "id": "customers_title", "label": "Customers title", "default": "Customers" },
    { "type": "header", "content": "Mega menu design" },
    { "type": "checkbox", "id": "enable_category_mega", "label": "Enable category mega menu", "default": true },
    { "type": "checkbox", "id": "enable_concern_mega", "label": "Enable concern mega menu", "default": true },
    { "type": "checkbox", "id": "enable_farm_mega", "label": "Enable farm mega menu", "default": true },
    { "type": "checkbox", "id": "enable_customers_mega", "label": "Enable customers mega menu", "default": true },
    { "type": "text", "id": "category_button_text", "label": "Category button text", "default": "Shop All" },
    { "type": "url", "id": "category_button_url", "label": "Category button link" },
    { "type": "image_picker", "id": "farm_mega_image", "label": "Farm Life mega image" },
    { "type": "image_picker", "id": "mega_wave_image", "label": "Mega menu wave image" },
    { "type": "color", "id": "mega_background", "label": "Mega background", "default": "#FFFFFF" },
    { "type": "color", "id": "mega_text_color", "label": "Mega text", "default": "#23421F" },
    { "type": "color", "id": "mega_hover_color", "label": "Mega hover background", "default": "#F1F8EC" },
    { "type": "color", "id": "mega_wave_color", "label": "Wave color", "default": "#EAF5E3" },
    { "type": "header", "content": "Actions" },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist icon", "default": true },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link" },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart icon", "default": true },
    { "type": "header", "content": "Feature row" },
    { "type": "color", "id": "feature_row_background", "label": "Feature row background", "default": "#FAF6EC" }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category mega card",
      "limit": 8,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Oil" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Cold Pressed Oils" },
        { "type": "url", "id": "url", "label": "Custom URL" }
      ]
    },
    {
      "type": "mega_link",
      "name": "Mega menu item",
      "settings": [
        { "type": "select", "id": "menu_group", "label": "Mega menu", "options": [
          { "value": "category", "label": "Shop By Category" },
          { "value": "concern", "label": "Shop By Concern" },
          { "value": "farm_left", "label": "Farm Life left column" },
          { "value": "farm_middle", "label": "Farm Life middle column" },
          { "value": "farm_right", "label": "Farm Life right column" },
          { "value": "customers", "label": "Customers" }
        ], "default": "category" },
        { "type": "text", "id": "title", "label": "Title", "default": "Oil" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "icon", "label": "SVG icon or emoji", "info": "Paste inline SVG or use a short emoji.", "default": "Oil" }
      ]
    },
    {
      "type": "feature_icon",
      "name": "Feature icon",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Membership Deals" },
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "Gift" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#23421F" },
        { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#F0D78A" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium custom header",
      "blocks": [
