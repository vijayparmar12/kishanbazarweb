
{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu.css' | asset_url | stylesheet_tag }}
{{ 'mega-menu-category.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu-category.js' | asset_url }}" defer="defer"></script>

{% style %}
  .kb-header {
    --kb-announcement-bg: {{ section.settings.announcement_background }};
    --kb-announcement-text: {{ section.settings.announcement_text_color }};
    --kb-header-bg: {{ section.settings.header_background | default: '#ffffff' }};
    --kb-nav-text: {{ section.settings.nav_text_color }};
    --kb-accent: {{ section.settings.accent_color }};
    --kb-feature-bg: {{ section.settings.feature_row_background }};
    --kb-logo-width: {{ section.settings.logo_width }}px;
    --kb-mega-bg: {{ section.settings.mega_background }};
    --kb-mega-text: {{ section.settings.mega_text_color }};
    --kb-mega-hover: {{ section.settings.mega_hover_color }};
    --kb-mega-wave: {{ section.settings.mega_wave_color }};
    background-image: none !important;
  }
{% endstyle %}

<header
  class="kb-header{% if section.settings.enable_sticky_header %} kb-header--sticky{% endif %}{% unless template.name == 'index' %} kb-header--inner-page{% endunless %}"
  data-premium-header
>
  <!-- STICKY TOP CONTAINER: ANNOUNCEMENT BAR + HEADER 1 (SEARCH, LOGO, PROFILE, WISHLIST, CART) -->
  <div class="kb-header-top-sticky" data-header-top-sticky>
    {% if section.settings.show_announcement %}
      <div class="kb-header__announcement" role="region" aria-label="Store announcement">
        <div class="kb-header__announcement-viewport">
          <p class="kb-header__announcement-text">
            <span class="kb-header__announcement-set">
              {% if section.settings.announcement_text != blank %}<span>{{ section.settings.announcement_text }}</span>{% endif %}
              {% if section.settings.announcement_text_2 != blank %}<span>{{ section.settings.announcement_text_2 }}</span>{% endif %}
              {% if section.settings.announcement_text_3 != blank %}<span>{{ section.settings.announcement_text_3 }}</span>{% endif %}
            </span>
            <span class="kb-header__announcement-set" aria-hidden="true">
              {% if section.settings.announcement_text != blank %}<span>{{ section.settings.announcement_text }}</span>{% endif %}
              {% if section.settings.announcement_text_2 != blank %}<span>{{ section.settings.announcement_text_2 }}</span>{% endif %}
              {% if section.settings.announcement_text_3 != blank %}<span>{{ section.settings.announcement_text_3 }}</span>{% endif %}
            </span>
          </p>
        </div>
      </div>
    {% endif %}
    <header class="kb-header1" data-header1>
      <div class="kb-header__main-grid">
        <button class="kb-header__menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="kb-mobile-menu-{{ section.id }}" data-menu-toggle>
          {% render 'icon', name: 'menu', size: 24 %}
        </button>

        {% if section.settings.show_search %}
          <form class="kb-header__search" action="{{ routes.search_url }}" method="get" role="search">
            <label class="visually-hidden" for="kb-header-search-{{ section.id }}"></label>
            <span class="kb-header__search-icon" aria-hidden="true">{% render 'icon', name: 'search', size: 22 %}</span>
            <input
              id="kb-header-search-{{ section.id }}"
              class="kb-header__search-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_fallback_placeholder | escape }}"
              autocomplete="off"
              data-typing-search
            >
            <button class="kb-header__search-submit" type="submit" aria-label="Submit search">{% render 'icon', name: 'search', size: 20 %}</button>
            <button class="kb-header__search-clear" type="button" aria-label="Clear search" data-search-clear>{% render 'icon', name: 'close', size: 24 %}</button>
          </form>
          <script type="application/json" data-placeholder-source>{{ section.settings.search_placeholders | json }}</script>
        {% endif %}

        <a class="kb-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'kb-header__logo-image', alt: shop.name, widths: '120, 160, 200, 240, 320', loading: 'eager', fetchpriority: 'high' }}
          {% else %}
            <img class="kb-header__logo-image" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo_width }}" height="80" loading="eager" fetchpriority="high">
          {% endif %}
        </a>

        <div class="kb-header__actions" aria-label="Header actions">
          {% if section.settings.show_account %}
            <a class="kb-header__action kb-header__action--account" href="{{ routes.account_url }}" aria-label="Account" data-customer-login-trigger>{% render 'icon', name: 'user', size: 25 %}</a>
          {% endif %}
          {% if section.settings.show_wishlist %}
            <button class="kb-header__action kb-header__action--wishlist" type="button" aria-label="Wishlist" data-wishlist-drawer-trigger>
              {% render 'icon', name: 'heart', size: 25 %}<span class="kb-header__badge" aria-hidden="true" data-wishlist-count-badge>0</span>
            </button>
          {% endif %}
          {% if section.settings.show_cart %}
            <button class="kb-header__action kb-header__action--cart" type="button" aria-label="Cart, {{ cart.item_count }} items" aria-controls="CartDrawer" data-cart-drawer-trigger>
              {% render 'icon', name: 'cart', size: 26 %}<span class="kb-header__badge kb-header__badge--cart" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
            </button>
          {% endif %}
        </div>
      </div>
    </header>
  </div>
  <div class="kb-header-top-placeholder" data-header-top-placeholder style="display: none; height: 110px;"></div>

  <!-- HEADER 2: NAVIGATION LINKS & FEATURES (SCROLLS NATURALLY BELOW HEADER 1) -->
  <div class="kb-header2" data-header2>
    <nav class="kb-header__nav" aria-label="Main navigation">
      <ul class="kb-header__nav-list" role="list">
        {% assign total_nav_count = 0 %}
        {% assign desktop_menu = section.settings.menu %}
        {% if desktop_menu == blank or desktop_menu.links.size == 0 %}
          {% assign desktop_menu = linklists['main-menu'] %}
        {% endif %}

        {% if desktop_menu != blank and desktop_menu.links.size > 0 %}
          {% for link in desktop_menu.links %}
            {% assign total_nav_count = total_nav_count | plus: 1 %}
            {% if link.links.size > 0 %}
              <li class="kb-header__nav-item kb-header__nav-item--has-dropdown" data-dropdown-item>
                <a class="kb-header__nav-link" href="{{ link.url }}">
                  <span>{{ link.title }}</span>
                  <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span>
                </a>
                <ul class="kb-header__submenu" role="list">
                  {% for childlink in link.links %}
                    <li>
                      <a href="{{ childlink.url }}" class="kb-header__submenu-link">{{ childlink.title }}</a>
                      {% if childlink.links.size > 0 %}
                        <ul class="kb-header__submenu-child-list" role="list">
                          {% for grandchildlink in childlink.links %}
                            <li>
                              <a href="{{ grandchildlink.url }}" class="kb-header__submenu-link kb-header__submenu-link--grandchild">{{ grandchildlink.title }}</a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              <li class="kb-header__nav-item">
                <a class="kb-header__nav-link" href="{{ link.url }}">
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'nav_item' or block.type == 'desktop_nav_item' %}
            {% assign target = block.settings.display_target | default: 'desktop' %}
            {% if block.type == 'desktop_nav_item' or target == 'desktop' or target == 'all' %}
              {% assign total_nav_count = total_nav_count | plus: 1 %}
              {% assign mega_type = block.settings.mega_menu | default: 'none' %}
              {% if mega_type != 'none' and mega_type != blank %}
                <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item {{ block.shopify_attributes }}>
                  <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-{{ mega_type }}-{{ section.id }}" data-mega-trigger>
                    {% if block.settings.icon_image != blank %}
                      {{ block.settings.icon_image | image_url: width: 48 | image_tag: class: 'kb-nav-icon-img', loading: 'lazy' }}
                    {% elsif block.settings.icon != blank %}
                      <span aria-hidden="true">{{ block.settings.icon }}</span>
                    {% endif %}
                    <span>{{ block.settings.title }}</span>
                    {% if block.settings.badge != blank %}
                      <span class="kb-nav-badge" style="{% if block.settings.badge_background != blank %}background-color: {{ block.settings.badge_background }};{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }};{% endif %}">{{ block.settings.badge }}</span>
                    {% endif %}
                    <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span>
                  </button>
                  {% render 'mega-menu', section: section, menu_type: mega_type %}
                </li>
              {% else %}
                <li class="kb-header__nav-item" {{ block.shopify_attributes }}>
                  <a class="kb-header__nav-link{% if block.settings.icon_image != blank or block.settings.icon != blank %} kb-header__nav-link--icon{% endif %}" href="{{ block.settings.url | default: routes.all_products_collection_url }}">
                    {% if block.settings.icon_image != blank %}
                      {{ block.settings.icon_image | image_url: width: 48 | image_tag: class: 'kb-nav-icon-img', loading: 'lazy' }}
                    {% elsif block.settings.icon != blank %}
                      <span aria-hidden="true">{{ block.settings.icon }}</span>
                    {% endif %}
                    <span>{{ block.settings.title }}</span>
                    {% if block.settings.badge != blank %}
                      <span class="kb-nav-badge" style="{% if block.settings.badge_background != blank %}background-color: {{ block.settings.badge_background }};{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }};{% endif %}">{{ block.settings.badge }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if total_nav_count == 0 %}
          <li class="kb-header__nav-item">
            <a class="kb-header__nav-link kb-header__nav-link--icon" href="{{ section.settings.ghee_url | default: routes.collections_url }}">
              <span>{{ section.settings.ghee_title }}</span>
            </a>
          </li>
          <li class="kb-header__nav-item">
            <a class="kb-header__nav-link kb-header__nav-link--icon" href="{{ section.settings.atta_url | default: routes.collections_url }}">
              <span>{{ section.settings.atta_title }}</span>
            </a>
          </li>
          <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
            <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-category-{{ section.id }}" data-mega-trigger>{{ section.settings.category_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
            {% render 'mega-menu', section: section, menu_type: 'category' %}
          </li>
          <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
            <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-farm-{{ section.id }}" data-mega-trigger>
              <span>{{ section.settings.farm_title }}</span>
              <span class="kb-nav-sprout-icon" aria-hidden="true" style="display: inline-flex; align-items: center; justify-content: center; margin-left: 2px;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#23421f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22V12"/>
                  <path d="M12 12c-3 0-6-3-6-7 4 0 6 3 6 7z"/>
                  <path d="M12 14c3 0 5-2.5 5-6-3.5 0-5 2.5-5 6z"/>
                </svg>
              </span>
              <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span>
            </button>
            {% render 'mega-menu', section: section, menu_type: 'farm' %}
          </li>
          <li class="kb-header__nav-item kb-header__nav-item--mega" data-mega-item>
            <button class="kb-header__nav-link kb-header__nav-button" type="button" aria-expanded="false" aria-controls="MegaMenu-customers-{{ section.id }}" data-mega-trigger>{{ section.settings.customers_title }} <span class="kb-header__nav-caret" aria-hidden="true">&dtrif;</span></button>
            {% render 'mega-menu', section: section, menu_type: 'customers' %}
          </li>
        {% endif %}
      </ul>
    </nav>
  </div>

  <nav class="kb-header__mobile-menu" id="kb-mobile-menu-{{ section.id }}" aria-label="Mobile navigation" hidden data-mobile-menu>
    <div class="kb-header__mobile-backdrop" data-menu-close></div>
    <div class="kb-header__mobile-panel">
      <div class="kb-header__mobile-panel-top">
        <span class="kb-header__mobile-title">Menu</span>
        <button class="kb-header__mobile-close" type="button" aria-label="Close menu" data-menu-close>{% render 'icon', name: 'close', size: 24 %}</button>
      </div>
      <ul class="kb-header__mobile-list" role="list">
        {% assign target_handle = section.settings.mobile_menu %}
        {% if target_handle == blank %}
          {% assign target_handle = section.settings.menu %}
        {% endif %}
        {% if target_handle == blank %}
          {% assign target_handle = 'main-menu' %}
        {% endif %}

        {% assign active_mobile_linklist = linklists[target_handle] %}

        {% if active_mobile_linklist != blank and active_mobile_linklist.links.size > 0 %}
          {% for link in active_mobile_linklist.links %}
            {% assign link_title_lower = link.title | downcase %}

            {% if link_title_lower contains 'category' or link_title_lower contains 'shop by category' %}
              <li class="kb-header__mobile-item">
                {% render 'mega-menu', section: section, menu_type: 'category', mobile: true, custom_title: link.title %}
              </li>
            {% elsif link_title_lower contains 'farm' %}
              <li class="kb-header__mobile-item">
                {% render 'mega-menu', section: section, menu_type: 'farm', mobile: true, custom_title: link.title %}
              </li>
            {% elsif link_title_lower contains 'customer' %}
              <li class="kb-header__mobile-item">
                {% render 'mega-menu', section: section, menu_type: 'customers', mobile: true, custom_title: link.title %}
              </li>
            {% elsif link.links.size > 0 %}
              <li class="kb-header__mobile-item">
                <details class="kb-mega-mobile" data-mega-mobile>
                  <summary class="kb-header__mobile-link kb-mega-mobile__summary">
                    <span>{{ link.title }}</span>
                    <span class="kb-mega-mobile__icon" aria-hidden="true">
                      <svg class="kb-mega-mobile__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="kb-mega-mobile__content">
                    <ul class="kb-header__mobile-child-list" role="list">
                      {% for childlink in link.links %}
                        {% if childlink.links.size > 0 %}
                          <li class="kb-header__mobile-child-item">
                            <details class="kb-mega-mobile kb-mega-mobile--sub" data-mega-mobile>
                              <summary class="kb-header__mobile-link kb-header__mobile-link--sub">
                                <span>{{ childlink.title }}</span>
                                <span class="kb-mega-mobile__icon" aria-hidden="true">
                                  <svg class="kb-mega-mobile__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                  </svg>
                                </span>
                              </summary>
                              <ul class="kb-header__mobile-grandchild-list" role="list">
                                {% for grandchildlink in childlink.links %}
                                  <li>
                                    <a href="{{ grandchildlink.url }}" class="kb-header__mobile-grandchild-link">{{ grandchildlink.title }}</a>
                                  </li>
                                {% endfor %}
                              </ul>
                            </details>
                          </li>
                        {% else %}
                          <li class="kb-header__mobile-child-item">
                            <a href="{{ childlink.url }}" class="kb-header__mobile-child-link">{{ childlink.title }}</a>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                </details>
              </li>
            {% else %}
              <li class="kb-header__mobile-item">
                <a class="kb-header__mobile-link" href="{{ link.url }}">
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        {% endif %}

        {% for block in section.blocks %}
          {% if block.type == 'nav_item' or block.type == 'mobile_nav_item' %}
            {% assign target = block.settings.display_target | default: 'mobile' %}
            {% if block.type == 'mobile_nav_item' or target == 'mobile' or target == 'all' %}
              {% assign mega_type = block.settings.mega_menu | default: 'none' %}
              {% if mega_type != 'none' and mega_type != blank %}
                <li class="kb-header__mobile-item" {{ block.shopify_attributes }}>
                  {% render 'mega-menu', section: section, menu_type: mega_type, mobile: true, custom_title: block.settings.title %}
                </li>
              {% else %}
                <li class="kb-header__mobile-item" {{ block.shopify_attributes }}>
                  <a class="kb-header__mobile-link" href="{{ block.settings.url | default: routes.all_products_collection_url }}">
                    <span>{{ block.settings.title }}</span>
                    {% if block.settings.badge != blank %}
                      <span class="kb-nav-badge" style="{% if block.settings.badge_background != blank %}background-color: {{ block.settings.badge_background }};{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }};{% endif %}">{{ block.settings.badge }}</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
      <div class="kb-header__mobile-account-wrap">
        <button type="button" class="kb-header__mobile-account-btn" data-customer-login-trigger>
          {% render 'icon', name: 'user', size: 20 %}
          <span data-mobile-account-text>My Profile / Login</span>
        </button>
      </div>
    </div>
  </nav>

  {% unless template.name == 'product' or page.handle == 'contact' or template.suffix == 'contact' %}
    <section class="kb-header__features" aria-label="Featured shopping links">
      <div class="kb-header__features-inner">
        {% assign feature_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'feature_icon' %}
            {% assign feature_count = feature_count | plus: 1 %}
            {% assign default_feature_url = routes.all_products_collection_url %}
            <a class="kb-header__feature" href="{{ block.settings.link | default: default_feature_url }}" style="--kb-feature-icon-bg: {{ block.settings.icon_background }}; --kb-feature-icon-color: {{ block.settings.icon_color }};" {{ block.shopify_attributes }}>
              <span class="kb-header__feature-icon" aria-hidden="true">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', widths: '48, 72, 96', loading: 'lazy', class: 'kb-header__feature-image' }}
                {% elsif block.settings.icon == 'Gift' %}
                  <span class="kb-header__feature-icon-art kb-header__feature-icon--gift"></span>
                {% elsif block.settings.icon == 'Rain' %}
                  <span class="kb-header__feature-icon-art kb-header__feature-icon--monsoon"></span>
                {% elsif block.settings.icon == 'Box' %}
                  <span class="kb-header__feature-icon-art kb-header__feature-icon--box"></span>
                {% elsif block.settings.icon == 'Jar' %}
                  <span class="kb-header__feature-icon-art kb-header__feature-icon--jar"></span>
                {% elsif block.settings.icon == 'Save' %}
                  <span class="kb-header__feature-icon-art kb-header__feature-icon--save"></span>
                {% else %}
                  {{ block.settings.icon }}
                {% endif %}
              </span>
              <span class="kb-header__feature-text-group">
                {% if block.settings.badge != blank %}
                  <span class="kb-header__feature-badge" style="{% if block.settings.badge_background != blank %}background-color: {{ block.settings.badge_background }};{% endif %}{% if block.settings.badge_color != blank %}color: {{ block.settings.badge_color }};{% endif %}">{{ block.settings.badge }}</span>
                {% endif %}
                <span class="kb-header__feature-title">{{ block.settings.title }}</span>
              </span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endunless %}
</header>

{% schema %}
{
  "name": "Premium custom header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "announcement_text", "label": "Announcement text 1", "default": "Big Savings Alert! Get 10% OFF on orders above Rs.3000 | Use code: TBOF10" },
    { "type": "text", "id": "announcement_text_2", "label": "Announcement text 2", "default": "Enjoy free shipping on orders above Rs.1499 | Shop now" },
    { "type": "text", "id": "announcement_text_3", "label": "Announcement text 3", "default": "Farm-fresh staples delivered to your doorstep" },
    { "type": "color", "id": "announcement_background", "label": "Announcement background", "default": "#23421F" },
    { "type": "color", "id": "announcement_text_color", "label": "Announcement text color", "default": "#FFFFFF" },
    { "type": "header", "content": "Header Styling & Colors" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 90, "max": 320, "step": 10, "unit": "px", "default": 220 },
    { "type": "checkbox", "id": "enable_sticky_header", "label": "Enable sticky header", "default": true },
    { "type": "color", "id": "header_background", "label": "Header background color", "default": "#FFFFFF" },
    { "type": "header", "content": "Header Background Images (Theme Editor)" },
    { "type": "image_picker", "id": "background_image", "label": "Custom Background Image", "info": "Upload custom background image for Header (like Best Sellers section)" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "header_background_image_desktop", "label": "Desktop Header Background Image", "info": "Upload background image for Desktop / Web view" },
    { "type": "image_picker", "id": "header_background_image_mobile", "label": "Mobile Header Background Image", "info": "Upload background image for Mobile Header view" },
    { "type": "image_picker", "id": "mobile_drawer_background_image", "label": "Mobile Drawer Menu Background Image", "info": "Upload background image for 3-line mobile drawer panel" },
    { "type": "color", "id": "nav_text_color", "label": "Navigation text", "default": "#23421F" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#23421F" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_fallback_placeholder", "label": "Fallback placeholder", "default": "Search For Jaggery" },
    { "type": "textarea", "id": "search_placeholders", "label": "Animated placeholder list", "info": "Add one placeholder per line.", "default": "Search For Jaggery\nSearch for Ghee\nSearch for Atta\nSearch for Oil\nSearch for Rice" },
    { "type": "header", "content": "Desktop Navigation Menu" },
    { "type": "link_list", "id": "menu", "label": "Shopify Desktop Navigation Menu", "info": "Select a menu created under Shopify Admin > Navigation for Desktop view (optional)", "default": "main-menu" },
    { "type": "header", "content": "Mobile Navigation Menu" },
