<link rel="stylesheet" href="{{ 'section-testimonials.css' | asset_url }}"><script src="{{ 'section-testimonials.js' | asset_url }}" defer="defer"></script>
<section class="home-section testimonials" data-testimonials><div class="home-section__head home-section__head--center"><p class="home-section__eyebrow">Community notes</p><h2>{{ section.settings.heading }}</h2></div><div class="testimonials__grid">{% for block in section.blocks %}<figure class="testimonials__card" {{ block.shopify_attributes }}><div class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..5) %}{% render 'icon', name: 'star', size: 16 %}{% endfor %}</div><blockquote>{{ block.settings.review }}</blockquote><figcaption>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96' }}{% else %}<img src="{{ 'testimonial-1.jpg.png' | asset_url }}" alt="{{ block.settings.name | escape }}" width="96" height="96" loading="lazy">{% endif %}<span><strong>{{ block.settings.name }}</strong><small>Verified customer</small></span></figcaption></figure>{% endfor %}</div></section>
{% schema %}{"name":"Testimonials","tag":"section","class":"section-testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"Kind words from your table"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"text","id":"name","label":"Customer name","default":"A happy customer"},{"type":"image_picker","id":"image","label":"Customer image"},{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"review","label":"Review","default":"Beautiful products, carefully packed, and so good to cook with."}]}],"max_blocks":8,"presets":[{"name":"Testimonials","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}{% endschema %}
