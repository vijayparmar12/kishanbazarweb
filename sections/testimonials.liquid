<link rel="stylesheet" href="{{ 'section-testimonials.css' | asset_url }}">
<script src="{{ 'section-testimonials.js' | asset_url }}" defer="defer"></script>

{% style %}
  #Testimonials-{{ section.id }} {
    scroll-margin-top: 140px !important;
    background-color: {{ section.settings.background_color | default: '#ffffff' }} !important;
    background-image: none !important;
    padding-top: 0.75rem !important;
    padding-bottom: 1.5rem !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  #Testimonials-{{ section.id }} .testimonials__card {
    border-color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
    background-color: {{ section.settings.card_bg_color | default: '#ffffff' }} !important;
    border-radius: {{ section.settings.card_border_radius | default: 24 }}px !important;
  }
  #Testimonials-{{ section.id }} .testimonials__card-headline {
    color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
    font-size: {{ section.settings.card_headline_size | default: 19 }}px !important;
  }
  #Testimonials-{{ section.id }} .testimonials__author-name {
    color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
  }
  #Testimonials-{{ section.id }} .testimonials__expand-btn {
    border-color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
    color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
  }
  #Testimonials-{{ section.id }} .testimonials__expand-btn:hover {
    background-color: {{ section.settings.card_border_color | default: '#1e3d20' }} !important;
    color: #ffffff !important;
  }

  #Testimonials-{{ section.id }} .testimonials__header {
    margin-bottom: 0.5rem !important;
    margin-top: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }

  #Testimonials-{{ section.id }} .testimonials__heading-banner-wrap {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 800 }}px !important;
    height: auto !important;
    margin: 0 auto !important;
    padding: 0 1rem !important;
    box-sizing: border-box !important;
  }

  #Testimonials-{{ section.id }} .home-section__heading-picture {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 auto !important;
    text-align: center !important;
  }

  #Testimonials-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    max-height: {{ section.settings.heading_box_height_desktop | default: 160 }}px !important;
    object-fit: {{ section.settings.heading_box_bg_size | default: 'contain' }} !important;
    object-position: center !important;
    display: inline-block !important;
    margin: 0 auto !important;
    border-radius: 8px !important;
    {% if section.settings.heading_image_flip %}
      transform: scaleX(-1) !important;
    {% endif %}
  }

  #Testimonials-{{ section.id }} .testimonials__heading-content {
    position: relative !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;
    text-align: left !important;
    max-width: {{ section.settings.heading_content_width_desktop | default: 80 }}% !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #Testimonials-{{ section.id }} .testimonials__heading-title,
  #Testimonials-{{ section.id }} .testimonials__header h2 {
    color: {{ section.settings.heading_color | default: '#1e3d20' }} !important;
    font-size: {{ section.settings.heading_font_size | default: 28 }}px !important;
    font-weight: 900 !important;
    font-family: inherit !important;
    margin: 0 !important;
    line-height: 1.25 !important;
    text-align: left !important;
  }

  #Testimonials-{{ section.id }} .testimonials__heading-eyebrow {
    color: #166534 !important;
    font-size: {{ section.settings.subheading_font_size | default: 15 }}px !important;
    font-weight: 800 !important;
    margin-bottom: 0.25rem !important;
    font-family: inherit !important;
    text-align: left !important;
    line-height: 1.2 !important;
  }

  @media (max-width: 48rem) {
    #Testimonials-{{ section.id }} {
      scroll-margin-top: 110px !important;
      padding-top: 0.5rem !important;
      padding-bottom: 1.2rem !important;
    }
  }

  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} .testimonials__card-headline {
      font-size: {{ section.settings.card_headline_size_mobile | default: 18 }}px !important;
    }
    #Testimonials-{{ section.id }} .testimonials__heading-banner-wrap {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 360 }}px !important;
      padding: 0 0.5rem !important;
      margin: 0 auto !important;
    }
    #Testimonials-{{ section.id }} .home-section__heading-image {
      max-height: {{ section.settings.heading_box_height_mobile | default: 90 }}px !important;
      object-fit: {{ section.settings.heading_box_bg_size_mobile | default: 'contain' }} !important;
    }
    #Testimonials-{{ section.id }} .testimonials__heading-content {
      max-width: {{ section.settings.heading_content_width_mobile | default: 85 }}% !important;
      align-items: flex-start !important;
      text-align: left !important;
      padding: 0 !important;
    }
    #Testimonials-{{ section.id }} .testimonials__heading-title,
    #Testimonials-{{ section.id }} .testimonials__header h2 {
      font-size: {{ section.settings.heading_font_size_mobile | default: 18 }}px !important;
      font-weight: 900 !important;
      line-height: 1.2 !important;
      text-align: left !important;
    }
    #Testimonials-{{ section.id }} .testimonials__heading-eyebrow {
      font-size: {{ section.settings.subheading_font_size_mobile | default: 12 }}px !important;
      font-weight: 800 !important;
      margin-bottom: 0.15rem !important;
      text-align: left !important;
    }
  }
{% endstyle %}

<section id="Testimonials-{{ section.id }}" class="testimonials-carousel-section" data-testimonials-section style="width: 100%; display: block !important; visibility: visible !important; opacity: 1 !important; clear: both;">

  <div class="testimonials__header">
    {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
      <div class="testimonials__heading-banner-wrap">
        <picture class="home-section__heading-picture">
          {% if section.settings.heading_image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 600 }}">
          {% endif %}
          {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
          {{ heading_img | image_url: width: 1200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
        </picture>
        {% if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subheading != blank %}
          <div class="testimonials__heading-content">
            {% if section.settings.eyebrow != blank %}
              <span class="testimonials__eyebrow testimonials__heading-eyebrow">{{ section.settings.eyebrow }}</span>
            {% endif %}
            {% if section.settings.heading != blank %}
              <h2 class="testimonials__heading testimonials__heading-title">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
              <p class="testimonials__subheading" style="text-align: left; margin: 0.15rem 0 0 0;">{{ section.settings.subheading }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      {% if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subheading != blank %}
        <div style="text-align: left; padding: 0 1rem; max-width: 1200px; margin: 0 auto;">
          {% if section.settings.eyebrow != blank %}
            <span class="testimonials__eyebrow" style="text-align: left;">{{ section.settings.eyebrow }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="testimonials__heading" style="text-align: left;">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="testimonials__subheading" style="text-align: left;">{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>

  <!-- Testimonial Cards Horizontal Carousel Track -->
  <div class="testimonials__carousel-container" data-testimonials-carousel>
    <div class="testimonials__track" data-testimonials-track>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign full_review = block.settings.review | default: 'Wholesome organic products with authentic flavour.' %}
          {% assign card_headline = block.settings.headline | default: full_review %}
          {% assign card_headline_trimmed = card_headline | strip %}
          {% unless card_headline_trimmed contains '"' %}
            {% assign card_headline_display = '"' | append: card_headline_trimmed | append: '"' %}
          {% else %}
            {% assign card_headline_display = card_headline_trimmed %}
          {% endunless %}

          <div class="testimonials__card" data-testimonial-card {{ block.shopify_attributes }}>
            <div class="testimonials__card-inner">
              <h3 class="testimonials__card-headline">{{ card_headline_display }}</h3>

              <div class="testimonials__card-media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 800 | image_tag: class: 'testimonials__card-img', loading: 'lazy', alt: block.settings.name }}
                {% else %}
                  <div class="testimonials__card-placeholder">
                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="testimonials__card-divider"></div>

              <footer class="testimonials__card-footer">
                <div class="testimonials__author-info">
                  <strong class="testimonials__author-name">{{ block.settings.name | default: 'Verified Customer' }}</strong>
                  {% if block.settings.role != blank %}
                    <span class="testimonials__author-role">{{ block.settings.role }}</span>
                  {% endif %}
                </div>
                <button
                  type="button"
                  class="testimonials__expand-btn"
                  data-review-modal-trigger
                  data-author-name="{{ block.settings.name | default: 'Verified Customer' | escape }}"
                  data-author-role="{{ block.settings.role | default: '' | escape }}"
                  data-headline="{{ card_headline_trimmed | escape }}"
                  data-full-review="{{ full_review | escape }}"
                  data-rating="{{ block.settings.rating | default: 5 }}"
                  data-image-url="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% endif %}"
                  aria-label="Read review from {{ block.settings.name | default: 'Customer' }}"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </footer>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Sample Testimonial Cards matching mock design -->
        <div class="testimonials__card" data-testimonial-card>
          <div class="testimonials__card-inner">
            <h3 class="testimonials__card-headline">"Finally a truly delicious and quality product."</h3>
            <div class="testimonials__card-media">
              <div class="testimonials__card-placeholder">
                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
              </div>
            </div>
            <div class="testimonials__card-divider"></div>
            <footer class="testimonials__card-footer">
              <div class="testimonials__author-info">
                <strong class="testimonials__author-name">Neha K.</strong>
                <span class="testimonials__author-role">Owner and Coach at Crossfit Third Eye</span>
              </div>
              <button
                type="button"
                class="testimonials__expand-btn"
                data-review-modal-trigger
                data-author-name="Neha K."
                data-author-role="Owner and Coach at Crossfit Third Eye"
                data-headline="Finally a truly delicious and quality product."
                data-full-review="Finally a truly delicious and quality product. Authentic taste and farm-fresh purity."
                data-rating="5"
                data-image-url=""
                aria-label="Read review from Neha K."
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </footer>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Review Modal / Lightbox Popup -->
  <div id="TestimonialsModal-{{ section.id }}" class="testimonials__modal" aria-hidden="true" role="dialog" aria-modal="true" data-review-modal>
    <div class="testimonials__modal-backdrop" data-review-modal-close></div>
    <div class="testimonials__modal-dialog">
      <button type="button" class="testimonials__modal-close" data-review-modal-close aria-label="Close review dialog">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="testimonials__modal-body">
        <div class="testimonials__modal-media" data-modal-media-wrap style="display: none;">
          <img src="" alt="" class="testimonials__modal-img" data-modal-img>
        </div>
        <div class="testimonials__modal-stars" data-modal-stars>
          ⭐⭐⭐⭐⭐
        </div>
        <h3 class="testimonials__modal-headline" data-modal-headline></h3>
        <div class="testimonials__modal-text" data-modal-text></div>
        <div class="testimonials__modal-divider"></div>
        <div class="testimonials__modal-author">
          <strong class="testimonials__modal-name" data-modal-name></strong>
          <span class="testimonials__modal-role" data-modal-role></span>
        </div>
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "class": "section-testimonials-carousel",
  "settings": [
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Image (Desktop)" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Image (Mobile)" },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "contain"
    },
    { "type": "checkbox", "id": "heading_image_flip", "label": "Flip Heading Image Horizontally", "default": false },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Desktop Heading Box Fixed Height (px)", "min": 60, "max": 400, "step": 10, "default": 160, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Mobile Heading Box Fixed Height (px)", "min": 40, "max": 250, "step": 10, "default": 90, "unit": "px" },
    { "type": "range", "id": "heading_image_max_width", "label": "Desktop Heading Image Max Width (px)", "min": 200, "max": 1200, "step": 20, "default": 800, "unit": "px" },
    { "type": "range", "id": "heading_image_mobile_max_width", "label": "Mobile Heading Image Max Width (px)", "min": 150, "max": 800, "step": 10, "default": 360, "unit": "px" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Badge" },
    { "type": "text", "id": "heading", "label": "Carousel Heading" },
    { "type": "color", "id": "heading_color", "label": "Heading Text Color", "default": "#1e3d20" },
    { "type": "range", "id": "heading_font_size", "label": "Desktop Heading Font Size (px)", "min": 14, "max": 80, "step": 1, "default": 28, "unit": "px" },
    { "type": "range", "id": "heading_font_size_mobile", "label": "Mobile Heading Font Size (px)", "min": 10, "max": 50, "step": 1, "default": 18, "unit": "px" },
    { "type": "range", "id": "subheading_font_size", "label": "Desktop Eyebrow/Subheading Font Size (px)", "min": 10, "max": 30, "step": 1, "default": 15, "unit": "px" },
    { "type": "range", "id": "subheading_font_size_mobile", "label": "Mobile Eyebrow/Subheading Font Size (px)", "min": 10, "max": 24, "step": 1, "default": 12, "unit": "px" },
    { "type": "range", "id": "heading_content_width_desktop", "label": "Desktop Heading Content Width (%)", "min": 40, "max": 100, "step": 5, "default": 80, "unit": "%" },
    { "type": "range", "id": "heading_content_width_mobile", "label": "Mobile Heading Content Width (%)", "min": 40, "max": 100, "step": 5, "default": 85, "unit": "%" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "background_color", "label": "Section Background Color", "default": "#ffffff" },
    { "type": "color", "id": "card_border_color", "label": "Card Border Color", "default": "#1e3d20" },
    { "type": "color", "id": "card_bg_color", "label": "Card Background Color", "default": "#ffffff" },
    { "type": "range", "id": "card_border_radius", "label": "Card Border Radius (px)", "min": 8, "max": 40, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "card_headline_size", "label": "Desktop Card Headline Size (px)", "min": 14, "max": 32, "step": 1, "default": 19, "unit": "px" },
    { "type": "range", "id": "card_headline_size_mobile", "label": "Mobile Card Headline Size (px)", "min": 14, "max": 26, "step": 1, "default": 18, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        { "type": "text", "id": "headline", "label": "Short Title / Headline", "default": "Finally a truly delicious and quality product." },
        { "type": "image_picker", "id": "image", "label": "Customer Photo / Review Image" },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Neha K." },
        { "type": "text", "id": "role", "label": "Role / Designation / Location", "default": "Owner and Coach at Crossfit Third Eye" },
        { "type": "textarea", "id": "review", "label": "Full Review Message", "default": "Finally a truly delicious and quality product. Authentic taste and farm-fresh purity." },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Testimonials Carousel"
    }
  ]
}
{% endschema %}
