<link rel="stylesheet" href="{{ 'section-testimonials.css' | asset_url }}">
<script src="{{ 'section-testimonials.js' | asset_url }}" defer="defer"></script>

{% style %}
  #Testimonials-{{ section.id }} {
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}') !important;
    {% else %}
      background-image: url('{{ "5.png" | asset_url }}') !important;
    {% endif %}
    background-size: cover !important;
    background-position: center top !important;
    background-repeat: no-repeat !important;
  }
  @media (max-width: 48rem) {
    #Testimonials-{{ section.id }} {
      background-size: 100% auto !important;
      background-position: bottom center !important;
      background-repeat: no-repeat !important;
    }
  }
{% endstyle %}

<section id="Testimonials-{{ section.id }}" class="testimonials-carousel-section" data-testimonials-section>

  <div class="testimonials__header">
    {% if section.settings.eyebrow != blank %}
      <span class="testimonials__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h2 class="testimonials__heading">{{ section.settings.heading | default: 'KIND WORDS FROM YOUR TABLE' }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="testimonials__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="testimonials__carousel-container" data-testimonials-carousel>
    <div class="testimonials__track" data-testimonials-track>
      {% for loop_pass in (1..2) %}
        {% for block in section.blocks %}
          <figure class="testimonials__card{% if loop_pass == 2 %} testimonials__card--clone{% endif %}" {{ block.shopify_attributes }}>
            <div class="testimonials__card-avatar">
              <span class="testimonials__avatar-text">{{ block.settings.name | slice: 0, 1 | upcase }}</span>
            </div>
            <blockquote class="testimonials__quote">"{{ block.settings.review }}"</blockquote>
            {% if block.settings.image != blank %}
              <div class="testimonials__card-image">
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: 'Customer review photo' }}
              </div>
            {% endif %}
            <div class="testimonials__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
              {% for i in (1..block.settings.rating) %}&#9733;{% endfor %}
            </div>
            <figcaption class="testimonials__author">
              <strong class="testimonials__author-name">{{ block.settings.name }}</strong>
              <span class="testimonials__author-location">- {{ block.settings.location | default: 'Verified Customer' }}</span>
            </figcaption>
          </figure>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Section Background Image",
      "info": "Upload custom background image from Shopify for Testimonials Section."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Badge", "default": "⭐ 10,000+ VERIFIED REVIEWS ⭐" },
    { "type": "text", "id": "heading", "label": "Carousel Heading", "default": "KIND WORDS FROM YOUR TABLE" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real stories from families who love our pure, farm-fresh organic staples." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Pramukh" },
        { "type": "text", "id": "location", "label": "Location", "default": "Surat" },
        { "type": "image_picker", "id": "image", "label": "Review Photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "review", "label": "Review", "default": "The team understands requirements quickly and delivers with consistent quality. We engaged again for another project." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Testimonials Carousel",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Pramukh", "location": "Surat", "rating": 5, "review": "The team understands requirements quickly and delivers with consistent quality. Very satisfied." } },
        { "type": "testimonial", "settings": { "name": "Sophie", "location": "Canada", "rating": 4, "review": "Strong delivery across multiple products and timelines. Very professional and reliable to order from." } },
        { "type": "testimonial", "settings": { "name": "Pavitra", "location": "Surat", "rating": 5, "review": "Everything was delivered on time and fresh. Great quality and smooth ordering experience throughout." } },
        { "type": "testimonial", "settings": { "name": "Aarav Sharma", "location": "Delhi", "rating": 5, "review": "The Khapli Atta is so soft and easy to digest! Will definitely be reordering every month." } },
        { "type": "testimonial", "settings": { "name": "Rohan Mehta", "location": "Mumbai", "rating": 5, "review": "Best Gir Cow Bilona Ghee I have tried in India. Natural aroma and golden granular texture!" } },
        { "type": "testimonial", "settings": { "name": "Ananya Patel", "location": "Ahmedabad", "rating": 5, "review": "100% authentic wood-pressed cold extracted oils. Excellent packing and fast delivery." } },
        { "type": "testimonial", "settings": { "name": "Vikram Rao", "location": "Bengaluru", "rating": 5, "review": "Clean organic ingredients with zero additives. Exceptional customer service too!" } },
        { "type": "testimonial", "settings": { "name": "Meera Iyer", "location": "Chennai", "rating": 5, "review": "Pure farm-fresh quality. Loved the natural taste and packaging details." } }
      ]
    }
  ]
}
{% endschema %}
