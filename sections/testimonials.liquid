<link rel="stylesheet" href="{{ 'section-testimonials.css' | asset_url }}">
<script src="{{ 'section-testimonials.js' | asset_url }}" defer="defer"></script>

{% style %}
  #Testimonials-{{ section.id }} {
    scroll-margin-top: 140px !important;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2200 }}') !important;
      background-size: cover !important;
      background-position: center top !important;
      background-repeat: no-repeat !important;
    {% else %}
      background: #ffffff !important;
      background-color: #ffffff !important;
      background-image: none !important;
    {% endif %}
  }
  #Testimonials-{{ section.id }} .testimonials__card {
    border-color: {{ section.settings.card_border_color | default: '#23421F' }} !important;
    background-color: {{ section.settings.card_bg_color | default: '#FFFFFF' }} !important;
  }
  #Testimonials-{{ section.id }} .testimonials__expand-btn {
    border-color: {{ section.settings.card_border_color | default: '#23421F' }} !important;
    color: {{ section.settings.card_border_color | default: '#23421F' }} !important;
  }
  #Testimonials-{{ section.id }} .testimonials__card.is-expanded .testimonials__expand-btn {
    background-color: {{ section.settings.card_border_color | default: '#23421F' }} !important;
    color: #ffffff !important;
  }

  #Testimonials-{{ section.id }} .testimonials__header {
    margin-bottom: 0.5rem !important;
    margin-top: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }

  #Testimonials-{{ section.id }} .testimonials__heading-banner-wrap {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
    height: auto !important;
    margin: 0 auto !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 12px !important;
  }

  #Testimonials-{{ section.id }} .home-section__heading-picture {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 auto !important;
    padding: 0 !important;
  }

  #Testimonials-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
    object-position: center !important;
    display: block !important;
    margin: 0 auto !important;
    padding: 0 !important;
    border-radius: 12px !important;
    {% if section.settings.heading_image_flip %}
      transform: scaleX(-1) !important;
    {% endif %}
  }

  @media (max-width: 48rem) {
    #Testimonials-{{ section.id }} {
      scroll-margin-top: 110px !important;
      background-size: 100% auto !important;
      background-position: bottom center !important;
      background-repeat: no-repeat !important;
    }
  }

  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} .testimonials__heading-banner-wrap {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 800 }}px !important;
      height: auto !important;
    }
    #Testimonials-{{ section.id }} .home-section__heading-picture {
      width: 100% !important;
      height: auto !important;
      margin: 0 auto !important;
    }
    #Testimonials-{{ section.id }} .home-section__heading-image {
      object-fit: contain !important;
      margin: 0 auto !important;
      height: auto !important;
    }
  }
{% endstyle %}

<section id="Testimonials-{{ section.id }}" class="testimonials-carousel-section" data-testimonials-section style="width: 100%; display: block !important; visibility: visible !important; opacity: 1 !important; clear: both; padding: 1rem 0;">

  <div class="testimonials__header">
    {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
      <div class="testimonials__heading-banner-wrap">
        <picture class="home-section__heading-picture">
          {% if section.settings.heading_image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 1200 }}">
          {% endif %}
          {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
          {{ heading_img | image_url: width: 2200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
        </picture>
      </div>
    {% else %}
      {% if section.settings.eyebrow != blank %}
        <span class="testimonials__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="testimonials__heading">{{ section.settings.heading | default: 'KIND WORDS FROM YOUR TABLE' }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="testimonials__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    {% endif %}
  </div>

  <!-- Live Judge.me Reviews Carousel -->
  <div class="testimonials__judgeme-container" style="width: 100%; margin: 0; min-height: 0;">
    <div class='jdgm-carousel-wrapper'>
      {% if shop.metafields.judgeme.featured_carousel != blank %}
        {{ shop.metafields.judgeme.featured_carousel }}
      {% else %}
        {% render 'judgeme_widgets', widget_type: 'judgeme_featured_carousel', concierge_install: true %}
      {% endif %}
    </div>
  </div>

  <!-- Fallback / Featured Testimonial Cards Carousel -->
  <div class="testimonials__carousel-container" data-testimonials-carousel>
    <div class="testimonials__track" data-testimonials-track>
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign full_review = block.settings.review | default: "Wholesome organic products with authentic flavour." %}
          <div class="testimonials__card" data-testimonial-card data-full-review="{{ full_review | escape }}" {{ block.shopify_attributes }}>
            <div class="testimonials__card-front" data-card-front>
              {% assign card_headline = block.settings.headline | default: full_review %}
              <h3 class="testimonials__card-headline">"{{ card_headline }}"</h3>

              <div class="testimonials__card-media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 500 | image_tag: class: 'testimonials__card-img', loading: 'lazy', alt: block.settings.name }}
                {% else %}
                  <div class="testimonials__card-avatar-fallback">
                    <span class="testimonials__avatar-text">{{ block.settings.name | slice: 0, 1 | upcase }}</span>
                  </div>
                {% endif %}
              </div>

              <footer class="testimonials__card-footer">
                <div class="testimonials__author-info">
                  <strong class="testimonials__author-name">{{ block.settings.name }}</strong>
                  <span class="testimonials__author-role">{{ block.settings.role | default: 'Verified Customer' }}</span>
                </div>
                <button type="button" class="testimonials__expand-btn" data-card-toggle aria-label="Read full review from {{ block.settings.name }}">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
              </footer>
            </div>

            <div class="testimonials__card-back" data-card-back>
              <div class="testimonials__card-full-msg">
                <p class="testimonials__card-full-text">"{{ full_review }}"</p>
              </div>

              <footer class="testimonials__card-footer">
                <div class="testimonials__author-info">
                  <strong class="testimonials__author-name">{{ block.settings.name }}</strong>
                  <span class="testimonials__author-role">{{ block.settings.role | default: 'Verified Customer' }}</span>
                </div>
                <button type="button" class="testimonials__expand-btn testimonials__expand-btn--active" data-card-toggle aria-label="Close full review">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </button>
              </footer>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Sample Testimonial Cards so section is never blank -->
        <div class="testimonials__card" data-testimonial-card data-full-review="Pure A2 Ghee and ancient Emmer Khapli wheat flour are staple in our house. Unmatched quality and authentic taste!">
          <div class="testimonials__card-front">
            <h3 class="testimonials__card-headline">"Pure A2 Ghee and ancient Emmer Khapli wheat flour are staple in our house."</h3>
            <div class="testimonials__card-media">
              <div class="testimonials__card-avatar-fallback">
                <span class="testimonials__avatar-text">A</span>
              </div>
            </div>
            <footer class="testimonials__card-footer">
              <div class="testimonials__author-info">
                <strong class="testimonials__author-name">Amaan Bakali</strong>
                <span class="testimonials__author-role">Verified Customer</span>
              </div>
            </footer>
          </div>
        </div>

        <div class="testimonials__card" data-testimonial-card data-full-review="Finally a truly delicious and genuine organic brand. Highly recommended for every family!">
          <div class="testimonials__card-front">
            <h3 class="testimonials__card-headline">"Finally a truly delicious and genuine organic brand. Highly recommended!"</h3>
            <div class="testimonials__card-media">
              <div class="testimonials__card-avatar-fallback">
                <span class="testimonials__avatar-text">P</span>
              </div>
            </div>
            <footer class="testimonials__card-footer">
              <div class="testimonials__author-info">
                <strong class="testimonials__author-name">Pooja Sharma</strong>
                <span class="testimonials__author-role">Verified Customer</span>
              </div>
            </footer>
          </div>
        </div>

        <div class="testimonials__card" data-testimonial-card data-full-review="Farm fresh staples delivered straight to our doorstep. Best quality wheat and jaggery in India!">
          <div class="testimonials__card-front">
            <h3 class="testimonials__card-headline">"Farm fresh staples delivered straight to our doorstep. Best quality wheat!"</h3>
            <div class="testimonials__card-media">
              <div class="testimonials__card-avatar-fallback">
                <span class="testimonials__avatar-text">V</span>
              </div>
            </div>
            <footer class="testimonials__card-footer">
              <div class="testimonials__author-info">
                <strong class="testimonials__author-name">Vijay Parmar</strong>
                <span class="testimonials__author-role">Verified Customer</span>
              </div>
            </footer>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "class": "section-testimonials-carousel",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Section Background Image" },
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Image (Desktop)" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Image (Mobile)" },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "contain"
    },
    { "type": "checkbox", "id": "heading_image_flip", "label": "Flip Heading Image Horizontally", "default": false },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Desktop Heading Box Fixed Height (px)", "min": 60, "max": 400, "step": 10, "default": 180, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Mobile Heading Box Fixed Height (px)", "min": 40, "max": 250, "step": 10, "default": 110, "unit": "px" },
    { "type": "range", "id": "heading_image_max_width", "label": "Desktop Heading Image Max Width (px)", "min": 200, "max": 1200, "step": 20, "default": 640, "unit": "px" },
    { "type": "range", "id": "heading_image_mobile_max_width", "label": "Mobile Heading Image Max Width (px)", "min": 150, "max": 800, "step": 10, "default": 360, "unit": "px" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Badge", "default": "⭐ 10,000+ VERIFIED REVIEWS ⭐" },
    { "type": "text", "id": "heading", "label": "Carousel Heading", "default": "WE'RE BLESSED! BECAUSE WE HAVE YOU ❤️" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real stories from families who love our pure, farm-fresh organic staples." },
    { "type": "color", "id": "card_border_color", "label": "Card Border Color", "default": "#23421F" },
    { "type": "color", "id": "card_bg_color", "label": "Card Background Color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        { "type": "text", "id": "headline", "label": "Short Title / Headline", "default": "Finally a truly delicious and quality product." },
        { "type": "textarea", "id": "review", "label": "Full Review Message", "default": "Wholesome organic products with authentic flavour." },
        { "type": "image_picker", "id": "image", "label": "Customer Photo / Review Image" },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Amaan Bakali" },
        { "type": "text", "id": "role", "label": "Role / Designation / Location", "default": "Verified Customer" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Testimonials Carousel"
    }
  ]
}
{% endschema %}
