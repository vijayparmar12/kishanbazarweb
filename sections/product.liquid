<link rel="stylesheet" href="{{ 'section-product.css' | asset_url }}">
<script src="{{ 'section-product.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sale = false
  if current_variant.compare_at_price > current_variant.price
    assign sale = true
  endif
%}

<!-- SEO JSON-LD Structured Data Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [
    {% for media in product.media %}
      {{ media | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "description": {{ product.description | strip_html | json }},
  "sku": {{ current_variant.sku | default: "KB-ORG-101" | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: "Kishan Bazar" | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | default: request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: "INR" | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "priceValidUntil": "2030-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "128"
  }
}
</script>

<div class="kishanbazar-product-page" data-kishanbazar-product-page>
  <!-- Main Grid Section (Section 2 Left Gallery & Section 3 Right Info) -->
  <section class="main-product main-product--media-{{ section.settings.desktop_media_width | default: 'large' }}" data-main-product>
    <!-- Left Column: Product Gallery -->
    <div class="main-product__left">
      {% render 'product-gallery', product: product, current_variant: current_variant, sale: sale %}
    </div>

    <!-- Right Column: Product Information (Sticky on Desktop) -->
    <div class="main-product__right">
      {% render 'product-info', product: product, current_variant: current_variant, sale: sale %}
    </div>
  </section>

  <!-- Section 5: Product Details Tabs (Description, Ingredients, Usage, Benefits, Storage, Mfr, Origin, Shelf Life, FAQ) -->
  <div class="product-page-section product-page-section--tabs">
    <div class="product-page-container">
      {% render 'product-tabs', product: product %}
    </div>
  </div>

  <!-- Section 6: Customer Reviews & Ratings Dashboard -->
  <div class="product-page-section product-page-section--reviews">
    <div class="product-page-container">
      {% render 'product-reviews-section', product: product %}
    </div>
  </div>

  <!-- Section 7: Recommended Organic Products Slider -->
  {% if section.settings.show_recommendations %}
    <div class="product-page-section product-page-section--recommendations">
      <div class="product-page-container">
        {% render 'product-recommendations-slider', product: product %}
      </div>
    </div>
  {% endif %}

  <!-- Sticky Add to Cart Bar on Mobile -->
  <div class="sticky-mobile-bar" data-sticky-mobile-bar aria-hidden="true">
    <div class="sticky-mobile-bar__content">
      <div class="sticky-mobile-bar__info">
        <img
          src="{{ current_variant.featured_media | default: product.featured_media | image_url: width: 120 }}"
          alt="{{ product.title | escape }}"
          class="sticky-mobile-bar__img"
          data-sticky-bar-img
        >
        <div class="sticky-mobile-bar__text">
          <span class="sticky-mobile-bar__title">{{ product.title }}</span>
          <div class="sticky-mobile-bar__prices">
            <strong data-sticky-bar-price>{{ current_variant.price | money }}</strong>
            <span class="sticky-mobile-bar__variant" data-sticky-bar-variant>{{ current_variant.title }}</span>
          </div>
        </div>
      </div>
      <button type="button" class="sticky-mobile-bar__btn" data-sticky-add-to-cart-btn>
        ADD TO CART
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Page",
  "tag": "section",
  "class": "section-product-page",
  "settings": [
    {
      "type": "select",
      "id": "desktop_media_width",
      "label": "Desktop media width",
      "options": [
        {
          "value": "medium",
          "label": "Medium (50%)"
        },
        {
          "value": "large",
          "label": "Large (60%)"
        },
        {
          "value": "xlarge",
          "label": "Extra Large (65%)"
        }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show product details accordions section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show customer reviews section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show recommended products slider",
      "default": true
    },
    {
      "type": "range",
      "id": "recommendations_limit",
      "label": "Recommendation limit",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Mobile Sticky Bar"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_mobile_bar",
      "label": "Show sticky Add to Cart bar on mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_bar_btn_text",
      "label": "Mobile sticky button text",
      "default": "ADD TO CART"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title & Subtitle",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_subtitle",
          "label": "Show category subtitle",
          "default": true
        }
      ]
    },
    {
      "type": "price",
      "name": "Price & Discount",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax & shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "rating",
      "name": "Star Rating & Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "score",
          "label": "Rating score",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count text",
          "default": "128 Verified Ratings"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons & Add to Cart",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_buy_now",
          "label": "Show Buy It Now button",
          "default": true
        },
        {
          "type": "text",
          "id": "cart_btn_text",
          "label": "Add to Cart button text",
          "default": "ADD TO CART"
        },
        {
          "type": "color",
          "id": "cart_btn_bg",
          "label": "Add to Cart button background",
          "default": "#23421F"
        },
        {
          "type": "color",
          "id": "cart_btn_color",
          "label": "Add to Cart button text color",
          "default": "#FFFFFF"
        }
      ]
    },
    {
      "type": "benefit_icons",
      "name": "Circle Benefit Badges",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "icon_size", "label": "Benefit Icon Size (px)", "min": 40, "max": 96, "step": 2, "default": 72, "unit": "px" },
        { "type": "image_picker", "id": "benefit_image_1", "label": "Benefit Icon 1 Image" },
        { "type": "image_picker", "id": "benefit_image_2", "label": "Benefit Icon 2 Image" },
        { "type": "image_picker", "id": "benefit_image_3", "label": "Benefit Icon 3 Image" },
        { "type": "image_picker", "id": "benefit_image_4", "label": "Benefit Icon 4 Image" }
      ]
    },
    {
      "type": "stock_status",
      "name": "Stock & Dispatch Status",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "stock_text",
          "label": "In stock status text",
          "default": "In Stock • Ready to Dispatch in 24 Hours"
        }
      ]
    },
    {
      "type": "custom_badge",
      "name": "Custom Tag Badge",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge label",
          "default": "ORGANIC & PURE"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge background color",
          "default": "#23421F"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge text color",
          "default": "#FFFFFF"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Tab Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab Heading",
          "default": "Shipping & Return Policy"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab Content",
          "default": "<p>Free shipping on orders above ₹499. Dispatched within 24 hours.</p>"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges Box",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge_1",
          "label": "Trust Badge 1 Text",
          "default": "100% Certified Organic"
        },
        {
          "type": "text",
          "id": "badge_2",
          "label": "Trust Badge 2 Text",
          "default": "Fast Express Delivery"
        }
      ]
    },
    {
      "type": "description",
      "name": "Product Description",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Product Page",
      "blocks": [
        { "type": "title" },
        { "type": "rating" },
        { "type": "benefit_icons" },
        { "type": "price" },
        { "type": "stock_status" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" },
        { "type": "trust_badges" }
      ]
    }
  ]
}
{% endschema %}
