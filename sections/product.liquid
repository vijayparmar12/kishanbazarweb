<link rel="stylesheet" href="{{ 'section-product.css' | asset_url }}">
<script src="{{ 'section-product.js' | asset_url }}" defer="defer"></script>

{% style %}
  @media screen and (max-width: 749px) {
    .kishanbazar-product-page {
      max-width: {{ section.settings.mobile_max_width | default: 100 }}% !important;
      padding-left: {{ section.settings.mobile_side_padding | default: 0 }}px !important;
      padding-right: {{ section.settings.mobile_side_padding | default: 0 }}px !important;
      margin-left: auto !important;
      margin-right: auto !important;
      box-sizing: border-box !important;
    }

    .kishanbazar-product-page .product-page-section {
      padding-top: {{ section.settings.mobile_vertical_gap | default: 4 }}px !important;
      padding-bottom: {{ section.settings.mobile_vertical_gap | default: 4 }}px !important;
    }

    .kishanbazar-product-page .product-page-section--reviews,
    .kishanbazar-product-page .product-reviews,
    .kishanbazar-product-page .product-reviews .jdgm-widget,
    .kishanbazar-product-page .jdgm-rev-widg {
      max-width: {{ section.settings.mobile_reviews_width | default: 100 }}% !important;
      margin-left: auto !important;
      margin-right: auto !important;
      padding-left: clamp(0.75rem, 3vw, 1.25rem) !important;
      padding-right: clamp(0.75rem, 3vw, 1.25rem) !important;
      box-sizing: border-box !important;
    }

    .kishanbazar-product-page .product-info .jdgm-widget,
    .kishanbazar-product-page .product-info .jdgm-preview-badge,
    .kishanbazar-product-page .product-info .jdgm-prev-badge,
    .kishanbazar-product-page .product-info__rating-block,
    .kishanbazar-product-page .product-info__rating {
      margin-left: 0 !important;
      margin-right: auto !important;
      align-items: flex-start !important;
      justify-content: flex-start !important;
      text-align: left !important;
    }
  }
{% endstyle %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sale = false
  if current_variant.compare_at_price > current_variant.price
    assign sale = true
  endif
%}

<!-- SEO JSON-LD Structured Data Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [
    {% for media in product.media %}
      {{ media | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "description": {{ product.description | strip_html | json }},
  "sku": {{ current_variant.sku | default: "KB-ORG-101" | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: "Kishan Bazar" | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | default: request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: "INR" | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "priceValidUntil": "2030-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "128"
  }
}
</script>

<div class="kishanbazar-product-page" data-kishanbazar-product-page>
  <!-- Main Grid Section (Section 2 Left Gallery & Section 3 Right Info) -->
  <section class="main-product main-product--media-{{ section.settings.desktop_media_width | default: 'large' }}" data-main-product>
    <!-- Left Column: Product Gallery -->
    <div class="main-product__left">
      {% render 'product-gallery', product: product, current_variant: current_variant, sale: sale %}
    </div>

    <!-- Right Column: Product Information (Sticky on Desktop) -->
    <div class="main-product__right">
      {% render 'product-info', product: product, current_variant: current_variant, sale: sale %}
    </div>
  </section>

  <!-- Section 4: Desktop Product Video Card (Placed Above Banners) -->
  {% assign video_block = section.blocks | where: 'type', 'product_video' | first %}
  <div class="product-page-section product-page-section--video-desktop">
    <div class="product-page-container">
      {% render 'product-video-card', product: product, block: video_block %}
    </div>
  </div>

  <!-- Section 4.5: Dynamic Product Page Banners Slider (Up to 6 Banners) -->
  <div class="product-page-section product-page-section--banners">
    <div class="product-page-container">
      {% render 'product-banners', product: product, section: section %}
    </div>
  </div>

  <!-- Section 5: Product Details Tabs (Description, Ingredients, Usage, Benefits, Storage, Mfr, Origin, Shelf Life) -->
  <div class="product-page-section product-page-section--tabs">
    <div class="product-page-container">
      {% render 'product-tabs', product: product %}
    </div>
  </div>

  <!-- Section 5.5: GirOrganic Style Dedicated FAQ Section -->
  {% assign faq_block = section.blocks | where: 'type', 'product_faq' | first %}
  <div class="product-page-section product-page-section--faq">
    <div class="product-page-container">
      {% render 'product-faq', product: product, block: faq_block, section: section %}
    </div>
  </div>

  <!-- Section 6: Customer Reviews & Ratings (Placed Directly Below FAQ Section on Desktop & Mobile) -->
  {% if section.settings.show_reviews %}
    <div class="product-page-section product-page-section--reviews">
      <div class="product-page-container">
        {% render 'product-reviews-section', product: product, section: section %}
      </div>
    </div>
  {% endif %}

  <!-- Section 7: Recommended Organic Products Slider -->
  {% if section.settings.show_recommendations %}
    <div class="product-page-section product-page-section--recommendations">
      <div class="product-page-container">
        {% render 'product-recommendations-slider', product: product %}
      </div>
    </div>
  {% endif %}

  <!-- Sticky Bottom Buy Bar on Mobile (Two Brothers Style: Add To Cart + Quantity Stepper) -->
  <div class="sticky-mobile-bar" data-sticky-mobile-bar aria-hidden="false">
    <div class="sticky-mobile-bar__content">
      <button type="button" class="sticky-mobile-bar__btn" data-sticky-add-to-cart-btn>
        ADD TO CART
      </button>

      <div class="sticky-mobile-bar__quantity-stepper">
        <button type="button" class="sticky-mobile-bar__qbtn" data-sticky-quantity-minus aria-label="Decrease quantity">-</button>
        <span class="sticky-mobile-bar__qval" data-sticky-quantity-val>1</span>
        <button type="button" class="sticky-mobile-bar__qbtn" data-sticky-quantity-plus aria-label="Increase quantity">+</button>
      </div>
    </div>
  </div>
</div>

