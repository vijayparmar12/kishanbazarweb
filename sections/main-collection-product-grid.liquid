<link rel="stylesheet" href="{{ 'section-collection.css' | asset_url }}">
<script src="{{ 'section-collection.js' | asset_url }}" defer="defer"></script>

{% paginate collection.products by section.settings.products_per_page %}
  {% assign show_filters = false %}

  <section class="main-collection page-width{% unless show_filters %} main-collection--no-filters{% endunless %}" data-collection-grid>
    <div class="main-collection__top-bar">
      {% if show_filters %}
        <div class="main-collection__filters-inline">
          {% render 'collection-filters', section_id: section.id %}
        </div>
      {% endif %}

      <div class="main-collection__sorting-wrap">
        {% if section.settings.enable_sorting %}
          {% render 'collection-sorting', section_id: section.id %}
        {% else %}
          <p class="collection-sorting__count" role="status">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
        {% endif %}
      </div>
    </div>

    <div class="main-collection__content">
      {% if collection.products_count > 0 %}
        <div class="main-collection__grid main-collection__grid--{{ section.settings.products_per_row }}" role="list">
          {% for product in collection.products %}
            <div role="listitem">
              {% render 'product-card',
                product: product,
                card_blocks: section.blocks,
                show_vendor: section.settings.show_vendor,
                show_price: section.settings.show_price,
                show_compare_price: section.settings.show_compare_price,
                show_rating: section.settings.show_rating,
                show_badge: section.settings.show_badges,
                show_wishlist: true,
                show_quickview: true,
                show_add_to_cart: true,
                show_subtitle: true,
                show_benefit_icons: true,
                show_variant_selector: true
              %}
            </div>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="collection-pagination" aria-label="Pagination">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{% else %}<span aria-disabled="true">Previous</span>{% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}<a href="{{ part.url }}" aria-label="Page {{ part.title }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}
            {% endfor %}
            {% if paginate.next %}<a href="{{ paginate.next.url }}" rel="next">Next</a>{% else %}<span aria-disabled="true">Next</span>{% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="main-collection__empty"><h2>No products found</h2><p>Try clearing filters or browse another collection.</p><a class="button button--outline" href="{{ collection.url }}">Clear filters</a></div>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

{% schema %}
{
  "name": "Collection product grid",
  "tag": "section",
  "class": "section-main-collection-grid",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 20 },
    { "type": "select", "id": "products_per_row", "label": "Products per row on desktop", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "5" },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable filters", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_compare_price", "label": "Show compare-at price", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating placeholder", "default": false },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges", "default": true }
  ],
  "blocks": [
    {
      "type": "card_title",
      "name": "Card Title",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "title_color", "label": "Title text color", "default": "#23421F" },
        { "type": "range", "id": "font_size", "label": "Title Font Size (px)", "min": 12, "max": 32, "step": 1, "default": 17, "unit": "px" },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Title Font Weight",
          "options": [
            { "value": "normal", "label": "Normal (400)" },
            { "value": "600", "label": "Semi-Bold (600)" },
            { "value": "bold", "label": "Bold (700)" },
            { "value": "800", "label": "Extra Bold (800)" }
          ],
          "default": "bold"
        }
      ]
    },
    {
      "type": "card_price",
      "name": "Card Price",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "price_color", "label": "Price color", "default": "#23421F" },
        { "type": "color", "id": "compare_price_color", "label": "Compare price color", "default": "#8D8D8D" },
        { "type": "range", "id": "price_font_size", "label": "Price Font Size (px)", "min": 12, "max": 36, "step": 1, "default": 19, "unit": "px" },
        {
          "type": "select",
          "id": "price_font_weight",
          "label": "Price Font Weight",
          "options": [
            { "value": "600", "label": "Semi-Bold (600)" },
            { "value": "700", "label": "Bold (700)" },
            { "value": "800", "label": "Extra Bold (800)" },
            { "value": "900", "label": "Black (900)" }
          ],
          "default": "800"
        }
      ]
    },
    {
      "type": "card_title_price",
      "name": "Card Title & Price",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "title_color", "label": "Title text color", "default": "#23421F" },
        { "type": "color", "id": "price_color", "label": "Price color", "default": "#23421F" },
        { "type": "color", "id": "compare_price_color", "label": "Compare price color", "default": "#8D8D8D" }
      ]
    },
    {
      "type": "card_subtitle",
      "name": "Card Subtitle Description",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#6B7280" }
      ]
    },
    {
      "type": "card_rating",
      "name": "Card Star Rating",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "rating_stars_color", "label": "Star rating color", "default": "#E5A800" }
      ]
    },
    {
      "type": "card_benefit_icons",
      "name": "Card Benefit Badges",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_benefit_icons", "label": "Show benefit circle icons", "default": true },
        { "type": "range", "id": "icon_size", "label": "Benefit Icon Size (px)", "min": 36, "max": 120, "step": 2, "default": 72, "unit": "px" },
        { "type": "image_picker", "id": "benefit_image_1", "label": "Benefit Icon 1 Image" },
        { "type": "image_picker", "id": "benefit_image_2", "label": "Benefit Icon 2 Image" },
        { "type": "image_picker", "id": "benefit_image_3", "label": "Benefit Icon 3 Image" },
        { "type": "image_picker", "id": "benefit_image_4", "label": "Benefit Icon 4 Image" }
      ]
    },
    {
      "type": "card_variant_selector",
      "name": "Card Variant Dropdown",
      "limit": 1,
      "settings": [
        { "type": "color", "id": "border_color", "label": "Dropdown border color", "default": "#1F1F1F" },
        { "type": "color", "id": "bg_color", "label": "Dropdown background color", "default": "#FFFFFF" },
        { "type": "color", "id": "text_color", "label": "Dropdown text color", "default": "#1F1F1F" }
      ]
    },
    {
      "type": "card_buy_button",
      "name": "Card Add to Cart Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_to_cart_text", "label": "Button text", "default": "ADD TO CART" },
        { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#23421F" },
        { "type": "color", "id": "btn_color", "label": "Button text color", "default": "#FFFFFF" }
      ]
    },
    {
      "type": "card_custom_text",
      "name": "Card Custom Text Line",
      "settings": [
        { "type": "text", "id": "text", "label": "Custom text", "default": "🚚 Free Shipping on orders over ₹499" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#23421F" },
        { "type": "select", "id": "font_weight", "label": "Font weight", "options": [{ "value": "normal", "label": "Normal" }, { "value": "bold", "label": "Bold" }], "default": "bold" }
      ]
    },
    {
      "type": "card_badge",
      "name": "Card Badge (Below Title)",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Renders badges like RECOMMENDED, OUR PICK, BESTSELLER below title. Leave badge text blank to automatically use product metafield/tag badge." },
        { "type": "text", "id": "badge_text", "label": "Custom Badge text (Optional)" },
        { "type": "color", "id": "badge_bg", "label": "Badge background color", "default": "#23421F" },
        { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#FFFFFF" },
        { "type": "range", "id": "font_size", "label": "Badge Font Size (px)", "min": 10, "max": 18, "step": 1, "default": 11, "unit": "px" },
        { "type": "range", "id": "border_radius", "label": "Badge Rounding (px)", "min": 0, "max": 24, "step": 2, "default": 20, "unit": "px" }
      ]
    },
    {
      "type": "custom_badge_block",
      "name": "Custom Card Badge",
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "SPECIAL OFFER" },
        { "type": "color", "id": "badge_bg", "label": "Badge background color", "default": "#E06535" },
        { "type": "color", "id": "badge_color", "label": "Badge text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection product grid",
      "blocks": [
        { "type": "card_title_price" },
        { "type": "card_subtitle" },
        { "type": "card_rating" },
        { "type": "card_benefit_icons" },
        { "type": "card_variant_selector" },
        { "type": "card_buy_button" }
      ]
    }
  ]
}
{% endschema %}
