<link rel="stylesheet" href="{{ 'section-footer.css' | asset_url }}">
<script src="{{ 'section-footer.js' | asset_url }}" defer="defer"></script>

{% style %}
  .site-footer {
    position: relative;
    background-color: transparent !important;
    background: transparent !important;
    color: {{ section.settings.footer_text_color | default: '#23421f' }};
    overflow: hidden;
  }

  .site-footer__content-layer {
    background: transparent !important;
    position: relative;
    z-index: 5;
  }
{% endstyle %}

{% assign social_blocks = section.blocks | where: 'type', 'social_link' %}

{% assign brand_email = '' %}
{% assign brand_phone = '' %}
{% assign brand_phone_label = '' %}
{% assign brand_email_label = '' %}
{% for b in section.blocks %}
  {% if b.type == 'brand' %}
    {% if b.settings.email != blank %}
      {% assign brand_email = b.settings.email %}
    {% endif %}
    {% if b.settings.phone != blank %}
      {% assign brand_phone = b.settings.phone %}
    {% endif %}
    {% if b.settings.phone_label != blank %}
      {% assign brand_phone_label = b.settings.phone_label %}
    {% endif %}
    {% if b.settings.email_label != blank %}
      {% assign brand_email_label = b.settings.email_label %}
    {% endif %}
  {% endif %}
{% endfor %}

<footer class="site-footer" data-site-footer>
  <div class="site-footer__content-layer">
    <div class="site-footer__inner">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'brand' %}
            <div class="site-footer__brand-col" {{ block.shopify_attributes }}>
              {% if block.settings.logo != blank or block.settings.show_default_logo %}
                <a href="{{ routes.root_url }}" class="site-footer__logo-link" aria-label="{{ shop.name | escape }} home">
                  {% if block.settings.logo != blank %}
                    {% assign footer_logo_style = '--logo-width: ' | append: block.settings.logo_width | append: 'px;' %}
                    {{
                      block.settings.logo
                      | image_url: width: 600
                      | image_tag:
                        class: 'site-footer__logo',
                        alt: shop.name,
                        loading: 'lazy',
                        widths: '180, 240, 320, 420, 600',
                        style: footer_logo_style
                    }}
                  {% else %}
                    <img
                      class="site-footer__logo"
                      src="{{ 'logo.png' | asset_url }}"
                      alt="{{ shop.name | escape }}"
                      width="200"
                      height="60"
                      loading="lazy"
                      style="--logo-width: {{ block.settings.logo_width | default: 180 }}px;"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';"
                    >
                    <span class="site-footer__logo-fallback-text" style="display: none; font-size: 1.5rem; font-weight: 800; color: #23421f; letter-spacing: -0.02em;">KISANVEDA</span>
                  {% endif %}
                </a>
              {% endif %}

              {% if block.settings.about_text != blank %}
                <div class="site-footer__brand-text">{{ block.settings.about_text | newline_to_br }}</div>
              {% endif %}

              {% if social_blocks.size > 0 %}
                <div class="site-footer__social-row" style="margin-top: 1rem; justify-content: flex-start;">
                  {% for social_block in social_blocks %}
                    {% if social_block.settings.url != blank %}
                      {% assign social_label = social_block.settings.label | default: social_block.settings.platform %}
                      <a href="{{ social_block.settings.url }}" class="social-btn social-btn--img" aria-label="{{ social_label | escape }}" target="_blank" rel="noopener noreferrer" {{ social_block.shopify_attributes }}>
                        {% if social_block.settings.icon_image != blank %}
                          {{
                            social_block.settings.icon_image
                            | image_url: width: 80
                            | image_tag: alt: social_label, width: 40, height: 40, loading: 'lazy'
                          }}
                        {% elsif social_block.settings.platform == 'facebook' %}
                          <img src="{{ 'facebook.png' | asset_url }}" alt="{{ social_label | escape }}" width="40" height="40" loading="lazy">
                        {% elsif social_block.settings.platform == 'instagram' %}
                          <img src="{{ 'instagram.png' | asset_url }}" alt="{{ social_label | escape }}" width="40" height="40" loading="lazy">
                        {% elsif social_block.settings.platform == 'youtube' %}
                          <img src="{{ 'youtube.png' | asset_url }}" alt="{{ social_label | escape }}" width="40" height="40" loading="lazy">
                        {% else %}
                          <span class="social-btn__text">{{ social_block.settings.icon_text }}</span>
                        {% endif %}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="site-footer__newsletter site-footer__newsletter--mobile">
                <h3 class="site-footer__newsletter-title">
                  {{ block.settings.newsletter_title | default: 'SUBSCRIBE TO OUR NEWSLETTER' | escape }}
                </h3>
                {% form 'customer', class: 'site-footer__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="site-footer__newsletter-boxes">
                    <div class="site-footer__newsletter-input-wrap">
                      <input
                        type="tel"
                        name="contact[note][mobile]"
                        class="site-footer__newsletter-input"
                        placeholder="Mobile / Phone Number"
                        aria-label="Mobile or Phone Number"
                      >
                      <span class="site-footer__newsletter-btn-spacer" aria-hidden="true"></span>
                    </div>
                    <div class="site-footer__newsletter-input-wrap">
                      <input
                        type="email"
                        name="contact[email]"
                        class="site-footer__newsletter-input"
                        value="{{ form.email }}"
                        placeholder="Your e-mail"
                        aria-label="Your e-mail"
                        required
                      >
                      <button type="submit" class="site-footer__newsletter-btn" aria-label="Subscribe">&rarr;</button>
                    </div>
                  </div>
                {% endform %}
              </div>
            </div>

          {% when 'link_column' %}
            <div class="site-footer__col" data-footer-col {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <button type="button" class="site-footer__col-title site-footer__col-toggle" aria-expanded="false" data-footer-toggle>
                  <span>{{ block.settings.heading }}</span>
                  <span class="accordion-icon" aria-hidden="true">
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </button>
              {% endif %}

              <ul class="site-footer__list" role="list">
                {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                {% else %}
                  {% if block.settings.link_1_label != blank %}<li><a href="{{ block.settings.link_1_url }}">{{ block.settings.link_1_label }}</a></li>{% endif %}
                  {% if block.settings.link_2_label != blank %}<li><a href="{{ block.settings.link_2_url }}">{{ block.settings.link_2_label }}</a></li>{% endif %}
                  {% if block.settings.link_3_label != blank %}<li><a href="{{ block.settings.link_3_url }}">{{ block.settings.link_3_label }}</a></li>{% endif %}
                  {% if block.settings.link_4_label != blank %}<li><a href="{{ block.settings.link_4_url }}">{{ block.settings.link_4_label }}</a></li>{% endif %}
                  {% if block.settings.link_5_label != blank %}<li><a href="{{ block.settings.link_5_url }}">{{ block.settings.link_5_label }}</a></li>{% endif %}
                  {% if block.settings.link_6_label != blank %}<li><a href="{{ block.settings.link_6_url }}">{{ block.settings.link_6_label }}</a></li>{% endif %}
                  {% if block.settings.link_7_label != blank %}<li><a href="{{ block.settings.link_7_url }}">{{ block.settings.link_7_label }}</a></li>{% endif %}
                  {% if block.settings.link_8_label != blank %}<li><a href="{{ block.settings.link_8_url }}">{{ block.settings.link_8_label }}</a></li>{% endif %}
                {% endif %}
              </ul>
            </div>

          {% when 'contact' %}
            <div class="site-footer__col site-footer__contact-col" data-footer-col {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <button type="button" class="site-footer__col-title site-footer__col-toggle" aria-expanded="false" data-footer-toggle>
                  <span>{{ block.settings.heading }}</span>
                  <span class="accordion-icon" aria-hidden="true">
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </span>
                </button>
              {% endif %}

              <div class="site-footer__company-details site-footer__accordion-content">
                {% if block.settings.address_text != blank %}
                  <div class="site-footer__address" style="margin-bottom: 0.75rem; line-height: 1.55;">{{ block.settings.address_text | newline_to_br }}</div>
                {% endif %}

                {% assign footer_email = block.settings.email %}
                {% if footer_email == blank %}
                  {% assign footer_email = brand_email %}
                {% endif %}

                {% assign footer_email_label = block.settings.email_label %}
                {% if footer_email_label == blank %}
                  {% assign footer_email_label = brand_email_label %}
                {% endif %}
                {% if footer_email_label == blank %}
                  {% assign footer_email_label = 'Email:' %}
                {% endif %}

                {% assign footer_phone = block.settings.phone %}
                {% if footer_phone == blank %}
                  {% assign footer_phone = brand_phone %}
                {% endif %}

                {% assign footer_phone_label = block.settings.phone_label %}
                {% if footer_phone_label == blank %}
                  {% assign footer_phone_label = brand_phone_label %}
                {% endif %}
                {% if footer_phone_label == blank %}
                  {% assign footer_phone_label = 'Tel:' %}
                {% endif %}

                <div class="site-footer__contact-details" style="margin-top: 0.65rem; margin-bottom: 0.85rem;">
                  {% if footer_phone != blank %}
                    <p class="site-footer__contact-line" style="margin: 0 0 0.35rem; font-size: 0.92rem; color: #23421f;">
                      <strong>{{ footer_phone_label }}</strong> <a href="tel:{{ footer_phone | remove: ' ' }}" style="color: #23421f; text-decoration: none;">{{ footer_phone }}</a>
                    </p>
                  {% endif %}
                  {% if footer_email != blank %}
                    <p class="site-footer__contact-line" style="margin: 0; font-size: 0.92rem; color: #23421f;">
                      <strong>{{ footer_email_label }}</strong> <a href="mailto:{{ footer_email }}" style="color: #23421f; text-decoration: underline;">{{ footer_email }}</a>
                    </p>
                  {% endif %}
                </div>

                {% if block.settings.show_newsletter %}
                  <div class="site-footer__newsletter site-footer__newsletter--desktop" style="margin-top: 1.15rem;">
                    <h3 class="site-footer__newsletter-title">
                      {{ block.settings.newsletter_title | default: 'SUBSCRIBE TO OUR NEWSLETTER' | escape }}
                    </h3>
                    {% form 'customer', class: 'site-footer__newsletter-form' %}
                      <input type="hidden" name="contact[tags]" value="newsletter">
                      <div class="site-footer__newsletter-boxes">
                        <div class="site-footer__newsletter-input-wrap">
                          <input
                            type="tel"
                            name="contact[note][mobile]"
                            class="site-footer__newsletter-input"
                            placeholder="{{ block.settings.phone_placeholder | default: 'Mobile / Phone Number' | escape }}"
                            aria-label="Mobile or Phone Number"
                          >
                          <span class="site-footer__newsletter-btn-spacer" aria-hidden="true"></span>
                        </div>
                        <div class="site-footer__newsletter-input-wrap">
                          <input
                            type="email"
                            name="contact[email]"
                            class="site-footer__newsletter-input"
                            value="{{ form.email }}"
                            placeholder="{{ block.settings.newsletter_placeholder | default: 'Your e-mail' | escape }}"
                            aria-label="Your e-mail"
                            required
                          >
                          <button type="submit" class="site-footer__newsletter-btn" aria-label="Subscribe">&rarr;</button>
                        </div>
                      </div>
                    {% endform %}
                  </div>
                {% endif %}
              </div>
            </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.footer_bottom_image != blank or section.settings.show_default_bottom_image %}
    <div class="site-footer__illustration-layer" style="--illustration-height: {{ section.settings.illustration_height | default: 480 }}px; --illustration-position: {{ section.settings.illustration_position | default: 'top center' }};">
      <div class="site-footer__bottom-banner-wrap">
        {% if section.settings.footer_bottom_image != blank %}
          {{
            section.settings.footer_bottom_image
            | image_url: width: 2400
            | image_tag:
              class: 'site-footer__bottom-banner-img',
              loading: 'lazy',
              widths: '750, 1100, 1400, 1800, 2400',
              alt: section.settings.footer_bottom_image_alt
          }}
        {% else %}
          <img
            class="site-footer__bottom-banner-img"
            src="{{ 'home.png' | asset_url }}"
            alt="{{ section.settings.footer_bottom_image_alt | escape }}"
            width="1400"
            height="500"
            loading="lazy"
          >
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if section.settings.copyright_text != blank %}
    {% assign current_year = 'now' | date: '%Y' %}
    {% assign copyright_text = section.settings.copyright_text | replace: '[year]', current_year | replace: '[shop]', shop.name %}
    <div class="site-footer__bottom" style="text-align: center !important; display: flex !important; justify-content: center !important; align-items: center !important; width: 100% !important;">
      <p class="site-footer__copyright" style="text-align: center !important; width: 100% !important; margin: 0 auto !important;">{{ copyright_text }}</p>
    </div>
  {% endif %}
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer design"
    },
    {
      "type": "color",
      "id": "footer_text_color",
      "label": "Footer text color",
      "default": "#23421f"
    },
    {
      "type": "image_picker",
      "id": "footer_bottom_image",
      "label": "Bottom illustration image"
    },
    {
      "type": "checkbox",
      "id": "show_default_bottom_image",
      "label": "Show default bottom illustration when no image is selected",
      "default": true
    },
    {
      "type": "range",
      "id": "illustration_height",
      "min": 250,
      "max": 650,
      "step": 10,
      "default": 480,
      "unit": "px",
      "label": "Bottom illustration height"
    },
    {
      "type": "select",
      "id": "illustration_position",
      "label": "Bottom illustration focal position",
      "options": [
        { "value": "top center", "label": "Top (Shows full tree tops)" },
        { "value": "center center", "label": "Center" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "top center"
    },
    {
      "type": "text",
      "id": "footer_bottom_image_alt",
      "label": "Bottom illustration alt text",
      "default": "Footer farm illustration"
    },
    {
      "type": "textarea",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Copyright &copy; [year], [shop] &bull; All Rights Reserved."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand content",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 60,
          "max": 350,
          "step": 10,
          "default": 240,
          "unit": "px",
          "label": "Logo width"
        },
        {
          "type": "checkbox",
          "id": "show_default_logo",
          "label": "Show default logo when no logo is selected",
          "default": true
        },
        {
          "type": "textarea",
          "id": "about_text",
          "label": "About text",
          "default": "Kishan Bazar, Welcome to our farm-fresh organic kitchen. We build wholesome pantry staples and marketing experiences that help brands stand out and scale confidently."
        },
        {
          "type": "text",
          "id": "email_label",
          "label": "Email label",
          "default": "Email:"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "support@kishanbazar.com"
        },
        {
          "type": "text",
          "id": "phone_label",
          "label": "Phone label",
          "default": "Tel:"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+91 88888 88888"
        }
      ]
