<link rel="stylesheet" href="{{ 'section-footer.css' | asset_url }}">
<script src="{{ 'section-footer.js' | asset_url }}" defer="defer"></script>

<footer class="site-footer" data-site-footer>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 300 | image_tag: class: 'site-footer__logo', alt: shop.name, loading: 'lazy', widths: '120, 180, 240, 300' }}{% else %}
        <img class="site-footer__logo" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy">{% endif %}</a>
      {% if section.settings.about != blank %}<div class="site-footer__about rte">{{ section.settings.about }}</div>{% endif %}
      {% if section.settings.show_social %}<div class="site-footer__social" aria-label="Social media links">{% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">f</a>{% endif %}{% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">◎</a>{% endif %}</div>{% endif %}
    </div>
    {% if section.settings.quick_menu != blank %}<div class="site-footer__column"><h2>{{ section.settings.quick_menu_title }}</h2><ul role="list">{% for link in section.settings.quick_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    {% if section.settings.policy_menu != blank %}<div class="site-footer__column"><h2>{{ section.settings.policy_menu_title }}</h2><ul role="list">{% for link in section.settings.policy_menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>{% endif %}
    <address class="site-footer__column site-footer__contact"><h2>{{ section.settings.contact_title }}</h2>{% if section.settings.address != blank %}<p>{{ section.settings.address | newline_to_br }}</p>{% endif %}{% if section.settings.phone != blank %}<p><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>{% endif %}{% if section.settings.email != blank %}<p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>{% endif %}{% if section.settings.hours != blank %}<p>{{ section.settings.hours }}</p>{% endif %}</address>
    {% if section.settings.show_newsletter %}<div class="site-footer__newsletter"><h2>{{ section.settings.newsletter_title }}</h2><p>{{ section.settings.newsletter_text }}</p>{% form 'customer', class: 'site-footer__newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="footer-email-{{ section.id }}">Email address</label><input id="footer-email-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" autocorrect="off" autocapitalize="off" required><button type="submit">Subscribe</button>{% if form.posted_successfully? %}<p class="site-footer__success" role="status">Thank you for subscribing.</p>{% endif %}{% endform %}</div>{% endif %}
  </div>
  <div class="site-footer__bottom"><p>{{ section.settings.copyright | default: shop.name }} &copy; {{ 'now' | date: '%Y' }}</p>{% if section.settings.show_payments %}<div class="site-footer__payments" aria-label="Accepted payment methods">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}<button class="site-footer__top" type="button" aria-label="Back to top" data-back-to-top>{% render 'icon', name: 'arrow' %}<span>Back to top</span></button></div>
</footer>

{% schema %}
{"name":"Footer","tag":"section","class":"section-footer","settings":[{"type":"image_picker","id":"logo","label":"Footer logo"},{"type":"richtext","id":"about","label":"About store","default":"<p>Wholesome, thoughtfully sourced food for your everyday table.</p>"},{"type":"link_list","id":"quick_menu","label":"Quick links menu"},{"type":"text","id":"quick_menu_title","label":"Quick menu heading","default":"Quick links"},{"type":"link_list","id":"policy_menu","label":"Policy menu"},{"type":"text","id":"policy_menu_title","label":"Policy menu heading","default":"Customer care"},{"type":"text","id":"contact_title","label":"Contact heading","default":"Get in touch"},{"type":"checkbox","id":"show_newsletter","label":"Show newsletter","default":true},{"type":"text","id":"newsletter_title","label":"Newsletter heading","default":"Stay in the loop"},{"type":"text","id":"newsletter_text","label":"Newsletter text","default":"Recipes, seasonal picks, and offers—sent occasionally."},{"type":"checkbox","id":"show_social","label":"Show social links","default":true},{"type":"url","id":"facebook_url","label":"Facebook URL"},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"checkbox","id":"show_payments","label":"Show payment icons","default":true},{"type":"textarea","id":"address","label":"Address"},{"type":"text","id":"phone","label":"Phone"},{"type":"text","id":"email","label":"Email"},{"type":"text","id":"hours","label":"Working hours"},{"type":"text","id":"copyright","label":"Copyright text"}],"presets":[{"name":"Footer"}]}
{% endschema %}
