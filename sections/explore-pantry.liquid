<link rel="stylesheet" href="{{ 'explore-pantry.css' | asset_url }}" media="print" onload="this.media='all'">

{% liquid
  assign image_ratio = '1 / 1'
  if section.settings.image_ratio == 'portrait'
    assign image_ratio = '4 / 5'
  elsif section.settings.image_ratio == 'landscape'
    assign image_ratio = '4 / 3'
  elsif section.settings.image_ratio == 'wide'
    assign image_ratio = '16 / 9'
  endif
%}

{% style %}
  #ExplorePantry-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#EEF5EA' }} !important;
    background-image: none !important;
  }

  #ExplorePantry-{{ section.id }} .explore-pantry__header {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    position: relative !important;
    width: 100% !important;
    max-width: {{ section.settings.heading_image_max_width | default: 1200 }}px !important;
    height: {{ section.settings.heading_box_height_desktop | default: 180 }}px !important;
    margin: 0 auto !important;
    padding: 0 2rem !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    box-sizing: border-box !important;
  }

  #ExplorePantry-{{ section.id }} .home-section__heading-picture {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 auto !important;
    padding: 0 !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  #ExplorePantry-{{ section.id }} .home-section__heading-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: {{ section.settings.heading_box_bg_size | default: 'cover' }} !important;
    object-position: center !important;
    display: block !important;
    margin: 0 auto !important;
    border-radius: 12px !important;
  }

  #ExplorePantry-{{ section.id }} .explore-pantry__heading-content {
    position: relative !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;
    text-align: left !important;
    max-width: 65% !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #ExplorePantry-{{ section.id }} .explore-pantry__heading-title,
  #ExplorePantry-{{ section.id }} .explore-pantry__header h2 {
    color: {{ section.settings.heading_color | default: '#1e3d20' }} !important;
    font-size: {{ section.settings.heading_font_size | default: 28 }}px !important;
    font-weight: 900 !important;
    font-family: 'Montserrat', sans-serif !important;
    margin: 0 !important;
    line-height: 1.25 !important;
    text-align: left !important;
  }

  #ExplorePantry-{{ section.id }} .explore-pantry__heading-eyebrow {
    color: #166534 !important;
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    margin-bottom: 0.25rem !important;
    font-family: 'Montserrat', sans-serif !important;
    text-align: left !important;
    line-height: 1.2 !important;
  }

  @media screen and (max-width: 749px) {
    #ExplorePantry-{{ section.id }} .explore-pantry__header {
      max-width: {{ section.settings.heading_image_mobile_max_width | default: 800 }}px !important;
      height: {{ section.settings.heading_box_height_mobile | default: 110 }}px !important;
      padding: 0 1rem !important;
      justify-content: flex-start !important;
      align-items: center !important;
    }
    #ExplorePantry-{{ section.id }} .home-section__heading-picture {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 auto !important;
      padding: 0 !important;
    }
    #ExplorePantry-{{ section.id }} .home-section__heading-image {
      object-fit: {{ section.settings.heading_box_bg_size_mobile | default: 'cover' }} !important;
      height: 100% !important;
      width: 100% !important;
    }
    #ExplorePantry-{{ section.id }} .explore-pantry__heading-content {
      max-width: 65% !important;
      align-items: flex-start !important;
      text-align: left !important;
      padding: 0 !important;
    }
    #ExplorePantry-{{ section.id }} .explore-pantry__heading-title,
    #ExplorePantry-{{ section.id }} .explore-pantry__header h2 {
      font-size: {{ section.settings.heading_font_size_mobile | default: 18 }}px !important;
      font-weight: 900 !important;
      line-height: 1.2 !important;
      text-align: left !important;
    }
    #ExplorePantry-{{ section.id }} .explore-pantry__heading-eyebrow {
      font-size: 0.78rem !important;
      font-weight: 800 !important;
      margin-bottom: 0.15rem !important;
      text-align: left !important;
    }
  }
{% endstyle %}

<section
  id="ExplorePantry-{{ section.id }}"
  class="explore-pantry"
  style="
    --explore-pantry-bg: {{ section.settings.background_color }};
    --explore-pantry-spacing: {{ section.settings.spacing }}px;
    --explore-pantry-radius: {{ section.settings.card_radius }}px;
    --explore-pantry-ratio: {{ image_ratio }};
  "
>
  <div class="explore-pantry__inner">
    <div class="explore-pantry__header">
      {% if section.settings.heading_image_desktop != blank or section.settings.heading_image_mobile != blank %}
        <picture class="home-section__heading-picture">
          {% if section.settings.heading_image_mobile != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.heading_image_mobile | image_url: width: 800 }}">
          {% endif %}
          {% assign heading_img = section.settings.heading_image_desktop | default: section.settings.heading_image_mobile %}
          {{ heading_img | image_url: width: 1200 | image_tag: class: 'home-section__heading-image', alt: section.settings.heading, loading: 'lazy' }}
        </picture>
        {% if section.settings.heading != blank or section.settings.subheading != blank %}
          <div class="explore-pantry__heading-content">
            {% if section.settings.subheading != blank %}
              <p class="explore-pantry__eyebrow explore-pantry__heading-eyebrow">{{ section.settings.subheading }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <h2 class="explore-pantry__heading explore-pantry__heading-title">{{ section.settings.heading }}</h2>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <div style="text-align: left;">
          {% if section.settings.subheading != blank %}
            <p class="explore-pantry__eyebrow" style="text-align: left;">{{ section.settings.subheading }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="explore-pantry__heading" style="text-align: left;">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <ul class="explore-pantry__grid" role="list">
      {% assign rendered_collections = 0 %}

      {% if section.settings.show_all_collections %}
        {% for collection in collections limit: section.settings.collection_count %}
          {% unless collection.handle == 'all' %}
            {% assign rendered_collections = rendered_collections | plus: 1 %}
            <li>
              <a class="explore-pantry__card" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
                <span class="explore-pantry__media">
                  {% liquid
                    assign pantry_image = collection.image
                    if pantry_image == blank
                      assign first_product = collection.products | first
                      if first_product != blank
                        assign pantry_image = first_product.featured_image
                      endif
                    endif
                  %}

                  {% if pantry_image != blank %}
                    {{
                      pantry_image
                      | image_url: width: 360
                      | image_tag:
                        class: 'explore-pantry__image',
                        alt: collection.title,
                        widths: '180, 240, 360, 480, 720',
                        sizes: '(min-width: 1200px) 16vw, (min-width: 750px) 33vw, 50vw',
                        loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'explore-pantry__image explore-pantry__image--placeholder' }}
                  {% endif %}
                </span>
                <h3 class="explore-pantry__title">{{ collection.title }}</h3>
              </a>
            </li>
          {% endunless %}
        {% endfor %}
      {% else %}
        {% for collection in section.settings.selected_collections limit: section.settings.collection_count %}
          {% assign rendered_collections = rendered_collections | plus: 1 %}
          <li>
            <a class="explore-pantry__card" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
              <span class="explore-pantry__media">
                {% liquid
                  assign pantry_image = collection.image
                  if pantry_image == blank
                    assign first_product = collection.products | first
                    if first_product != blank
                      assign pantry_image = first_product.featured_image
                    endif
                  endif
                %}

                {% if pantry_image != blank %}
                  {{
                    pantry_image
                    | image_url: width: 360
                    | image_tag:
                      class: 'explore-pantry__image',
                      alt: collection.title,
                      widths: '180, 240, 360, 480, 720',
                      sizes: '(min-width: 1200px) 16vw, (min-width: 750px) 33vw, 50vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'explore-pantry__image explore-pantry__image--placeholder' }}
                {% endif %}
              </span>
              <h3 class="explore-pantry__title">{{ collection.title }}</h3>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>

    {% if rendered_collections == 0 %}
      <div class="explore-pantry__empty">
        <p>No collections selected yet.</p>
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <div class="explore-pantry__actions">
        <a class="explore-pantry__button" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Explore Our Pantry",
  "tag": "section",
  "class": "section-explore-pantry",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label",
      "default": "SHOP BY NEED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Pantry Categories"
    },
    { "type": "color", "id": "heading_color", "label": "Heading Text Color", "default": "#1e3d20" },
    { "type": "range", "id": "heading_font_size", "label": "Desktop Heading Font Size (px)", "min": 14, "max": 60, "step": 1, "default": 28, "unit": "px" },
    { "type": "range", "id": "heading_font_size_mobile", "label": "Mobile Heading Font Size (px)", "min": 10, "max": 40, "step": 1, "default": 18, "unit": "px" },
    { "type": "image_picker", "id": "heading_image_desktop", "label": "Heading Box Background Image (Desktop)", "info": "Upload graphic image to use as background for the Heading Box on Desktop" },
    { "type": "image_picker", "id": "heading_image_mobile", "label": "Heading Box Background Image (Mobile)", "info": "Upload graphic image to use as background for the Heading Box on Mobile" },
    {
      "type": "select",
      "id": "heading_box_bg_size",
      "label": "Desktop Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "heading_box_bg_size_mobile",
      "label": "Mobile Image Fit Mode",
      "options": [
        { "value": "cover", "label": "Cover (Fill entire box)" },
        { "value": "contain", "label": "Contain (Fit full image without cropping)" }
      ],
      "default": "cover"
    },
    { "type": "range", "id": "heading_box_height_desktop", "label": "Heading Box Minimum Height (Desktop px)", "min": 60, "max": 400, "step": 10, "default": 110, "unit": "px" },
    { "type": "range", "id": "heading_box_height_mobile", "label": "Heading Box Minimum Height (Mobile px)", "min": 40, "max": 300, "step": 10, "default": 80, "unit": "px" },
    { "type": "color", "id": "background_color", "label": "Background Color", "default": "#EEF5EA" },
    {
      "type": "checkbox",
      "id": "show_all_collections",
      "label": "Show all collections",
      "default": true
    },
    {
      "type": "collection_list",
      "id": "selected_collections",
      "label": "Selected collections",
      "limit": 24
    },
    {
      "type": "range",
      "id": "collection_count",
      "label": "Number of collections",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Section spacing",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Explore Our Pantry"
    }
  ]
}
{% endschema %}
