{% doc %}
  Renders the global cart drawer section exposed directly in Theme Editor sidebar.
{% enddoc %}

{% render 'cart-drawer', section: section %}

{% schema %}
{
  "name": "Cart Drawer Settings",
  "tag": "section",
  "class": "section-cart-drawer",
  "settings": [
    {
      "type": "header",
      "content": "Cart Drawer Header & Announcement"
    },
    {
      "type": "text",
      "id": "cart_title_text",
      "label": "Cart Drawer Title",
      "default": "YOUR CART"
    },
    {
      "type": "text",
      "id": "cart_promo_bar_text",
      "label": "Top Promo Banner Text (leave blank to hide)"
    },
    {
      "type": "header",
      "content": "Free Shipping & Offer Progress Bar"
    },
    {
      "type": "number",
      "id": "cart_free_shipping_threshold",
      "label": "Free Shipping Threshold (in ₹)",
      "default": 1499
    },
    {
      "type": "number",
      "id": "cart_discount_threshold",
      "label": "10% Discount Threshold (in ₹)",
      "default": 3000
    },
    {
      "type": "header",
      "content": "Coupons & Offers"
    },
    {
      "type": "text",
      "id": "cart_coupons_modal_title",
      "label": "Coupons Modal Title",
      "default": "Available Coupons & Offers"
    },
    {
      "type": "text",
      "id": "cart_coupon_code",
      "label": "Primary Coupon Code (leave blank if using coupon blocks)"
    },
    {
      "type": "text",
      "id": "cart_savings_label",
      "label": "Primary Coupon Savings Label (e.g. Save ₹709)"
    },
    {
      "type": "header",
      "content": "Dynamic Savings Ribbon & Total Box"
    },
    {
      "type": "text",
      "id": "cart_savings_ribbon_suffix",
      "label": "Savings Ribbon Suffix Text",
      "default": "Saved so far!"
    },
    {
      "type": "text",
      "id": "cart_estimated_total_label",
      "label": "Estimated Total Label",
      "default": "Estimated Total"
    },
    {
      "type": "header",
      "content": "Frequently Bought Together Addons"
    },
    {
      "type": "text",
      "id": "cart_addons_heading",
      "label": "Addons Section Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "collection",
      "id": "cart_addons_collection",
      "label": "Addons Collection"
    },
    {
      "type": "header",
      "content": "Checkout Button & Footer Branding"
    },
    {
      "type": "text",
      "id": "cart_checkout_btn_text",
      "label": "Checkout Button Text",
      "default": "Checkout"
    },
    {
      "type": "checkbox",
      "id": "cart_show_payment_badges",
      "label": "Show Payment Method Badges (Paytm, GPay, etc.)",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_credit_branding_text",
      "label": "Bottom Branding Credit Text",
      "default": "Powered by Shopflo"
    },
    {
      "type": "header",
      "content": "Choose Option Drawer Modal"
    },
    {
      "type": "text",
      "id": "cart_choose_option_title",
      "label": "Choose Option Modal Title",
      "default": "Choose Option"
    },
    {
      "type": "text",
      "id": "cart_choose_option_confirm_btn",
      "label": "Choose Option Confirm Button Text",
      "default": "Confirm"
    }
  ],
  "blocks": [
    {
      "type": "coupon_offer",
      "name": "Coupon / Offer Code",
      "settings": [
        {
          "type": "text",
          "id": "code",
          "label": "Coupon Code (e.g. TBOF10)",
          "default": "TBOF10"
        },
        {
          "type": "text",
          "id": "discount_title",
          "label": "Savings Title (e.g. Save ₹709)",
          "default": "Save ₹709"
        },
        {
          "type": "text",
          "id": "discount_sub",
          "label": "Offer Details (e.g. 10% OFF on orders above ₹3000)",
          "default": "10% OFF on orders above ₹3000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart Drawer Settings",
      "blocks": [
        {
          "type": "coupon_offer",
          "settings": {
            "code": "TBOF10",
            "discount_title": "Save ₹709",
            "discount_sub": "10% OFF on orders above ₹3000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
