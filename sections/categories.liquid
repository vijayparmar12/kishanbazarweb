<link rel="stylesheet" href="{{ 'section-collections.css' | asset_url }}">
<script src="{{ 'section-collections.js' | asset_url }}" defer="defer"></script>

<section class="home-section categories" data-categories>
  <div class="home-section__head">
    <div>
      <p class="home-section__eyebrow">{{ section.settings.subheading }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>

  <div class="categories__grid">
    {% assign rendered_collections = 0 %}

    {% if section.settings.collections != blank %}
      {% for collection in section.settings.collections limit: section.settings.maximum %}
        {% assign rendered_collections = rendered_collections | plus: 1 %}
        <a class="categories__card" href="{{ collection.url }}">
          {% liquid
            assign category_image = collection.image
            if category_image == blank
              assign first_product = collection.products | first
              if first_product != blank
                assign category_image = first_product.featured_image
              endif
            endif
          %}

          {% if category_image != blank %}
            {{ category_image | image_url: width: 500 | image_tag: class: 'categories__image', alt: collection.title, loading: 'lazy', widths: '180, 300, 500' }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'categories__image' }}
          {% endif %}
          <span>{{ collection.title }}</span>
        </a>
      {% endfor %}
    {% else %}
      {% for collection in collections limit: section.settings.maximum %}
        {% unless collection.handle == 'all' %}
          {% assign rendered_collections = rendered_collections | plus: 1 %}
          <a class="categories__card" href="{{ collection.url }}">
            {% liquid
              assign category_image = collection.image
              if category_image == blank
                assign first_product = collection.products | first
                if first_product != blank
                  assign category_image = first_product.featured_image
                endif
              endif
            %}

            {% if category_image != blank %}
              {{ category_image | image_url: width: 500 | image_tag: class: 'categories__image', alt: collection.title, loading: 'lazy', widths: '180, 300, 500' }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'categories__image' }}
            {% endif %}
            <span>{{ collection.title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    {% endif %}
  </div>

  {% if rendered_collections == 0 %}
    <p class="home-section__empty">Collections will appear here after you create them in Shopify.</p>
  {% endif %}

  {% if section.settings.button_text != blank %}
    <div class="home-section__action">
      {% render 'button', text: section.settings.button_text, url: section.settings.button_link | default: routes.collections_url, variant: 'outline' %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Categories",
  "tag": "section",
  "class": "section-categories",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop by need"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Selected collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "maximum",
      "label": "Maximum collections",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Categories"
    }
  ]
}
{% endschema %}
