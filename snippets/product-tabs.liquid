{% doc %}
  Renders product details accordions in Two Brothers India Shop style matching user's CSV Metafield Keys:
  - DESCRIPTION: raw_desc
  - INGREDIENTS: raw_ingredients
  - USAGE INFO: raw_usage
  - BENEFITS: raw_benefits
  - STORAGE INFO: raw_storage
  - MANUFACTURER & PACKER DETAILS: raw_mfr
  - COUNTRY OF ORIGIN: raw_origin
  - SHELF LIFE: raw_shelflife
  - FREQUENTLY ASKED QUESTIONS (FAQ): raw_faq1..5

  @param {object} product - The Shopify product object

  @example
  {% render 'product-tabs', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  assign raw_desc = c_meta.description.value | default: c_meta.description | default: c_meta.Description.value | default: c_meta.Description | default: product.description
  assign raw_ingredients = c_meta.ingredients.value | default: c_meta.ingredients | default: c_meta.Ingredients.value | default: c_meta.Ingredients
  assign raw_usage = c_meta.usage.value | default: c_meta.usage | default: c_meta.Usage.value | default: c_meta.Usage
  assign raw_benefits = c_meta.benefits.value | default: c_meta.benefits | default: c_meta.Benefits.value | default: c_meta.Benefits
  assign raw_storage = c_meta.storage_info.value | default: c_meta.storage_info | default: c_meta.Storage_info.value | default: c_meta.Storage_info | default: c_meta.storage
  assign raw_mfr = c_meta.manufacturer.value | default: c_meta.manufacturer | default: c_meta.Manufacturer.value | default: c_meta.Manufacturer
  assign raw_origin = c_meta.origin.value | default: c_meta.origin | default: c_meta.Origin.value | default: c_meta.Origin
  assign raw_shelflife = c_meta.shelf_life.value | default: c_meta.shelf_life | default: c_meta.Shelf_life.value | default: c_meta.Shelf_life

  assign raw_faq1_q = c_meta.faq_1_question.value | default: c_meta.faq_1_question
  assign raw_faq1_a = c_meta.faq_1_answer.value | default: c_meta.faq_1_answer
  assign raw_faq2_q = c_meta.faq_2_question.value | default: c_meta.faq_2_question
  assign raw_faq2_a = c_meta.faq_2_answer.value | default: c_meta.faq_2_answer
  assign raw_faq3_q = c_meta.faq_3_question.value | default: c_meta.faq_3_question
  assign raw_faq3_a = c_meta.faq_3_answer.value | default: c_meta.faq_3_answer
  assign raw_faq4_q = c_meta.faq_4_question.value | default: c_meta.faq_4_question
  assign raw_faq4_a = c_meta.faq_4_answer.value | default: c_meta.faq_4_answer
  assign raw_faq5_q = c_meta.faq_5_question.value | default: c_meta.faq_5_question
  assign raw_faq5_a = c_meta.faq_5_answer.value | default: c_meta.faq_5_answer
%}

<section class="product-accordions" data-product-accordions-component>
  <div class="product-accordions__list">

    <!-- 1. DESCRIPTION -->
    <details class="product-accordion-item" open>
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">DESCRIPTION</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content rte">
        {% if raw_desc != blank %}
          {{ raw_desc }}
        {% else %}
          <p>100% natural, unrefined organic {{ product.title }} sourced straight from native Indian farms.</p>
        {% endif %}
      </div>
    </details>

    <!-- 2. INGREDIENTS -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">INGREDIENTS</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_ingredients != blank %}
          <div class="product-tabs__ingredients-box">
            {{ raw_ingredients | newline_to_br }}
          </div>
        {% else %}
          <div class="product-tabs__highlight-box">
            <span class="product-tabs__badge-icon">🌿</span>
            <p><strong>100% Raw & Organic {{ product.title }}</strong></p>
          </div>
          <p>Pure ingredients sourced directly from organic farms. Free from chemical bleaches, synthetic anti-caking agents, and artificial preservatives.</p>
        {% endif %}
      </div>
    </details>

    <!-- 3. USAGE INFO -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">USAGE INFO</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_usage != blank %}
          <p>{{ raw_usage | newline_to_br }}</p>
        {% else %}
          <p>Ideal for daily home cooking, preparing traditional Indian recipes, and healthy meals with authentic flavor and aroma.</p>
        {% endif %}
      </div>
    </details>

    <!-- 4. BENEFITS -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">BENEFITS</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_benefits != blank %}
          <div class="product-tabs__benefits-list">
            {{ raw_benefits | newline_to_br }}
          </div>
        {% else %}
          <div class="product-tabs__grid-2col">
            <div class="product-tabs__benefit-item">
              <h4>🌾 100% Pure & Natural</h4>
              <p>Sourced from unpolluted organic soils to deliver essential natural nutrients.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>🛡️ Chemical Free</h4>
              <p>Zero pesticides, insecticides, synthetic additives, or heavy metals.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>💪 Rich in Micronutrients</h4>
              <p>Packed with natural vitamins, minerals, and antioxidants for overall well-being.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>❤️ Heart & Gut Healthy</h4>
              <p>Supports digestion, immunity, and healthy lifestyle choices for your family.</p>
            </div>
          </div>
        {% endif %}
      </div>
    </details>

    <!-- 5. STORAGE INFO -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">STORAGE INFO</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_storage != blank %}
          <p>{{ raw_storage | newline_to_br }}</p>
        {% else %}
          <ul>
            <li>Store in a cool, dry place away from direct sunlight and moisture.</li>
            <li>Once opened, transfer into an airtight container.</li>
            <li>Always use a clean, dry spoon to handle the product.</li>
          </ul>
        {% endif %}
      </div>
    </details>

    <!-- 6. MANUFACTURER & PACKER DETAILS -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">MANUFACTURER & PACKER DETAILS</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_mfr != blank %}
          <p><strong>Manufacturer:</strong> {{ raw_mfr }}</p>
          <p><strong>Brand / Vendor:</strong> {{ product.vendor | default: 'Kishan Bazar' }}</p>
        {% else %}
          <p><strong>Brand / Vendor:</strong> {{ product.vendor | default: 'Kishan Bazar' }}</p>
          <p><strong>Manufacturer:</strong> Kishan Bazar Organic Foods Pvt. Ltd.</p>
          <p><strong>Address:</strong> Plot No. 42-45, Green Agro Industrial Park, Surat - 395006, Gujarat, India.</p>
          <p><strong>FSSAI License No:</strong> 10721999000341</p>
        {% endif %}
      </div>
    </details>

    <!-- 7. COUNTRY OF ORIGIN -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">COUNTRY OF ORIGIN</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_origin != blank %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <strong>{{ raw_origin }}</strong>
              <p>Sourced directly from certified organic farmer co-operatives across India.</p>
            </div>
          </div>
        {% else %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <strong>Made in India</strong>
              <p>Sourced directly from certified organic farmer co-operatives across India.</p>
            </div>
          </div>
        {% endif %}
      </div>
    </details>

    <!-- 8. SHELF LIFE -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">SHELF LIFE</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_shelflife != blank %}
          <p><strong>{{ raw_shelflife }}</strong></p>
        {% else %}
          <p><strong>4 Months (120 Days)</strong> from date of packaging.</p>
        {% endif %}
      </div>
    </details>

    <!-- 9. FREQUENTLY ASKED QUESTIONS (FAQ) -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">FREQUENTLY ASKED QUESTIONS (FAQ)</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if c_meta.faq_1_question != blank or raw_faq1_q != blank %}
          <details class="product-tabs__accordion" open>
            <summary><strong>{{ raw_faq1_q }}</strong></summary>
            <p>{{ raw_faq1_a }}</p>
          </details>
        {% endif %}

        {% if c_meta.faq_2_question != blank or raw_faq2_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ raw_faq2_q }}</strong></summary>
            <p>{{ raw_faq2_a }}</p>
          </details>
        {% endif %}

        {% if c_meta.faq_3_question != blank or raw_faq3_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ raw_faq3_q }}</strong></summary>
            <p>{{ raw_faq3_a }}</p>
          </details>
        {% endif %}

        {% if c_meta.faq_4_question != blank or raw_faq4_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ raw_faq4_q }}</strong></summary>
            <p>{{ raw_faq4_a }}</p>
          </details>
        {% endif %}

        {% if c_meta.faq_5_question != blank or raw_faq5_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ raw_faq5_q }}</strong></summary>
            <p>{{ raw_faq5_a }}</p>
          </details>
        {% endif %}

        {% if c_meta.faq_1_question == blank and raw_faq1_q == blank %}
          <details class="product-tabs__accordion" open>
            <summary><strong>Is {{ product.title }} 100% natural and unrefined?</strong></summary>
            <p>Yes, all {{ product.vendor | default: 'Kishan Bazar' }} products are 100% natural, unrefined, and processed without chemicals or artificial bleaches.</p>
          </details>
          <details class="product-tabs__accordion">
            <summary><strong>What is the estimated delivery time for my order?</strong></summary>
            <p>Orders are dispatched within 24 hours and delivered in 1-3 business days across India.</p>
          </details>
        {% endif %}
      </div>
    </details>

  </div>
</section>
