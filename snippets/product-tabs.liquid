{% doc %}
  Renders product details tabs matching user's exact Shopify CSV Metafield Keys:
  - description: product.metafields.custom.description | default: product.description
  - ingredients: product.metafields.custom.ingredients
  - usage: product.metafields.custom.usage
  - benefits: product.metafields.custom.benefits
  - storage_info: product.metafields.custom.storage_info
  - manufacturer: product.metafields.custom.manufacturer
  - origin: product.metafields.custom.origin
  - shelf_life: product.metafields.custom.shelf_life
  - faq_1..5: product.metafields.custom.faq_1_question / faq_1_answer .. faq_5_question / faq_5_answer

  @param {object} product - The Shopify product object

  @example
  {% render 'product-tabs', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  assign raw_desc = c_meta.description.value | default: c_meta.description | default: product.description
  assign raw_ingredients = c_meta.ingredients.value | default: c_meta.ingredients
  assign raw_usage = c_meta.usage.value | default: c_meta.usage
  assign raw_benefits = c_meta.benefits.value | default: c_meta.benefits
  assign raw_storage = c_meta.storage_info.value | default: c_meta.storage_info | default: c_meta.storage
  assign raw_mfr = c_meta.manufacturer.value | default: c_meta.manufacturer
  assign raw_origin = c_meta.origin.value | default: c_meta.origin
  assign raw_shelflife = c_meta.shelf_life.value | default: c_meta.shelf_life

  assign raw_faq1_q = c_meta.faq_1_question.value | default: c_meta.faq_1_question
  assign raw_faq1_a = c_meta.faq_1_answer.value | default: c_meta.faq_1_answer
  assign raw_faq2_q = c_meta.faq_2_question.value | default: c_meta.faq_2_question
  assign raw_faq2_a = c_meta.faq_2_answer.value | default: c_meta.faq_2_answer
  assign raw_faq3_q = c_meta.faq_3_question.value | default: c_meta.faq_3_question
  assign raw_faq3_a = c_meta.faq_3_answer.value | default: c_meta.faq_3_answer
  assign raw_faq4_q = c_meta.faq_4_question.value | default: c_meta.faq_4_question
  assign raw_faq4_a = c_meta.faq_4_answer.value | default: c_meta.faq_4_answer
  assign raw_faq5_q = c_meta.faq_5_question.value | default: c_meta.faq_5_question
  assign raw_faq5_a = c_meta.faq_5_answer.value | default: c_meta.faq_5_answer

  assign active_tab = ''
  if raw_desc != blank
    assign active_tab = 'desc'
  elsif raw_ingredients != blank
    assign active_tab = 'ingredients'
  elsif raw_usage != blank
    assign active_tab = 'usage'
  elsif raw_benefits != blank
    assign active_tab = 'benefits'
  elsif raw_storage != blank
    assign active_tab = 'storage'
  elsif raw_mfr != blank
    assign active_tab = 'mfr'
  elsif raw_origin != blank
    assign active_tab = 'origin'
  elsif raw_shelflife != blank
    assign active_tab = 'shelflife'
  elsif raw_faq1_q != blank or raw_faq2_q != blank or raw_faq3_q != blank or raw_faq4_q != blank or raw_faq5_q != blank
    assign active_tab = 'faq'
  endif
%}

{% if active_tab != blank %}
  <section class="product-tabs" data-product-tabs-component>
    <!-- Desktop / Tablet Tab Header Buttons (Only buttons with uploaded CSV data) -->
    <div class="product-tabs__header" role="tablist" aria-label="Product Information Tabs">
      {% if raw_desc != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'desc' %}is-active{% endif %}" id="tab-btn-desc" role="tab" aria-selected="{% if active_tab == 'desc' %}true{% else %}false{% endif %}" aria-controls="tab-pane-desc" data-tab-trigger="desc">
          Description
        </button>
      {% endif %}

      {% if raw_ingredients != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'ingredients' %}is-active{% endif %}" id="tab-btn-ingredients" role="tab" aria-selected="{% if active_tab == 'ingredients' %}true{% else %}false{% endif %}" aria-controls="tab-pane-ingredients" data-tab-trigger="ingredients">
          Ingredients
        </button>
      {% endif %}

      {% if raw_usage != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'usage' %}is-active{% endif %}" id="tab-btn-usage" role="tab" aria-selected="{% if active_tab == 'usage' %}true{% else %}false{% endif %}" aria-controls="tab-pane-usage" data-tab-trigger="usage">
          Usage
        </button>
      {% endif %}

      {% if raw_benefits != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'benefits' %}is-active{% endif %}" id="tab-btn-benefits" role="tab" aria-selected="{% if active_tab == 'benefits' %}true{% else %}false{% endif %}" aria-controls="tab-pane-benefits" data-tab-trigger="benefits">
          Benefits
        </button>
      {% endif %}

      {% if raw_storage != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'storage' %}is-active{% endif %}" id="tab-btn-storage" role="tab" aria-selected="{% if active_tab == 'storage' %}true{% else %}false{% endif %}" aria-controls="tab-pane-storage" data-tab-trigger="storage">
          Storage Info
        </button>
      {% endif %}

      {% if raw_mfr != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'mfr' %}is-active{% endif %}" id="tab-btn-mfr" role="tab" aria-selected="{% if active_tab == 'mfr' %}true{% else %}false{% endif %}" aria-controls="tab-pane-mfr" data-tab-trigger="mfr">
          Manufacturer
        </button>
      {% endif %}

      {% if raw_origin != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'origin' %}is-active{% endif %}" id="tab-btn-origin" role="tab" aria-selected="{% if active_tab == 'origin' %}true{% else %}false{% endif %}" aria-controls="tab-pane-origin" data-tab-trigger="origin">
          Origin
        </button>
      {% endif %}

      {% if raw_shelflife != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'shelflife' %}is-active{% endif %}" id="tab-btn-shelflife" role="tab" aria-selected="{% if active_tab == 'shelflife' %}true{% else %}false{% endif %}" aria-controls="tab-pane-shelflife" data-tab-trigger="shelflife">
          Shelf Life
        </button>
      {% endif %}

      {% if raw_faq1_q != blank or raw_faq2_q != blank or raw_faq3_q != blank or raw_faq4_q != blank or raw_faq5_q != blank %}
        <button type="button" class="product-tabs__tab-btn {% if active_tab == 'faq' %}is-active{% endif %}" id="tab-btn-faq" role="tab" aria-selected="{% if active_tab == 'faq' %}true{% else %}false{% endif %}" aria-controls="tab-pane-faq" data-tab-trigger="faq">
          FAQ
        </button>
      {% endif %}
    </div>

    <!-- Tab Content Panes (ONLY CSV Data - NO Fallbacks) -->
    <div class="product-tabs__body">
      {% if raw_desc != blank %}
        <div class="product-tabs__pane {% if active_tab == 'desc' %}is-active{% endif %}" id="tab-pane-desc" role="tabpanel" aria-labelledby="tab-btn-desc" data-tab-pane="desc" {% unless active_tab == 'desc' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Product Description</h3>
          <div class="product-tabs__pane-content rte">
            {{ raw_desc }}
          </div>
        </div>
      {% endif %}

      {% if raw_ingredients != blank %}
        <div class="product-tabs__pane {% if active_tab == 'ingredients' %}is-active{% endif %}" id="tab-pane-ingredients" role="tabpanel" aria-labelledby="tab-btn-ingredients" data-tab-pane="ingredients" {% unless active_tab == 'ingredients' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Ingredients</h3>
          <div class="product-tabs__pane-content">
            <div class="product-tabs__ingredients-box">
              {{ raw_ingredients | newline_to_br }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if raw_usage != blank %}
        <div class="product-tabs__pane {% if active_tab == 'usage' %}is-active{% endif %}" id="tab-pane-usage" role="tabpanel" aria-labelledby="tab-btn-usage" data-tab-pane="usage" {% unless active_tab == 'usage' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Usage Instructions</h3>
          <div class="product-tabs__pane-content">
            <p>{{ raw_usage | newline_to_br }}</p>
          </div>
        </div>
      {% endif %}

      {% if raw_benefits != blank %}
        <div class="product-tabs__pane {% if active_tab == 'benefits' %}is-active{% endif %}" id="tab-pane-benefits" role="tabpanel" aria-labelledby="tab-btn-benefits" data-tab-pane="benefits" {% unless active_tab == 'benefits' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Nutritional & Health Benefits</h3>
          <div class="product-tabs__pane-content">
            <div class="product-tabs__benefits-list">
              {{ raw_benefits | newline_to_br }}
            </div>
          </div>
        </div>
      {% endif %}

      {% if raw_storage != blank %}
        <div class="product-tabs__pane {% if active_tab == 'storage' %}is-active{% endif %}" id="tab-pane-storage" role="tabpanel" aria-labelledby="tab-btn-storage" data-tab-pane="storage" {% unless active_tab == 'storage' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Storage Information</h3>
          <div class="product-tabs__pane-content">
            <p>{{ raw_storage | newline_to_br }}</p>
          </div>
        </div>
      {% endif %}

      {% if raw_mfr != blank %}
        <div class="product-tabs__pane {% if active_tab == 'mfr' %}is-active{% endif %}" id="tab-pane-mfr" role="tabpanel" aria-labelledby="tab-btn-mfr" data-tab-pane="mfr" {% unless active_tab == 'mfr' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Manufacturer & Packer Details</h3>
          <div class="product-tabs__pane-content">
            <p><strong>Manufacturer:</strong> {{ raw_mfr }}</p>
          </div>
        </div>
      {% endif %}

      {% if raw_origin != blank %}
        <div class="product-tabs__pane {% if active_tab == 'origin' %}is-active{% endif %}" id="tab-pane-origin" role="tabpanel" aria-labelledby="tab-btn-origin" data-tab-pane="origin" {% unless active_tab == 'origin' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Country of Origin</h3>
          <div class="product-tabs__pane-content">
            <div class="product-tabs__origin-flag">
              <span class="flag-icon">🇮🇳</span>
              <div>
                <strong>{{ raw_origin }}</strong>
              </div>
            </div>
          </div>
        </div>
      {% endif %}

      {% if raw_shelflife != blank %}
        <div class="product-tabs__pane {% if active_tab == 'shelflife' %}is-active{% endif %}" id="tab-pane-shelflife" role="tabpanel" aria-labelledby="tab-btn-shelflife" data-tab-pane="shelflife" {% unless active_tab == 'shelflife' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Shelf Life</h3>
          <div class="product-tabs__pane-content">
            <p><strong>{{ raw_shelflife }}</strong></p>
          </div>
        </div>
      {% endif %}

      {% if raw_faq1_q != blank or raw_faq2_q != blank or raw_faq3_q != blank or raw_faq4_q != blank or raw_faq5_q != blank %}
        <div class="product-tabs__pane {% if active_tab == 'faq' %}is-active{% endif %}" id="tab-pane-faq" role="tabpanel" aria-labelledby="tab-btn-faq" data-tab-pane="faq" {% unless active_tab == 'faq' %}hidden{% endunless %}>
          <h3 class="product-tabs__pane-title">Frequently Asked Questions (FAQ)</h3>
          <div class="product-tabs__pane-content">
            {% if raw_faq1_q != blank %}
              <details class="product-tabs__accordion" open>
                <summary><strong>{{ raw_faq1_q }}</strong></summary>
                <p>{{ raw_faq1_a }}</p>
              </details>
            {% endif %}

            {% if raw_faq2_q != blank %}
              <details class="product-tabs__accordion">
                <summary><strong>{{ raw_faq2_q }}</strong></summary>
                <p>{{ raw_faq2_a }}</p>
              </details>
            {% endif %}

            {% if raw_faq3_q != blank %}
              <details class="product-tabs__accordion">
                <summary><strong>{{ raw_faq3_q }}</strong></summary>
                <p>{{ raw_faq3_a }}</p>
              </details>
            {% endif %}

            {% if raw_faq4_q != blank %}
              <details class="product-tabs__accordion">
                <summary><strong>{{ raw_faq4_q }}</strong></summary>
                <p>{{ raw_faq4_a }}</p>
              </details>
            {% endif %}

            {% if raw_faq5_q != blank %}
              <details class="product-tabs__accordion">
                <summary><strong>{{ raw_faq5_q }}</strong></summary>
                <p>{{ raw_faq5_a }}</p>
              </details>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}
