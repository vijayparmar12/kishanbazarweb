{% doc %}
  Renders product details tabs matching user's exact Shopify CSV Metafield Keys:
  - description: product.metafields.custom.description | default: product.description
  - ingredients: product.metafields.custom.ingredients
  - usage: product.metafields.custom.usage
  - benefits: product.metafields.custom.benefits
  - storage_info: product.metafields.custom.storage_info
  - manufacturer: product.metafields.custom.manufacturer
  - origin: product.metafields.custom.origin
  - shelf_life: product.metafields.custom.shelf_life
  - faq_1..5: product.metafields.custom.faq_1_question / faq_1_answer .. faq_5_question / faq_5_answer

  @param {object} product - The Shopify product object

  @example
  {% render 'product-tabs', product: product %}
{% enddoc %}

{% liquid
  assign custom_meta = product.metafields.custom
  assign tab_desc = custom_meta.description.value | default: custom_meta.description | default: product.description
  assign tab_ingredients = custom_meta.ingredients.value | default: custom_meta.ingredients
  assign tab_usage = custom_meta.usage.value | default: custom_meta.usage
  assign tab_benefits = custom_meta.benefits.value | default: custom_meta.benefits
  assign tab_storage = custom_meta.storage_info.value | default: custom_meta.storage_info | default: custom_meta.storage
  assign tab_mfr = custom_meta.manufacturer.value | default: custom_meta.manufacturer
  assign tab_origin = custom_meta.origin.value | default: custom_meta.origin
  assign tab_shelflife = custom_meta.shelf_life.value | default: custom_meta.shelf_life

  assign faq1_q = custom_meta.faq_1_question.value | default: custom_meta.faq_1_question
  assign faq1_a = custom_meta.faq_1_answer.value | default: custom_meta.faq_1_answer
  assign faq2_q = custom_meta.faq_2_question.value | default: custom_meta.faq_2_question
  assign faq2_a = custom_meta.faq_2_answer.value | default: custom_meta.faq_2_answer
  assign faq3_q = custom_meta.faq_3_question.value | default: custom_meta.faq_3_question
  assign faq3_a = custom_meta.faq_3_answer.value | default: custom_meta.faq_3_answer
  assign faq4_q = custom_meta.faq_4_question.value | default: custom_meta.faq_4_question
  assign faq4_a = custom_meta.faq_4_answer.value | default: custom_meta.faq_4_answer
  assign faq5_q = custom_meta.faq_5_question.value | default: custom_meta.faq_5_question
  assign faq5_a = custom_meta.faq_5_answer.value | default: custom_meta.faq_5_answer
%}

<section class="product-tabs" data-product-tabs-component>
  <!-- Desktop / Tablet Tab Header Buttons -->
  <div class="product-tabs__header" role="tablist" aria-label="Product Information Tabs">
    <button type="button" class="product-tabs__tab-btn is-active" id="tab-btn-desc" role="tab" aria-selected="true" aria-controls="tab-pane-desc" data-tab-trigger="desc">
      Description
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-ingredients" role="tab" aria-selected="false" aria-controls="tab-pane-ingredients" data-tab-trigger="ingredients">
      Ingredients
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-usage" role="tab" aria-selected="false" aria-controls="tab-pane-usage" data-tab-trigger="usage">
      Usage
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-benefits" role="tab" aria-selected="false" aria-controls="tab-pane-benefits" data-tab-trigger="benefits">
      Benefits
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-storage" role="tab" aria-selected="false" aria-controls="tab-pane-storage" data-tab-trigger="storage">
      Storage Info
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-mfr" role="tab" aria-selected="false" aria-controls="tab-pane-mfr" data-tab-trigger="mfr">
      Manufacturer
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-origin" role="tab" aria-selected="false" aria-controls="tab-pane-origin" data-tab-trigger="origin">
      Origin
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-shelflife" role="tab" aria-selected="false" aria-controls="tab-pane-shelflife" data-tab-trigger="shelflife">
      Shelf Life
    </button>
    <button type="button" class="product-tabs__tab-btn" id="tab-btn-faq" role="tab" aria-selected="false" aria-controls="tab-pane-faq" data-tab-trigger="faq">
      FAQ
    </button>
  </div>

  <!-- Tab Content Panes -->
  <div class="product-tabs__body">
    <!-- Tab 1: Description -->
    <div class="product-tabs__pane is-active" id="tab-pane-desc" role="tabpanel" aria-labelledby="tab-btn-desc" data-tab-pane="desc">
      <h3 class="product-tabs__pane-title">Product Description</h3>
      <div class="product-tabs__pane-content rte">
        {% if tab_desc != blank %}
          {{ tab_desc | newline_to_br }}
        {% else %}
          <p>100% natural, unrefined organic {{ product.title }} sourced straight from native Indian farms.</p>
        {% endif %}
      </div>
    </div>

    <!-- Tab 2: Ingredients -->
    <div class="product-tabs__pane" id="tab-pane-ingredients" role="tabpanel" aria-labelledby="tab-btn-ingredients" data-tab-pane="ingredients" hidden>
      <h3 class="product-tabs__pane-title">Ingredients</h3>
      <div class="product-tabs__pane-content">
        {% if tab_ingredients != blank %}
          <div class="product-tabs__ingredients-box">
            {{ tab_ingredients | newline_to_br }}
          </div>
        {% else %}
          <div class="product-tabs__highlight-box">
            <span class="product-tabs__badge-icon">🌿</span>
            <p><strong>100% Raw & Organic {{ product.title }}</strong></p>
          </div>
          <p>Pure ingredients sourced directly from organic farms. Free from chemical bleaches, synthetic anti-caking agents, and artificial preservatives.</p>
        {% endif %}
      </div>
    </div>

    <!-- Tab 3: Usage -->
    <div class="product-tabs__pane" id="tab-pane-usage" role="tabpanel" aria-labelledby="tab-btn-usage" data-tab-pane="usage" hidden>
      <h3 class="product-tabs__pane-title">Usage Instructions</h3>
      <div class="product-tabs__pane-content">
        {% if tab_usage != blank %}
          <p>{{ tab_usage | newline_to_br }}</p>
        {% else %}
          <p>Ideal for daily home cooking, preparing traditional Indian recipes, and healthy meals with authentic flavor and aroma.</p>
        {% endif %}
      </div>
    </div>

    <!-- Tab 4: Benefits -->
    <div class="product-tabs__pane" id="tab-pane-benefits" role="tabpanel" aria-labelledby="tab-btn-benefits" data-tab-pane="benefits" hidden>
      <h3 class="product-tabs__pane-title">Nutritional & Health Benefits</h3>
      <div class="product-tabs__pane-content">
        {% if tab_benefits != blank %}
          <div class="product-tabs__benefits-list">
            {{ tab_benefits | newline_to_br }}
          </div>
        {% else %}
          <div class="product-tabs__grid-2col">
            <div class="product-tabs__benefit-item">
              <h4>🌾 100% Pure & Natural</h4>
              <p>Sourced from unpolluted organic soils to deliver essential natural nutrients.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>🛡️ Chemical Free</h4>
              <p>Zero pesticides, insecticides, synthetic additives, or heavy metals.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>💪 Rich in Micronutrients</h4>
              <p>Packed with natural vitamins, minerals, and antioxidants for overall well-being.</p>
            </div>
            <div class="product-tabs__benefit-item">
              <h4>❤️ Heart & Gut Healthy</h4>
              <p>Supports digestion, immunity, and healthy lifestyle choices for your family.</p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Tab 5: Storage Information -->
    <div class="product-tabs__pane" id="tab-pane-storage" role="tabpanel" aria-labelledby="tab-btn-storage" data-tab-pane="storage" hidden>
      <h3 class="product-tabs__pane-title">Storage Information</h3>
      <div class="product-tabs__pane-content">
        {% if tab_storage != blank %}
          <p>{{ tab_storage | newline_to_br }}</p>
        {% else %}
          <ul>
            <li>Store in a cool, dry place away from direct sunlight and moisture.</li>
            <li>Once opened, transfer into an airtight container.</li>
            <li>Always use a clean, dry spoon to handle the product.</li>
          </ul>
        {% endif %}
      </div>
    </div>

    <!-- Tab 6: Manufacturer Details -->
    <div class="product-tabs__pane" id="tab-pane-mfr" role="tabpanel" aria-labelledby="tab-btn-mfr" data-tab-pane="mfr" hidden>
      <h3 class="product-tabs__pane-title">Manufacturer & Packer Details</h3>
      <div class="product-tabs__pane-content">
        {% if tab_mfr != blank %}
          <p><strong>Manufacturer:</strong> {{ tab_mfr }}</p>
          <p><strong>Brand / Vendor:</strong> {{ product.vendor | default: 'Kishan Bazar' }}</p>
          <p><strong>Address:</strong> Surat - 395006, Gujarat, India.</p>
          <p><strong>FSSAI License No:</strong> 10721999000341</p>
        {% else %}
          <p><strong>Brand / Vendor:</strong> {{ product.vendor | default: 'Kishan Bazar' }}</p>
          <p><strong>Manufacturer:</strong> Kishan Bazar Organic Foods Pvt. Ltd.</p>
          <p><strong>Address:</strong> Plot No. 42-45, Green Agro Industrial Park, Surat - 395006, Gujarat, India.</p>
          <p><strong>FSSAI License No:</strong> 10721999000341</p>
        {% endif %}
      </div>
    </div>

    <!-- Tab 7: Country of Origin -->
    <div class="product-tabs__pane" id="tab-pane-origin" role="tabpanel" aria-labelledby="tab-btn-origin" data-tab-pane="origin" hidden>
      <h3 class="product-tabs__pane-title">Country of Origin</h3>
      <div class="product-tabs__pane-content">
        {% if tab_origin != blank %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <strong>{{ tab_origin }}</strong>
              <p>Sourced directly from certified organic farmer co-operatives across India.</p>
            </div>
          </div>
        {% else %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <strong>Made in India</strong>
              <p>Sourced directly from certified organic farmer co-operatives across India.</p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Tab 8: Shelf Life -->
    <div class="product-tabs__pane" id="tab-pane-shelflife" role="tabpanel" aria-labelledby="tab-btn-shelflife" data-tab-pane="shelflife" hidden>
      <h3 class="product-tabs__pane-title">Shelf Life</h3>
      <div class="product-tabs__pane-content">
        {% if tab_shelflife != blank %}
          <p><strong>{{ tab_shelflife }}</strong></p>
        {% else %}
          <p><strong>4 Months (120 Days)</strong> from date of packaging.</p>
        {% endif %}
      </div>
    </div>

    <!-- Tab 9: FAQ Accordions (Dynamic from CSV faq_1_question..faq_5_question) -->
    <div class="product-tabs__pane" id="tab-pane-faq" role="tabpanel" aria-labelledby="tab-btn-faq" data-tab-pane="faq" hidden>
      <h3 class="product-tabs__pane-title">Frequently Asked Questions (FAQ)</h3>
      <div class="product-tabs__pane-content">
        {% if faq1_q != blank %}
          <details class="product-tabs__accordion" open>
            <summary><strong>{{ faq1_q }}</strong></summary>
            <p>{{ faq1_a }}</p>
          </details>
        {% endif %}

        {% if faq2_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ faq2_q }}</strong></summary>
            <p>{{ faq2_a }}</p>
          </details>
        {% endif %}

        {% if faq3_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ faq3_q }}</strong></summary>
            <p>{{ faq3_a }}</p>
          </details>
        {% endif %}

        {% if faq4_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ faq4_q }}</strong></summary>
            <p>{{ faq4_a }}</p>
          </details>
        {% endif %}

        {% if faq5_q != blank %}
          <details class="product-tabs__accordion">
            <summary><strong>{{ faq5_q }}</strong></summary>
            <p>{{ faq5_a }}</p>
          </details>
        {% endif %}

        {% if faq1_q == blank and faq2_q == blank %}
          <details class="product-tabs__accordion" open>
            <summary><strong>Is {{ product.title }} 100% natural and unrefined?</strong></summary>
            <p>Yes, all {{ product.vendor | default: 'Kishan Bazar' }} products are 100% natural, unrefined, and processed without chemicals or artificial bleaches.</p>
          </details>
          <details class="product-tabs__accordion">
            <summary><strong>What is the estimated delivery time for my order?</strong></summary>
            <p>Orders are dispatched within 24 hours and delivered in 1-3 business days across India.</p>
          </details>
        {% endif %}
      </div>
    </div>
  </div>
</section>
