{% doc %}
  Renders Product Accordions section dynamically pulling product custom metafields:
  - Ingredients (c_meta.Ingredients / c_meta.ingredients)
  - Description (c_meta.description / product.description)
  - Usage (c_meta.usage)
  - Benefits (c_meta.benefits)
  - Storage Info (c_meta.storage_info)
  - Manufacturer & Packer Details (c_meta.manufacturer)
  - Country of Origin (c_meta.origin)
  - Shelf Life (c_meta.shelf_life)

  @param {object} product - The Shopify product object
  @param {object} [section] - The section object

  @example
  {% render 'product-tabs', product: product, section: section %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom
  assign alt_meta = product.metafields['product.metafields.custom']

  # 1. DESCRIPTION
  assign raw_desc = c_meta.description.value | default: c_meta.description | default: alt_meta.description.value | default: alt_meta.description | default: section.settings.tab_description | default: product.description

  # 2. INGREDIENTS
  assign raw_ingredients = c_meta.Ingredients.value | default: c_meta.Ingredients | default: c_meta.ingredients.value | default: c_meta.ingredients | default: alt_meta.Ingredients.value | default: alt_meta.ingredients.value | default: section.settings.tab_ingredients

  # 3. USAGE INFO
  assign raw_usage = c_meta.usage.value | default: c_meta.usage | default: alt_meta.usage.value | default: alt_meta.usage | default: section.settings.tab_usage

  # 4. BENEFITS
  assign raw_benefits = c_meta.benefits.value | default: c_meta.benefits | default: alt_meta.benefits.value | default: alt_meta.benefits | default: section.settings.tab_benefits

  # 5. STORAGE INFO
  assign raw_storage = c_meta.storage_info.value | default: c_meta.storage_info | default: alt_meta.storage_info.value | default: alt_meta.storage_info | default: c_meta.storage | default: section.settings.tab_storage

  # 6. MANUFACTURER & PACKER DETAILS
  assign raw_mfr = c_meta.manufacturer.value | default: c_meta.manufacturer | default: alt_meta.manufacturer.value | default: alt_meta.manufacturer | default: section.settings.tab_manufacturer

  # 7. COUNTRY OF ORIGIN
  assign raw_origin = c_meta.origin.value | default: c_meta.origin | default: alt_meta.origin.value | default: alt_meta.origin | default: section.settings.tab_origin

  # 8. SHELF LIFE
  assign raw_shelflife = c_meta.shelf_life.value | default: c_meta.shelf_life | default: alt_meta.shelf_life.value | default: alt_meta.shelf_life | default: section.settings.tab_shelflife
%}

<section class="product-tabs-section" aria-label="Product Details">
  <div class="product-accordion">
    
    <!-- 1. DESCRIPTION -->
    {% if raw_desc != blank %}
      <details class="product-accordion-item" open>
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">DESCRIPTION</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_desc }}
        </div>
      </details>
    {% endif %}

    <!-- 2. INGREDIENTS -->
    {% if raw_ingredients != blank %}
      <details class="product-accordion-item">
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">INGREDIENTS</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_ingredients }}
        </div>
      </details>
    {% endif %}

    <!-- 3. USAGE INFO -->
    {% if raw_usage != blank %}
      <details class="product-accordion-item">
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">USAGE INFO</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_usage }}
        </div>
      </details>
    {% endif %}

    <!-- 4. BENEFITS -->
    {% if raw_benefits != blank %}
      <details class="product-accordion-item">
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">BENEFITS</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_benefits }}
        </div>
      </details>
    {% endif %}

    <!-- 5. STORAGE INFO -->
    {% if raw_storage != blank %}
      <details class="product-accordion-item">
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">STORAGE INFO</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_storage }}
        </div>
      </details>
    {% endif %}

    <!-- 6. MANUFACTURER & PACKER DETAILS -->
    {% if raw_mfr != blank %}
      <details class="product-accordion-item">
        <summary class="product-accordion-item__header">
          <span class="product-accordion-item__title">MANUFACTURER &amp; PACKER DETAILS</span>
          <span class="product-accordion-item__icon" aria-hidden="true">
            <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="product-accordion-item__content rte">
          {{ raw_mfr }}
        </div>
      </details>
    {% endif %}

    <!-- 7. COUNTRY OF ORIGIN -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">COUNTRY OF ORIGIN</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_origin != blank %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <div class="rte">{{ raw_origin }}</div>
            </div>
          </div>
        {% else %}
          <div class="product-tabs__origin-flag">
            <span class="flag-icon">🇮🇳</span>
            <div>
              <strong>Made in India</strong>
              <p>Sourced directly from certified organic farmer co-operatives across India.</p>
            </div>
          </div>
        {% endif %}
      </div>
    </details>

    <!-- 8. SHELF LIFE -->
    <details class="product-accordion-item">
      <summary class="product-accordion-item__header">
        <span class="product-accordion-item__title">SHELF LIFE</span>
        <span class="product-accordion-item__icon" aria-hidden="true">
          <svg class="product-accordion-item__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b4317" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="product-accordion-item__content">
        {% if raw_shelflife != blank %}
          <div class="rte">{{ raw_shelflife }}</div>
        {% else %}
          <p><strong>4 Months (120 Days)</strong> from date of packaging.</p>
        {% endif %}
      </div>
    </details>

  </div>
</section>
