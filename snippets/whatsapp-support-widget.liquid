{% doc %}
  Renders a floating WhatsApp & Call customer support widget button and popup modal.
  Editable via Shopify Theme Settings & Section Schema.

  @example
  {% render 'whatsapp-support-widget' %}
{% enddoc %}

{% assign enable_widget = settings.support_widget_enable | default: true %}

{% if enable_widget != false %}
  {% assign raw_wa_phone = settings.support_whatsapp_number | default: "919377341042" | strip %}
  {% assign wa_phone = raw_wa_phone | remove: "+" | remove: " " | remove: "-" %}
  {% assign display_phone = settings.support_call_number | default: "+91 93773 41042" | strip %}
  {% assign modal_title = settings.support_modal_title | default: "Kishan Bazar Support" %}
  {% assign wa_msg = settings.support_whatsapp_prefilled_text | default: "Hi, I have a query regarding my order on Kishan Bazar." %}
  {% assign wa_btn_text = settings.support_whatsapp_btn_text | default: "Chat on WhatsApp" %}
  {% assign call_btn_text = settings.support_call_btn_text | default: "Call Us" %}

  <div class="kb-support-widget" data-kb-support-widget>
    <!-- Floating Trigger Button (Headphone Icon) -->
    <button type="button" class="kb-support-widget__trigger" data-kb-support-trigger aria-label="Open Customer Support Chat" aria-expanded="false">
      <svg class="kb-support-widget__trigger-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
      </svg>
      <span class="kb-support-widget__badge">1k+</span>
    </button>

    <!-- Modal Backdrop -->
    <div class="kb-support-widget__backdrop" data-kb-support-backdrop></div>

    <!-- Support Modal Popup -->
    <div class="kb-support-widget__modal" data-kb-support-modal role="dialog" aria-modal="true" aria-labelledby="kb-support-modal-title">
      <!-- Header -->
      <div class="kb-support-widget__header">
        <div class="kb-support-widget__brand">
          <div class="kb-support-widget__avatar">
            <span class="kb-support-widget__avatar-letter">K</span>
          </div>
          <div class="kb-support-widget__brand-info">
            <h3 id="kb-support-modal-title" class="kb-support-widget__title">{{ modal_title }}</h3>
            <span class="kb-support-widget__status">
              <span class="kb-support-widget__status-dot"></span>
              Online now
            </span>
          </div>
        </div>
        <button type="button" class="kb-support-widget__close" data-kb-support-close aria-label="Close support chat">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Body -->
      <div class="kb-support-widget__body">
        <div class="kb-support-widget__bubble">
          <p class="kb-support-widget__message" data-kb-support-greeting>
            Welcome to {{ modal_title }}! Please click on the button below to connect with our team.
          </p>
        </div>

        <!-- Action Buttons -->
        <div class="kb-support-widget__actions">
          <!-- Chat on WhatsApp -->
          <a href="https://wa.me/{{ wa_phone }}?text={{ wa_msg | url_encode }}" target="_blank" rel="noopener" class="kb-support-widget__btn kb-support-widget__btn--wa">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>{{ wa_btn_text }}</span>
          </a>

          <!-- Call Us -->
          <a href="tel:{{ display_phone | remove: ' ' }}" class="kb-support-widget__btn kb-support-widget__btn--call">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{{ call_btn_text }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Floating Trigger Button */
    .kb-support-widget {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 99998;
      font-family: var(--font-family-base, inherit);
    }

    body.template-product .kb-support-widget {
      bottom: 84px;
    }

    .kb-support-widget__trigger {
      background-color: #1b4317;
      color: #ffffff;
      border: none;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(27, 67, 23, 0.35);
      position: relative;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
    }

    .kb-support-widget__trigger:hover {
      transform: scale(1.08);
      background-color: #23421f;
    }

    .kb-support-widget__trigger:active {
      transform: scale(0.95);
    }

    .kb-support-widget__badge {
      position: absolute;
      bottom: -2px;
      right: -4px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 10px;
      border: 1.5px solid #ffffff;
      line-height: 1;
    }

    /* Backdrop Overlay */
    .kb-support-widget__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 99998;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .kb-support-widget.is-open .kb-support-widget__backdrop {
      opacity: 1;
      visibility: visible;
    }

    /* Support Modal Popup */
    .kb-support-widget__modal {
      position: fixed;
      bottom: 90px;
      right: 24px;
      width: min(90vw, 340px);
      background-color: #ffffff;
      border-radius: 20px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
      overflow: hidden;
      z-index: 99999;
      opacity: 0;
      visibility: hidden;
      transform: translateY(20px) scale(0.95);
      transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0.25s ease;
      border: 1px solid #efe8da;
    }

    body.template-product .kb-support-widget__modal {
      bottom: 148px;
    }

    .kb-support-widget.is-open .kb-support-widget__modal {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    /* Header */
    .kb-support-widget__header {
      background-color: #1b4317;
      color: #ffffff;
      padding: 1.15rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kb-support-widget__brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .kb-support-widget__avatar {
      width: 40px;
      height: 40px;
      background-color: rgba(255, 255, 255, 0.15);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid rgba(255, 255, 255, 0.3);
    }

    .kb-support-widget__avatar-letter {
      font-size: 1.2rem;
      font-weight: 800;
      color: #ffffff;
    }

    .kb-support-widget__title {
      margin: 0;
      font-size: 0.98rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
    }

    .kb-support-widget__status {
      font-size: 0.75rem;
      color: #a7f3d0;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-top: 2px;
    }

    .kb-support-widget__status-dot {
      width: 7px;
      height: 7px;
      background-color: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 8px #10b981;
      animation: kb-pulse 2s infinite;
    }

    @keyframes kb-pulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .kb-support-widget__close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: color 0.15s ease, background-color 0.15s ease;
    }

    .kb-support-widget__close:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.15);
    }

    /* Body */
    .kb-support-widget__body {
      padding: 1.25rem;
      background-color: #faf7f2;
    }

    .kb-support-widget__bubble {
      background-color: #ffffff;
      border-radius: 14px;
      border-top-left-radius: 4px;
      padding: 0.9rem 1rem;
      margin-bottom: 1.15rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid #efe8da;
    }

    .kb-support-widget__message {
      margin: 0;
      font-size: 0.88rem;
      color: #374151;
      line-height: 1.45;
      font-weight: 500;
    }

    /* Actions */
    .kb-support-widget__actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .kb-support-widget__btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 1rem;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      border: none;
    }

    .kb-support-widget__btn:active {
      transform: scale(0.98);
    }

    .kb-support-widget__btn--wa {
      background-color: #25d366;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    }

    .kb-support-widget__btn--wa:hover {
      background-color: #20bd5a;
      color: #ffffff;
    }

    .kb-support-widget__btn--call {
      background-color: #1b4317;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(27, 67, 23, 0.25);
    }

    .kb-support-widget__btn--call:hover {
      background-color: #23421f;
      color: #ffffff;
    }

    @media screen and (max-width: 48rem) {
      .kb-support-widget {
        bottom: 20px;
        right: 16px;
      }
      body.template-product .kb-support-widget {
        bottom: 74px;
      }
      .kb-support-widget__modal {
        right: 16px;
        width: calc(100vw - 32px);
      }
      body.template-product .kb-support-widget__modal {
        bottom: 138px;
      }
    }
  </style>

  <script>
    (function() {
      function initSupportWidget() {
        const widget = document.querySelector('[data-kb-support-widget]');
        if (!widget) return;

        const trigger = widget.querySelector('[data-kb-support-trigger]');
        const closeBtn = widget.querySelector('[data-kb-support-close]');
        const backdrop = widget.querySelector('[data-kb-support-backdrop]');
        const greeting = widget.querySelector('[data-kb-support-greeting]');
        const modalTitle = {{ modal_title | json }};

        // Set dynamic time-of-day greeting
        if (greeting) {
          const hour = new Date().getHours();
          let timeSalutation = "Good morning! ☀️";
          if (hour >= 12 && hour < 17) {
            timeSalutation = "Good afternoon! 🌤️";
          } else if (hour >= 17) {
            timeSalutation = "Good evening! 🌙";
          }
          greeting.textContent = `${timeSalutation} Welcome to ${modalTitle}. Please click on the button below to connect with our team.`;
        }

        function toggleWidget(open) {
          const shouldOpen = open !== undefined ? open : !widget.classList.contains('is-open');
          widget.classList.toggle('is-open', shouldOpen);
          if (trigger) trigger.setAttribute('aria-expanded', String(shouldOpen));
        }

        if (trigger) {
          trigger.addEventListener('click', function(e) {
            e.preventDefault();
            toggleWidget();
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            toggleWidget(false);
          });
        }

        if (backdrop) {
          backdrop.addEventListener('click', function() {
            toggleWidget(false);
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSupportWidget);
      } else {
        initSupportWidget();
      }
    })();
  </script>
{% endif %}
