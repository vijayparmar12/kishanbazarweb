{% doc %}
  Renders the header for the Wishlist drawer including title, item counter, search input, and close button.

  @param {object} [section] - The parent section containing schema settings
{% enddoc %}

{% assign drawer_title = settings.wishlist_drawer_title | default: section.settings.drawer_title | default: 'My Wishlist' %}
{% assign search_placeholder = settings.wishlist_search_placeholder | default: section.settings.search_placeholder | default: 'Search saved products...' %}

<div class="kb-wishlist-header">
  <div class="kb-wishlist-header__top">
    <div class="kb-wishlist-header__title-wrap">
      <span class="kb-wishlist-header__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#23421F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </span>
      <h2 class="kb-wishlist-header__title" id="WishlistDrawerTitle">{{ drawer_title }}</h2>
      <span class="kb-wishlist-header__count" data-wishlist-count-badge>0</span>
    </div>
    <button type="button" class="kb-wishlist-header__close" aria-label="Close wishlist" data-wishlist-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>
