{% doc %}
  Renders the header for the Wishlist drawer including title, item counter, search input, and close button.

  @param {object} [section] - The parent section containing schema settings
{% enddoc %}

{% assign drawer_title = section.settings.drawer_title | default: 'My Wishlist' %}
{% assign search_placeholder = section.settings.search_placeholder | default: 'Search saved products...' %}

<div class="kb-wishlist-header">
  <div class="kb-wishlist-header__top">
    <div class="kb-wishlist-header__title-wrap">
      <span class="kb-wishlist-header__icon" aria-hidden="true">❤️</span>
      <h2 class="kb-wishlist-header__title" id="WishlistDrawerTitle">{{ drawer_title }}</h2>
      <span class="kb-wishlist-header__count" data-wishlist-count-badge>0</span>
    </div>
    <button type="button" class="kb-wishlist-header__close" aria-label="Close wishlist" data-wishlist-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="kb-wishlist-header__search-wrap">
    <span class="kb-wishlist-search-icon" aria-hidden="true">🔍</span>
    <input
      type="search"
      class="kb-wishlist-search-input"
      placeholder="{{ search_placeholder | escape }}"
      autocomplete="off"
      data-wishlist-search-input
    >
    <button type="button" class="kb-wishlist-search-clear" aria-label="Clear search" data-wishlist-search-clear style="display: none;">&times;</button>
  </div>
</div>
