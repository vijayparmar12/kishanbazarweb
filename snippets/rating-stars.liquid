{% doc %}
  Renders dynamic vector SVG rating stars (Full, Half, or Empty) based on exact rating value.
  Uses a single inline <defs><symbol> to define the star path once and <use> for every star
  instance, eliminating repeated 224-byte path strings.

  @param {object} [product] - The Shopify product object
  @param {number} [rating] - Explicit rating number (e.g. 4.91, 4.5, 5.0)
  @param {string} [stars_color] - CSS color override

  @example
  {% render 'rating-stars', product: product %}
{% enddoc %}

{% liquid
  assign rating_val = product.metafields.reviews.rating.value.rating | default: rating | default: 4.91 | times: 1.0
  assign full_stars = rating_val | floor
  assign decimal_part = rating_val | minus: full_stars

  assign has_half_star = false
  if decimal_part >= 0.15 and decimal_part < 0.98
    assign has_half_star = true
  elsif decimal_part >= 0.98
    assign full_stars = full_stars | plus: 1
  endif

  if full_stars > 5
    assign full_stars = 5
  endif

  assign empty_stars = 5 | minus: full_stars
  if has_half_star and empty_stars > 0
    assign empty_stars = empty_stars | minus: 1
  endif

  assign rand_id = product.id | default: 'def'
  assign active_star_color = stars_color | default: '#e5b42a'
%}

<span class="product-card__stars" aria-hidden="true" style="color: {{ active_star_color }};">
  {%- comment -%}Define star path once; reuse via <use href="#..."> for full/empty states{%- endcomment -%}
  <svg width="0" height="0" style="position:absolute;overflow:hidden">
    <defs>
      <symbol id="star-full-{{ rand_id }}" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69L9.049 2.927z"/>
      </symbol>
      {% if has_half_star %}
        <linearGradient id="star-grad-{{ rand_id }}">
          <stop offset="70%" stop-color="{{ active_star_color }}"/>
          <stop offset="70%" stop-color="#d1d5db"/>
        </linearGradient>
        <symbol id="star-half-{{ rand_id }}" viewBox="0 0 20 20">
          <path fill="url(#star-grad-{{ rand_id }})" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69L9.049 2.927z"/>
        </symbol>
      {% endif %}
    </defs>
  </svg>

  {%- if full_stars > 0 -%}
    {%- for i in (1..full_stars) -%}
      <svg class="product-card__star-icon product-card__star-icon--full" width="20" height="20" fill="currentColor" aria-hidden="true"><use href="#star-full-{{ rand_id }}"/></svg>
    {%- endfor -%}
  {%- endif -%}

  {%- if has_half_star -%}
    <svg class="product-card__star-icon product-card__star-icon--half" width="20" height="20" aria-hidden="true"><use href="#star-half-{{ rand_id }}"/></svg>
  {%- endif -%}

  {%- if empty_stars > 0 -%}
    {%- for i in (1..empty_stars) -%}
      <svg class="product-card__star-icon product-card__star-icon--empty" width="20" height="20" fill="#d1d5db" aria-hidden="true"><use href="#star-full-{{ rand_id }}"/></svg>
    {%- endfor -%}
  {%- endif -%}
</span>
