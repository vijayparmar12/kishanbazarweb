{% doc %}
  Renders the horizontal slider for recommended organic products in Kishan Bazar.

  @param {object} product - Main product object
  @param {object} [collection] - Parent collection if available

  @example
  {% render 'product-recommendations-slider', product: product %}
{% enddoc %}

{% liquid
  assign rec_products = collection.products
  if rec_products == blank or rec_products.size == 0
    assign rec_products = product.collections.first.products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections.all.products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections['all'].products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections.frontpage.products
  endif
%}

<section class="product-recommendations-slider" aria-label="Recommended Products" data-recommended-products-section>
  <div class="product-recommendations-slider__inner">
    <div class="product-recommendations-slider__head" style="margin-bottom: 1.25rem;">
      <div>
        <span class="product-recommendations-slider__eyebrow" style="color: #D97706; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.25rem;">Handpicked Organic Staples</span>
        <h2 class="product-recommendations-slider__title" style="color: #1B4317; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0;">RECOMMENDED</h2>
      </div>
      <div class="product-recommendations-slider__nav-btns">
        <button type="button" class="product-recommendations-slider__nav-btn cta-arrow-circle" data-slider-prev aria-label="Previous recommended products">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="product-recommendations-slider__nav-btn cta-arrow-circle" data-slider-next aria-label="Next recommended products">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="product-recommendations-slider__track" data-slider-track>
      {% if rec_products.size > 0 %}
        {% assign count = 0 %}
        {% for rec_product in rec_products %}
          {% unless rec_product.id == product.id %}
            {% assign count = count | plus: 1 %}
            {% if count <= 8 %}
              <div class="product-recommendations-slider__slide">
                {% render 'product-card', product: rec_product, show_badge: true, show_rating: true, show_wishlist: true %}
              </div>
            {% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
