{% doc %}
  Renders the horizontal slider for recommended organic products in Kishan Bazar.
  - Smooth snap slider with navigation buttons
  - Clean Green Circle [ → ] More Card (No Box / No Box Hover) that navigates to All Products (/collections/all)

  @param {object} product - Main product object
  @param {object} [collection] - Parent collection if available

  @example
  {% render 'product-recommendations-slider', product: product %}
{% enddoc %}

{% liquid
  assign rec_products = collection.products
  if rec_products == blank or rec_products.size == 0
    assign rec_products = product.collections.first.products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections.all.products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections['all'].products
  endif
  if rec_products == blank or rec_products.size == 0
    assign rec_products = collections.frontpage.products
  endif

  assign all_products_url = routes.all_products_collection_url
%}

<section class="product-recommendations-slider" aria-label="Recommended Products" data-recommended-products-section>
  <div class="product-recommendations-slider__inner">
    <div class="product-recommendations-slider__head" style="margin-bottom: 1.25rem;">
      <div>
        <span class="product-recommendations-slider__eyebrow" style="color: #D97706; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.25rem;">Handpicked Organic Staples</span>
        <h2 class="product-recommendations-slider__title" style="color: #1B4317; font-size: clamp(1.4rem, 3.2vw, 2.2rem); font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0;">RECOMMENDED</h2>
      </div>
      <div class="product-recommendations-slider__nav-btns">
        <button type="button" class="product-recommendations-slider__nav-btn cta-arrow-circle" data-slider-prev aria-label="Previous recommended products">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="product-recommendations-slider__nav-btn cta-arrow-circle" data-slider-next aria-label="Next recommended products">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="product-recommendations-slider__track" data-slider-track style="align-items: stretch;">
      {% if rec_products.size > 0 %}
        {% assign count = 0 %}
        {% for rec_product in rec_products %}
          {% unless rec_product.id == product.id %}
            {% assign count = count | plus: 1 %}
            {% if count <= 8 %}
              <div class="product-recommendations-slider__slide">
                {% render 'product-card', product: rec_product, show_badge: true, show_rating: true, show_wishlist: true, hide_benefit_icons: true %}
              </div>
            {% endif %}
          {% endunless %}
        {% endfor %}

        <!-- CLEAN GREEN CIRCLE [ → ] MORE ARROW (NO BOX / NO BOX HOVER) -->
        <div class="product-recommendations-slider__slide product-recommendations-slider__slide--more" style="flex: 0 0 120px; max-width: 120px; display: flex; align-items: center; justify-content: center; scroll-snap-align: start;">
          <a href="{{ all_products_url }}" class="product-recommendations-slider__more-card" aria-label="View all products" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.65rem; width: 100%; height: 100%; min-height: 200px; text-decoration: none; background: transparent; border: none; box-shadow: none; padding: 0; margin: 0; cursor: pointer;">
            <div class="product-recommendations-slider__more-circle" style="width: 56px; height: 56px; border-radius: 50%; background-color: #1b4317; color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(27, 67, 23, 0.28); transition: transform 220ms ease;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
            <span class="product-recommendations-slider__more-label" style="font-size: 0.92rem; font-weight: 800; color: #1b4317; letter-spacing: 0.02em;">More</span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>
