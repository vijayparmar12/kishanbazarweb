{% doc %}
  Renders the cart summary, note editor, and checkout actions.

  @param {cart} cart - The current cart object.
  @param {number} [free_shipping_threshold] - Threshold for the free shipping progress message.
  @param {string} [checkout_url] - Checkout destination.
{% enddoc %}

{% assign checkout_url = checkout_url | default: routes.checkout_url %}
{% assign free_shipping_threshold = free_shipping_threshold | default: 0 %}
{% assign threshold_cents = free_shipping_threshold | times: 100 %}
{% assign subtotal = cart.original_total_price | default: cart.total_price %}
{% assign total = cart.total_price %}
{% assign discount_total = cart.total_discount | default: 0 %}
{% assign progress_value = 0 %}
{% assign has_free_shipping = false %}

{% if threshold_cents > 0 %}
  {% assign progress_value = total | times: 100 | divided_by: threshold_cents %}
  {% if progress_value > 100 %}
    {% assign progress_value = 100 %}
  {% endif %}
  {% if total >= threshold_cents %}
    {% assign has_free_shipping = true %}
  {% endif %}
{% endif %}

<aside class="kb-cart-summary" data-cart-summary>
  <div class="kb-cart-summary__card">
    <div class="kb-cart-summary__header">
      <h2 class="kb-cart-summary__title">Order Summary</h2>
      <span class="kb-cart-summary__item-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
    </div>

    {% if threshold_cents > 0 %}
      <div class="kb-cart-drawer__progress kb-cart-summary__progress-card">
        {% if has_free_shipping %}
          <div class="kb-cart-drawer__progress-title">
            <span>🎉 You have unlocked <strong>FREE Shipping!</strong></span>
          </div>
        {% else %}
          {% assign remaining_amount = threshold_cents | minus: total | money %}
          <div class="kb-cart-drawer__progress-title">
            <span>Add <strong>{{ remaining_amount }}</strong> more for <strong>FREE Shipping</strong> 🚚</span>
          </div>
        {% endif %}
        <div class="kb-cart-drawer__progress-bar-wrap">
          <div class="kb-cart-drawer__progress-fill" style="width: {{ progress_value }}%;"></div>
          <div class="kb-cart-drawer__progress-truck" style="left: {{ progress_value }}%;" aria-hidden="true">🚚</div>
          <div class="kb-cart-drawer__progress-badge" style="left: {{ progress_value }}%;">{{ progress_value }}%</div>
        </div>
      </div>
    {% endif %}

    <dl class="kb-cart-summary__totals">
      <div class="kb-cart-summary__line">
        <dt>Subtotal</dt>
        <dd>{{ subtotal | money }}</dd>
      </div>
      {% if discount_total > 0 %}
        <div class="kb-cart-summary__line kb-cart-summary__line--discount">
          <dt>Discount Savings</dt>
          <dd>-{{ discount_total | money }}</dd>
        </div>
      {% endif %}
      <div class="kb-cart-summary__line">
        <dt>Shipping</dt>
        <dd>{% if has_free_shipping or total >= 149900 %}<strong class="kb-text-green">FREE</strong>{% else %}Calculated at checkout{% endif %}</dd>
      </div>
      <div class="kb-cart-summary__line kb-cart-summary__line--grand">
        <dt>Estimated Total</dt>
        <dd class="kb-cart-summary__grand-price">{{ total | money }}</dd>
      </div>
    </dl>

    <div class="kb-cart-summary__coupon-box">
      <div class="kb-cart-summary__coupon-header">
        <span class="kb-cart-summary__coupon-icon">🏷️</span>
        <span class="kb-cart-summary__coupon-label">Apply Discount Code</span>
      </div>
      <div class="kb-cart-summary__coupon-row">
        <input class="kb-cart-summary__coupon-input" id="CartDiscountCode-{{ section.id }}" type="text" autocomplete="off" placeholder="Enter coupon code (e.g. TBOF10)" value="TBOF10" data-discount-code>
        <button class="kb-cart-summary__coupon-btn" type="button" data-apply-discount>Apply</button>
      </div>
      <div class="kb-cart-summary__applied-badge">
        <span>✓ Code <strong>TBOF10</strong> applied (10% OFF above ₹3000)</span>
      </div>
    </div>

    <div class="kb-cart-summary__actions">
      <a class="kb-cart-summary__checkout-btn" href="{{ checkout_url }}" data-checkout-link>
        <span class="kb-cart-summary__checkout-btn-text">Proceed to Checkout →</span>
        <span class="kb-cart-summary__payment-badges">
          <span class="kb-pay-badge kb-pay-badge--paytm">Paytm</span>
          <span class="kb-pay-badge kb-pay-badge--gpay">GPay</span>
          <span class="kb-pay-badge kb-pay-badge--phonepe">Pe</span>
          <span class="kb-pay-badge kb-pay-badge--cards">💳</span>
        </span>
      </a>
      <a class="kb-cart-summary__continue-btn" href="{{ routes.collections_url }}">← Continue Shopping</a>
    </div>

    <!-- Trust Badges -->
    <div class="kb-cart-summary__trust-grid">
      <div class="kb-cart-summary__trust-item">
        <span class="kb-cart-summary__trust-icon">🌿</span>
        <span>100% Certified Organic</span>
      </div>
      <div class="kb-cart-summary__trust-item">
        <span class="kb-cart-summary__trust-icon">🚚</span>
        <span>Express Delivery</span>
      </div>
      <div class="kb-cart-summary__trust-item">
        <span class="kb-cart-summary__trust-icon">🔒</span>
        <span>Secure Checkout</span>
      </div>
    </div>
  </div>
</aside>