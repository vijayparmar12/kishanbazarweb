{% doc %}
  Renders the cart summary, note editor, and checkout actions.

  @param {cart} cart - The current cart object.
  @param {number} [free_shipping_threshold] - Threshold for the free shipping progress message.
  @param {string} [checkout_url] - Checkout destination.
{% enddoc %}

{% assign checkout_url = checkout_url | default: routes.checkout_url %}
{% assign free_shipping_threshold = free_shipping_threshold | default: 0 %}
{% assign threshold_cents = free_shipping_threshold | times: 100 %}
{% assign subtotal = cart.original_total_price | default: cart.total_price %}
{% assign total = cart.total_price %}
{% assign discount_total = cart.total_discount | default: 0 %}
{% assign progress_value = 0 %}
{% assign has_free_shipping = false %}

{% if threshold_cents > 0 %}
  {% assign progress_value = total | times: 100 | divided_by: threshold_cents %}
  {% if progress_value > 100 %}
    {% assign progress_value = 100 %}
  {% endif %}
  {% if total >= threshold_cents %}
    {% assign has_free_shipping = true %}
  {% endif %}
{% endif %}

{% assign free_ship_val = settings.cart_free_shipping_threshold | default: 1499 | times: 100 %}
{% assign discount_val = settings.cart_discount_threshold | default: 3000 | times: 100 %}
{% assign coupon_code = settings.cart_coupon_code | default: 'TBOF10' %}
{% assign savings_label = settings.cart_savings_label | default: 'Save ₹709' %}
{% assign addons_heading = settings.cart_addons_heading | default: 'Frequently Bought Together' %}
{% assign checkout_label = settings.cart_checkout_btn_text | default: 'Checkout' %}

<aside class="kb-cart-summary" data-cart-summary>
  <div class="kb-cart-summary__card">
    <div class="kb-cart-summary__header">
      <h2 class="kb-cart-summary__title">Order Summary</h2>
      <span class="kb-cart-summary__item-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
    </div>

    <!-- Offers & Discounts Block (Matching Cart Drawer Image 2) -->
    <div class="kb-cart-drawer__offers-block" data-cart-offers-block style="margin-bottom: 20px;">
      <div class="kb-cart-coupon-box">
        <div class="kb-cart-coupon-info">
          <span class="kb-cart-coupon-icon">%</span>
          <div class="kb-cart-coupon-text">
            <strong data-cart-savings-label>{{ savings_label }}</strong>
            <span>with '<strong data-applied-coupon>{{ coupon_code }}</strong>'</span>
          </div>
        </div>
        <button type="button" class="kb-cart-coupon-apply-btn" data-cart-apply-coupon>Apply</button>
      </div>
      
      <div class="kb-cart-offers-links">
        <button type="button" class="kb-cart-offers-link" data-open-coupons-modal>
          <span class="icon">%</span> More offers <span class="arrow">View all coupons &gt;</span>
        </button>
      </div>
    </div>

    <!-- Frequently Bought Together Carousel -->
    <div class="kb-cart-drawer__addons-block" style="margin-bottom: 20px;">
      <div class="kb-cart-addons-tabs">
        <button type="button" class="kb-cart-tab-btn is-active" data-cart-tab="frequently">{{ addons_heading }}</button>
      </div>

      <div class="kb-cart-tab-panel is-active" data-tab-panel="frequently">
        <div class="kb-cart-addons-track">
          {% assign addons_coll = settings.cart_addons_collection.products | default: collections.all.products %}
          {% for product in addons_coll limit: 6 %}
            {% assign addon_variant = product.selected_or_first_available_variant %}
            {% assign addon_available = addon_variant.available %}
            {% if addon_variant.inventory_management != blank and addon_variant.inventory_policy == 'deny' and addon_variant.inventory_quantity <= 0 %}
              {% assign addon_available = false %}
            {% elsif addon_variant.inventory_quantity != blank and addon_variant.inventory_quantity <= 0 and addon_variant.inventory_policy != 'continue' %}
              {% assign addon_available = false %}
            {% endif %}
            <div
              class="kb-cart-addon-card"
              data-fbt-card
              data-product-handle="{{ product.handle }}"
              data-variants-count="{{ product.variants.size }}"
              data-add-variant-id="{{ addon_variant.id }}"
              data-product-title="{{ product.title | escape }}"
            >
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" class="kb-cart-addon-img" width="60" height="60" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'kb-cart-addon-img' }}
              {% endif %}
              <div class="kb-cart-addon-details">
                <div class="kb-cart-addon-title">{{ product.title }}</div>
                <div class="kb-cart-addon-price">
                  {% if product.compare_at_price > product.price %}
                    <s class="kb-cart-addon-compare">{{ product.compare_at_price | money }}</s>
                  {% endif %}
                  <span>{{ product.price | money }}</span>
                </div>
              </div>
              <button
                type="button"
                class="kb-cart-addon-add-btn"
                data-add-variant-id="{{ addon_variant.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-variants-count="{{ product.variants.size }}"
                {% unless addon_available %}disabled style="opacity: 0.65; cursor: not-allowed;"{% endunless %}
              >
                {% if addon_available %}+ ADD{% else %}SOLD OUT{% endif %}
              </button>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% assign shipping_fee_num = section.settings.cart_shipping_fee | default: settings.cart_shipping_fee | default: 99 %}
    {% assign shipping_fee_cents = shipping_fee_num | times: 100 %}
    <dl class="kb-cart-summary__totals">
      <div class="kb-cart-summary__line">
        <dt>Subtotal</dt>
        <dd>{{ cart.total_price | money }}</dd>
      </div>
      <div class="kb-cart-summary__line">
        <dt>Shipping Charge</dt>
        <dd>
          {% if threshold_cents > 0 and cart.total_price >= threshold_cents %}
            <span style="color: #166534; font-weight: 700;">FREE</span>
          {% else %}
            <span>+{{ shipping_fee_cents | money }}</span>
          {% endif %}
        </dd>
      </div>
      {% if cart.total_discount > 0 %}
        <div class="kb-cart-summary__line kb-cart-summary__line--discount">
          <dt>Discount Savings</dt>
          <dd>-{{ cart.total_discount | money }}</dd>
        </div>
      {% endif %}
      <div class="kb-cart-summary__line kb-cart-summary__line--grand">
        <dt>Estimated Total</dt>
        <dd class="kb-cart-summary__grand-price">
          {% if threshold_cents > 0 and cart.total_price >= threshold_cents %}
            {{ cart.total_price | money }}
          {% else %}
            {{ cart.total_price | plus: shipping_fee_cents | money }}
          {% endif %}
        </dd>
      </div>
    </dl>

    <!-- Sticky Checkout Footer (Matching Cart Drawer Image 2) -->
    <div class="kb-cart-drawer__footer" style="padding: 0; background: transparent; border: none; box-shadow: none; margin-top: 16px;">
      <a href="/checkout" class="kb-cart-drawer__checkout-btn" style="text-decoration: none; display: flex;">
        <span class="kb-cart-drawer__checkout-label">{{ checkout_label }}</span>
        <span class="kb-cart-drawer__payment-badges">
          <span class="kb-pay-badge kb-pay-badge--paytm">Paytm</span>
          <span class="kb-pay-badge kb-pay-badge--gpay">GPay</span>
          <span class="kb-pay-badge kb-pay-badge--phonepe">Pe</span>
          <span class="kb-pay-badge kb-pay-badge--cards">💳</span>
        </span>
      </a>
      <div class="kb-cart-drawer__credit">Powered by <strong>Shopflo</strong></div>
    </div>
  </div>
</aside>
