{% doc %}
  Renders the global cart drawer shell.
{% enddoc %}

{% liquid
  assign cart_title_text = section.settings.cart_title_text | default: settings.cart_title_text | default: 'YOUR CART'
  assign free_shipping_threshold_num = section.settings.cart_free_shipping_threshold | default: settings.cart_free_shipping_threshold | default: 1499
  assign discount_threshold_num = section.settings.cart_discount_threshold | default: settings.cart_discount_threshold | default: 3000
  assign free_ship_val = free_shipping_threshold_num | times: 100
  assign discount_val = discount_threshold_num | times: 100
  assign promo_text = section.settings.cart_promo_bar_text | default: settings.cart_promo_bar_text
  assign coupon_code = section.settings.cart_coupon_code | default: settings.cart_coupon_code
  assign savings_label = section.settings.cart_savings_label | default: settings.cart_savings_label
  assign coupon_blocks = section.blocks | where: 'type', 'coupon_offer'
  assign coupons_modal_title = section.settings.cart_coupons_modal_title | default: 'Available Coupons & Offers'
  assign savings_ribbon_suffix = section.settings.cart_savings_ribbon_suffix | default: 'Saved so far!'
  assign estimated_total_label = section.settings.cart_estimated_total_label | default: 'Estimated Total'
  assign show_payment_badges = section.settings.cart_show_payment_badges
  if show_payment_badges == nil
    assign show_payment_badges = true
  endif
  assign credit_branding_text = section.settings.cart_credit_branding_text | default: 'Powered by Shopflo'
  assign choose_option_title = section.settings.cart_choose_option_title | default: 'Choose Option'
  assign choose_option_confirm_btn = section.settings.cart_choose_option_confirm_btn | default: 'Confirm'

  if coupon_code == blank and coupon_blocks.size > 0
    assign coupon_code = coupon_blocks[0].settings.code
    assign savings_label = coupon_blocks[0].settings.discount_title
  endif

  assign addons_heading = section.settings.cart_addons_heading | default: settings.cart_addons_heading | default: 'Frequently Bought Together'
  assign addons_collection = section.settings.cart_addons_collection | default: settings.cart_addons_collection
  assign checkout_label = section.settings.cart_checkout_btn_text | default: settings.cart_checkout_btn_text | default: 'Checkout'

  assign cart_original_price = 0
  for item in cart.items
    if item.variant.compare_at_price > item.variant.price
      assign item_unit_compare = item.variant.compare_at_price
    elsif item.original_line_price > item.final_line_price
      assign item_unit_compare = item.original_line_price | divided_by: item.quantity
    else
      assign item_unit_compare = item.final_price
    endif
    assign line_orig = item_unit_compare | times: item.quantity
    assign cart_original_price = cart_original_price | plus: line_orig
  endfor

  if cart_original_price <= cart.total_price and cart.original_total_price > cart.total_price
    assign cart_original_price = cart.original_total_price
  endif

  assign total_saved = cart_original_price | minus: cart.total_price
  if total_saved < 0
    assign total_saved = 0
  endif
%}

<aside class="kb-cart-drawer" id="CartDrawer" hidden data-cart-drawer data-cart-drawer-mode="full" aria-label="{{ 'cart.title' | t }}">
  <div class="kb-cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="kb-cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="kb-cart-drawer__header">
      <h2 class="kb-cart-drawer__title" id="CartDrawerTitle">{{ cart_title_text }} ({{ cart.item_count }})</h2>
      <button class="kb-cart-drawer__close" type="button" aria-label="{{ 'cart.close' | t }}" data-cart-drawer-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="kb-cart-drawer__progress" data-cart-drawer-progress {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
      <p class="kb-cart-drawer__promo-copy" data-cart-drawer-status>
        {% if cart.total_price >= free_ship_val %}
          Hurray! You've unlocked FREE Shipping
        {% else %}
          {% assign remaining_ship = free_ship_val | minus: cart.total_price %}
          Add {{ remaining_ship | money }} more for FREE Shipping
        {% endif %}
      </p>
      
      <div class="kb-cart-drawer__progress-track-wrap">
        <div class="kb-cart-drawer__progress-track">
          {% liquid
            if cart.total_price >= free_ship_val
              assign fill_pct = 100
            else
              assign fill_pct = cart.total_price | times: 100 | divided_by: free_ship_val
            endif
          %}
          <span class="kb-cart-drawer__progress-fill" style="width: {{ fill_pct }}%"></span>
          
          <div class="kb-cart-drawer__marker kb-cart-drawer__marker--1 kb-cart-drawer__progress-marker--1 {% if cart.total_price >= free_ship_val %}is-active{% endif %}" style="left: 95%">
            <span class="kb-cart-drawer__marker-top">₹{{ free_shipping_threshold_num }}</span>
            <div class="kb-cart-drawer__marker-box">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="2" ry="2"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <span class="kb-cart-drawer__marker-bottom">FREE SHIPPING</span>
          </div>
        </div>
      </div>
    </div>

    <div class="kb-cart-drawer__body">
      <div class="kb-cart-drawer__items" data-cart-drawer-items>
        {% for item in cart.items %}
          {% render 'cart-item', item: item, line_index: forloop.index, compact: true %}
        {% else %}
          <div class="kb-cart-drawer__empty" data-cart-drawer-empty>
            <h2 class="kb-cart-drawer__empty-heading">Cart</h2>
            <p class="kb-cart-drawer__empty-text">Your cart is empty</p>
            <a href="/collections/all" class="kb-cart-drawer__empty-btn" data-cart-drawer-close>START SHOPPING</a>
          </div>
        {% endfor %}
      </div>



      <!-- Frequently Bought Together Carousel (Matching Two Brothers Organic Farms UI) -->
      <div class="kb-cart-drawer__addons-block" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        <div class="kb-cart-addons-tabs" style="margin-bottom: 0.6rem;">
          <button type="button" class="kb-cart-tab-btn is-active" data-cart-tab="frequently" style="font-weight: 800; font-size: 0.88rem; color: #166534;">Frequently Bought Together</button>
        </div>

        <div class="kb-cart-tab-panel is-active" data-tab-panel="frequently">
          <div class="kb-cart-addons-track" style="display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem; scrollbar-width: none;">
            {% assign addons_coll = addons_collection.products | default: collections.all.products %}
            {% for product in addons_coll limit: 8 %}
              <div
                class="kb-cart-addon-card"
                data-fbt-card
                data-product-handle="{{ product.handle }}"
                data-variants-count="{{ product.variants.size }}"
                data-add-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-product-title="{{ product.title | escape }}"
                style="cursor: pointer;"
              >
                <div class="kb-cart-addon-top-row">
                  {% if product.featured_image != blank %}
                    <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" class="kb-cart-addon-img" width="58" height="58" loading="lazy">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'kb-cart-addon-img' }}
                  {% endif %}
                  <div class="kb-cart-addon-info-meta">
                    <div class="kb-cart-addon-title">{{ product.title }}</div>
                    <div class="kb-cart-addon-price">
                      {% if product.compare_at_price > product.price %}
                        <s class="kb-cart-addon-compare">{{ product.compare_at_price | money }}</s>
                      {% endif %}
                      <span>{{ product.price | money }}</span>
                    </div>
                  </div>
                </div>
                <button
                  type="button"
                  class="kb-cart-addon-add-btn"
                  data-add-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  data-product-handle="{{ product.handle }}"
                  data-product-title="{{ product.title | escape }}"
                  data-variants-count="{{ product.variants.size }}"
                >
                  + ADD
                </button>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="kb-cart-drawer__footer" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
      <!-- Rosier Foods Style Dynamic Savings Ribbon & Estimated Total Box -->
      <div class="kb-cart-drawer__summary-box" data-cart-summary-box style="width: 100%;">
        <div class="kb-cart-savings-ribbon-wrap">
          <div class="kb-cart-savings-ribbon" data-cart-savings-ribbon {% if total_saved <= 0 %}style="display: none;"{% endif %}>
            <span><strong data-cart-total-saved-amount>{{ total_saved | money }}</strong> {{ savings_ribbon_suffix }}</span>
          </div>
        </div>

        <div class="kb-cart-estimated-total-row">
          <div class="kb-cart-estimated-label">
            <span class="kb-cart-estimated-tag-icon">₹</span>
            <strong>{{ estimated_total_label }}</strong>
          </div>
          <div class="kb-cart-estimated-prices">
            <strong class="kb-cart-estimated-final" data-cart-drawer-subtotal>{{ cart.total_price | money }}</strong>
            <s class="kb-cart-estimated-original" data-cart-drawer-original-total {% if total_saved <= 0 %}style="display: none;"{% endif %}>{{ cart_original_price | money }}</s>
            {% if total_saved > 0 and cart_original_price > 0 %}
              {% assign save_pct = total_saved | times: 100 | divided_by: cart_original_price %}
              <span class="kb-cart-estimated-badge" data-cart-drawer-save-badge>({{ save_pct }}% OFF)</span>
            {% else %}
              <span class="kb-cart-estimated-badge" data-cart-drawer-save-badge style="display: none;"></span>
            {% endif %}
          </div>
        </div>
      </div>

      <a href="/checkout" class="kb-cart-drawer__checkout-btn">
        <div class="kb-cart-drawer__checkout-left">
          <span class="kb-cart-drawer__checkout-label">{{ checkout_label }}</span>
          <span class="kb-cart-drawer__checkout-subtext">Free Shipping on Orders Above ₹{{ free_shipping_threshold_num }}</span>
        </div>
      </a>
    </div>

    <!-- Choose Option Variant Drawer Modal Popup (Overlaying Directly On Top Of Cart Drawer) -->
    <aside class="kb-choose-option-modal" id="ChooseOptionModal" hidden data-choose-option-modal>
      <div class="kb-choose-option-modal__backdrop" data-close-choose-option></div>
      <div class="kb-choose-option-modal__container">
        <div class="kb-choose-option-modal__header">
          <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" class="kb-choose-option-modal__back" data-close-choose-option aria-label="Back" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #1e293b;">&larr;</button>
            <div>
              <div class="kb-choose-option-modal__product-title" data-choose-product-title style="font-size: 0.78rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px;">Product</div>
              <h3 style="margin: 0; font-size: 1.15rem; color: #1e293b; font-weight: 800;">{{ choose_option_title }}</h3>
            </div>
          </div>
          <button type="button" class="kb-choose-option-modal__close" data-close-choose-option aria-label="Close modal" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <div class="kb-choose-option-modal__body" data-choose-options-list style="padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.85rem; max-height: 55vh; overflow-y: auto;">
          <!-- Populated dynamically via JS -->
        </div>

        <div class="kb-choose-option-modal__footer" style="padding: 0.75rem 1rem 1.25rem;">
          <button type="button" class="kb-choose-option-modal__confirm-btn" data-confirm-choose-option style="width: 100%; height: 50px; background: #23421f; color: #ffffff; border: none; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center;">{{ choose_option_confirm_btn }}</button>
        </div>
      </div>
    </aside>
  </div>
</aside>

<!-- Available Coupons Modal Popup -->
<aside class="kb-coupons-modal" id="CouponsModal" hidden data-coupons-modal>
  <div class="kb-coupons-modal__backdrop" data-close-coupons-modal></div>
  <div class="kb-coupons-modal__container">
    <div class="kb-coupons-modal__header">
      <h3 style="margin: 0; font-size: 1.1rem; color: #23421f; font-weight: 800;">{{ coupons_modal_title }}</h3>
      <button type="button" class="kb-coupons-modal__close" data-close-coupons-modal aria-label="Close modal" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>
    <div class="kb-coupons-modal__body" style="padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.85rem; max-height: 60vh; overflow-y: auto;">
      {% if coupon_blocks.size > 0 %}
        {% for block in coupon_blocks %}
          <div class="kb-coupon-item" {{ block.shopify_attributes }} style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1.5px dashed #23421f; border-radius: 12px; background: #fbfdfa;">
            <div class="kb-coupon-item__info">
              <div class="kb-coupon-item__code" style="font-weight: 900; color: #23421f; font-size: 1rem;">{{ block.settings.code }}</div>
              {% if block.settings.discount_title != blank %}
                <div class="kb-coupon-item__title" style="font-weight: 700; color: #1e293b; font-size: 0.88rem; margin-top: 2px;">{{ block.settings.discount_title }}</div>
              {% endif %}
              {% if block.settings.discount_sub != blank %}
                <div class="kb-coupon-item__sub" style="font-size: 0.80rem; color: #64748b; margin-top: 2px;">{{ block.settings.discount_sub }}</div>
              {% endif %}
            </div>
            <button type="button" class="kb-coupon-item__apply-btn" data-cart-apply-coupon data-coupon-code="{{ block.settings.code }}" style="background: #23421f; color: #ffffff; border: none; padding: 0.45rem 1rem; border-radius: 8px; font-weight: 800; cursor: pointer;">Apply</button>
          </div>
        {% endfor %}
      {% elsif coupon_code != blank %}
        <div class="kb-coupon-item" style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1.5px dashed #23421f; border-radius: 12px; background: #fbfdfa;">
          <div class="kb-coupon-item__info">
            <div class="kb-coupon-item__code" style="font-weight: 900; color: #23421f; font-size: 1rem;">{{ coupon_code }}</div>
            {% if savings_label != blank %}
              <div class="kb-coupon-item__title" style="font-weight: 700; color: #1e293b; font-size: 0.88rem; margin-top: 2px;">{{ savings_label }}</div>
            {% endif %}
          </div>
          <button type="button" class="kb-coupon-item__apply-btn" data-cart-apply-coupon data-coupon-code="{{ coupon_code }}" style="background: #23421f; color: #ffffff; border: none; padding: 0.45rem 1rem; border-radius: 8px; font-weight: 800; cursor: pointer;">Apply</button>
        </div>
      {% else %}
        <p style="text-align: center; color: #64748b; margin: 1rem 0;">No coupons available right now.</p>
      {% endif %}
    </div>
  </div>
</aside>
