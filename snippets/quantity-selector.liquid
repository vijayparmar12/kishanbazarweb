{% doc %}
  Renders an accessible quantity selector. @param {string} id - Unique ID. @param {number} [value] - Initial quantity. @param {number} [min] - Minimum. @param {number} [max] - Maximum. @param {number} [step] - Increment.
{% enddoc %}
<div class="quantity-selector" data-quantity-selector><button class="quantity-selector__button" type="button" data-quantity-minus aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 16 %}</button><label class="visually-hidden" for="{{ id }}">Quantity</label><input class="quantity-selector__input" id="{{ id }}" name="quantity" type="number" value="{{ value | default: 1 }}" min="{{ min | default: 1 }}"{% if max != blank %} max="{{ max }}"{% endif %} step="{{ step | default: 1 }}" inputmode="numeric" data-quantity-input><button class="quantity-selector__button" type="button" data-quantity-plus aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 16 %}</button></div>
