{% doc %}
  Renders an accessible inline SVG icon.
  @param {string} name - Icon name.
  @param {number} [size] - Icon size in pixels.
  @param {string} [class] - Extra CSS classes.
{% enddoc %}
{% assign icon_size = size | default: 20 %}
<svg class="icon {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'search' %}<circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path>
    {% when 'cart' %}<path d="M3 4h2l2 12h11l2-9H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle>
    {% when 'user' %}<circle cx="12" cy="8" r="4"></circle><path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
    {% when 'heart' %}<path d="M20.8 4.8a5.5 5.5 0 0 0-7.8 0L12 5.9l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.4a5.5 5.5 0 0 0-.1-7.8Z"></path>
    {% when 'menu' %}<path d="M4 7h16M4 12h16M4 17h16"></path>
    {% when 'close' %}<path d="m6 6 12 12M18 6 6 18"></path>
    {% when 'arrow' %}<path d="M5 12h14M13 6l6 6-6 6"></path>
    {% when 'chevron' %}<path d="m9 18 6-6-6-6"></path>
    {% when 'plus' %}<path d="M12 5v14M5 12h14"></path>
    {% when 'minus' %}<path d="M5 12h14"></path>
    {% when 'trash' %}<path d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3"></path>
    {% when 'eye' %}<path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle>
    {% when 'star' %}<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"></path>
    {% when 'location' %}<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>
    {% when 'phone' %}<path d="M5 3h3l1.5 4-2 1.5a15 15 0 0 0 8 8l1.5-2 4 1.5v3a2 2 0 0 1-2 2C10.2 21 3 13.8 3 5a2 2 0 0 1 2-2Z"></path>
    {% when 'email' %}<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>
    {% when 'credit-card' %}<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M7 14h3"></path>
    {% when 'wallet' %}<path d="M4 7h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7Zm0 0a2 2 0 0 1 2-2h12"></path><circle cx="16.5" cy="13" r="1.5"></circle>
    {% when 'bank' %}<path d="M3 10h18M5 10v8m4-8v8m6-8v8m4-8v8M2 18h20M12 3 3 8h18Z"></path>
    {% when 'check-circle' %}<circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16 9"></path>
    {% when 'truck' %}<path d="M3 7h11v10H3z"></path><path d="M14 10h4l3 3v4h-7z"></path><circle cx="7" cy="18" r="1.5"></circle><circle cx="18" cy="18" r="1.5"></circle>
    {% when 'cash' %}<path d="M3 7h18v10H3z"></path><circle cx="12" cy="12" r="3"></circle><path d="M7 5h10"></path><path d="M7 19h10"></path>
  {% endcase %}
</svg>
