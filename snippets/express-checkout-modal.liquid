{% doc %}
  Renders the Shopflo-style Express Checkout Modal (Delivery Address + Order Summary Payment flow).
{% enddoc %}

<aside class="kb-express-checkout" id="ExpressCheckoutModal" hidden data-express-checkout>
  <div class="kb-express-checkout__overlay" data-express-close></div>
  <div class="kb-express-checkout__panel" role="dialog" aria-modal="true">
    
    <!-- STEP 1: DELIVERY / ADDRESS SELECTION VIEW (Image 2) -->
    <div class="kb-express-checkout__step kb-express-checkout__step--address" data-checkout-step="address">
      <div class="kb-express-checkout__header">
        <button class="kb-express-checkout__back" type="button" aria-label="Back to Cart" data-express-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>
        <h2 class="kb-express-checkout__title">Delivery</h2>
        <button class="kb-express-checkout__close" type="button" aria-label="Close Checkout" data-express-close>&times;</button>
      </div>

      <div class="kb-express-checkout__promo-bar">
        🎉 Get 10% OFF on orders above ₹3000 | <strong>TBOF10</strong>
      </div>

      <div class="kb-express-checkout__body">
        <!-- Add New Address Button -->
        <button type="button" class="kb-express-add-address-btn" data-toggle-address-form>
          <span class="icon">+</span> Add new address
        </button>

        <!-- New Address Form -->
        <form class="kb-express-address-form" data-address-form style="display: none;">
          <h3 class="kb-express-form-heading">Enter Delivery Address</h3>
          <div class="kb-express-form-grid">
            <div class="kb-express-field">
              <label for="CheckoutName">Full Name *</label>
              <input type="text" id="CheckoutName" name="name" placeholder="e.g. Vaibhavi Anilbhai Raut" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutPhone">Phone Number *</label>
              <input type="tel" id="CheckoutPhone" name="phone" placeholder="+91 98765 43210" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutEmail">Email Address *</label>
              <input type="email" id="CheckoutEmail" name="email" placeholder="name@example.com" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutFlat">Flat / House No. / Building *</label>
              <input type="text" id="CheckoutFlat" name="flat" placeholder="e.g. Zariyal Dharmpur" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutCity">City / District *</label>
              <input type="text" id="CheckoutCity" name="city" placeholder="e.g. Valsad" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutState">State *</label>
              <input type="text" id="CheckoutState" name="state" placeholder="e.g. Gujarat" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutPincode">Pincode *</label>
              <input type="text" id="CheckoutPincode" name="pincode" placeholder="396050" required class="kb-express-input">
            </div>
            <div class="kb-express-field">
              <label for="CheckoutTag">Address Type</label>
              <select id="CheckoutTag" name="tag" class="kb-express-select">
                <option value="Home">Home</option>
                <option value="Work">Work</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <button type="submit" class="kb-express-save-address-btn">Save & Deliver Here</button>
        </form>

        <!-- Saved Addresses List -->
        <div class="kb-express-address-list" data-address-list>
          <div class="kb-express-address-card is-selected" data-address-id="default">
            <div class="kb-express-address-header">
              <label class="kb-express-radio-label">
                <input type="radio" name="selected_address" value="default" checked class="kb-express-radio">
                <span class="kb-express-tag" data-display-tag>Home</span>
              </label>
              <button type="button" class="kb-express-edit-address-btn" data-edit-address>&hellip;</button>
            </div>
            <div class="kb-express-address-content">
              <strong class="kb-express-address-name" data-display-name>Vaibhavi Anilbhai Raut</strong>
              <p class="kb-express-address-text" data-display-address>Zariyal Dharmpur, Valsad, Gujarat, India, 396050</p>
              <p class="kb-express-address-contact" data-display-contact>+91 88496 89402, vaibhaviraut031@gmail.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Address Step Bottom Action -->
      <div class="kb-express-checkout__footer">
        <button type="button" class="kb-express-proceed-btn" data-goto-summary-step>
          Proceed to Pay
        </button>
        <div class="kb-express-security">🔒 Secured by <strong>shopflo</strong></div>
      </div>
    </div>

    <!-- STEP 2: ORDER SUMMARY & PAYMENT CHECKOUT VIEW (Image 3) -->
    <div class="kb-express-checkout__step kb-express-checkout__step--summary" data-checkout-step="summary" style="display: none;">
      <div class="kb-express-checkout__header">
        <button class="kb-express-checkout__back" type="button" aria-label="Back to Address" data-goto-address-step>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>
        <div class="kb-express-brand-logo">
          <span class="kb-brand-text">KISHANVEDA</span>
        </div>
        <span class="kb-express-header-total" data-express-total>₹{{ cart.total_price | money_without_currency }}</span>
      </div>

      <div class="kb-express-checkout__promo-bar">
        🎉 Get 10% OFF on orders above ₹3000 | <strong>TBOF10</strong>
      </div>

      <div class="kb-express-checkout__body">
        <!-- Collapsible Order Summary Box -->
        <details class="kb-express-box kb-express-order-summary-box" open>
          <summary class="kb-express-box-header">
            <div class="left">
              <span class="icon">🛒</span>
              <strong>Order summary</strong>
            </div>
            <div class="right">
              <span data-express-item-count>{{ cart.item_count }} items</span>
              <span class="chevron">∨</span>
            </div>
          </summary>
          <div class="kb-express-order-items-list" data-express-items-list>
            {% for item in cart.items %}
              <div class="kb-express-item-row">
                <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" class="kb-express-item-img">
                <div class="kb-express-item-info">
                  <strong>{{ item.product.title }}</strong>
                  <p>{{ item.variant.title }} &bull; Qty: {{ item.quantity }}</p>
                </div>
                <div class="kb-express-item-price">₹{{ item.final_line_price | money_without_currency }}</div>
              </div>
            {% endfor %}
          </div>
        </details>

        <!-- Selected Delivery Address Box -->
        <div class="kb-express-box kb-express-deliver-box">
          <div class="kb-express-box-header">
            <div class="left">
              <span class="icon">📍</span>
              <strong>Deliver to</strong>
              <span class="kb-express-tag" data-summary-tag>Home</span>
            </div>
            <button type="button" class="kb-express-edit-link" data-goto-address-step>Edit &gt;</button>
          </div>
          <div class="kb-express-deliver-details">
            <strong data-summary-name>Vaibhavi Anilbhai Raut</strong>
            <p data-summary-address>Zariyal Dharmpur, Valsad, Gujarat, India, 396050</p>
            <p data-summary-contact>+91 88496 89402 &bull; vaibhaviraut031@gmail.com</p>
          </div>
        </div>

        <!-- Shipping Status Box -->
        <div class="kb-express-box kb-express-shipping-box">
          <div class="kb-express-box-header">
            <div class="left">
              <span class="icon">🚚</span>
              <strong>Shipping</strong>
            </div>
            <div class="right">
              <strong class="kb-express-free-shipping">FREE</strong>
              <span class="chevron">∨</span>
            </div>
          </div>
        </div>

        <!-- Offers & Rewards Section -->
        <div class="kb-express-offers-section">
          <h4 class="kb-express-section-title">Offers & Rewards</h4>
          
          <div class="kb-cart-coupon-box">
            <div class="kb-cart-coupon-info">
              <span class="kb-cart-coupon-icon">%</span>
              <div class="kb-cart-coupon-text">
                <strong data-cart-savings-label>Save ₹512.30</strong>
                <span>with '<strong data-applied-coupon>TBOF10</strong>'</span>
              </div>
            </div>
            <button type="button" class="kb-cart-coupon-apply-btn" data-cart-apply-coupon>Apply</button>
          </div>

          <button type="button" class="kb-express-link-row" data-open-coupons-modal>
            <span class="icon">%</span> More offers <span class="arrow">View all coupons &gt;</span>
          </button>

          <button type="button" class="kb-express-link-row">
            <span class="icon">🎁</span> Have any gift card <span class="arrow">&gt;</span>
          </button>

          <!-- Membership Banner -->
          <div class="kb-express-membership-banner">
            <div class="left">
              <span class="badge-icon">C</span>
              <div>
                <strong>Get 18% off on your first order</strong>
                <p>with <strong>Collective Membership</strong></p>
              </div>
            </div>
            <button type="button" class="kb-express-membership-add-btn" data-add-membership="45000">+ ₹450</button>
          </div>
        </div>

        <!-- Membership & Add-ons Tabs -->
        <div class="kb-express-addons-block">
          <div class="kb-cart-addons-tabs">
            <button type="button" class="kb-cart-tab-btn is-active" data-express-tab="membership">Membership</button>
            <button type="button" class="kb-cart-tab-btn" data-express-tab="frequently">Frequently Bought Together</button>
          </div>

          <div class="kb-cart-tab-panel is-active" data-express-panel="membership">
            <div class="kb-cart-addons-track">
              <div class="kb-cart-addon-card">
                <div class="kb-cart-addon-badge">Member Benefits<br><strong>12% OFF</strong><br>on all orders</div>
                <div class="kb-cart-addon-details">
                  <div class="kb-cart-addon-title">GET MEMBERSHIP FOR 3 months</div>
                  <div class="kb-cart-addon-price">₹450.00</div>
                </div>
                <button type="button" class="kb-cart-addon-add-btn" data-add-membership="45000">+ ADD</button>
              </div>

              <div class="kb-cart-addon-card">
                <div class="kb-cart-addon-badge">Member Benefits<br><strong>12% OFF</strong><br>on all orders</div>
                <div class="kb-cart-addon-details">
                  <div class="kb-cart-addon-title">GET MEMBERSHIP FOR 12 months</div>
                  <div class="kb-cart-addon-price">₹1,500.00</div>
                </div>
                <button type="button" class="kb-cart-addon-add-btn" data-add-membership="150000">+ ADD</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Payment Methods Preview -->
        <div class="kb-express-payment-preview">
          <h4 class="kb-express-section-title">Payment methods</h4>
          <div class="kb-express-pay-methods-list">
            <div class="kb-express-pay-method-item">
              <span>UPI / QR (GPay, PhonePe, Paytm)</span>
              <span class="price" data-express-pay-total>₹{{ cart.total_price | money_without_currency }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Step Bottom Action Button -->
      <div class="kb-express-checkout__footer">
        <button type="button" class="kb-express-proceed-btn" data-final-proceed-to-pay>
          Proceed to Pay
        </button>
        <div class="kb-express-security">🔒 Secured by <strong>shopflo</strong></div>
      </div>
    </div>

  </div>
</aside>
