{% doc %}
  Renders a Lab Test Report card on the product page powered dynamically by product metafields (custom.lab_test_report or custom.pdf_report) or fallback block settings.

  @param {object} product - The Shopify product object
  @param {object} [block] - Optional block object containing settings

  @example
  {% render 'product-lab-report', product: product, block: block %}
{% enddoc %}

{% liquid
  assign pdf_url = ''

  # Candidate product metafields (order of priority)
  assign mf_1 = product.metafields.custom.lab_test_report
  assign mf_2 = product.metafields.custom.pdf_report
  assign mf_3 = product.metafields.custom.lab_report
  assign mf_4 = product.metafields.custom.test_report
  assign mf_5 = product.metafields.custom.lab_test
  assign mf_6 = product.metafields.custom.pdf_link
  assign mf_7 = product.metafields.custom.lab_report_pdf
  assign mf_8 = product.metafields.custom.lab_test_report_link

  # Helper logic to extract valid URL from a metafield object (Link drop, File drop, URL, String, JSON)
  if mf_1 != blank
    if mf_1.value.url != blank
      assign pdf_url = mf_1.value.url
    elsif mf_1.url != blank
      assign pdf_url = mf_1.url
    elsif mf_1.value.target != blank
      assign pdf_url = mf_1.value.target
    elsif mf_1.value != blank
      assign temp_file = mf_1.value | file_url
      if temp_file contains 'cdn.shopify.com' or temp_file contains '/files/'
        assign pdf_url = temp_file
      else
        assign temp_str = mf_1.value | append: ''
        if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
          assign pdf_url = temp_str
        endif
      endif
    endif
  endif

  if pdf_url == blank and mf_2 != blank
    if mf_2.value.url != blank
      assign pdf_url = mf_2.value.url
    elsif mf_2.url != blank
      assign pdf_url = mf_2.url
    elsif mf_2.value != blank
      assign temp_file = mf_2.value | file_url
      if temp_file contains 'cdn.shopify.com' or temp_file contains '/files/'
        assign pdf_url = temp_file
      else
        assign temp_str = mf_2.value | append: ''
        if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
          assign pdf_url = temp_str
        endif
      endif
    endif
  endif

  if pdf_url == blank and mf_3 != blank
    if mf_3.value.url != blank
      assign pdf_url = mf_3.value.url
    elsif mf_3.url != blank
      assign pdf_url = mf_3.url
    elsif mf_3.value != blank
      assign temp_file = mf_3.value | file_url
      if temp_file contains 'cdn.shopify.com' or temp_file contains '/files/'
        assign pdf_url = temp_file
      else
        assign temp_str = mf_3.value | append: ''
        if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
          assign pdf_url = temp_str
        endif
      endif
    endif
  endif

  if pdf_url == blank and mf_4 != blank
    if mf_4.value.url != blank
      assign pdf_url = mf_4.value.url
    elsif mf_4.url != blank
      assign pdf_url = mf_4.url
    elsif mf_4.value != blank
      assign temp_str = mf_4.value | append: ''
      if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
        assign pdf_url = temp_str
      endif
    endif
  endif

  if pdf_url == blank and mf_5 != blank
    if mf_5.value.url != blank
      assign pdf_url = mf_5.value.url
    elsif mf_5.url != blank
      assign pdf_url = mf_5.url
    elsif mf_5.value != blank
      assign temp_str = mf_5.value | append: ''
      if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
        assign pdf_url = temp_str
      endif
    endif
  endif

  if pdf_url == blank and mf_6 != blank
    if mf_6.value.url != blank
      assign pdf_url = mf_6.value.url
    elsif mf_6.url != blank
      assign pdf_url = mf_6.url
    elsif mf_6.value != blank
      assign temp_str = mf_6.value | append: ''
      if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
        assign pdf_url = temp_str
      endif
    endif
  endif

  if pdf_url == blank and mf_7 != blank
    if mf_7.value.url != blank
      assign pdf_url = mf_7.value.url
    elsif mf_7.url != blank
      assign pdf_url = mf_7.url
    elsif mf_7.value != blank
      assign temp_str = mf_7.value | append: ''
      if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
        assign pdf_url = temp_str
      endif
    endif
  endif

  if pdf_url == blank and mf_8 != blank
    if mf_8.value.url != blank
      assign pdf_url = mf_8.value.url
    elsif mf_8.url != blank
      assign pdf_url = mf_8.url
    elsif mf_8.value != blank
      assign temp_str = mf_8.value | append: ''
      if temp_str contains 'http://' or temp_str contains 'https://' or temp_str contains '//' or temp_str contains '/files/' or temp_str contains '.pdf'
        assign pdf_url = temp_str
      endif
    endif
  endif

  # Fallback: Parse embedded JSON string if Link object was converted to JSON string
  if pdf_url contains '"url":' or pdf_url contains '{"url"' or pdf_url contains '"url"'
    assign json_clean = pdf_url | replace: '"', ' ' | replace: '}', ' ' | replace: '{', ' '
    assign words = json_clean | split: ' '
    for word in words
      if word contains 'http://' or word contains 'https://' or word contains '//cdn' or word contains '/files/'
        assign pdf_url = word | strip
        break
      endif
    endfor
  endif

  # Clean up residual quotes or braces and trim whitespace
  assign pdf_url = pdf_url | replace: '"', '' | replace: '}', '' | replace: '{', '' | strip

  # Fallback to block setting if pdf_url is blank
  if pdf_url == blank and block.settings.pdf_url != blank
    assign pdf_url = block.settings.pdf_url
  endif

  # Default fallback page if pdf_url is still blank (or when rendered on product page)
  assign display_card = false
  if pdf_url != blank
    assign display_card = true
  elsif block != blank
    assign pdf_url = '/pages/lab-report'
    assign display_card = true
  elsif request.design_mode
    assign display_card = true
  endif

  assign card_title = block.settings.title | default: 'Lab Test Report'
  assign card_badge = block.settings.badge_text | default: 'VERIFIED'
  assign card_subtitle = block.settings.subtitle | default: 'NABL-accredited purity & nutrition analysis (PDF)'
  assign card_btn_text = block.settings.btn_text | default: 'Download'

  assign bg_color = block.settings.bg_color | default: '#FEF3C7'
  assign border_color = block.settings.border_color | default: '#FDE68A'
  assign title_color = block.settings.title_color | default: '#1E293B'
  assign subtitle_color = block.settings.subtitle_color | default: '#475569'
  assign badge_bg = block.settings.badge_bg | default: '#0284C7'
  assign badge_color = block.settings.badge_color | default: '#FFFFFF'
  assign btn_bg = block.settings.btn_bg | default: '#064E3B'
  assign btn_color = block.settings.btn_color | default: '#FFFFFF'
%}

{% if display_card %}
  <div
    class="product-lab-report"
    {% if block %}
      {{ block.shopify_attributes }}
    {% endif %}
    style="
      --lab-bg: {{ bg_color }};
      --lab-border: {{ border_color }};
      --lab-title-color: {{ title_color }};
      --lab-sub-color: {{ subtitle_color }};
      --lab-badge-bg: {{ badge_bg }};
      --lab-badge-color: {{ badge_color }};
      --lab-btn-bg: {{ btn_bg }};
      --lab-btn-color: {{ btn_color }};
    "
  >
    <div class="product-lab-report__main">
      <div class="product-lab-report__icon-wrap">
        <svg class="product-lab-report__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2v7.31L4.75 20.5a2 2 0 0 0 1.71 3h11.08a2 2 0 0 0 1.71-3L14 9.31V2"/>
          <path d="M8.5 2h7"/>
          <path d="M7 16h10"/>
        </svg>
      </div>
      <div class="product-lab-report__content">
        <div class="product-lab-report__header">
          <span class="product-lab-report__title">{{ card_title }}</span>
          {% if card_badge != blank %}
            <span class="product-lab-report__badge">{{ card_badge }}</span>
          {% endif %}
        </div>
        <div class="product-lab-report__subtitle">{{ card_subtitle }}</div>
      </div>
    </div>

    <div class="product-lab-report__action">
      <a
        href="{{ pdf_url | default: '/pages/lab-report' }}"
        target="_blank"
        rel="noopener noreferrer"
        class="product-lab-report__btn"
      >
        <svg class="product-lab-report__btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>{{ card_btn_text }}</span>
      </a>
    </div>
  </div>
{% endif %}
