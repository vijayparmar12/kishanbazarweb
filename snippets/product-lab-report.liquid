{% doc %}
  Renders a Lab Test Report card on the product page powered dynamically by product metafields (custom.lab_test_report or custom.pdf_report) or fallback block settings.

  @param {object} product - The Shopify product object
  @param {object} [block] - Optional block object containing settings

  @example
  {% render 'product-lab-report', product: product, block: block %}
{% enddoc %}

{% liquid
  assign pdf_url = ''

  # 0. Dynamic scan of product.metafields.custom for any key containing lab, pdf, report, or test
  for mf_entry in product.metafields.custom
    assign mf_key = mf_entry[0] | downcase
    if mf_key contains 'lab' or mf_key contains 'pdf' or mf_key contains 'report' or mf_key contains 'test'
      assign mf_item = mf_entry[1]
      assign mf_val = mf_item.value | default: mf_item
      
      if mf_val.url != blank
        assign pdf_url = mf_val.url
        break
      elsif mf_item.url != blank
        assign pdf_url = mf_item.url
        break
      elsif mf_val.target != blank
        assign pdf_url = mf_val.target
        break
      elsif mf_val.text != blank and mf_val.text contains 'http'
        assign pdf_url = mf_val.text
        break
      elsif mf_val != blank
        assign file_chk = mf_val | file_url
        if file_chk contains 'cdn.shopify.com' or file_chk contains '/files/'
          assign pdf_url = file_chk
          break
        else
          assign str_chk = mf_val | append: ''
          if str_chk contains 'http://' or str_chk contains 'https://' or str_chk contains '//' or str_chk contains '/files/' or str_chk contains '.pdf'
            assign pdf_url = str_chk
            break
          endif
        endif
      endif
    endif
  endfor

  # 1. Direct explicit check for custom_lab_test_report1, lab_test_report1, custom_lab_test_report, lab_test_report
  if pdf_url == blank
    assign mf_val1 = product.metafields.custom.custom_lab_test_report1.value | default: product.metafields.custom.lab_test_report1.value | default: product.metafields.custom.custom_lab_test_report.value | default: product.metafields.custom.lab_test_report.value
    assign mf_obj1 = product.metafields.custom.custom_lab_test_report1 | default: product.metafields.custom.lab_test_report1 | default: product.metafields.custom.custom_lab_test_report | default: product.metafields.custom.lab_test_report

    if mf_val1.url != blank
      assign pdf_url = mf_val1.url
    elsif mf_obj1.url != blank
      assign pdf_url = mf_obj1.url
    elsif mf_val1.target != blank
      assign pdf_url = mf_val1.target
    elsif mf_val1 != blank
      assign file_check1 = mf_val1 | file_url
      if file_check1 contains 'cdn.shopify.com' or file_check1 contains '/files/'
        assign pdf_url = file_check1
      else
        assign str_check1 = mf_val1 | append: ''
        if str_check1 contains 'http://' or str_check1 contains 'https://' or str_check1 contains '//' or str_check1 contains '/files/' or str_check1 contains '.pdf'
          assign pdf_url = str_check1
        endif
      endif
    endif
  endif

  # 2. Check custom.custom_pdf_report or custom.pdf_report
  if pdf_url == blank
    assign mf_val2 = product.metafields.custom.custom_pdf_report.value | default: product.metafields.custom.pdf_report.value
    assign mf_obj2 = product.metafields.custom.custom_pdf_report | default: product.metafields.custom.pdf_report
    if mf_val2.url != blank
      assign pdf_url = mf_val2.url
    elsif mf_obj2.url != blank
      assign pdf_url = mf_obj2.url
    elsif mf_val2 != blank
      assign file_check2 = mf_val2 | file_url
      if file_check2 contains 'cdn.shopify.com' or file_check2 contains '/files/'
        assign pdf_url = file_check2
      else
        assign str_check2 = mf_val2 | append: ''
        if str_check2 contains 'http://' or str_check2 contains 'https://' or str_check2 contains '//' or str_check2 contains '/files/' or str_check2 contains '.pdf'
          assign pdf_url = str_check2
        endif
      endif
    endif
  endif

  # 3. Check custom.custom_lab_report or custom.lab_report
  if pdf_url == blank
    assign mf_val3 = product.metafields.custom.custom_lab_report.value | default: product.metafields.custom.lab_report.value
    assign mf_obj3 = product.metafields.custom.custom_lab_report | default: product.metafields.custom.lab_report
    if mf_val3.url != blank
      assign pdf_url = mf_val3.url
    elsif mf_obj3.url != blank
      assign pdf_url = mf_obj3.url
    elsif mf_val3 != blank
      assign file_check3 = mf_val3 | file_url
      if file_check3 contains 'cdn.shopify.com' or file_check3 contains '/files/'
        assign pdf_url = file_check3
      else
        assign str_check3 = mf_val3 | append: ''
        if str_check3 contains 'http://' or str_check3 contains 'https://' or str_check3 contains '//' or str_check3 contains '/files/' or str_check3 contains '.pdf'
          assign pdf_url = str_check3
        endif
      endif
    endif
  endif

  # 4. Check custom.custom_test_report, custom.test_report, custom.lab_test, custom.pdf_link, custom.report_url, custom.lab_report_pdf, custom.lab_test_report_link
  if pdf_url == blank
    assign mf_val4 = product.metafields.custom.custom_test_report.value | default: product.metafields.custom.test_report.value | default: product.metafields.custom.lab_test.value | default: product.metafields.custom.pdf_link.value | default: product.metafields.custom.report_url.value | default: product.metafields.custom.lab_report_pdf.value | default: product.metafields.custom.lab_test_report_link.value
    if mf_val4.url != blank
      assign pdf_url = mf_val4.url
    elsif mf_val4 != blank
      assign str_check4 = mf_val4 | append: ''
      if str_check4 contains 'http://' or str_check4 contains 'https://' or str_check4 contains '//' or str_check4 contains '/files/' or str_check4 contains '.pdf'
        assign pdf_url = str_check4
      endif
    endif
  endif

  # 5. Extract clean URL substring if embedded in JSON or text
  if pdf_url contains '"url":' or pdf_url contains '{"url"' or pdf_url contains '"url"'
    assign json_clean = pdf_url | replace: '"', ' ' | replace: '}', ' ' | replace: '{', ' '
    assign words = json_clean | split: ' '
    for word in words
      if word contains 'http://' or word contains 'https://' or word contains '//cdn' or word contains '/files/'
        assign pdf_url = word | strip
        break
      endif
    endfor
  endif

  assign pdf_url = pdf_url | strip

  # Fallback to block / section setting if pdf_url is blank
  if pdf_url == blank
    if block and block.settings.pdf_file != blank
      assign pdf_url = block.settings.pdf_file | file_url
    elsif block and block.settings.pdf_url != blank
      assign pdf_url = block.settings.pdf_url
    elsif section and section.settings.lab_report_pdf_url != blank
      assign pdf_url = section.settings.lab_report_pdf_url
    endif
  endif

  # Show card ONLY if a valid PDF URL exists for this product (or in Theme Editor design mode)
  assign show_card = false
  if pdf_url != blank
    assign show_card = true
  elsif request.design_mode
    assign show_card = true
    assign pdf_url = '#'
  endif

  # Check section level visibility toggle
  if section and section.settings.show_lab_report == false
    unless request.design_mode
      assign show_card = false
    endunless
  endif

  # Card settings resolution (Block Settings -> Section Settings -> Defaults)
  assign card_title = 'Lab Test Report'
  if block and block.settings.title != blank
    assign card_title = block.settings.title
  elsif section and section.settings.lab_report_title != blank
    assign card_title = section.settings.lab_report_title
  endif

  assign card_badge = 'VERIFIED'
  if block and block.settings.badge_text != blank
    assign card_badge = block.settings.badge_text
  elsif section and section.settings.lab_report_badge != blank
    assign card_badge = section.settings.lab_report_badge
  endif

  assign card_subtitle = 'NABL-accredited purity & nutrition analysis (PDF)'
  if block and block.settings.subtitle != blank
    assign card_subtitle = block.settings.subtitle
  elsif section and section.settings.lab_report_subtitle != blank
    assign card_subtitle = section.settings.lab_report_subtitle
  endif

  assign card_btn_text = 'Download'
  if block and block.settings.btn_text != blank
    assign card_btn_text = block.settings.btn_text
  elsif section and section.settings.lab_report_btn_text != blank
    assign card_btn_text = section.settings.lab_report_btn_text
  endif

  assign bg_color = '#FEF3C7'
  if block and block.settings.bg_color != blank
    assign bg_color = block.settings.bg_color
  elsif section and section.settings.lab_report_bg_color != blank
    assign bg_color = section.settings.lab_report_bg_color
  endif

  assign border_color = '#FDE68A'
  if block and block.settings.border_color != blank
    assign border_color = block.settings.border_color
  elsif section and section.settings.lab_report_border_color != blank
    assign border_color = section.settings.lab_report_border_color
  endif

  assign title_color = '#1E293B'
  if block and block.settings.title_color != blank
    assign title_color = block.settings.title_color
  elsif section and section.settings.lab_report_title_color != blank
    assign title_color = section.settings.lab_report_title_color
  endif

  assign subtitle_color = '#475569'
  if block and block.settings.subtitle_color != blank
    assign subtitle_color = block.settings.subtitle_color
  elsif section and section.settings.lab_report_subtitle_color != blank
    assign subtitle_color = section.settings.lab_report_subtitle_color
  endif

  assign badge_bg = '#0284C7'
  if block and block.settings.badge_bg != blank
    assign badge_bg = block.settings.badge_bg
  elsif section and section.settings.lab_report_badge_bg != blank
    assign badge_bg = section.settings.lab_report_badge_bg
  endif

  assign badge_color = '#FFFFFF'
  if block and block.settings.badge_color != blank
    assign badge_color = block.settings.badge_color
  elsif section and section.settings.lab_report_badge_color != blank
    assign badge_color = section.settings.lab_report_badge_color
  endif

  assign btn_bg = '#064E3B'
  if block and block.settings.btn_bg != blank
    assign btn_bg = block.settings.btn_bg
  elsif section and section.settings.lab_report_btn_bg != blank
    assign btn_bg = section.settings.lab_report_btn_bg
  endif

  assign btn_color = '#FFFFFF'
  if block and block.settings.btn_color != blank
    assign btn_color = block.settings.btn_color
  elsif section and section.settings.lab_report_btn_color != blank
    assign btn_color = section.settings.lab_report_btn_color
  endif
%}

{% if show_card %}
  <div
    class="product-lab-report"
    {% if block %}
      {{ block.shopify_attributes }}
    {% endif %}
    style="
      --lab-bg: {{ bg_color }};
      --lab-border: {{ border_color }};
      --lab-title-color: {{ title_color }};
      --lab-sub-color: {{ subtitle_color }};
      --lab-badge-bg: {{ badge_bg }};
      --lab-badge-color: {{ badge_color }};
      --lab-btn-bg: {{ btn_bg }};
      --lab-btn-color: {{ btn_color }};
      margin: 1.25rem 0 !important;
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
    "
  >
    <div class="product-lab-report__main">
      <div class="product-lab-report__icon-wrap">
        <svg class="product-lab-report__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2v7.31L4.75 20.5a2 2 0 0 0 1.71 3h11.08a2 2 0 0 0 1.71-3L14 9.31V2"/>
          <path d="M8.5 2h7"/>
          <path d="M7 16h10"/>
        </svg>
      </div>
      <div class="product-lab-report__content">
        <div class="product-lab-report__header">
          <span class="product-lab-report__title">{{ card_title }}</span>
          {% if card_badge != blank %}
            <span class="product-lab-report__badge">{{ card_badge }}</span>
          {% endif %}
        </div>
        <div class="product-lab-report__subtitle">{{ card_subtitle }}</div>
      </div>
    </div>

    <div class="product-lab-report__action">
      <a
        href="{{ pdf_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="product-lab-report__btn"
      >
        <svg class="product-lab-report__btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>{{ card_btn_text }}</span>
      </a>
    </div>
  </div>
{% endif %}
