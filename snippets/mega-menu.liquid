{% doc %}
  Renders a premium desktop mega menu or mobile accordion for the header.

  @param {section} section - Header section with mega menu settings and blocks.
  @param {string} menu_type - One of category, concern, farm, customers.
  @param {boolean} [mobile] - Render accordion markup for mobile navigation.

  @example
  {% render 'mega-menu', section: section, menu_type: 'category' %}
{% enddoc %}

{% liquid
  assign enabled = true
  assign panel_title = section.settings.category_title
  assign panel_class = 'kb-mega--category'

  if menu_type == 'category'
    assign enabled = section.settings.enable_category_mega
    assign panel_title = section.settings.category_title
    assign panel_class = 'kb-mega--category'
  elsif menu_type == 'farm'
    assign enabled = section.settings.enable_farm_mega
    assign panel_title = section.settings.farm_title
    assign panel_class = 'kb-mega--farm'
  elsif menu_type == 'customers'
    assign enabled = section.settings.enable_customers_mega
    assign panel_title = section.settings.customers_title
    assign panel_class = 'kb-mega--customers'
  endif
%}

{% if enabled %}
  {% if mobile == 'items_only' %}
    <ul class="kb-mega-mobile__list" role="list">
      {% assign rendered_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'mega_link' %}
          {% if block.settings.menu_group == menu_type %}
            {% assign rendered_count = rendered_count | plus: 1 %}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.collections_url }}">
                {% if block.settings.icon != blank %}<span aria-hidden="true">{{ block.settings.icon }}</span>{% endif %}
                {{ block.settings.title }}
              </a>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if rendered_count == 0 %}
        {% assign defaults = '' %}
        {% if menu_type == 'category' %}
          {% assign defaults = 'Oil,Rice,Jaggery,Spices,Immunity,Breakfast & Snacks,Grains & Pulses' %}
        {% elsif menu_type == 'concern' %}
          {% assign defaults = 'Diabetes,Gut Health,Immunity,Weight Loss' %}
        {% elsif menu_type == 'customers' %}
          {% assign defaults = 'Track Order,Contact Us,Refund & Cancellation Policy,Shipping & Delivery Policy' %}
        {% elsif menu_type == 'farm_left' %}
          {% assign defaults = 'Founders & Team,Media Recognition,Traceability,Health of People & Planet,Team on Ground' %}
        {% elsif menu_type == 'farm_middle' %}
          {% assign defaults = 'Farm Visit,Events,Quality Assurance,Testimonials,Our Philosophy' %}
        {% elsif menu_type == 'farm_right' %}
          {% assign defaults = 'Lab Reports,Our Team,CSR Initiatives,Blogs,Farmers Market' %}
        {% endif %}
        {% assign default_items = defaults | split: ',' %}
        {% for item in default_items %}
          <li><a href="{{ routes.collections_url }}">{{ item }}</a></li>
        {% endfor %}
      {% endif %}
    </ul>
  {% elsif mobile %}
    <details class="kb-mega-mobile" data-mega-mobile>
      <summary class="kb-header__mobile-link kb-mega-mobile__summary">
        <span style="display: inline-flex; align-items: center; gap: 0.5rem;">
          {% if custom_icon_image != blank %}
            {{ custom_icon_image | image_url: width: 64 | image_tag: class: 'kb-nav-icon-img', loading: 'lazy', style: 'width: 28px; height: 28px; object-fit: contain;' }}
          {% elsif custom_icon != blank %}
            <span>{{ custom_icon }}</span>
          {% endif %}
          <span>{{ custom_title | default: panel_title }}</span>
          {% if custom_badge != blank %}
            <span class="kb-nav-badge">{{ custom_badge }}</span>
          {% endif %}
        </span>
        <span class="kb-mega-mobile__icon" aria-hidden="true"></span>
      </summary>
      <div class="kb-mega-mobile__content">
        {% if menu_type == 'farm' %}
          {% render 'mega-menu', section: section, menu_type: 'farm_left', mobile: 'items_only' %}
          {% render 'mega-menu', section: section, menu_type: 'farm_middle', mobile: 'items_only' %}
          {% render 'mega-menu', section: section, menu_type: 'farm_right', mobile: 'items_only' %}
        {% elsif menu_type == 'category' %}
          {% render 'mobile-category-grid', section: section %}
        {% else %}
          {% render 'mega-menu', section: section, menu_type: menu_type, mobile: 'items_only' %}
        {% endif %}
      </div>
    </details>
  {% else %}
    <div class="kb-mega {{ panel_class }}" id="MegaMenu-{{ menu_type }}-{{ section.id }}" data-mega-panel>
      <span class="kb-mega__pointer" aria-hidden="true"></span>
      <div class="kb-mega__inner">
        {% if menu_type == 'category' %}
          {% render 'mega-menu-category', section: section %}
        {% elsif menu_type == 'farm' %}
          <div class="kb-mega__farm-grid">
            {% assign farm_groups = 'farm_left,farm_middle,farm_right' | split: ',' %}
            {% for group in farm_groups %}
              <div class="kb-mega__farm-column">
                {% render 'mega-menu', section: section, menu_type: group, mobile: 'items_only' %}
              </div>
            {% endfor %}
            <div class="kb-mega__image-wrap">
              {% if section.settings.farm_mega_image != blank %}
                {{ section.settings.farm_mega_image | image_url: width: 520 | image_tag: class: 'kb-mega__image', alt: section.settings.farm_title, widths: '260, 390, 520', loading: 'lazy' }}
              {% else %}
                <img src="{{ 'farm-life-mega.jpg' | asset_url }}" class="kb-mega__image" alt="Farm Life" loading="lazy">
              {% endif %}
            </div>
          </div>
        {% elsif menu_type == 'customers' %}
          <div class="kb-mega__customer-list">
            {% render 'mega-menu', section: section, menu_type: 'customers', mobile: 'items_only' %}
          </div>
        {% endif %}
      </div>

      {% if section.settings.mega_wave_image != blank %}
        {{ section.settings.mega_wave_image | image_url: width: 1200 | image_tag: class: 'kb-mega__wave-image', alt: '', loading: 'lazy' }}
      {% else %}
        <div class="kb-category-mega__wave-container" aria-hidden="true">
          <svg class="kb-category-mega__wave-svg" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="kbFarmWaveGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E8F2E6" stop-opacity="0.85"/>
                <stop offset="50%" stop-color="#D6E8D2" stop-opacity="0.75"/>
                <stop offset="100%" stop-color="#C2DCBD" stop-opacity="0.8"/>
              </linearGradient>
              <linearGradient id="kbFarmGoldStroke" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#D4A359" stop-opacity="0.3"/>
                <stop offset="50%" stop-color="#F5E8B8" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#C59B27" stop-opacity="0.4"/>
              </linearGradient>
            </defs>
            <path d="M0,75 C300,105 600,60 900,90 C1050,105 1150,95 1200,85 L1200,120 L0,120 Z" fill="url(#kbFarmWaveGrad1)"/>
            <path d="M0,73 C300,103 600,58 900,88 C1050,103 1150,93 1200,83" stroke="url(#kbFarmGoldStroke)" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endif %}
