{% doc %}
  Renders the Shop By Category mega menu on Desktop.
  Displays ONLY categories added by the merchant in Shopify Theme Editor.
  Excludes "best product", "daily essential", and "monsoon" categories.

  @param {section} section - Header section containing category_card blocks.

  @example
  {% render 'mega-menu-category', section: section %}
{% enddoc %}

{% liquid
  assign wave_img = section.settings.category_wave_image | default: section.settings.mega_wave_image
  assign custom_cards = section.blocks | where: 'type', 'category_card'
%}

<div class="kb-category-mega{% if wave_img != blank %} has-bg-image{% endif %}" data-category-mega {% if wave_img != blank %}style="background-image: url('{{ wave_img | image_url: width: 1800 }}'); background-size: cover; background-position: center center; background-repeat: no-repeat;"{% endif %}>
  <div class="kb-category-mega__slider" data-category-slider>
    {% assign category_count = 0 %}

    {% if custom_cards.size > 0 %}
      <!-- 1. Display ONLY Category Cards explicitly selected by Merchant in Theme Editor -->
      {% for block in custom_cards %}
        {% liquid
          assign card_collection = block.settings.collection
          assign card_title = block.settings.title | default: card_collection.title
          assign card_handle = card_title | handleize
          assign check_title = card_title | downcase
          assign check_handle = card_collection.handle | default: card_handle
        %}

        {% unless check_title contains 'best' or check_title contains 'daily' or check_title contains 'monsoon' or check_handle contains 'best' or check_handle contains 'daily' or check_handle contains 'monsoon' %}
          {% liquid
            assign category_count = category_count | plus: 1
            assign card_url = card_collection.url

            if card_url == blank or card_collection == blank
              if collections[card_handle] != blank
                assign card_url = collections[card_handle].url
              elsif card_handle != blank
                assign card_url = '/collections/' | append: card_handle
              else
                assign card_url = routes.all_products_collection_url
              endif
            endif

            assign card_image = block.settings.image | default: card_collection.image
            if card_image == blank and card_collection != blank
              assign first_product = card_collection.products | first
              if first_product != blank
                assign card_image = first_product.featured_image
              endif
            endif
          %}
          <a class="kb-category-card" href="{{ card_url }}" {{ block.shopify_attributes }}>
            <span class="kb-category-card__media">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 320
                  | image_tag:
                    class: 'kb-category-card__image',
                    alt: card_title,
                    widths: '160, 240, 320',
                    sizes: '(min-width: 990px) 120px, 35vw',
                    loading: 'lazy'
                }}
              {% else %}
                {% render 'category-icon', category: card_collection, category_name: card_title, size: 48 %}
              {% endif %}
            </span>
            <span class="kb-category-card__content">
              <span class="kb-category-card__title">{{ card_title }}</span>
            </span>
          </a>
        {% endunless %}
      {% endfor %}

    {% else %}
      <!-- 2. Store Collections Fallback (Shown ONLY if no Theme Editor category_card blocks exist) -->
      {% for collection in collections limit: 12 %}
        {% assign col_title = collection.title | downcase %}
        {% assign col_handle = collection.handle %}
        {% unless col_handle == 'all' or col_title contains 'best' or col_title contains 'daily' or col_title contains 'monsoon' or col_handle contains 'best' or col_handle contains 'daily' or col_handle contains 'monsoon' %}
          {% if collection.products_count > 0 %}
            {% assign category_count = category_count | plus: 1 %}
            {% liquid
              assign card_image = collection.image
              if card_image == blank
                assign first_product = collection.products | first
                if first_product != blank
                  assign card_image = first_product.featured_image
                endif
              endif
            %}
            <a class="kb-category-card" href="{{ collection.url }}">
              <span class="kb-category-card__media">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 320
                    | image_tag:
                      class: 'kb-category-card__image',
                      alt: collection.title,
                      widths: '160, 240, 320',
                      sizes: '(min-width: 990px) 120px, 35vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  {% render 'category-icon', category: collection, size: 48 %}
                {% endif %}
              </span>
              <span class="kb-category-card__content">
                <span class="kb-category-card__title">{{ collection.title }}</span>
              </span>
            </a>
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endif %}

    {% if category_count == 0 %}
      <p class="kb-category-mega__empty">No categories added yet. Add Category Card blocks in Theme Editor.</p>
    {% endif %}
  </div>

  {% if wave_img == blank %}
    <!-- Two Brothers Style Organic Green Wave Illustration SVG -->
    <div class="kb-category-mega__wave-container" aria-hidden="true">
      <svg class="kb-category-mega__wave-svg" viewBox="0 0 1200 140" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,40 C300,110 600,10 900,80 C1050,110 1150,90 1200,70 L1200,140 L0,140 Z" fill="#e2f0e0" fill-opacity="0.85"/>
        <path d="M0,65 C250,120 550,30 850,100 C1020,125 1130,105 1200,90 L1200,140 L0,140 Z" fill="#cbe6c7" fill-opacity="0.95"/>
      </svg>
    </div>
  {% endif %}

  <!-- Centered SHOP ALL Button -->
  <div class="kb-category-mega__footer-action">
    <a class="kb-category-mega__button-pill" href="{{ section.settings.category_button_url | default: routes.all_products_collection_url }}">
      <span>{{ section.settings.category_button_text | default: "SHOP ALL" }}</span>
    </a>
  </div>
</div>
