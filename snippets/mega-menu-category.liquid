{% doc %}
  Renders the premium grocery-style Shop By Category mega menu.
  Matching Two Brothers India Shop reference layout with green wave illustration background & centered Shop All button.

  @param {section} section - Header section containing category_card blocks and wave settings.

  @example
  {% render 'mega-menu-category', section: section %}
{% enddoc %}

<div class="kb-category-mega" data-category-mega>
  <div class="kb-category-mega__slider" data-category-slider>
    {% liquid
      assign category_count = 0
      assign rendered_handles = '|'
    %}

    {% for block in section.blocks %}
      {% if block.type == 'category_card' %}
        {% if block.settings.collection != blank %}
          {% assign card_collection = block.settings.collection %}
          {% if card_collection.products_count > 0 or card_collection.title != blank %}
            {% assign category_count = category_count | plus: 1 %}
            {% assign rendered_handles = rendered_handles | append: card_collection.handle | append: '|' %}
            {% liquid
              assign card_title = card_collection.title
              assign card_subtitle = block.settings.subtitle
              assign card_url = card_collection.url
              assign card_image = block.settings.image
              if card_image == blank
                assign card_image = card_collection.image
              endif
              if card_image == blank
                assign first_product = card_collection.products | first
                if first_product != blank
                  assign card_image = first_product.featured_image
                endif
              endif
            %}
            <a class="kb-category-card" href="{{ card_url }}" {{ block.shopify_attributes }}>
              <span class="kb-category-card__media">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 320
                    | image_tag:
                      class: 'kb-category-card__image',
                      alt: card_title,
                      widths: '160, 240, 320',
                      sizes: '(min-width: 990px) 120px, 35vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'kb-category-card__image kb-category-card__image--placeholder' }}
                {% endif %}
              </span>
              <span class="kb-category-card__content">
                <span class="kb-category-card__title">{{ card_title }}</span>
                {% if card_subtitle != blank %}
                  <span class="kb-category-card__subtitle">{{ card_subtitle }}</span>
                {% elsif card_collection.products_count > 0 %}
                  <span class="kb-category-card__subtitle">{{ card_collection.products_count }} {{ card_collection.products_count | pluralize: 'product', 'products' }}</span>
                {% endif %}
              </span>
            </a>
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% for collection in collections limit: 12 %}
      {% unless collection.handle == 'all' %}
        {% unless rendered_handles contains collection.handle %}
          {% if collection.products_count > 0 %}
            {% assign category_count = category_count | plus: 1 %}
            {% assign rendered_handles = rendered_handles | append: collection.handle | append: '|' %}
            {% liquid
              assign card_image = collection.image
              if card_image == blank
                assign first_product = collection.products | first
                if first_product != blank
                  assign card_image = first_product.featured_image
                endif
              endif
            %}
            <a class="kb-category-card" href="{{ collection.url }}">
              <span class="kb-category-card__media">
                {% if card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 320
                    | image_tag:
                      class: 'kb-category-card__image',
                      alt: collection.title,
                      widths: '160, 240, 320',
                      sizes: '(min-width: 990px) 120px, 35vw',
                      loading: 'lazy'
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'kb-category-card__image kb-category-card__image--placeholder' }}
                {% endif %}
              </span>
              <span class="kb-category-card__content">
                <span class="kb-category-card__title">{{ collection.title }}</span>
                <span class="kb-category-card__subtitle">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
              </span>
            </a>
          {% endif %}
        {% endunless %}
      {% endunless %}
    {% endfor %}

    {% if category_count == 0 %}
      <p class="kb-category-mega__empty">Product categories will appear here after collections have products.</p>
    {% endif %}
  </div>

  <!-- Organic Green Wave Background Illustration (Matching Two Brothers Reference) -->
  <div class="kb-category-mega__wave-container" aria-hidden="true">
    {% if section.settings.category_wave_image != blank %}
      {{
        section.settings.category_wave_image
        | image_url: width: 1400
        | image_tag: class: 'kb-category-mega__wave-img', loading: 'lazy', alt: 'Mega Menu Wave Illustration'
      }}
    {% else %}
      <svg class="kb-category-mega__wave-svg" viewBox="0 0 1200 180" preserveAspectRatio="none" fill="none">
        <path d="M0,80 C300,160 600,20 900,120 C1050,170 1150,130 1200,100 L1200,180 L0,180 Z" fill="#dff2dd" fill-opacity="0.85"/>
        <path d="M0,110 C250,175 550,60 850,150 C1020,185 1130,150 1200,130 L1200,180 L0,180 Z" fill="#cbe7c8" fill-opacity="0.95"/>
      </svg>
    {% endif %}
  </div>

  <!-- Centered SHOP ALL Button on top of Wave -->
  <div class="kb-category-mega__footer-action">
    <a class="kb-category-mega__button-pill" href="{{ section.settings.category_button_url | default: routes.all_products_collection_url }}">
      <span>SHOP ALL</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>
