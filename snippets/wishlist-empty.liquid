{% doc %}
  Renders the empty state view when no items are saved in the wishlist.

  @param {object} [section] - The parent section containing schema settings
{% enddoc %}

{% assign empty_heading = settings.wishlist_empty_heading | default: section.settings.empty_heading | default: 'Your Wishlist is Empty' %}
{% assign empty_text = settings.wishlist_empty_text | default: section.settings.empty_text | default: 'Discover pure, farm-fresh organic staples you love and save them here for later.' %}
{% assign empty_btn_text = settings.wishlist_empty_btn_text | default: section.settings.empty_btn_text | default: 'Continue Shopping' %}
{% assign empty_btn_url = settings.wishlist_empty_btn_url | default: section.settings.empty_btn_url | default: '/collections/all' %}

<div class="kb-wishlist-empty" data-wishlist-empty>
  <div class="kb-wishlist-empty__icon-wrap">
    <span class="kb-wishlist-empty__icon" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#23421F" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </span>
    <span class="kb-wishlist-empty__pulse"></span>
  </div>
  <h3 class="kb-wishlist-empty__heading">{{ empty_heading }}</h3>
  <p class="kb-wishlist-empty__description">{{ empty_text }}</p>
  <a href="{{ empty_btn_url }}" class="kb-wishlist-empty__cta" data-wishlist-close>{{ empty_btn_text }}</a>
</div>
