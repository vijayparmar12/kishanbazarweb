{% doc %}
  Renders the empty state view when no items are saved in the wishlist.
{% enddoc %}

<div class="kb-wishlist-empty" data-wishlist-empty>
  <div class="kb-wishlist-empty__icon-wrap">
    <span class="kb-wishlist-empty__icon" aria-hidden="true">❤️</span>
    <span class="kb-wishlist-empty__pulse"></span>
  </div>
  <h3 class="kb-wishlist-empty__heading">Your Wishlist is Empty</h3>
  <p class="kb-wishlist-empty__description">Discover pure, farm-fresh organic staples you love and save them here for later.</p>
  <a href="/collections/all" class="kb-wishlist-empty__cta" data-wishlist-close>Continue Shopping</a>
</div>
