{% doc %}
  Renders the attached floating predictive search dropdown combining Rosier Foods layout
  (#F8F4EB cream backdrop, 2-column layout for suggestions & products, serif headers with divider lines)
  with Anveshan structure (pills, blog links, star ratings) and client-side instant search fallback.

  @example
  {% render 'predictive-search-drawer' %}
{% enddoc %}

{{ 'predictive-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<div class="kb-search-dropdown" id="PredictiveSearchDropdown" aria-hidden="true" data-predictive-search-drawer>
  <div class="kb-search-dropdown__inner">
    
    <!-- 2-Column Content Body (Rosier & Anveshan Hybrid) -->
    <div class="kb-search-dropdown__content" data-predictive-search-results>
      
      <!-- Left Column: Suggestions & Pages/Articles -->
      <div class="kb-search-dropdown__left-col">
        
        <!-- Suggestions Section -->
        <div class="kb-search-dropdown__section">
          <h3 class="kb-search-dropdown__title">Suggestions</h3>
          
          <div class="kb-search-dropdown__pills" data-search-pills-container>
            <button type="button" class="kb-search-pill" data-search-pill="Ghee">Ghee</button>
            <button type="button" class="kb-search-pill" data-search-pill="Atta">Atta</button>
            <button type="button" class="kb-search-pill" data-search-pill="Khapli Atta">Khapli Atta</button>
            <button type="button" class="kb-search-pill" data-search-pill="A2 Gir Cow Ghee">A2 Gir Cow Ghee</button>
            <button type="button" class="kb-search-pill" data-search-pill="Cold Pressed Oil">Cold Pressed Oil</button>
          </div>

          <ul class="kb-search-dropdown__suggestion-list" data-suggestion-list-container style="display: none;"></ul>
        </div>

        <!-- Pages & Articles Section -->
        <div class="kb-search-dropdown__section" style="margin-top: 1.25rem;">
          <h3 class="kb-search-dropdown__title">Pages & articles</h3>
          <div class="kb-search-dropdown__articles-list" data-blogs-container>
            <a href="/blogs/news" class="kb-search-article-link">Pure Cow Ghee vs Desi Ghee Explained</a>
            <a href="/blogs/news" class="kb-search-article-link">Difference between Vanaspati Ghee and Desi Ghee</a>
            <a href="/pages/about-us" class="kb-search-article-link">Farm Traceability & Quality Guarantee</a>
          </div>
        </div>

      </div>

      <!-- Right Column: Products List -->
      <div class="kb-search-dropdown__right-col">
        <div class="kb-search-dropdown__section">
          <h3 class="kb-search-dropdown__title">Products</h3>
          
          <div class="kb-search-dropdown__products-list" data-products-container>
            {% assign featured_collection = collections['best-sellers'] | default: collections['all'] %}
            {% if featured_collection != blank and featured_collection.products_count > 0 %}
              {% for product in featured_collection.products limit: 4 %}
                {% assign variant = product.selected_or_first_available_variant %}
                <a href="{{ product.url }}" class="kb-search-product-row">
                  <div class="kb-search-product-row__img-wrap">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 140 | image_tag: class: 'kb-search-product-row__img', loading: 'lazy', alt: product.title }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'kb-search-product-row__img' }}
                    {% endif %}
                  </div>
                  <div class="kb-search-product-row__details">
                    <h4 class="kb-search-product-row__title">{{ product.title }}</h4>
                    <div class="kb-search-product-row__meta">
                      <span class="kb-search-product-row__price">{{ variant.price | money }}</span>
                      <span class="kb-search-product-row__rating">★ 4.9 <small style="color: #64748b; font-weight: 500;">(1279)</small></span>
                    </div>
                  </div>
                </a>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Footer Bar (Rosier Style) -->
    <div class="kb-search-dropdown__footer">
      <span class="kb-search-dropdown__footer-text">Results for "<strong data-search-footer-query>search</strong>"</span>
      <button type="button" class="kb-search-dropdown__footer-close" data-search-close>&times; Close</button>
    </div>

  </div>
</div>

<script type="application/json" id="PredictiveSearchStoreProducts">
[
  {% for product in collections['all'].products limit: 50 %}
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "price": {{ product.price | money | json }},
      "image": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 140 | json }}{% else %}""{% endif %},
      "type": {{ product.type | json }},
      "tags": {{ product.tags | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>
