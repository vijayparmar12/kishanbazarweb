{% doc %}
  Renders the predictive search popup overlay combining Anveshan layout structure
  and Rosier Foods design aesthetics (Popular Searches tags, 2-column layout,
  warm cream backdrop #F8F4EB, serif section titles with divider lines, and yellow query highlights).

  @example
  {% render 'predictive-search-drawer' %}
{% enddoc %}

{{ 'predictive-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<div class="kb-search-drawer" id="PredictiveSearchDrawer" aria-hidden="true" data-predictive-search-drawer>
  <div class="kb-search-drawer__backdrop" data-search-close></div>

  <div class="kb-search-drawer__container" role="dialog" aria-modal="true" aria-label="Search store">
    <!-- Header Row -->
    <div class="kb-search-drawer__header-row">
      <span class="kb-search-drawer__label">Search our store</span>
      <button type="button" class="kb-search-drawer__close" aria-label="Close search modal" data-search-close>&times;</button>
    </div>

    <!-- Search Form -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="kb-search-drawer__form" data-predictive-search-form>
      <input
        type="search"
        name="q"
        class="kb-search-drawer__input"
        placeholder="Search for Ghee, Atta, Oil..."
        value=""
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        data-predictive-search-input
      >
      <button type="button" class="kb-search-drawer__clear" aria-label="Clear search query" data-search-input-clear style="display: none;">&times;</button>
      <button type="submit" class="kb-search-drawer__submit" aria-label="Submit search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
    </form>

    <!-- 2-Column Results Content -->
    <div class="kb-search-drawer__body" data-predictive-search-results>
      <div class="kb-search-drawer__grid-layout">
        
        <!-- Left Column: Suggestions & Pages/Articles -->
        <div class="kb-search-drawer__col-left">
          <!-- Suggestions -->
          <div class="kb-search-drawer__section" data-section-suggestions>
            <h3 class="kb-search-drawer__title">Suggestions</h3>
            <div class="kb-search-drawer__pills" data-pills-container>
              <button type="button" class="kb-search-pill" data-search-pill="A2 Ghee">A2 Ghee</button>
              <button type="button" class="kb-search-pill" data-search-pill="Bilona Ghee">Bilona Ghee</button>
              <button type="button" class="kb-search-pill" data-search-pill="Khapli Atta">Khapli Atta</button>
              <button type="button" class="kb-search-pill" data-search-pill="Cold Pressed Oil">Cold Pressed Oil</button>
            </div>
            <ul class="kb-search-drawer__suggestion-list" data-suggestion-list-container style="display: none;"></ul>
          </div>

          <!-- Pages & Articles -->
          <div class="kb-search-drawer__section" data-section-blogs style="margin-top: 1.25rem;">
            <h3 class="kb-search-drawer__title">Pages & Articles</h3>
            <div class="kb-search-drawer__blogs-grid" data-blogs-container>
              <a href="/blogs/news" class="kb-search-blog-card">
                <div class="kb-search-blog-card__content">
                  <h4 class="kb-search-blog-title">Pure Cow Ghee vs Desi Ghee Explained</h4>
                  <p class="kb-search-blog-meta">Read full article in Simple Words for Everyday Buyers &rarr;</p>
                </div>
              </a>
              <a href="/blogs/news" class="kb-search-blog-card">
                <div class="kb-search-blog-card__content">
                  <h4 class="kb-search-blog-title">Difference between Vanaspati Ghee and Desi Ghee</h4>
                  <p class="kb-search-blog-meta">Health benefits and traditional Bilona churning process &rarr;</p>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Products List/Grid -->
        <div class="kb-search-drawer__col-right">
          <div class="kb-search-drawer__section" data-section-products>
            <h3 class="kb-search-drawer__title">
              <span>Products</span>
            </h3>
            <div class="kb-search-drawer__products-list" data-products-container>
              {% assign featured_collection = collections['best-sellers'] | default: collections['all'] %}
              {% if featured_collection != blank and featured_collection.products_count > 0 %}
                {% for product in featured_collection.products limit: 4 %}
                  {% assign variant = product.selected_or_first_available_variant %}
                  <div class="kb-search-product-row">
                    <a href="{{ product.url }}" class="kb-search-product-row__link">
                      <div class="kb-search-product-row__img-wrap">
                        {% if product.featured_image != blank %}
                          {{ product.featured_image | image_url: width: 160 | image_tag: class: 'kb-search-product-thumb', loading: 'lazy', alt: product.title }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'kb-search-product-thumb' }}
                        {% endif %}
                      </div>
                      <div class="kb-search-product-row__info">
                        <h4 class="kb-search-product-title">{{ product.title }}</h4>
                        <div class="kb-search-product-prices">
                          <span class="kb-search-product-price">{{ variant.price | money }}</span>
                          {% if variant.compare_at_price > variant.price %}
                            <s class="kb-search-product-compare">{{ variant.compare_at_price | money }}</s>
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div class="kb-search-drawer__footer-bar" data-search-footer-bar>
      <span class="kb-search-drawer__footer-status" data-search-status-text>Type to search or pick a popular term above</span>
    </div>
  </div>
</div>
