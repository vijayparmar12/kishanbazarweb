{% doc %}
  Renders the predictive search dropdown drawer matching Rosier Foods layout
  (Split 2-column: Suggestions on Left with yellow match highlight, Products row list on Right).
  Hidden when input is empty.

  @example
  {% render 'predictive-search-drawer' %}
{% enddoc %}

{{ 'predictive-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

<div class="kb-search-drawer" id="PredictiveSearchDrawer" aria-hidden="true" data-predictive-search-drawer>
  <div class="kb-search-drawer__backdrop" data-search-close></div>

  <div class="kb-search-drawer__container" role="dialog" aria-modal="true" aria-label="Search store">
    <!-- Header Row inside drawer -->
    <div class="kb-search-drawer__header-row">
      <form action="{{ routes.search_url }}" method="get" role="search" class="kb-search-drawer__form" data-predictive-search-form>
        <input
          type="search"
          name="q"
          class="kb-search-drawer__input"
          placeholder="Search products..."
          value=""
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          data-predictive-search-input
        >
        <button type="button" class="kb-search-drawer__clear" aria-label="Clear search query" data-search-input-clear style="display: none;">&times;</button>
        <button type="submit" class="kb-search-drawer__submit" aria-label="Submit search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
      <button type="button" class="kb-search-drawer__close" aria-label="Close search modal" data-search-close>&times;</button>
    </div>

    <!-- Scrollable Results Body (Split Layout: Suggestions Left | Products Right) -->
    <div class="kb-search-drawer__body" data-predictive-search-results style="display: none;">
      <!-- Column 1: Suggestions -->
      <div class="kb-search-drawer__col kb-search-drawer__col--suggestions" data-section-suggestions>
        <h3 class="kb-search-drawer__title">Suggestions</h3>
        <ul class="kb-search-drawer__suggestion-list" data-suggestion-list-container></ul>
      </div>

      <!-- Column 2: Products -->
      <div class="kb-search-drawer__col kb-search-drawer__col--products" data-section-products>
        <h3 class="kb-search-drawer__title">
          <span>Products</span>
          <a href="{{ routes.all_products_collection_url }}" class="kb-search-drawer__view-all" data-view-all-products style="display: none;">View All &rarr;</a>
        </h3>
        <div class="kb-search-drawer__products-list" data-products-container></div>
      </div>
    </div>
  </div>
</div>
