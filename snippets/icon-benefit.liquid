{% doc %}
  Renders an optimized, accessible, reusable product benefit vector SVG icon.

  @param {string} [type] - Benefit icon type keyword ('natural', 'organic', 'cold_pressed', 'stone_ground', 'pure_bilona', 'chemical_free', 'lab_tested', 'farm_fresh', 'badge_1', 'badge_2', 'badge_3', 'badge_4', etc.)
  @param {string} [name] - Alternative parameter for icon type name
  @param {number} [size] - Icon display size in pixels (default: 72)
  @param {string} [class] - Extra CSS classes
  @param {string} [color] - Primary stroke/fill color (default: '#23421f')

  @example
  {% render 'icon-benefit', type: 'natural', size: 72 %}
{% enddoc %}

{% liquid
  assign icon_size = size | default: 72
  assign target_type = type | default: name | default: 'natural' | downcase
  assign primary_color = color | default: '#23421f'
%}

<svg class="kb-benefit-svg {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {% case target_type %}
    {% when 'natural', '1', 'badge_1', 'trust_1', 'leaf' %}
      <circle cx="32" cy="32" r="30" fill="#EEF5EA" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M32 14C22 14 16 22 16 34C16 42 22 48 32 48C42 48 48 42 48 34C48 22 42 14 32 14Z" fill="{{ primary_color }}" fill-opacity="0.12" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M32 48V26" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M32 34C37 31 42 32 44 34" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M32 38C27 35 22 36 20 38" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round"/>

    {% when 'organic', '2', 'badge_2', 'trust_2', 'sun', 'sprout' %}
      <circle cx="32" cy="32" r="30" fill="#F4F8F0" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <circle cx="32" cy="32" r="22" stroke="{{ primary_color }}" stroke-width="1.8" stroke-dasharray="3 3"/>
      <path d="M32 44V28M32 28C32 22 24 18 20 22C20 28 26 30 32 28ZM32 28C32 22 40 18 44 22C44 28 38 30 32 28Z" fill="{{ primary_color }}" fill-opacity="0.15" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>

    {% when 'cold_pressed', 'stone_ground', '3', 'badge_3', 'trust_3', 'oil', 'drop' %}
      <circle cx="32" cy="32" r="30" fill="#EEF5EA" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M32 16C32 16 18 30 18 37A14 14 0 0 0 46 37C46 30 32 16 32 16Z" fill="{{ primary_color }}" fill-opacity="0.15" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M28 34C28 31.8 29.8 30 32 30" stroke="{{ primary_color }}" stroke-width="2" stroke-linecap="round"/>
      <circle cx="32" cy="38" r="3" fill="{{ primary_color }}"/>

    {% when 'pure_bilona', 'bilona', '4', 'badge_4', 'trust_4', 'ghee', 'pot' %}
      <circle cx="32" cy="32" r="30" fill="#FDF8EB" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M22 18H42M24 14H40V18H24V14Z" stroke="{{ primary_color }}" stroke-width="2" stroke-linecap="round"/>
      <path d="M18 24C18 21 21 20 24 20H40C43 20 46 21 46 24V38C46 43 41 46 32 46C23 46 18 43 18 38V24Z" fill="{{ primary_color }}" fill-opacity="0.15" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M32 24V40M26 30H38" stroke="{{ primary_color }}" stroke-width="1.8" stroke-linecap="round"/>

    {% when 'chemical_free', 'no_preservatives', 'shield' %}
      <circle cx="32" cy="32" r="30" fill="#EEF5EA" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M32 14L46 20V32C46 41 40 47 32 50C24 47 18 41 18 32V20L32 14Z" fill="{{ primary_color }}" fill-opacity="0.12" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M26 32L30 36L38 26" stroke="{{ primary_color }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>

    {% when 'lab_tested', 'verified', 'flask' %}
      <circle cx="32" cy="32" r="30" fill="#F4F8F0" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M28 16H36M30 16V26L18 44H46L34 26V16" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M22 38H42" fill="{{ primary_color }}" fill-opacity="0.2" stroke="{{ primary_color }}" stroke-width="2"/>
      <circle cx="28" cy="34" r="1.5" fill="{{ primary_color }}"/>
      <circle cx="35" cy="32" r="1.5" fill="{{ primary_color }}"/>

    {% when 'farm_fresh', 'farmers', 'wheat' %}
      <circle cx="32" cy="32" r="30" fill="#EEF5EA" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M32 48V16M32 20C28 16 20 18 20 24C24 24 28 22 32 20ZM32 20C36 16 44 18 44 24C40 24 36 22 32 20ZM32 30C26 26 18 28 18 34C22 34 26 32 32 30ZM32 30C38 26 46 28 46 34C42 34 38 32 32 30Z" fill="{{ primary_color }}" fill-opacity="0.15" stroke="{{ primary_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

    {% else %}
      <circle cx="32" cy="32" r="30" fill="#EEF5EA" stroke="{{ primary_color }}" stroke-width="1.5"/>
      <path d="M32 14C22 14 16 22 16 34C16 42 22 48 32 48C42 48 48 42 48 34C48 22 42 14 32 14Z" fill="{{ primary_color }}" fill-opacity="0.12" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M32 48V26" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round"/>
      <path d="M32 34C37 31 42 32 44 34" stroke="{{ primary_color }}" stroke-width="2.2" stroke-linecap="round"/>
  {% endcase %}
</svg>
