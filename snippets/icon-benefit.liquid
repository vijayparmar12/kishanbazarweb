{% doc %}
  Renders an optimized product benefit icon badge (SVG vector or dynamic image drop).

  @param {object|string} [image] - Shopify image drop, file drop, or URL string
  @param {string} [name] - Benefit type name ('organic', 'bilona', 'cold-pressed', 'stone-ground', 'chemical-free', 'lab-tested', 'natural')
  @param {string} [alt] - Optional accessibility alt text
  @param {boolean} [eager] - Whether to load eagerly (default: false)
  @param {number} [size] - Display icon size in pixels (default: 72)
  @param {string} [class] - Additional CSS classes

  @example
  {% render 'icon-benefit', image: product.metafields.custom.badge_image_1.value, alt: 'Organic', size: 72 %}
  {% render 'icon-benefit', name: 'organic', size: 72 %}
{% enddoc %}

{% liquid
  assign icon_display_size = size | default: 72
  assign retina_size = icon_display_size | times: 2
  assign is_eager = eager | default: false
%}

{% if image != blank %}
  {% liquid
    assign img_drop = image.preview_image | default: image
    assign img_src_str = img_drop.src | default: img_drop | append: ''
    assign is_svg_file = false
    if img_src_str contains '.svg'
      assign is_svg_file = true
    endif

    if is_svg_file
      assign final_img_url = img_drop | image_url
    else
      assign final_img_url = img_drop | image_url: width: retina_size
    endif
    assign img_alt_text = alt | default: img_drop.alt | default: 'Product Benefit' | escape
  %}

  <img
    src="{{ final_img_url }}"
    alt="{{ img_alt_text }}"
    width="{{ icon_display_size }}"
    height="{{ icon_display_size }}"
    loading="{% if is_eager %}eager{% else %}lazy{% endif %}"
    fetchpriority="{% if is_eager %}high{% else %}low{% endif %}"
    decoding="async"
    class="kb-benefit-icon-img {{ class }}"
    style="object-fit: contain; display: block; max-width: 100%; height: auto;"
  >
{% elsif name != blank or icon != blank %}
  {% assign b_name = name | default: icon | downcase %}
  <svg viewBox="0 0 48 48" width="{{ icon_display_size }}" height="{{ icon_display_size }}" class="kb-benefit-icon-svg {{ class }}" fill="none" stroke="#23421f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% case b_name %}
      {% when 'organic', '100% organic', 'bio' %}
        <path d="M24 40C14 40 8 32 8 22C8 12 16 6 24 4C32 6 40 12 40 22C40 32 34 40 24 40Z" fill="#23421f" fill-opacity="0.12"/>
        <path d="M24 10V34M24 20C18 16 14 18 14 22M24 24C30 20 34 22 34 26"/>
      {% when 'bilona', 'a2 bilona', 'ghee' %}
        <path d="M18 12h12M20 8h8v4h-8z"/>
        <path d="M13 18c0-3 3-6 11-6s11 3 11 6v16c0 4-5 6-11 6s-11-2-11-6V18z" fill="#23421f" fill-opacity="0.12"/>
        <path d="M24 20c-3 0-5 2-5 4s5 5 5 5 5-3 5-5-2-4-5-4z" fill="#23421f"/>
      {% when 'cold-pressed', 'wood-pressed', 'oil' %}
        <path d="M19 12h10v4H19z" fill="#23421f" fill-opacity="0.15"/>
        <path d="M24 6v6M18 16c-3 0-5 2-5 5v17c0 2.2 1.8 4 4 4h14c2.2 0 4-1.8 4-4V21c0-3-2-5-5-5H18z"/>
        <path d="M24 24a4 4 0 0 1 4 4c0 3-4 6-4 6s-4-3-4-6a4 4 0 0 1 4-4z" fill="#23421f"/>
      {% when 'stone-ground', 'atta', 'flour' %}
        <path d="M10 18c0-2 4-4 14-4s14 2 14 4v18c0 3-4 6-14 6S10 39 10 36V18z" fill="#23421f" fill-opacity="0.12"/>
        <path d="M10 18c0 2 4 4 14 4s14-2 14-4"/>
        <path d="M24 6v8M18 8l-3-4M30 8l3-4"/>
      {% when 'chemical-free', 'natural', 'pure' %}
        <circle cx="24" cy="24" r="18" fill="#23421f" fill-opacity="0.08"/>
        <path d="m16 24 5 5 11-11"/>
      {% when 'lab-tested', 'tested', 'certified' %}
        <path d="M18 8h12v6H18z" fill="#23421f" fill-opacity="0.15"/>
        <path d="M16 14l-6 24h28l-6-24M24 24v8M20 28h8"/>
      {% else %}
        <circle cx="24" cy="24" r="18" fill="#23421f" fill-opacity="0.08"/>
        <path d="M24 14v20M14 24h20"/>
    {% endcase %}
  </svg>
{% endif %}
