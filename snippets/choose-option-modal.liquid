{% doc %}
  Renders the global Choose Option variant drawer modal (Two Brothers style UI).
{% enddoc %}

<!-- Choose Option Variant Drawer Modal Popup (Two Brothers Style) -->
<aside class="kb-choose-option-modal" id="ChooseOptionModal" hidden data-choose-option-modal>
  <div class="kb-choose-option-modal__backdrop" data-close-choose-option></div>
  <div class="kb-choose-option-modal__container">
    <div class="kb-choose-option-modal__header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <button type="button" class="kb-choose-option-modal__back" data-close-choose-option aria-label="Back" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #1e293b;">&larr;</button>
        <div>
          <div class="kb-choose-option-modal__product-title" data-choose-product-title style="font-size: 0.78rem; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px;">Product</div>
          <h3 style="margin: 0; font-size: 1.15rem; color: #1e293b; font-weight: 800;">Choose Option</h3>
        </div>
      </div>
      <button type="button" class="kb-choose-option-modal__close" data-close-choose-option aria-label="Close modal" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>

    <div class="kb-choose-option-modal__body" data-choose-options-list style="padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.85rem; max-height: 55vh; overflow-y: auto;">
      <!-- Populated dynamically via JS -->
    </div>

    <div class="kb-choose-option-modal__footer" style="padding: 0.75rem 1rem 1.25rem;">
      <button type="button" class="kb-choose-option-modal__confirm-btn" data-confirm-choose-option style="width: 100%; height: 50px; background: #23421f; color: #ffffff; border: none; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center;">Confirm</button>
    </div>
  </div>
</aside>
