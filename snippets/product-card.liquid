{% liquid
  assign variant = product.selected_or_first_available_variant
  assign is_sale = false
  assign discount = 0
  if variant.compare_at_price > variant.price
    assign is_sale = true
    assign saving = variant.compare_at_price | minus: variant.price
    assign discount = saving | times: 100 | divided_by: variant.compare_at_price
  endif
%}

<article class="product-card" data-product-card data-product-handle="{{ product.handle }}">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="View {{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 760 | image_tag: class: 'product-card__image', loading: 'lazy', widths: '260, 420, 560, 760' }}
        {% if product.images[1] != blank %}
          {{ product.images[1] | image_url: width: 760 | image_tag: class: 'product-card__image product-card__image--hover', loading: 'lazy', widths: '260, 420, 560, 760' }}
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {% endif %}
    </a>

    <div class="product-card__top-bar">
      {% if show_badge %}
        {% unless product.available %}
          <span class="product-card__badge product-card__badge--sold">Sold out</span>
        {% else %}
          {% if is_sale %}
            <span class="product-card__badge">Save {{ discount }}%</span>
          {% elsif product.tags contains 'new' or product.tags contains 'New' %}
            <span class="product-card__badge">New Launch</span>
          {% else %}
            <span class="product-card__badge">Most Loved</span>
          {% endif %}
        {% endunless %}
      {% endif %}

      {% if show_wishlist %}
        <button
          class="product-card__action"
          type="button"
          aria-label="Add {{ product.title | escape }} to wishlist"
          aria-pressed="false"
          data-wishlist-button
          data-product-handle="{{ product.handle }}"
          data-product-title="{{ product.title | escape }}"
          data-product-price="{{ variant.price | money | escape }}"
          {% if variant.compare_at_price > variant.price %}data-product-compare="{{ variant.compare_at_price | money | escape }}"{% endif %}
          data-product-discount="{{ discount }}"
          data-product-variant="{{ variant.title | escape }}"
          data-variant-id="{{ variant.id }}"
          {% if product.featured_image != blank %}data-product-image="{{ product.featured_image | image_url: width: 300 }}"{% endif %}
          data-product-vendor="{{ product.vendor | default: 'Kishan Bazar' | escape }}"
        >
          {% render 'icon', name: 'heart', size: 18 %}
        </button>
      {% endif %}
    </div>
  </div>

  <div class="product-card__content">
    <div class="product-card__title-row">
      <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      {% if show_price != false %}
        <div class="product-card__price">
          <span class="product-card__price-current">₹{{ variant.price | money_without_currency }}</span>
          {% if is_sale and show_compare_price != false %}
            <s class="product-card__price-compare">₹{{ variant.compare_at_price | money_without_currency }}</s>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if show_vendor %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}

    <p class="product-card__subtitle">
      {% if product.tags contains 'Khapli' or product.title contains 'Khapli' or product.title contains 'Atta' %}
        22g Protein in 4 Rotis | Low Gluten
      {% elsif product.tags contains 'Ghee' or product.type == 'Ghee' or product.title contains 'Ghee' %}
        Cultured Gir Cow Bilona Ghee | Pure & Natural
      {% elsif product.tags contains 'Oil' or product.type contains 'Oil' or product.title contains 'Oil' %}
        100% Wood-Pressed Cold Extracted
      {% elsif product.type != blank %}
        {{ product.type }} | Certified Organic
      {% else %}
        Organic & Farm Fresh
      {% endif %}
    </p>

    {% if show_rating %}
      <p class="product-card__rating" aria-label="Customer rating">
        <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <strong>4.91</strong>
        <small>| 58 Reviews</small>
      </p>
    {% endif %}

    <div class="product-card__actions">
          {% if show_add_to_cart != false %}
        <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form">
          <div class="product-card__variant-wrap">
            <label class="visually-hidden" for="ProductCardVariant-{{ product.id }}">Choose size</label>
            <select class="product-card__variant-select" id="ProductCardVariant-{{ product.id }}" name="id" data-product-card-variant-select>
              {% for card_variant in product.variants %}
                <option
                  value="{{ card_variant.id }}"
                  data-price="₹{{ card_variant.price | money_without_currency }}"
                  data-compare="{% if card_variant.compare_at_price > card_variant.price %}₹{{ card_variant.compare_at_price | money_without_currency }}{% endif %}"
                  data-available="{% if card_variant.available %}true{% else %}false{% endif %}"
                  {% if card_variant == variant %}selected{% endif %}
                  {% unless card_variant.available %}disabled{% endunless %}
                >
                  {% if card_variant.title != 'Default Title' and card_variant.title != blank %}{{ card_variant.title }}{% else %}10kg{% endif %}
                </option>
              {% endfor %}
            </select>
          </div>

          <button class="product-card__add" type="submit"{% unless product.available %} disabled{% endunless %}>
            {% if product.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
          </button>
        </form>
      {% endif %}
    </div>
  </div>
</article>
