{% liquid
  assign variant = product.selected_or_first_available_variant
  assign compare_price = variant.compare_at_price
  if compare_price == blank or compare_price <= variant.price
    assign compare_price = variant.price | times: 110 | divided_by: 100
    if compare_price == variant.price
      assign compare_price = variant.price | plus: 2000
    endif
  endif
  assign is_sale = true
  assign saving = compare_price | minus: variant.price
  assign discount = saving | times: 100 | divided_by: compare_price
%}

<article class="product-card" data-product-card data-product-handle="{{ product.handle }}">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="View {{ product.title | escape }}">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 760 | image_tag: class: 'product-card__image', loading: 'lazy', widths: '260, 420, 560, 760' }}
        {% if product.images[1] != blank %}
          {{ product.images[1] | image_url: width: 760 | image_tag: class: 'product-card__image product-card__image--hover', loading: 'lazy', widths: '260, 420, 560, 760' }}
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {% endif %}
    </a>

    <div class="product-card__top-bar">
      {% if show_badge %}
        {% if product.available == false %}
          <span class="product-card__badge product-card__badge--sold">Sold out</span>
        {% else %}
          <span class="product-card__badge product-card__badge--loved" style="{% if badge_bg != blank %}background-color: {{ badge_bg }};{% endif %}{% if badge_color != blank %}color: {{ badge_color }};{% endif %}">
            {% if badge_text != blank %}
              {{ badge_text }}
            {% elsif product.tags contains 'new' or product.tags contains 'New' %}
              New Launch
            {% else %}
              MOST LOVED
            {% endif %}
          </span>
        {% endif %}
      {% endif %}

      {% if show_wishlist %}
        <button
          class="product-card__action"
          type="button"
          aria-label="Add {{ product.title | escape }} to wishlist"
          aria-pressed="false"
          data-wishlist-button
          data-product-handle="{{ product.handle }}"
          data-product-title="{{ product.title | escape }}"
          data-product-price="{{ variant.price | money | escape }}"
          data-product-compare="{{ compare_price | money | escape }}"
          data-product-discount="{{ discount }}"
          data-product-variant="{{ variant.title | escape }}"
          data-variant-id="{{ variant.id }}"
          {% if product.featured_image != blank %}data-product-image="{{ product.featured_image | image_url: width: 300 }}"{% endif %}
          data-product-vendor="{{ product.vendor | default: 'Kishan Bazar' | escape }}"
          style="{% if wishlist_bg != blank %}background-color: {{ wishlist_bg }};{% endif %}{% if wishlist_color != blank %}color: {{ wishlist_color }};{% endif %}"
        >
          {% render 'icon', name: 'heart', size: 18 %}
        </button>
      {% endif %}
    </div>

    <!-- Option 4 Seamless White Wave with Dark Green Stroke Accent -->
    <div class="product-card__wave-divider" aria-hidden="true">
      <svg viewBox="0 0 500 36" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,14 C140,36 360,2 500,14 L500,36 L0,36 Z" fill="#ffffff"/>
        <path d="M0,14 C140,36 360,2 500,14" stroke="#23421f" stroke-width="3" fill="none" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <div class="product-card__content">
    {% if card_blocks.size > 0 %}
      {% for block in card_blocks %}
        {% case block.type %}
          {% when 'card_title_price' %}
            <div class="product-card__title-row" {{ block.shopify_attributes }}>
              <h3 class="product-card__title"><a href="{{ product.url }}" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% elsif title_color != blank %}color: {{ title_color }};{% endif %}">{{ product.title }}</a></h3>
              {% if show_price != false %}
                <div class="product-card__price">
                  <s class="product-card__price-compare" style="{% if block.settings.compare_price_color != blank %}color: {{ block.settings.compare_price_color }};{% elsif compare_price_color != blank %}color: {{ compare_price_color }};{% endif %}">₹{{ compare_price | money_without_currency }}</s>
                  <span class="product-card__price-current" style="{% if block.settings.price_color != blank %}color: {{ block.settings.price_color }};{% elsif price_color != blank %}color: {{ price_color }};{% endif %}">₹{{ variant.price | money_without_currency }}</span>
                </div>
              {% endif %}
            </div>

          {% when 'card_subtitle' %}
            {% assign card_subtitle = product.metafields.descriptors.subtitle %}
            {% if card_subtitle == blank %}
              {% assign card_subtitle = product.metafields.custom.subtitle %}
            {% endif %}
            {% if card_subtitle == blank %}
              {% assign card_subtitle = product.metafields.custom.made_from %}
            {% endif %}
            {% if card_subtitle == blank %}
              {% assign p_title_down = product.title | downcase %}
              {% assign p_type_down = product.type | downcase %}
              {% if p_title_down contains 'atta' or p_title_down contains 'flour' or p_title_down contains 'khapli' or p_type_down contains 'atta' %}
                {% assign card_subtitle = "Made from ancient Emmer Wheat" %}
              {% elsif p_title_down contains 'ghee' or p_type_down contains 'ghee' %}
                {% assign card_subtitle = "Made from 100% Pure Bilona A2 Gir Cow Milk" %}
              {% elsif p_title_down contains 'oil' or p_type_down contains 'oil' %}
                {% assign card_subtitle = "Made from Cold Pressed & Unrefined Seeds" %}
              {% elsif p_title_down contains 'jaggery' or p_title_down contains 'sweetener' or p_type_down contains 'jaggery' %}
                {% assign card_subtitle = "Made from 100% Natural Organic Sugarcane Juice" %}
              {% else %}
                {% assign card_subtitle = "Made from 100% Natural & Organic Ingredients" %}
              {% endif %}
            {% endif %}
            <p class="product-card__subtitle" style="{% if block.settings.subtitle_color != blank %}color: {{ block.settings.subtitle_color }};{% elsif subtitle_color != blank %}color: {{ subtitle_color }};{% endif %}" {{ block.shopify_attributes }}>{{ card_subtitle }}</p>

          {% when 'card_rating' %}
            <p class="product-card__rating" aria-label="Customer rating" {{ block.shopify_attributes }}>
              <span class="product-card__stars" aria-hidden="true" style="{% if block.settings.rating_stars_color != blank %}color: {{ block.settings.rating_stars_color }};{% elsif rating_stars_color != blank %}color: {{ rating_stars_color }};{% endif %}">
                <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </span>
              <strong class="product-card__rating-value">{% if product.metafields.reviews.rating.value != blank %}{{ product.metafields.reviews.rating.value.rating | round: 2 }}{% else %}4.91{% endif %}</strong>
            </p>

          {% when 'card_benefit_icons' %}
            <div {{ block.shopify_attributes }}>
              {% render 'product-circle-features', product: product, block: block, limit: 3 %}
            </div>

          {% when 'card_variant_selector' or 'card_buy_button' %}
            {% if rendered_actions_row != true %}
              {% assign rendered_actions_row = true %}
              <div class="product-card__actions" style="margin-top: auto; padding-top: 0.4rem; width: 100%;">
                <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form" data-product-card-form style="display: flex; flex-direction: row; align-items: center; gap: 0.4rem; width: 100%;">
                  {% if product.has_only_default_variant == false and show_variant_selector != false %}
                    <div class="product-card__variant-wrap" style="flex: 1 1 38%; min-width: 0; margin-bottom: 0;">
                      <select class="product-card__variant-select" name="id" aria-label="Select variant for {{ product.title | escape }}" data-product-card-variant-select style="padding: 0.45rem 1.4rem 0.45rem 0.5rem; font-size: 0.82rem; font-weight: 700; height: 40px; min-height: 40px; width: 100%; border: 1.5px solid #23421f; border-radius: 8px; {% if variant_block.settings.border_color != blank %}border-color: {{ variant_block.settings.border_color }};{% endif %}{% if variant_block.settings.bg_color != blank %}background-color: {{ variant_block.settings.bg_color }};{% endif %}{% if variant_block.settings.text_color != blank %}color: {{ variant_block.settings.text_color }};{% endif %}">
                        {% for card_variant in product.variants %}
                          {% assign v_compare = card_variant.compare_at_price %}
                          {% if v_compare == blank or v_compare <= card_variant.price %}
                            {% assign v_compare = card_variant.price | times: 110 | divided_by: 100 %}
                          {% endif %}
                          <option value="{{ card_variant.id }}" data-price="₹{{ card_variant.price | money_without_currency }}" data-compare="₹{{ v_compare | money_without_currency }}" {% if card_variant == variant %}selected{% endif %} {% if card_variant.available == false %}disabled{% endif %}>
                            {{ card_variant.title }}{% if card_variant.available == false %} (Sold out){% endif %}
                          </option>
                        {% endfor %}
                      </select>
                    </div>
                  {% else %}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                  {% endif %}

                  <!-- In-Place Morphing Button Container (Side-by-Side in 1 Row) -->
                  <div class="product-card__btn-container" data-card-btn-container style="flex: 1 1 62%; min-width: 0; height: 40px; min-height: 40px; position: relative;">
                    <!-- Standard ADD TO CART Button -->
                    <button class="product-card__add" type="submit"{% if product.available == false %} disabled{% endif %} data-card-add-btn style="width: 100%; height: 40px; min-height: 40px; padding: 0.45rem 0.35rem; font-size: 0.80rem; font-weight: 800; border-radius: 8px; background-color: #23421f; color: #ffffff; border: none; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 0.25rem; cursor: pointer; {% if buy_block.settings.btn_bg != blank %}background-color: {{ buy_block.settings.btn_bg }};{% elsif btn_bg != blank %}background-color: {{ btn_bg }};{% endif %}{% if buy_block.settings.btn_color != blank %}color: {{ buy_block.settings.btn_color }};{% elsif btn_color != blank %}color: {{ btn_color }};{% endif %}">
                      <span>{% if product.available %}{{ buy_block.settings.add_to_cart_text | default: add_to_cart_text | default: "ADD TO CART" }}{% else %}SOLD OUT{% endif %}</span>
                      <svg class="product-card__cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px; flex-shrink: 0;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    </button>

                    <!-- Morphing In-Place Stepper [- 1 +] Pill (Initially Hidden) -->
                    <div class="product-card__inline-stepper" data-card-inline-stepper style="display: none; width: 100%; height: 40px; min-height: 40px; border: 2px solid #23421f; border-radius: 8px; background: #ffffff; align-items: center; justify-content: space-between; padding: 0 6px; box-sizing: border-box;">
                      <button type="button" class="product-card__inline-btn product-card__inline-btn--minus" data-inline-minus aria-label="Decrease quantity" style="width: 24px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.15rem; font-weight: 900; color: #23421f; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">-</button>
                      <span class="product-card__inline-count" data-inline-count style="font-size: 0.90rem; font-weight: 900; color: #23421f; text-align: center;">1</span>
                      <button type="button" class="product-card__inline-btn product-card__inline-btn--plus" data-inline-plus aria-label="Increase quantity" style="width: 24px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.15rem; font-weight: 900; color: #23421f; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">+</button>
                    </div>
                  </div>
                </form>
              </div>
            {% endif %}

          {% when 'card_custom_text' %}
            {% if block.settings.text != blank %}
              <p class="product-card__custom-text-line" style="color: {{ block.settings.text_color | default: '#23421F' }}; font-weight: {{ block.settings.font_weight | default: 'bold' }}; font-size: 0.85rem; margin: 0.25rem 0;" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </p>
            {% endif %}

        {% endcase %}
      {% endfor %}
    {% else %}
      <!-- Standard Layout Fallback -->
      <div class="product-card__title-row">
        <h3 class="product-card__title"><a href="{{ product.url }}" style="{% if title_color != blank %}color: {{ title_color }};{% endif %}">{{ product.title }}</a></h3>
        {% if show_price != false %}
          <div class="product-card__price">
            <s class="product-card__price-compare" style="{% if compare_price_color != blank %}color: {{ compare_price_color }};{% endif %}">₹{{ compare_price | money_without_currency }}</s>
            <span class="product-card__price-current" style="{% if price_color != blank %}color: {{ price_color }};{% endif %}">₹{{ variant.price | money_without_currency }}</span>
          </div>
        {% endif %}
      </div>

      {% if show_vendor %}
        <p class="product-card__vendor">{{ product.vendor }}</p>
      {% endif %}

      {% if show_subtitle != false %}
        {% assign card_subtitle = product.metafields.descriptors.subtitle %}
        {% if card_subtitle == blank %}
          {% assign card_subtitle = product.metafields.custom.subtitle %}
        {% endif %}
        {% if card_subtitle == blank %}
          {% assign card_subtitle = product.metafields.custom.made_from %}
        {% endif %}
        {% if card_subtitle == blank %}
          {% assign p_title_down = product.title | downcase %}
          {% assign p_type_down = product.type | downcase %}
          {% if p_title_down contains 'atta' or p_title_down contains 'flour' or p_title_down contains 'khapli' or p_type_down contains 'atta' %}
            {% assign card_subtitle = "Made from ancient Emmer Wheat" %}
          {% elsif p_title_down contains 'ghee' or p_type_down contains 'ghee' %}
            {% assign card_subtitle = "Made from 100% Pure Bilona A2 Gir Cow Milk" %}
          {% elsif p_title_down contains 'oil' or p_type_down contains 'oil' %}
            {% assign card_subtitle = "Made from Cold Pressed & Unrefined Seeds" %}
          {% elsif p_title_down contains 'jaggery' or p_title_down contains 'sweetener' or p_type_down contains 'jaggery' %}
            {% assign card_subtitle = "Made from 100% Natural Organic Sugarcane Juice" %}
          {% else %}
            {% assign card_subtitle = "Made from 100% Natural & Organic Ingredients" %}
          {% endif %}
        {% endif %}
        <p class="product-card__subtitle" style="{% if subtitle_color != blank %}color: {{ subtitle_color }};{% endif %}">{{ card_subtitle }}</p>
      {% endif %}

      {% if show_rating %}
        <p class="product-card__rating" aria-label="Customer rating">
          <span class="product-card__stars" aria-hidden="true" style="{% if rating_stars_color != blank %}color: {{ rating_stars_color }};{% endif %}">
            <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="product-card__star-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </span>
          <strong class="product-card__rating-value">{% if product.metafields.reviews.rating.value != blank %}{{ product.metafields.reviews.rating.value.rating | round: 2 }}{% else %}4.91{% endif %}</strong>
        </p>
      {% endif %}

      {% if show_benefit_icons != false %}
        {% render 'product-circle-features', product: product, limit: 3 %}
      {% endif %}

      <div class="product-card__actions" style="margin-top: auto; padding-top: 0.4rem; width: 100%;">
        {% if show_add_to_cart != false %}
          <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form" data-product-card-form style="display: flex; flex-direction: row; align-items: center; gap: 0.4rem; width: 100%;">
            {% if product.has_only_default_variant == false and show_variant_selector != false %}
              <div class="product-card__variant-wrap" style="flex: 1 1 38%; min-width: 0; margin-bottom: 0;">
                <select
                  class="product-card__variant-select"
                  name="id"
                  aria-label="Select variant for {{ product.title | escape }}"
                  data-product-card-variant-select
                  style="padding: 0.45rem 1.4rem 0.45rem 0.5rem; font-size: 0.82rem; font-weight: 700; height: 40px; min-height: 40px; width: 100%; border: 1.5px solid #23421f; border-radius: 8px;"
                >
                  {% for card_variant in product.variants %}
                    {% assign v_compare = card_variant.compare_at_price %}
                    {% if v_compare == blank or v_compare <= card_variant.price %}
                      {% assign v_compare = card_variant.price | times: 110 | divided_by: 100 %}
                      {% if v_compare == card_variant.price %}
                        {% assign v_compare = card_variant.price | plus: 2000 %}
                      {% endif %}
                    {% endif %}
                    <option
                      value="{{ card_variant.id }}"
                      data-price="₹{{ card_variant.price | money_without_currency }}"
                      data-compare="₹{{ v_compare | money_without_currency }}"
                      {% if card_variant == variant %}selected{% endif %}
                      {% if card_variant.available == false %}disabled{% endif %}
                    >
                      {{ card_variant.title }}{% if card_variant.available == false %} (Sold out){% endif %}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ variant.id }}">
            {% endif %}

            <!-- In-Place Morphing Button Container (Side-by-Side in 1 Row) -->
            <div class="product-card__btn-container" data-card-btn-container style="flex: 1 1 62%; min-width: 0; height: 40px; min-height: 40px; position: relative;">
              <!-- Standard ADD TO CART Button -->
              <button class="product-card__add" type="submit"{% if product.available == false %} disabled{% endif %} data-card-add-btn style="width: 100%; height: 40px; min-height: 40px; padding: 0.45rem 0.5rem; font-size: 0.85rem; font-weight: 800; border-radius: 8px; background-color: #23421f; color: #ffffff; border: none; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 0.35rem; cursor: pointer; {% if btn_bg != blank %}background-color: {{ btn_bg }};{% endif %}{% if btn_color != blank %}color: {{ btn_color }};{% endif %}">
                <span>
                  {% if product.available %}
                    {{ add_to_cart_text | default: "ADD TO CART" }}
                  {% else %}
                    SOLD OUT
                  {% endif %}
                </span>
                <svg class="product-card__cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px; flex-shrink: 0;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </button>

              <!-- Morphing In-Place Stepper [- 1 +] Pill (Initially Hidden) -->
              <div class="product-card__inline-stepper" data-card-inline-stepper style="display: none; width: 100%; height: 40px; min-height: 40px; border: 2px solid #23421f; border-radius: 8px; background: #ffffff; align-items: center; justify-content: space-between; padding: 0 10px; box-sizing: border-box;">
                <button type="button" class="product-card__inline-btn product-card__inline-btn--minus" data-inline-minus aria-label="Decrease quantity" style="width: 32px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.25rem; font-weight: 900; color: #23421f; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">-</button>
                <span class="product-card__inline-count" data-inline-count style="font-size: 0.95rem; font-weight: 900; color: #23421f; text-align: center;">1</span>
                <button type="button" class="product-card__inline-btn product-card__inline-btn--plus" data-inline-plus aria-label="Increase quantity" style="width: 32px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.25rem; font-weight: 900; color: #23421f; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">+</button>
              </div>
            </div>
          </form>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>
