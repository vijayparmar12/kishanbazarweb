{% doc %}
  Renders trust badge icons dynamically purely from Shopify CSV / Product Metafields or Theme Editor Block Settings.
  Supports trust_badge_image_1..4, trust_icon_1..4, and badge_image_1..4 keys.

  @param {object} [product] - The Shopify product object
  @param {object} [block] - The Shopify block object with settings

  @example
  {% render 'product-highlights', product: product, block: block %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom
  assign alt_meta = product.metafields['product.metafields.custom']

  # Extract ONLY the .value file drops from custom metafields per product
  assign m_t1_val = c_meta.trust_badge_image_1.value | default: alt_meta.trust_badge_image_1.value | default: c_meta.trust_icon_1.value | default: alt_meta.trust_icon_1.value | default: c_meta.badge_image_1.value | default: alt_meta.badge_image_1.value
  assign m_t2_val = c_meta.trust_badge_image_2.value | default: alt_meta.trust_badge_image_2.value | default: c_meta.trust_icon_2.value | default: alt_meta.trust_icon_2.value | default: c_meta.badge_image_2.value | default: alt_meta.badge_image_2.value
  assign m_t3_val = c_meta.trust_badge_image_3.value | default: alt_meta.trust_badge_image_3.value | default: c_meta.trust_icon_3.value | default: alt_meta.trust_icon_3.value | default: c_meta.badge_image_3.value | default: alt_meta.badge_image_3.value
  assign m_t4_val = c_meta.trust_badge_image_4.value | default: alt_meta.trust_badge_image_4.value | default: c_meta.trust_icon_4.value | default: alt_meta.trust_icon_4.value | default: c_meta.badge_image_4.value | default: alt_meta.badge_image_4.value

  assign has_custom_metafields = false
  if m_t1_val != blank or m_t2_val != blank or m_t3_val != blank or m_t4_val != blank
    assign has_custom_metafields = true
  endif

  # Image 1 (Product Custom Metafield FIRST)
  assign img_url_1 = blank
  if m_t1_val != blank
    assign t1_img = m_t1_val.preview_image | default: m_t1_val
    assign img_url_1 = t1_img | image_url: width: 300
  elsif has_custom_metafields == false
    if block.settings.trust_image_1 != blank
      assign img_url_1 = block.settings.trust_image_1 | image_url: width: 300
    elsif section.settings.trust_image_1 != blank
      assign img_url_1 = section.settings.trust_image_1 | image_url: width: 300
    endif
  endif

  # Image 2
  assign img_url_2 = blank
  if m_t2_val != blank
    assign t2_img = m_t2_val.preview_image | default: m_t2_val
    assign img_url_2 = t2_img | image_url: width: 300
  elsif has_custom_metafields == false
    if block.settings.trust_image_2 != blank
      assign img_url_2 = block.settings.trust_image_2 | image_url: width: 300
    elsif section.settings.trust_image_2 != blank
      assign img_url_2 = section.settings.trust_image_2 | image_url: width: 300
    endif
  endif

  # Image 3
  assign img_url_3 = blank
  if m_t3_val != blank
    assign t3_img = m_t3_val.preview_image | default: m_t3_val
    assign img_url_3 = t3_img | image_url: width: 300
  elsif has_custom_metafields == false
    if block.settings.trust_image_3 != blank
      assign img_url_3 = block.settings.trust_image_3 | image_url: width: 300
    elsif section.settings.trust_image_3 != blank
      assign img_url_3 = section.settings.trust_image_3 | image_url: width: 300
    endif
  endif

  # Image 4
  assign img_url_4 = blank
  if m_t4_val != blank
    assign t4_img = m_t4_val.preview_image | default: m_t4_val
    assign img_url_4 = t4_img | image_url: width: 300
  elsif has_custom_metafields == false
    if block.settings.trust_image_4 != blank
      assign img_url_4 = block.settings.trust_image_4 | image_url: width: 300
    elsif section.settings.trust_image_4 != blank
      assign img_url_4 = section.settings.trust_image_4 | image_url: width: 300
    endif
  endif

  assign max_icons = limit | default: 4

  assign uploaded_count = 0
  if img_url_1 != blank
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_2 != blank and max_icons >= 2
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_3 != blank and max_icons >= 3
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_4 != blank and max_icons >= 4
    assign uploaded_count = uploaded_count | plus: 1
  endif

  assign current_icon_size = block.settings.icon_size | default: section.settings.icon_size | default: 64
%}

{% if uploaded_count > 0 %}
  <div class="product-circle-features product-circle-features--trust" aria-label="Product Trust Badges" style="margin: 0.5rem 0; width: 100%; --kb-benefit-icon-size: {{ current_icon_size }}px;">
    <div class="product-circle-features__grid" style="display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 0.75rem; width: 100%;">
      
      {% if img_url_1 != blank and max_icons >= 1 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_1 }}" alt="Trust Badge 1" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_2 != blank and max_icons >= 2 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_2 }}" alt="Trust Badge 2" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_3 != blank and max_icons >= 3 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_3 }}" alt="Trust Badge 3" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_4 != blank and max_icons >= 4 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_4 }}" alt="Trust Badge 4" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}
