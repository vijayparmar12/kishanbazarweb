{% doc %}
  Renders trust badge icons dynamically purely from Shopify CSV / Product Metafields or Theme Editor Block Settings.
  Matches the exact 85px size, height, width, and flex grid spacing of the Benefit Icons above.

  @param {object} [product] - The Shopify product object
  @param {object} [block] - The Shopify block object with settings
  @param {boolean} [eager] - Whether to load icons eagerly (default: false)

  @example
  {% render 'product-highlights', product: product, block: block %}
{% enddoc %}

{% liquid
  assign trust_block = block
  if trust_block == blank
    for b in section.blocks
      if b.type == 'trust_badges'
        assign trust_block = b
        break
      endif
    endfor
  endif

  assign c_meta = product.metafields.custom
  assign alt_meta = product.metafields['product.metafields.custom']

  # Extract ONLY the .value file drops from custom metafields per product
  assign m_t1_val = c_meta.trust_badge_image_1.value | default: alt_meta.trust_badge_image_1.value | default: c_meta.trust_icon_1.value | default: alt_meta.trust_icon_1.value | default: c_meta.badge_image_1.value | default: alt_meta.badge_image_1.value
  assign m_t2_val = c_meta.trust_badge_image_2.value | default: alt_meta.trust_badge_image_2.value | default: c_meta.trust_icon_2.value | default: alt_meta.trust_icon_2.value | default: c_meta.badge_image_2.value | default: alt_meta.badge_image_2.value
  assign m_t3_val = c_meta.trust_badge_image_3.value | default: alt_meta.trust_badge_image_3.value | default: c_meta.trust_icon_3.value | default: alt_meta.trust_icon_3.value | default: c_meta.badge_image_3.value | default: alt_meta.badge_image_3.value
  assign m_t4_val = c_meta.trust_badge_image_4.value | default: alt_meta.trust_badge_image_4.value | default: c_meta.trust_icon_4.value | default: alt_meta.trust_icon_4.value | default: c_meta.badge_image_4.value | default: alt_meta.badge_image_4.value

  assign has_custom_metafields = false
  if m_t1_val != blank or m_t2_val != blank or m_t3_val != blank or m_t4_val != blank
    assign has_custom_metafields = true
  endif

  assign t1_drop = m_t1_val
  if t1_drop == blank and has_custom_metafields == false
    assign t1_drop = trust_block.settings.trust_image_1 | default: section.settings.trust_image_1
  endif

  assign t2_drop = m_t2_val
  if t2_drop == blank and has_custom_metafields == false
    assign t2_drop = trust_block.settings.trust_image_2 | default: section.settings.trust_image_2
  endif

  assign t3_drop = m_t3_val
  if t3_drop == blank and has_custom_metafields == false
    assign t3_drop = trust_block.settings.trust_image_3 | default: section.settings.trust_image_3
  endif

  assign t4_drop = m_t4_val
  if t4_drop == blank and has_custom_metafields == false
    assign t4_drop = trust_block.settings.trust_image_4 | default: section.settings.trust_image_4
  endif

  assign max_icons = limit | default: 4

  assign uploaded_count = 0
  if t1_drop != blank
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if t2_drop != blank and max_icons >= 2
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if t3_drop != blank and max_icons >= 3
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if t4_drop != blank and max_icons >= 4
    assign uploaded_count = uploaded_count | plus: 1
  endif

  assign is_eager = eager | default: false
%}

{% if uploaded_count > 0 %}
  <div class="product-circle-features product-circle-features--trust" aria-label="Product Trust Badges">
    <div class="product-circle-features__grid">
      
      {% if t1_drop != blank and max_icons >= 1 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% render 'benefit-icon', image: t1_drop, alt: 'Trust Badge 1', type: 'trust_1', eager: is_eager, size: 72 %}
          </div>
        </div>
      {% endif %}

      {% if t2_drop != blank and max_icons >= 2 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% render 'benefit-icon', image: t2_drop, alt: 'Trust Badge 2', type: 'trust_2', eager: is_eager, size: 72 %}
          </div>
        </div>
      {% endif %}

      {% if t3_drop != blank and max_icons >= 3 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% render 'benefit-icon', image: t3_drop, alt: 'Trust Badge 3', type: 'trust_3', eager: is_eager, size: 72 %}
          </div>
        </div>
      {% endif %}

      {% if t4_drop != blank and max_icons >= 4 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% render 'benefit-icon', image: t4_drop, alt: 'Trust Badge 4', type: 'trust_4', eager: is_eager, size: 72 %}
          </div>
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}
