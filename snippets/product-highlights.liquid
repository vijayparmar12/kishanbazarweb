{% doc %}
  Renders custom trust & highlight feature badges per product from Shopify Product Metafields.
  Renders ONLY if custom icons exist for that particular product (no dummy fallbacks).

  Supported metafield keys:
  - product.metafields.custom.trust_icon_1 & trust_title_1
  - product.metafields.custom.trust_icon_2 & trust_title_2
  - product.metafields.custom.trust_icon_3 & trust_title_3
  - product.metafields.custom.trust_icon_4 & trust_title_4

  @param {object} [product] - The Shopify product object
  @param {object} [block] - The Shopify block object with settings

  @example
  {% render 'product-highlights', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom
  assign alt_meta = product.metafields['product.metafields.custom']

  # Extract ONLY custom uploaded metafield drops per product
  assign t1_icon = c_meta.trust_icon_1.value | default: alt_meta.trust_icon_1.value
  assign t1_title = c_meta.trust_title_1.value | default: alt_meta.trust_title_1.value

  assign t2_icon = c_meta.trust_icon_2.value | default: alt_meta.trust_icon_2.value
  assign t2_title = c_meta.trust_title_2.value | default: alt_meta.trust_title_2.value

  assign t3_icon = c_meta.trust_icon_3.value | default: alt_meta.trust_icon_3.value
  assign t3_title = c_meta.trust_title_3.value | default: alt_meta.trust_title_3.value

  assign t4_icon = c_meta.trust_icon_4.value | default: alt_meta.trust_icon_4.value
  assign t4_title = c_meta.trust_title_4.value | default: alt_meta.trust_title_4.value

  # Also support section / block settings if explicitly set in Theme Editor
  if t1_icon == blank and block.settings.trust_icon_1 != blank
    assign t1_icon = block.settings.trust_icon_1
    assign t1_title = block.settings.trust_title_1
  endif
  if t2_icon == blank and block.settings.trust_icon_2 != blank
    assign t2_icon = block.settings.trust_icon_2
    assign t2_title = block.settings.trust_title_2
  endif
  if t3_icon == blank and block.settings.trust_icon_3 != blank
    assign t3_icon = block.settings.trust_icon_3
    assign t3_title = block.settings.trust_title_3
  endif
  if t4_icon == blank and block.settings.trust_icon_4 != blank
    assign t4_icon = block.settings.trust_icon_4
    assign t4_title = block.settings.trust_title_4
  endif

  # Count uploaded icons
  assign count = 0
  if t1_icon != blank
    assign count = count | plus: 1
  endif
  if t2_icon != blank
    assign count = count | plus: 1
  endif
  if t3_icon != blank
    assign count = count | plus: 1
  endif
  if t4_icon != blank
    assign count = count | plus: 1
  endif
%}

{% if count > 0 %}
  <section class="product-highlights-row" aria-label="Store Trust Highlights">
    <div class="product-highlights-row__grid" style="display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; gap: 1rem; width: 100%;">
      
      {% if t1_icon != blank %}
        {% assign img1 = t1_icon.preview_image | default: t1_icon %}
        <div class="product-highlights-row__item" style="display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1 1 0;">
          <div class="product-highlights-row__icon-wrap" style="margin-bottom: 0.35rem;">
            <img src="{{ img1 | image_url: width: 140 }}" alt="{{ t1_title | strip_html | escape | default: 'Trust Icon 1' }}" loading="lazy" width="44" height="44" style="width: 44px; height: 44px; object-fit: contain;">
          </div>
          {% if t1_title != blank %}
            <span class="product-highlights-row__label" style="font-size: 0.78rem; font-weight: 700; color: #111827; line-height: 1.2;">{{ t1_title }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if t2_icon != blank %}
        {% assign img2 = t2_icon.preview_image | default: t2_icon %}
        <div class="product-highlights-row__item" style="display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1 1 0;">
          <div class="product-highlights-row__icon-wrap" style="margin-bottom: 0.35rem;">
            <img src="{{ img2 | image_url: width: 140 }}" alt="{{ t2_title | strip_html | escape | default: 'Trust Icon 2' }}" loading="lazy" width="44" height="44" style="width: 44px; height: 44px; object-fit: contain;">
          </div>
          {% if t2_title != blank %}
            <span class="product-highlights-row__label" style="font-size: 0.78rem; font-weight: 700; color: #111827; line-height: 1.2;">{{ t2_title }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if t3_icon != blank %}
        {% assign img3 = t3_icon.preview_image | default: t3_icon %}
        <div class="product-highlights-row__item" style="display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1 1 0;">
          <div class="product-highlights-row__icon-wrap" style="margin-bottom: 0.35rem;">
            <img src="{{ img3 | image_url: width: 140 }}" alt="{{ t3_title | strip_html | escape | default: 'Trust Icon 3' }}" loading="lazy" width="44" height="44" style="width: 44px; height: 44px; object-fit: contain;">
          </div>
          {% if t3_title != blank %}
            <span class="product-highlights-row__label" style="font-size: 0.78rem; font-weight: 700; color: #111827; line-height: 1.2;">{{ t3_title }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if t4_icon != blank %}
        {% assign img4 = t4_icon.preview_image | default: t4_icon %}
        <div class="product-highlights-row__item" style="display: flex; flex-direction: column; align-items: center; text-align: center; flex: 1 1 0;">
          <div class="product-highlights-row__icon-wrap" style="margin-bottom: 0.35rem;">
            <img src="{{ img4 | image_url: width: 140 }}" alt="{{ t4_title | strip_html | escape | default: 'Trust Icon 4' }}" loading="lazy" width="44" height="44" style="width: 44px; height: 44px; object-fit: contain;">
          </div>
          {% if t4_title != blank %}
            <span class="product-highlights-row__label" style="font-size: 0.78rem; font-weight: 700; color: #111827; line-height: 1.2;">{{ t4_title }}</span>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </section>
{% endif %}
