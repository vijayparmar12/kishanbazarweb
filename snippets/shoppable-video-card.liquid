{% doc %}
  Renders a clean video card with play button, direct product link overlay, and sound playback.

  @param {object} section - Parent section
  @param {object} block - Current video block
  @param {product} [card_product] - Product linked to the video
  @param {object} [hosted_video] - Shopify hosted video
  @param {string} [mp4_url] - External MP4 URL
  @param {image} [poster] - Video poster image
  @param {string} [shopify_attributes] - Block attributes from theme editor
{% enddoc %}

{% liquid
  if card_product == blank and collections.all.products.size > 0
    assign card_product = collections.all.products.first
  endif

  assign p_title = block.settings.custom_title
  if p_title == blank and card_product != blank
    assign p_title = card_product.title
  elsif p_title == blank
    assign p_title = 'Featured Product'
  endif

  assign selling_p = ''
  if card_product != blank
    assign selling_p = card_product.price | money
  endif
%}

<li class="shoppable-videos__slide" {{ shopify_attributes }}>
  <article class="shoppable-videos__card">
    
    <!-- Video Media Wrap (Clicking plays/pauses video) -->
    <div class="shoppable-videos__media-wrap">
      {% if hosted_video != blank %}
        {{ hosted_video | video_tag: class: 'shoppable-videos__video', loop: true, playsinline: true, preload: 'metadata' }}
      {% elsif mp4_url != blank %}
        <video class="shoppable-videos__video" loop playsinline preload="metadata" {% if poster != blank %}poster="{{ poster | image_url: width: 500 }}"{% elsif card_product.featured_image %}poster="{{ card_product.featured_image | image_url: width: 500 }}"{% endif %}>
          <source src="{{ mp4_url }}" type="video/mp4">
        </video>
      {% else %}
        <div class="shoppable-videos__video shoppable-videos__video--placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'shoppable-videos__poster' }}
        </div>
      {% endif %}

      <!-- Center Play Button Overlay -->
      <div class="shoppable-videos__play-btn" aria-label="Play video">
        <svg class="icon-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </div>

      <!-- Mute / Unmute Control Top Right -->
      <button type="button" class="shoppable-videos__mute-btn" aria-label="Toggle Mute">
        <svg class="icon-unmuted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        <svg class="icon-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
      </button>
    </div>

    <!-- Bottom Floating Product Pill Overlay (Direct Product Redirect) -->
    {% if card_product != blank %}
      <a href="{{ card_product.url }}" class="shoppable-videos__product-pill" aria-label="{{ p_title | escape }}">
        {% if card_product.featured_image != blank %}
          {{ card_product.featured_image | image_url: width: 120 | image_tag: class: 'shoppable-videos__product-thumb', loading: 'lazy', alt: p_title }}
        {% elsif poster != blank %}
          {{ poster | image_url: width: 120 | image_tag: class: 'shoppable-videos__product-thumb', loading: 'lazy', alt: p_title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'shoppable-videos__product-thumb' }}
        {% endif %}

        <div class="shoppable-videos__product-info">
          <h3 class="shoppable-videos__product-title">{{ p_title }}</h3>
          {% if selling_p != blank %}
            <span class="shoppable-videos__product-price">{{ selling_p }}</span>
          {% endif %}
        </div>
      </a>
    {% endif %}

  </article>
</li>
