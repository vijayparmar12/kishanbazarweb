{% doc %}
  Renders up to 6 promotional/feature banners directly above the description section.
  Banners are dynamically rendered from:
  1. Product listing metafields:
     - product.metafields.custom.banner_1 ... banner_6
     - product.metafields.custom.product_banners (file list)
  2. Theme Editor blocks ('product_banner' with settings for Banner 1 ... Banner 6)
  3. Theme Editor section settings (banner_image_1 ... banner_image_6)

  @param {object} product - The Shopify product object
  @param {object} section - The section object
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom
  assign alt_meta = product.metafields['product.metafields.custom']

  # Extract ALL 6 custom metafield banner drops (file drop or MediaImage)
  assign b1_raw = c_meta.banner_1.value | default: c_meta.banner_1 | default: alt_meta.banner_1.value | default: alt_meta.banner_1 | default: c_meta.banner_image_1.value | default: c_meta.banner_image_1 | default: c_meta.banner1.value | default: c_meta.banner1
  assign b2_raw = c_meta.banner_2.value | default: c_meta.banner_2 | default: alt_meta.banner_2.value | default: alt_meta.banner_2 | default: c_meta.banner_image_2.value | default: c_meta.banner_image_2 | default: c_meta.banner2.value | default: c_meta.banner2
  assign b3_raw = c_meta.banner_3.value | default: c_meta.banner_3 | default: alt_meta.banner_3.value | default: alt_meta.banner_3 | default: c_meta.banner_image_3.value | default: c_meta.banner_image_3 | default: c_meta.banner3.value | default: c_meta.banner3
  assign b4_raw = c_meta.banner_4.value | default: c_meta.banner_4 | default: alt_meta.banner_4.value | default: alt_meta.banner_4 | default: c_meta.banner_image_4.value | default: c_meta.banner_image_4 | default: c_meta.banner4.value | default: c_meta.banner4
  assign b5_raw = c_meta.banner_5.value | default: c_meta.banner_5 | default: alt_meta.banner_5.value | default: alt_meta.banner_5 | default: c_meta.banner_image_5.value | default: c_meta.banner_image_5 | default: c_meta.banner5.value | default: c_meta.banner5
  assign b6_raw = c_meta.banner_6.value | default: c_meta.banner_6 | default: alt_meta.banner_6.value | default: alt_meta.banner_6 | default: c_meta.banner_image_6.value | default: c_meta.banner_image_6 | default: c_meta.banner6.value | default: c_meta.banner6

  assign img_url_1 = blank
  if b1_raw != blank
    assign b1_img = b1_raw.preview_image | default: b1_raw
    assign img_url_1 = b1_img | image_url: width: 1400
  endif

  assign img_url_2 = blank
  if b2_raw != blank
    assign b2_img = b2_raw.preview_image | default: b2_raw
    assign img_url_2 = b2_img | image_url: width: 1400
  endif

  assign img_url_3 = blank
  if b3_raw != blank
    assign b3_img = b3_raw.preview_image | default: b3_raw
    assign img_url_3 = b3_img | image_url: width: 1400
  endif

  assign img_url_4 = blank
  if b4_raw != blank
    assign b4_img = b4_raw.preview_image | default: b4_raw
    assign img_url_4 = b4_img | image_url: width: 1400
  endif

  assign img_url_5 = blank
  if b5_raw != blank
    assign b5_img = b5_raw.preview_image | default: b5_raw
    assign img_url_5 = b5_img | image_url: width: 1400
  endif

  assign img_url_6 = blank
  if b6_raw != blank
    assign b6_img = b6_raw.preview_image | default: b6_raw
    assign img_url_6 = b6_img | image_url: width: 1400
  endif

  assign m_banner_list = c_meta.product_banners.value | default: alt_meta.product_banners.value | default: c_meta.banner_images.value | default: c_meta.banners.value
  assign block_banners = section.blocks | where: 'type', 'product_banner'
%}

<div class="product-banners-wrapper" data-product-banners-wrapper style="margin: 1.25rem 0 1.75rem; width: 100%;">
  <div class="product-banners-container" style="position: relative; width: 100%;">

    <!-- 1. Render Product Metafield File List if present -->
    {% if m_banner_list != blank and m_banner_list.size > 0 %}
      <div class="product-banners-grid" style="display: flex; flex-direction: column; gap: 1.5rem; width: 100%;">
        {% for b_img in m_banner_list limit: 6 %}
          {% assign b_src = b_img.preview_image | default: b_img | image_url: width: 1400 %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ b_src }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endfor %}
      </div>

    <!-- 2. Render Product Custom Metafields 1 to 6 (banner_1 ... banner_6) -->
    {% elsif img_url_1 != blank or img_url_2 != blank or img_url_3 != blank or img_url_4 != blank or img_url_5 != blank or img_url_6 != blank %}
      <div class="product-banners-grid" style="display: flex; flex-direction: column; gap: 1.5rem; width: 100%;">
        {% if img_url_1 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_1 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
        {% if img_url_2 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_2 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
        {% if img_url_3 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_3 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
        {% if img_url_4 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_4 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
        {% if img_url_5 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_5 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
        {% if img_url_6 != blank %}
          <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
            <img src="{{ img_url_6 }}" class="product-banner-img" loading="lazy" alt="{{ product.title | escape }}" style="width: 100%; height: auto; display: block; border-radius: 20px;">
          </div>
        {% endif %}
      </div>

    <!-- 3. Fallback to Theme Editor Blocks if configured (supporting up to 6 banners per block or 6 blocks) -->
    {% elsif block_banners.size > 0 %}
      <div class="product-banners-grid" style="display: flex; flex-direction: column; gap: 1.5rem; width: 100%;">
        {% for block in block_banners limit: 6 %}
          {% liquid
            assign b_img_1 = block.settings.image_1 | default: block.settings.image
            assign b_img_2 = block.settings.image_2
            assign b_img_3 = block.settings.image_3
            assign b_img_4 = block.settings.image_4
            assign b_img_5 = block.settings.image_5
            assign b_img_6 = block.settings.image_6
          %}

          {% if b_img_1 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_1 != blank or block.settings.link != blank %}<a href="{{ block.settings.link_1 | default: block.settings.link }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_1_mobile != blank or block.settings.image_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_1_mobile | default: block.settings.image_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_1 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_1 | default: block.settings.heading | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_1 != blank or block.settings.link != blank %}</a>{% endif %}
            </div>
          {% endif %}

          {% if b_img_2 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_2 != blank %}<a href="{{ block.settings.link_2 }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_2_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_2_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_2 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_2 | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_2 != blank %}</a>{% endif %}
            </div>
          {% endif %}

          {% if b_img_3 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_3 != blank %}<a href="{{ block.settings.link_3 }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_3_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_3_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_3 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_3 | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_3 != blank %}</a>{% endif %}
            </div>
          {% endif %}

          {% if b_img_4 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_4 != blank %}<a href="{{ block.settings.link_4 }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_4_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_4_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_4 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_4 | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_4 != blank %}</a>{% endif %}
            </div>
          {% endif %}

          {% if b_img_5 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_5 != blank %}<a href="{{ block.settings.link_5 }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_5_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_5_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_5 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_5 | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_5 != blank %}</a>{% endif %}
            </div>
          {% endif %}

          {% if b_img_6 != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }} style="border-radius: 20px; overflow: hidden; width: 100%; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
              {% if block.settings.link_6 != blank %}<a href="{{ block.settings.link_6 }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_6_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_6_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ b_img_6 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading_6 | default: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
                </picture>
              {% if block.settings.link_6 != blank %}</a>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    <!-- 4. Fallback to Theme Editor Section Settings (banner_image_1 .. banner_image_6) -->
    {% else %}
      {% liquid
        assign s_b1 = section.settings.banner_image_1
        assign s_b2 = section.settings.banner_image_2
        assign s_b3 = section.settings.banner_image_3
        assign s_b4 = section.settings.banner_image_4
        assign s_b5 = section.settings.banner_image_5
        assign s_b6 = section.settings.banner_image_6
      %}
      {% if s_b1 != blank or s_b2 != blank or s_b3 != blank or s_b4 != blank or s_b5 != blank or s_b6 != blank %}
        <div class="product-banners-grid" style="display: flex; flex-direction: column; gap: 1.5rem; width: 100%;">
          {% if s_b1 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b1 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
          {% if s_b2 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b2 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
          {% if s_b3 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b3 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
          {% if s_b4 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b4 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
          {% if s_b5 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b5 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
          {% if s_b6 != blank %}
            <div class="product-banner-card" style="border-radius: 20px; overflow: hidden; width: 100%;">
              {{ s_b6 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title, style: 'width: 100%; height: auto; display: block; border-radius: 20px;' }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>
