{% doc %}
  Renders up to 6 promotional/feature banners directly above the description section.
  Banners are dynamically rendered from:
  1. Product listing metafields:
     - product.metafields.custom.banner_1 ... banner_6
     - product.metafields.custom.product_banners (file list)
  2. Theme Editor blocks ('product_banner' up to 6 blocks)
  3. Theme Editor section settings (banner_image_1 ... banner_image_6)

  @param {object} product - The Shopify product object
  @param {object} section - The section object
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  assign m_b1_file = c_meta.banner_1.value | default: c_meta.banner_image_1.value | default: c_meta.banner1.value | default: c_meta.product_banner_1.value | default: c_meta.banner.value
  assign m_b2_file = c_meta.banner_2.value | default: c_meta.banner_image_2.value | default: c_meta.banner2.value | default: c_meta.product_banner_2.value
  assign m_b3_file = c_meta.banner_3.value | default: c_meta.banner_image_3.value | default: c_meta.banner3.value | default: c_meta.product_banner_3.value
  assign m_b4_file = c_meta.banner_4.value | default: c_meta.banner_image_4.value | default: c_meta.banner4.value | default: c_meta.product_banner_4.value
  assign m_b5_file = c_meta.banner_5.value | default: c_meta.banner_image_5.value | default: c_meta.banner5.value | default: c_meta.product_banner_5.value
  assign m_b6_file = c_meta.banner_6.value | default: c_meta.banner_image_6.value | default: c_meta.banner6.value | default: c_meta.product_banner_6.value

  assign m_banner_1 = m_b1_file
  assign m_banner_2 = m_b2_file
  assign m_banner_3 = m_b3_file
  assign m_banner_4 = m_b4_file
  assign m_banner_5 = m_b5_file
  assign m_banner_6 = m_b6_file

  assign m_banner_list = c_meta.product_banners.value | default: c_meta.banner_images.value | default: c_meta.banners.value

  assign block_banners = section.blocks | where: 'type', 'product_banner'
%}

<div class="product-banners-wrapper" data-product-banners-wrapper style="margin: 1.25rem 0 1.75rem; width: 100%;">
  <div class="product-banners-container" style="position: relative; width: 100%;">
    
    <!-- 1. Render Product Metafield Banners if set on Product Listing -->
    {% if m_banner_list != blank and m_banner_list.size > 0 %}
      <div class="product-banners-grid product-banners-grid--{{ m_banner_list.size | at_most: 6 }}">
        {% for b_img in m_banner_list limit: 6 %}
          <div class="product-banner-card">
            {{ b_img | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endfor %}
      </div>

    {% elsif m_banner_1 != blank or m_banner_2 != blank or m_banner_3 != blank or m_banner_4 != blank or m_banner_5 != blank or m_banner_6 != blank %}
      <div class="product-banners-grid">
        {% if m_banner_1 != blank %}
          <div class="product-banner-card">
            {{ m_banner_1 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
        {% if m_banner_2 != blank %}
          <div class="product-banner-card">
            {{ m_banner_2 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
        {% if m_banner_3 != blank %}
          <div class="product-banner-card">
            {{ m_banner_3 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
        {% if m_banner_4 != blank %}
          <div class="product-banner-card">
            {{ m_banner_4 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
        {% if m_banner_5 != blank %}
          <div class="product-banner-card">
            {{ m_banner_5 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
        {% if m_banner_6 != blank %}
          <div class="product-banner-card">
            {{ m_banner_6 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
          </div>
        {% endif %}
      </div>

    <!-- 2. Fallback to Theme Editor Blocks if configured (up to 6 blocks) -->
    {% elsif block_banners.size > 0 %}
      <div class="product-banners-grid product-banners-grid--{{ block_banners.size | at_most: 6 }}">
        {% for block in block_banners limit: 6 %}
          {% if block.settings.image != blank %}
            <div class="product-banner-card" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="product-banner-link">{% endif %}
                <picture class="product-banner-picture">
                  {% if block.settings.image_mobile != blank %}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
                  {% endif %}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: block.settings.heading | default: product.title }}
                </picture>
                {% if block.settings.heading != blank or block.settings.subtitle != blank %}
                  <div class="product-banner-overlay-text">
                    {% if block.settings.heading != blank %}<h4 class="product-banner-heading">{{ block.settings.heading }}</h4>{% endif %}
                    {% if block.settings.subtitle != blank %}<p class="product-banner-sub">{{ block.settings.subtitle }}</p>{% endif %}
                  </div>
                {% endif %}
              {% if block.settings.link != blank %}</a>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    <!-- 3. Fallback to Theme Editor Section Settings (banner_image_1 .. banner_image_6) -->
    {% else %}
      {% liquid
        assign s_b1 = section.settings.banner_image_1
        assign s_b2 = section.settings.banner_image_2
        assign s_b3 = section.settings.banner_image_3
        assign s_b4 = section.settings.banner_image_4
        assign s_b5 = section.settings.banner_image_5
        assign s_b6 = section.settings.banner_image_6
      %}
      {% if s_b1 != blank or s_b2 != blank or s_b3 != blank or s_b4 != blank or s_b5 != blank or s_b6 != blank %}
        <div class="product-banners-grid">
          {% if s_b1 != blank %}
            <div class="product-banner-card">
              {{ s_b1 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
          {% if s_b2 != blank %}
            <div class="product-banner-card">
              {{ s_b2 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
          {% if s_b3 != blank %}
            <div class="product-banner-card">
              {{ s_b3 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
          {% if s_b4 != blank %}
            <div class="product-banner-card">
              {{ s_b4 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
          {% if s_b5 != blank %}
            <div class="product-banner-card">
              {{ s_b5 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
          {% if s_b6 != blank %}
            <div class="product-banner-card">
              {{ s_b6 | image_url: width: 1400 | image_tag: class: 'product-banner-img', loading: 'lazy', widths: '400, 600, 800, 1200, 1400', alt: product.title }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

  </div>
</div>
