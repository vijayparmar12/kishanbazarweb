{% doc %}
  Renders an accessible dialog. @param {string} id - Unique dialog ID. @param {string} title - Dialog title. @param {string} content - Dialog body HTML. @param {string} [size] - small, medium, or large.
{% enddoc %}
<div class="modal" id="{{ id }}" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title" aria-hidden="true" hidden data-modal><div class="modal__overlay" data-modal-close></div><div class="modal__dialog modal__dialog--{{ size | default: 'medium' }}" role="document" tabindex="-1"><header class="modal__header"><h2 class="modal__title" id="{{ id }}-title">{{ title }}</h2><button class="modal__close" type="button" data-modal-close aria-label="Close dialog">{% render 'icon', name: 'close' %}</button></header><div class="modal__body">{{ content }}</div></div></div>
