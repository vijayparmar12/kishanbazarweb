{% doc %}
  Renders a cart line item structured identically to the Wishlist Drawer card for unified design.

  @param {line_item} item - The cart line item.
  @param {number} [line_index] - Cart line index used by the AJAX change endpoint.
  @param {boolean} [compact] - Compact variant for the cart drawer.
{% enddoc %}

{% liquid
  assign variant = item.variant
  assign compare_unit = variant.compare_at_price | default: variant.price
  if compare_unit <= variant.price and item.original_price > item.final_price
    assign compare_unit = item.original_price
  endif

  assign compare_price = compare_unit | times: item.quantity
  if compare_price <= item.final_line_price and item.original_line_price > item.final_line_price
    assign compare_price = item.original_line_price
  endif

  assign line_key = item.key | default: item.id
  assign product_handle = item.url | split: '/products/' | last | split: '?' | first
  assign all_item_variants = item.variant.product.variants | default: item.product.variants
%}

<script>
  window._variantComparePrices = window._variantComparePrices || {};
  window._productVariantsMap = window._productVariantsMap || {};
  {% for v in all_item_variants %}
    {% assign v_compare = v.compare_at_price | default: 0 %}
    window._variantComparePrices[{{ v.id }}] = {{ v_compare }};
    window._productVariantsMap[{{ v.id }}] = {
      id: {{ v.id }},
      title: {{ v.title | json }},
      available: {{ v.available | json }}
    };
  {% endfor %}
</script>

<article class="kb-cart-item{% if compact %} kb-cart-item--compact{% endif %}" data-cart-line-item data-cart-line-key="{{ line_key }}" data-cart-line-index="{{ line_index }}" data-cart-product-handle="{{ product_handle }}" data-variant-id="{{ variant.id }}" data-compare-unit-price="{{ compare_unit }}" data-compare-line-price="{{ compare_price }}">
  <!-- Left Column: Image Container matching Wishlist Drawer -->
  <div class="kb-cart-item__media-wrap">
    <a class="kb-cart-item__media-link" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
      {% if item.image != blank %}
        {{ item.image | image_url: width: 260 | image_tag: class: 'kb-cart-item__image', loading: 'lazy', widths: '100, 150, 260' }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'kb-cart-item__placeholder' }}
      {% endif %}
    </a>
  </div>

  <!-- Right Column: Content matching Wishlist Drawer -->
  <div class="kb-cart-item__content" style="position: relative;">
    
    <!-- Title & Trash Bin Header Row -->
    <div class="kb-cart-item__header-row" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; width: 100%;">
      <h3 class="kb-cart-item__title" style="margin: 0; flex: 1;">
        <a href="{{ item.url }}">{{ item.product.title | default: item.title }}</a>
      </h3>

      <button class="kb-cart-item__remove-btn" type="button" aria-label="{{ 'cart.remove' | t }}" data-cart-remove title="Remove item" style="background: none; border: none; padding: 4px; cursor: pointer; color: #64748b; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      </button>
    </div>

    <!-- Variant Select Dropdown -->
    <div class="kb-cart-item__variant-container" data-cart-variant-container="{{ line_key }}" style="margin-top: 6px; margin-bottom: 6px;">
      {% assign total_variants = all_item_variants.size %}
      {% if total_variants > 1 or item.product.has_only_default_variant == false or variant.title != 'Default Title' %}
        <select class="kb-cart-item__variant-select" data-cart-item-variant-select data-line-key="{{ line_key }}" data-current-qty="{{ item.quantity }}" data-current-variant-id="{{ variant.id }}" style="padding: 4px 24px 4px 10px; border-radius: 8px; border: 1px solid #cbd5e1; background-color: #f8fafc; font-size: 13px; font-weight: 600; color: #334155; cursor: pointer;">
          {% for v in all_item_variants %}
            {% assign is_opt_avail = v.available %}
            {% if v.inventory_management != blank and v.inventory_policy == 'deny' and v.inventory_quantity <= 0 %}
              {% assign is_opt_avail = false %}
            {% elsif v.inventory_quantity != blank and v.inventory_quantity <= 0 and v.inventory_policy != 'continue' %}
              {% assign is_opt_avail = false %}
            {% endif %}
            <option
              value="{{ v.id }}"
              data-variant-title="{{ v.title | escape }}"
              {% if v.id == variant.id %}selected{% endif %}
              {% unless is_opt_avail %}disabled data-available="false" style="color: #ef4444; font-weight: 700;"{% else %}data-available="true"{% endunless %}
            >
              {{ v.title }}{% unless is_opt_avail %} - (Sold Out){% endunless %}
            </option>
          {% endfor %}
        </select>
      {% elsif variant.title != blank and variant.title != 'Default Title' %}
        <span class="kb-cart-item__variant-pill" style="display: inline-block; padding: 3px 10px; border-radius: 6px; background-color: #f1f5f9; font-size: 12px; font-weight: 600; color: #475569;">
          {{ variant.title }}
          {% if variant.available == false %}
            <span class="kb-cart-item__sold-badge" style="color: #ef4444; font-weight: 700; margin-left: 4px;">(Sold Out)</span>
          {% endif %}
        </span>
      {% endif %}
    </div>

    <!-- Price Row -->
    <div class="kb-cart-item__price-row" style="margin-bottom: 8px;">
      <span class="kb-cart-item__price" data-cart-line-price style="font-size: 16px; font-weight: 800; color: #1b4317;">{{ item.final_line_price | money }}</span>
      {% if compare_price > item.final_line_price %}
        <s class="kb-cart-item__compare" style="font-size: 13px; color: #94a3b8; margin-left: 6px;">{{ compare_price | money }}</s>
      {% endif %}
    </div>

    <!-- Quantity Actions -->
    <div class="kb-cart-item__actions">
      <div class="kb-cart-item__control-pill" style="display: inline-flex; align-items: center; justify-content: space-between; border: 1px solid #cbd5e1; border-radius: 8px; padding: 2px 6px; background: #fff;">
        <button class="kb-cart-item__qty-btn" type="button" aria-label="Decrease quantity" data-cart-qty-minus style="width: 28px; height: 28px; border: none; background: none; font-size: 16px; font-weight: 700; color: #334155; cursor: pointer; display: flex; align-items: center; justify-content: center;">-</button>
        <input
          class="kb-cart-item__qty-input"
          type="number"
          min="1"
          step="1"
          value="{{ item.quantity }}"
          inputmode="numeric"
          aria-label="{{ 'cart.update' | t }}"
          data-cart-quantity-input
          style="width: 38px !important; min-width: 38px !important; height: 28px !important; line-height: 28px !important; font-size: 15px !important; font-weight: 700 !important; color: #1b4317 !important; text-align: center !important; border: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; outline: none !important; -webkit-appearance: none !important; -moz-appearance: textfield !important;"
        >
        <button class="kb-cart-item__qty-btn" type="button" aria-label="Increase quantity" data-cart-qty-plus style="width: 28px; height: 28px; border: none; background: none; font-size: 16px; font-weight: 700; color: #334155; cursor: pointer; display: flex; align-items: center; justify-content: center;">+</button>
      </div>
    </div>

  </div>
</article>