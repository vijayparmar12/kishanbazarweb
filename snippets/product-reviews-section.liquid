{% doc %}
  Renders the live Judge.me Reviews plugin widget for KishanVeda / Kishan Bazar.
  Matches official Judge.me app preview styling and mobile padding.

  @param {object} product - The Shopify product object
  @param {object} [section] - The section object containing theme editor settings

  @example
  {% render 'product-reviews-section', product: product, section: section %}
{% enddoc %}

{% liquid
  assign heading = section.settings.reviews_heading | default: "Customer Reviews"
  assign btn_bg = section.settings.reviews_btn_bg | default: "#1B4317"
  assign btn_text = section.settings.reviews_btn_text | default: "#FFFFFF"
  assign btn_hover = section.settings.reviews_btn_hover_bg | default: "#143511"
  assign star_col = section.settings.reviews_star_color | default: "#F59E0B"
  assign bar_col = section.settings.reviews_bar_fill | default: "#1B4317"
  assign border_rad = section.settings.reviews_border_radius | default: 16
%}

<style>
  #ProductReviews-{{ section.id }} {
    --jdgm-btn-bg: {{ btn_bg }};
    --jdgm-btn-text: {{ btn_text }};
    --jdgm-btn-hover: {{ btn_hover }};
    --jdgm-star-color: {{ star_col }};
    --jdgm-bar-fill: {{ bar_col }};
    --jdgm-radius: {{ border_rad }}px;
  }

  /* Judge.me Section & Container Padding Fix (Eliminate Double/Triple Padding) */
  #ProductReviews-{{ section.id }} {
    padding: 0.5rem 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  #ProductReviews-{{ section.id }} .product-reviews__container {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 0.75rem !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  /* Judge.me Main Card Box */
  #ProductReviews-{{ section.id }} .jdgm-rev-widg,
  #ProductReviews-{{ section.id }} .jdgm-review-widget {
    border-radius: var(--jdgm-radius) !important;
    border: 1px solid #efe8da !important;
    background-color: #ffffff !important;
    padding: 1.5rem 1.25rem !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03) !important;
    box-sizing: border-box !important;
    width: 100% !important;
    margin: 0 auto !important;
  }

  /* Responsive Mobile Padding Adjustments */
  @media (max-width: 768px) {
    #ProductReviews-{{ section.id }} .product-reviews__container {
      padding: 0 0.5rem !important;
    }
    #ProductReviews-{{ section.id }} .jdgm-rev-widg,
    #ProductReviews-{{ section.id }} .jdgm-review-widget {
      padding: 1.25rem 0.85rem !important;
      border-radius: 16px !important;
    }
    #ProductReviews-{{ section.id }} .jdgm-rev-widg__summary {
      padding: 1rem 0.65rem !important;
    }
  }

  /* Comprehensive Judge.me Button Overrides */
  #ProductReviews-{{ section.id }} .jdgm-write-rev-btn,
  #ProductReviews-{{ section.id }} .jdgm-btn,
  #ProductReviews-{{ section.id }} .jdgm-submit-rev,
  #ProductReviews-{{ section.id }} .jdgm-btn--primary,
  #ProductReviews-{{ section.id }} a.jdgm-btn,
  #ProductReviews-{{ section.id }} button.jdgm-btn,
  #ProductReviews-{{ section.id }} input[type="submit"].jdgm-btn,
  #ProductReviews-{{ section.id }} .jdgm-all-reviews-rating-actions__write-btn {
    background-color: var(--jdgm-btn-bg) !important;
    color: var(--jdgm-btn-text) !important;
    border-color: var(--jdgm-btn-bg) !important;
    border-radius: var(--jdgm-radius) !important;
  }

  #ProductReviews-{{ section.id }} .jdgm-write-rev-btn:hover,
  #ProductReviews-{{ section.id }} .jdgm-btn:hover,
  #ProductReviews-{{ section.id }} .jdgm-submit-rev:hover,
  #ProductReviews-{{ section.id }} .jdgm-btn--primary:hover,
  #ProductReviews-{{ section.id }} a.jdgm-btn:hover,
  #ProductReviews-{{ section.id }} button.jdgm-btn:hover,
  #ProductReviews-{{ section.id }} input[type="submit"].jdgm-btn:hover {
    background-color: var(--jdgm-btn-hover) !important;
    border-color: var(--jdgm-btn-hover) !important;
  }

  /* Star Color Override */
  #ProductReviews-{{ section.id }} .jdgm-star {
    color: var(--jdgm-star-color) !important;
  }

  /* Prevent title word-break issues like "Custome r Reviews" */
  .jdgm-rev-widg__title,
  .jdgm-widget-title,
  .jdgm-rev-widg__header,
  .jdgm-rev-widg__summary-text,
  h2.jdgm-rev-widg__title,
  h2.jdgm-widget-title {
    font-size: 1.35rem !important;
    font-weight: 800 !important;
    word-break: keep-all !important;
    word-wrap: normal !important;
    overflow-wrap: normal !important;
    white-space: normal !important;
    hyphens: manual !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    margin-bottom: 0.5rem !important;
  }

  /* Force Stars to remain horizontal inline row */
  .jdgm-star,
  .jdgm-star.jdgm--on,
  .jdgm-star.jdgm--off,
  .jdgm-star.jdgm--half {
    display: inline-block !important;
    float: none !important;
    font-family: JudgemeStar, sans-serif !important;
    line-height: 1 !important;
    width: auto !important;
    height: auto !important;
    margin: 0 1px !important;
  }

  .jdgm-rev__rating,
  .jdgm-rev-widg__summary-stars,
  .jdgm-prev-badge__stars {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
    gap: 2px !important;
  }

  /* Histogram Rating Rows (5★, 4★, 3★, 2★, 1★) Horizontal Flex Layout matching Judge.me Preview */
  .jdgm-histogram {
    width: 100% !important;
    max-width: 480px !important;
    margin: 12px auto !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }

  .jdgm-histogram__row {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .jdgm-histogram__star {
    min-width: 45px !important;
    flex: 0 0 45px !important;
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    font-size: 0.9rem !important;
    white-space: nowrap !important;
  }

  .jdgm-histogram__bar {
    flex: 1 1 auto !important;
    height: 8px !important;
    background-color: #e5e7eb !important;
    border-radius: 999px !important;
    position: relative !important;
    overflow: hidden !important;
    min-width: 60px !important;
    margin: 0 4px !important;
  }

  .jdgm-histogram__bar-content,
  .jdgm-rev-widg__summary-bar-fill {
    background-color: var(--jdgm-bar-fill, #1B4317) !important;
    height: 100% !important;
    border-radius: 999px !important;
  }

  .jdgm-histogram__count,
  .jdgm-histogram__percentage {
    min-width: 25px !important;
    flex: 0 0 25px !important;
    text-align: right !important;
    font-size: 0.85rem !important;
    color: #6b7280 !important;
  }

  /* Write a Review Button Fix */
  .jdgm-write-rev-btn,
  .jdgm-all-reviews-rating-actions__write-btn {
    white-space: nowrap !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: auto !important;
    min-width: 140px !important;
    padding: 10px 22px !important;
    margin: 8px auto !important;
    text-align: center !important;
  }

  /* Filter & Sort Dropdowns Layout */
  .jdgm-rev-widg__sub-wrap,
  .jdgm-sub-wrap,
  .jdgm-sort-dropdown,
  .jdgm-filter-dropdown {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
  }
</style>

<section class="product-reviews" id="ProductReviews-{{ section.id }}" aria-label="Customer Reviews">
  <div class="product-reviews__container">
    {% if heading != blank %}
      <h2 class="product-reviews__main-title" style="text-align: center; font-size: 1.85rem; font-weight: 800; margin-bottom: 1.25rem; color: #111827;">{{ heading }}</h2>
    {% endif %}

    <!-- Live Judge.me App Review Widget -->
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</section>
