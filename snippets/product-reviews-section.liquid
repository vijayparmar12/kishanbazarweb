{% doc %}
  Renders Rosier Foods style Product Reviews section.
  Features:
  - Rating Breakdown Bars (5★ to 1★ with vote counts)
  - Customer Photo Thumbnail Carousel / Grid
  - Big "Write a review" Button
  - "Customers say" AI Summary Box
  - Review Filter Dropdown (Pictures first, Most recent, Highest rating)
  - Detailed Review Cards with Verified Pill Badges, Photos, and Product Badges
  - Pagination Bar (< 1 2 3 4 ... 119 >)
  - Interactive Write a Review Modal Form with Photo Upload

  @param {object} product - The Shopify product object

  @example
  {% render 'product-reviews-section', product: product %}
{% enddoc %}

<section class="product-reviews" id="ProductReviews-{{ section.id }}" aria-label="Customer Reviews">
  <div class="product-reviews__container">
    <!-- Judge.me Dynamic App Integration (If Installed) -->
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>

    <!-- Section Title (Rosier Foods Centered Header) -->
    <h2 class="product-reviews__main-title">Product Reviews</h2>

    <!-- Summary Dashboard (Score + Breakdown Bars) -->
    <div class="product-reviews__summary-header">
      <div class="product-reviews__score-row">
        <span class="product-reviews__big-score">4.7</span>
        <span class="product-reviews__count-label">592 reviews</span>
      </div>

      <!-- Rating Distribution Bars (Rosier Foods Flow) -->
      <div class="product-reviews__rating-bars">
        <div class="product-reviews__bar-line">
          <span class="product-reviews__star-num">5 &#9733;</span>
          <div class="product-reviews__track"><div class="product-reviews__fill" style="width: 74%;"></div></div>
          <span class="product-reviews__vote-count">440</span>
        </div>
        <div class="product-reviews__bar-line">
          <span class="product-reviews__star-num">4 &#9733;</span>
          <div class="product-reviews__track"><div class="product-reviews__fill" style="width: 25%;"></div></div>
          <span class="product-reviews__vote-count">149</span>
        </div>
        <div class="product-reviews__bar-line">
          <span class="product-reviews__star-num">3 &#9733;</span>
          <div class="product-reviews__track"><div class="product-reviews__fill" style="width: 1%;"></div></div>
          <span class="product-reviews__vote-count">3</span>
        </div>
        <div class="product-reviews__bar-line">
          <span class="product-reviews__star-num">2 &#9733;</span>
          <div class="product-reviews__track"><div class="product-reviews__fill" style="width: 0%;"></div></div>
          <span class="product-reviews__vote-count">0</span>
        </div>
        <div class="product-reviews__bar-line">
          <span class="product-reviews__star-num">1 &#9733;</span>
          <div class="product-reviews__track"><div class="product-reviews__fill" style="width: 0%;"></div></div>
          <span class="product-reviews__vote-count">0</span>
        </div>
      </div>
    </div>

    <!-- Customer Photos Preview Grid (Horizontal Scrollable Thumbnails) -->
    <div class="product-reviews__photos-gallery">
      <div class="product-reviews__photos-scroll">
        <img src="{{ product.featured_image | image_url: width: 240, height: 240 }}" alt="Customer photo 1" class="product-reviews__photo-thumb" loading="lazy">
        <img src="{{ product.images[1] | default: product.featured_image | image_url: width: 240, height: 240 }}" alt="Customer photo 2" class="product-reviews__photo-thumb" loading="lazy">
        <img src="{{ product.images[2] | default: product.featured_image | image_url: width: 240, height: 240 }}" alt="Customer photo 3" class="product-reviews__photo-thumb" loading="lazy">
        <img src="{{ product.images[3] | default: product.featured_image | image_url: width: 240, height: 240 }}" alt="Customer photo 4" class="product-reviews__photo-thumb" loading="lazy">
      </div>
    </div>

    <!-- Big Action Button: Write a review -->
    <div class="product-reviews__action-wrap">
      <button type="button" class="product-reviews__write-btn-full" data-review-modal-trigger>
        Write a review
      </button>
    </div>

    <!-- "Customers say" AI Summary Box (Rosier Foods Card) -->
    <div class="product-reviews__ai-summary">
      <h3 class="product-reviews__ai-heading">Customers say</h3>
      <p class="product-reviews__ai-text">
        Customers praised this product for authentic, natural taste and purity. Many mentioned premium quality justified the cost. <em>"Best product I've ever taste,"</em> one said.
      </p>
      <span class="product-reviews__ai-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
        AI-powered review summary based on recent customer reviews
      </span>
    </div>

    <!-- Filter Dropdown Bar -->
    <div class="product-reviews__filter-bar">
      <div class="product-reviews__filter-dropdown">
        <svg class="filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
        </svg>
        <select class="product-reviews__select" data-reviews-sort>
          <option value="pictures_first" selected>Pictures first</option>
          <option value="most_recent">Most recent</option>
          <option value="highest_rating">Highest rating</option>
          <option value="lowest_rating">Lowest rating</option>
        </select>
        <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <!-- Reviews Cards List -->
    <div class="product-reviews__cards-list" data-reviews-list>
      <!-- Review 1 -->
      <article class="product-reviews__card">
        <div class="product-reviews__card-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="product-reviews__card-author-row">
          <span class="product-reviews__author-initial">M</span>
          <strong class="product-reviews__author-title">Manish Prajapati</strong>
          <span class="product-reviews__verified-badge">Verified</span>
        </div>
        <div class="product-reviews__card-date">07/27/2026</div>
        <h4 class="product-reviews__card-headline">100% pure Good quality Must</h4>
        <p class="product-reviews__card-body">
          100% pure Good quality Must recommendation. Extremely fresh, authentic aroma and taste. Highly recommended!
        </p>
        <div class="product-reviews__card-photo">
          <img src="{{ product.featured_image | image_url: width: 300, height: 300 }}" alt="Review photo 1" loading="lazy">
        </div>
      </article>

      <!-- Review 2 -->
      <article class="product-reviews__card">
        <div class="product-reviews__card-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="product-reviews__card-author-row">
          <span class="product-reviews__author-initial">A</span>
          <strong class="product-reviews__author-title">Anonymous</strong>
          <span class="product-reviews__verified-badge">Verified</span>
        </div>
        <div class="product-reviews__card-date">07/21/2026</div>
        <h4 class="product-reviews__card-headline">Good taste and quality</h4>
        <p class="product-reviews__card-body">
          Good taste and quality. Freshly packaged and fast delivery across India.
        </p>
        <div class="product-reviews__card-photo">
          <img src="{{ product.images[1] | default: product.featured_image | image_url: width: 300, height: 300 }}" alt="Review photo 2" loading="lazy">
        </div>
      </article>

      <!-- Review 3 -->
      <article class="product-reviews__card">
        <div class="product-reviews__card-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <div class="product-reviews__card-author-row">
          <span class="product-reviews__author-initial">B</span>
          <strong class="product-reviews__author-title">Bhavnamavotra</strong>
          <span class="product-reviews__verified-badge">Verified</span>
        </div>
        <div class="product-reviews__card-date">04/05/2026</div>
        <h4 class="product-reviews__card-headline">Boht rich quality taste hai so yummy mene pehle</h4>
        <p class="product-reviews__card-body">
          Boht rich quality taste hai so yummy mene pehle ek order kiya tha isliye isbaar 2 bottle order ki and every time same taste I really like it.
        </p>
        <div class="product-reviews__card-photo">
          <img src="{{ product.images[2] | default: product.featured_image | image_url: width: 300, height: 300 }}" alt="Review photo 3" loading="lazy">
        </div>

        <!-- Product Attached Thumbnail Card -->
        <div class="product-reviews__product-ref">
          <img src="{{ product.featured_image | image_url: width: 80, height: 80 }}" alt="{{ product.title }}" class="product-reviews__ref-img">
          <div class="product-reviews__ref-info">
            <span class="product-reviews__ref-label">Review for</span>
            <span class="product-reviews__ref-title">{{ product.title }}</span>
          </div>
        </div>
      </article>
    </div>

    <!-- Pagination Controls (< 1 2 3 4 ... 119 >) -->
    <nav class="product-reviews__pagination" aria-label="Reviews Pagination">
      <button type="button" class="product-reviews__page-nav product-reviews__page-nav--prev" aria-label="Previous Page">&lt;</button>
      <span class="product-reviews__page-num is-active">1</span>
      <span class="product-reviews__page-num">2</span>
      <span class="product-reviews__page-num">3</span>
      <span class="product-reviews__page-num">4</span>
      <span class="product-reviews__page-dots">...</span>
      <span class="product-reviews__page-num">119</span>
      <button type="button" class="product-reviews__page-nav product-reviews__page-nav--next" aria-label="Next Page">&gt;</button>
    </nav>

    <!-- Write Review Modal Form -->
    <div class="product-reviews__modal" data-review-modal aria-hidden="true">
      <div class="product-reviews__modal-overlay" data-review-modal-close></div>
      <div class="product-reviews__modal-dialog">
        <button type="button" class="product-reviews__modal-close-btn" data-review-modal-close aria-label="Close modal">&times;</button>
        <h3 class="product-reviews__modal-title">Write a Review for {{ product.title }}</h3>
        
        <form class="product-reviews__form" data-review-form>
          <div class="product-reviews__form-group">
            <label class="product-reviews__label">Your Rating:</label>
            <div class="product-reviews__star-input-group" data-star-picker>
              <input type="hidden" name="rating" value="5" data-star-rating-val>
              <span class="star-picker-icon is-selected" data-star-num="1">&#9733;</span>
              <span class="star-picker-icon is-selected" data-star-num="2">&#9733;</span>
              <span class="star-picker-icon is-selected" data-star-num="3">&#9733;</span>
              <span class="star-picker-icon is-selected" data-star-num="4">&#9733;</span>
              <span class="star-picker-icon is-selected" data-star-num="5">&#9733;</span>
            </div>
          </div>

          <div class="product-reviews__form-grid">
            <div class="product-reviews__form-group">
              <label for="ReviewAuthorName" class="product-reviews__label">Your Name *</label>
              <input type="text" id="ReviewAuthorName" name="name" required placeholder="e.g. Ramesh Shah" class="product-reviews__input">
            </div>
            <div class="product-reviews__form-group">
              <label for="ReviewAuthorEmail" class="product-reviews__label">Email Address *</label>
              <input type="email" id="ReviewAuthorEmail" name="email" required placeholder="e.g. ramesh@example.com" class="product-reviews__input">
            </div>
          </div>

          <div class="product-reviews__form-group">
            <label for="ReviewTitle" class="product-reviews__label">Review Headline *</label>
            <input type="text" id="ReviewTitle" name="title" required placeholder="Summarize your experience..." class="product-reviews__input">
          </div>

          <div class="product-reviews__form-group">
            <label for="ReviewBody" class="product-reviews__label">Detailed Review *</label>
            <textarea id="ReviewBody" name="body" rows="4" required placeholder="Share details about flavor, texture, packing, delivery..." class="product-reviews__textarea"></textarea>
          </div>

          <!-- Photo Upload Box -->
          <div class="product-reviews__form-group">
            <label class="product-reviews__label">Attach Photos (Optional):</label>
            <div class="product-reviews__image-upload-box" data-image-upload-dropzone>
              <input type="file" id="ReviewImages" name="review_images" accept="image/*" multiple class="product-reviews__file-input" data-review-file-input>
              <label for="ReviewImages" class="product-reviews__image-upload-label">
                <span class="product-reviews__upload-icon" aria-hidden="true">📷</span>
                <span class="product-reviews__upload-text"><strong>Click to upload photos</strong> or drag and drop</span>
                <span class="product-reviews__upload-subtext">PNG, JPG or WEBP (Max 5 photos)</span>
              </label>
              <div class="product-reviews__image-preview-grid" data-image-preview-grid></div>
            </div>
          </div>

          <button type="submit" class="product-reviews__submit-btn">Submit Review</button>
          <p class="product-reviews__success-msg" data-review-success style="display: none;">
            Thank you! Your review has been submitted successfully.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
