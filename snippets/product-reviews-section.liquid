{% doc %}
  Renders the Judge.me review widget for KishanVeda / Kishan Bazar.
{% enddoc %}

{% liquid
  assign heading = section.settings.reviews_heading | default: "Customer Reviews"
%}

<section class="product-reviews" id="ProductReviews-{{ section.id }}" aria-label="Customer Reviews">
  <div class="product-reviews__container product-reviews-box-card">
    {% if heading != blank %}
      <h2 class="product-reviews__main-title">{{ heading }}</h2>
    {% endif %}

    <!-- Live Judge.me App Review Widget -->
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</section>
