{% doc %}
  Renders the live Judge.me Reviews plugin widget for KishanVeda / Kishan Bazar.
  Static manual review fallback removed as requested.
  Deduplication script included to ensure ONLY 1 review widget renders on the page.

  @param {object} product - The Shopify product object

  @example
  {% render 'product-reviews-section', product: product %}
{% enddoc %}

<section class="product-reviews" id="ProductReviews-{{ section.id }}" aria-label="Customer Reviews">
  <div class="product-reviews__container">
    <!-- Live Judge.me App Review Widget -->
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</section>

<script>
  (function() {
    function cleanupDuplicateWidgets() {
      const reviewWidgets = document.querySelectorAll('.jdgm-review-widget, .jdgm-rev-widg');
      if (reviewWidgets.length > 1) {
        for (let i = 1; i < reviewWidgets.length; i++) {
          reviewWidgets[i].style.display = 'none';
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', cleanupDuplicateWidgets);
    } else {
      cleanupDuplicateWidgets();
    }
    window.addEventListener('load', cleanupDuplicateWidgets);
    setTimeout(cleanupDuplicateWidgets, 1200);
  })();
</script>
