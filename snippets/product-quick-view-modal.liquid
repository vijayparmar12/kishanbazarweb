{% doc %}
  Renders the global Product Quick View drawer modal (Rosier Foods style UI).
{% enddoc %}

<div class="kb-quick-view-modal" id="KbQuickViewModal" hidden data-quick-view-modal aria-label="Product Quick View">
  <div class="kb-quick-view__backdrop" data-quick-view-close></div>
  
  <div class="kb-quick-view__card" role="dialog" aria-modal="true">
    <!-- Close Button Top Right -->
    <button type="button" class="kb-quick-view__close" aria-label="Close" data-quick-view-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="kb-quick-view__content">
      <!-- Media / Image Box -->
      <div class="kb-quick-view__media-box">
        <img src="" alt="" class="kb-quick-view__image" data-qv-image loading="lazy">
      </div>

      <!-- Title & Price -->
      <div class="kb-quick-view__info-head">
        <h3 class="kb-quick-view__title" data-qv-title>Product Title</h3>
        <div class="kb-quick-view__price-row">
          <span class="kb-quick-view__price" data-qv-price>₹0</span>
          <s class="kb-quick-view__compare-price" data-qv-compare style="display: none;">₹0</s>
        </div>
      </div>

      <!-- Option Selectors (Variant Size Dropdown) -->
      <div class="kb-quick-view__options-wrap" data-qv-options>
        <div class="kb-quick-view__field">
          <label class="kb-quick-view__label" data-qv-option-label>Size</label>
          <select class="kb-quick-view__select" data-qv-variant-select></select>
        </div>
      </div>

      <!-- Description Summary -->
      <div class="kb-quick-view__desc-wrap">
        <div class="kb-quick-view__desc" data-qv-desc></div>
      </div>
    </div>

    <!-- Action Row (Quantity Stepper & Proceed Button matching Image 1) -->
    <div class="kb-quick-view__footer" style="padding: 0.85rem 1.25rem 1.25rem; display: flex; align-items: center; gap: 12px; border-top: 1px solid #f1f5f9; background: #ffffff;">
      <div class="kb-quick-view__qty-pill" style="display: flex; align-items: center; justify-content: space-between; border: 1.5px solid #23421f; border-radius: 10px; height: 48px; padding: 0 12px; width: 105px; flex-shrink: 0;">
        <button type="button" class="kb-quick-view__qty-btn" data-qv-qty-minus aria-label="Decrease quantity" style="border: none; background: transparent; font-size: 1.2rem; font-weight: 800; cursor: pointer; color: #23421f;">-</button>
        <span class="kb-quick-view__qty-count" data-qv-qty-count style="font-weight: 800; font-size: 1rem; color: #23421f;">1</span>
        <button type="button" class="kb-quick-view__qty-btn" data-qv-qty-plus aria-label="Increase quantity" style="border: none; background: transparent; font-size: 1.2rem; font-weight: 800; cursor: pointer; color: #23421f;">+</button>
      </div>
      <button type="button" class="kb-quick-view__submit-btn" data-qv-add-btn style="flex: 1; height: 48px; background: #23421f; color: #ffffff; border: none; border-radius: 10px; font-weight: 800; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
        ADD TO CART
      </button>
    </div>
  </div>
</div>
