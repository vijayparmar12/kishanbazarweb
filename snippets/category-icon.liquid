{% doc %}
  Renders a consistent category icon dynamically from Shopify collections site-wide.

  @param {collection|string} category - Collection object or handle/title string.
  @param {image} [custom_image] - Optional custom image override.
  @param {number} [size] - Icon size in px (default: 68).
  @param {string} [class] - Extra CSS classes.

  @example
  {% render 'category-icon', category: 'ghee', size: 68 %}
{% enddoc %}

{% liquid
  assign icon_size = size | default: 68
  assign img_width = icon_size | times: 2

  assign cat_str = ''
  if category.title != blank
    assign cat_str = category.title | downcase
  elsif category.handle != blank
    assign cat_str = category.handle | downcase
  else
    assign cat_str = category | append: '' | downcase
  endif

  assign category_img = nil
  if custom_image != blank
    assign category_img = custom_image
  elsif category != blank and category.image != blank
    assign category_img = category.image
  elsif category != blank and category.products != blank and category.products.first != blank and category.products.first.featured_image != blank
    assign category_img = category.products.first.featured_image
  endif
%}

<span class="kb-category-icon-wrapper {{ class }}" style="width: {{ icon_size }}px; height: {{ icon_size }}px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; vertical-align: middle;" aria-hidden="true">
  {% if category_img != blank %}
    {{
      category_img
      | image_url: width: img_width
      | image_tag:
        class: 'kb-category-icon-img',
        style: 'width: 100%; height: 100%; object-fit: contain; display: block;',
        width: icon_size,
        height: icon_size,
        loading: 'eager',
        alt: 'Category Icon'
    }}
  {% elsif cat_str contains 'ghee' %}
    <img src="{{ 'ghee.png' | asset_url }}" alt="Ghee" class="kb-category-icon-img" width="{{ icon_size }}" height="{{ icon_size }}" style="width: 100%; height: 100%; object-fit: contain; display: block;" loading="eager">
  {% elsif cat_str contains 'atta' or cat_str contains 'flour' %}
    <img src="{{ 'atta.png' | asset_url }}" alt="Atta" class="kb-category-icon-img" width="{{ icon_size }}" height="{{ icon_size }}" style="width: 100%; height: 100%; object-fit: contain; display: block;" loading="eager">
  {% else %}
    <span class="kb-category-icon-svg" style="display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--kb-accent, #23421f);">
      <svg viewBox="0 0 24 24" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 7v10M7 12h10"/>
      </svg>
    </span>
  {% endif %}
</span>
