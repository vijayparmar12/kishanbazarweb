{% doc %}
  Renders 4 feature badge icons dynamically from Shopify CSV / Metafields or Default CDN files.

  @param {object} [product] - The Shopify product object

  @example
  {% render 'product-circle-features', product: product %}
{% enddoc %}

{% liquid
  assign custom_meta = product.metafields.custom
  assign badge_img_1 = custom_meta.badge_image_1.value | default: custom_meta.badge_image_1 | default: custom_meta.feature_icon_1
  assign badge_img_2 = custom_meta.badge_image_2.value | default: custom_meta.badge_image_2 | default: custom_meta.feature_icon_2
  assign badge_img_3 = custom_meta.badge_image_3.value | default: custom_meta.badge_image_3 | default: custom_meta.feature_icon_3
  assign badge_img_4 = custom_meta.badge_image_4.value | default: custom_meta.badge_image_4 | default: custom_meta.feature_icon_4
%}

<div class="product-circle-features" aria-label="Product Key Benefits">
  <div class="product-circle-features__grid">
    {% comment %} 1. Metafield Uploaded Images (URL string or file_reference) {% endcomment %}
    {% if badge_img_1 != blank or badge_img_2 != blank or badge_img_3 != blank or badge_img_4 != blank %}
      {% if badge_img_1 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% if badge_img_1.src or badge_img_1.cloudinary_src or badge_img_1.aspect_ratio %}
              {{ badge_img_1 | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title | escape }}
            {% else %}
              <img src="{{ badge_img_1 }}" alt="Feature Badge 1" loading="lazy" width="120" height="120">
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if badge_img_2 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% if badge_img_2.src or badge_img_2.cloudinary_src or badge_img_2.aspect_ratio %}
              {{ badge_img_2 | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title | escape }}
            {% else %}
              <img src="{{ badge_img_2 }}" alt="Feature Badge 2" loading="lazy" width="120" height="120">
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if badge_img_3 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% if badge_img_3.src or badge_img_3.cloudinary_src or badge_img_3.aspect_ratio %}
              {{ badge_img_3 | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title | escape }}
            {% else %}
              <img src="{{ badge_img_3 }}" alt="Feature Badge 3" loading="lazy" width="120" height="120">
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if badge_img_4 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            {% if badge_img_4.src or badge_img_4.cloudinary_src or badge_img_4.aspect_ratio %}
              {{ badge_img_4 | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title | escape }}
            {% else %}
              <img src="{{ badge_img_4 }}" alt="Feature Badge 4" loading="lazy" width="120" height="120">
            {% endif %}
          </div>
        </div>
      {% endif %}

    {% comment %} 2. Default Uploaded Shopify CDN Icon Images {% endcomment %}
    {% else %}
      <div class="product-circle-features__item">
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="https://cdn.shopify.com/s/files/1/1011/5832/2485/files/secure_payments.png?v=1785927371" alt="Organic - 100% Organic" loading="lazy" width="120" height="120">
        </div>
      </div>

      <div class="product-circle-features__item">
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="https://cdn.shopify.com/s/files/1/1011/5832/2485/files/free_shipping.png?v=1785927371" alt="Farm Fresh - Direct from Farm" loading="lazy" width="120" height="120">
        </div>
      </div>

      <div class="product-circle-features__item">
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="https://cdn.shopify.com/s/files/1/1011/5832/2485/files/icon2.png?v=1785927371" alt="Lab Tested - Quality Tested" loading="lazy" width="120" height="120">
        </div>
      </div>

      <div class="product-circle-features__item">
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="https://cdn.shopify.com/s/files/1/1011/5832/2485/files/icon3.png?v=1785927371" alt="Chemical Free - No Chemicals" loading="lazy" width="120" height="120">
        </div>
      </div>
    {% endif %}
  </div>
</div>
