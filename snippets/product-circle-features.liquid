{% doc %}
  Renders feature badge icons dynamically purely from Shopify CSV / Product Metafields.
  Metafield keys supported:
  - product.metafields.custom.badge_image_1
  - product.metafields.custom.badge_image_2
  - product.metafields.custom.badge_image_3
  - product.metafields.custom.badge_image_4

  @param {object} [product] - The Shopify product object

  @example
  {% render 'product-circle-features', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  # Image 1 (Theme Setting / Block Setting override -> Metafield)
  assign img_url_1 = blank
  if benefit_image_1 != blank
    assign img_url_1 = benefit_image_1 | image_url: width: 300
  elsif block.settings.benefit_image_1 != blank
    assign img_url_1 = block.settings.benefit_image_1 | image_url: width: 300
  elsif section.settings.benefit_image_1 != blank
    assign img_url_1 = section.settings.benefit_image_1 | image_url: width: 300
  else
    assign item_1 = c_meta.badge_image_1.value | default: c_meta.badge_image_1 | default: c_meta.Badge_image_1.value | default: c_meta.Badge_image_1 | default: c_meta.feature_icon_1.value | default: c_meta.feature_icon_1
    if item_1 != blank
      if item_1.preview_image != blank
        assign img_url_1 = item_1.preview_image | image_url: width: 300
      elsif item_1.cloudinary_src != blank
        assign img_url_1 = item_1.cloudinary_src
      elsif item_1.src != blank
        assign img_url_1 = item_1.src | image_url: width: 300
      elsif item_1.width != blank or item_1.aspect_ratio != blank
        assign img_url_1 = item_1 | image_url: width: 300
      else
        assign img_url_1 = item_1 | file_url
      endif
    endif
  endif

  # Image 2
  assign img_url_2 = blank
  if benefit_image_2 != blank
    assign img_url_2 = benefit_image_2 | image_url: width: 300
  elsif block.settings.benefit_image_2 != blank
    assign img_url_2 = block.settings.benefit_image_2 | image_url: width: 300
  elsif section.settings.benefit_image_2 != blank
    assign img_url_2 = section.settings.benefit_image_2 | image_url: width: 300
  else
    assign item_2 = c_meta.badge_image_2.value | default: c_meta.badge_image_2 | default: c_meta.Badge_image_2.value | default: c_meta.Badge_image_2 | default: c_meta.feature_icon_2.value | default: c_meta.feature_icon_2
    if item_2 != blank
      if item_2.preview_image != blank
        assign img_url_2 = item_2.preview_image | image_url: width: 300
      elsif item_2.cloudinary_src != blank
        assign img_url_2 = item_2.cloudinary_src
      elsif item_2.src != blank
        assign img_url_2 = item_2.src | image_url: width: 300
      elsif item_2.width != blank or item_2.aspect_ratio != blank
        assign img_url_2 = item_2 | image_url: width: 300
      else
        assign img_url_2 = item_2 | file_url
      endif
    endif
  endif

  # Image 3
  assign img_url_3 = blank
  if benefit_image_3 != blank
    assign img_url_3 = benefit_image_3 | image_url: width: 300
  elsif block.settings.benefit_image_3 != blank
    assign img_url_3 = block.settings.benefit_image_3 | image_url: width: 300
  elsif section.settings.benefit_image_3 != blank
    assign img_url_3 = section.settings.benefit_image_3 | image_url: width: 300
  else
    assign item_3 = c_meta.badge_image_3.value | default: c_meta.badge_image_3 | default: c_meta.Badge_image_3.value | default: c_meta.Badge_image_3 | default: c_meta.feature_icon_3.value | default: c_meta.feature_icon_3
    if item_3 != blank
      if item_3.preview_image != blank
        assign img_url_3 = item_3.preview_image | image_url: width: 300
      elsif item_3.cloudinary_src != blank
        assign img_url_3 = item_3.cloudinary_src
      elsif item_3.src != blank
        assign img_url_3 = item_3.src | image_url: width: 300
      elsif item_3.width != blank or item_3.aspect_ratio != blank
        assign img_url_3 = item_3 | image_url: width: 300
      else
        assign img_url_3 = item_3 | file_url
      endif
    endif
  endif

  # Image 4
  assign img_url_4 = blank
  if benefit_image_4 != blank
    assign img_url_4 = benefit_image_4 | image_url: width: 300
  elsif block.settings.benefit_image_4 != blank
    assign img_url_4 = block.settings.benefit_image_4 | image_url: width: 300
  elsif section.settings.benefit_image_4 != blank
    assign img_url_4 = section.settings.benefit_image_4 | image_url: width: 300
  else
    assign item_4 = c_meta.badge_image_4.value | default: c_meta.badge_image_4 | default: c_meta.Badge_image_4.value | default: c_meta.Badge_image_4 | default: c_meta.feature_icon_4.value | default: c_meta.feature_icon_4
    if item_4 != blank
      if item_4.preview_image != blank
        assign img_url_4 = item_4.preview_image | image_url: width: 300
      elsif item_4.cloudinary_src != blank
        assign img_url_4 = item_4.cloudinary_src
      elsif item_4.src != blank
        assign img_url_4 = item_4.src | image_url: width: 300
      elsif item_4.width != blank or item_4.aspect_ratio != blank
        assign img_url_4 = item_4 | image_url: width: 300
      else
        assign img_url_4 = item_4 | file_url
      endif
    endif
  endif

  assign show_default_icons = false
  if img_url_1 == blank and img_url_2 == blank and img_url_3 == blank and img_url_4 == blank
    assign show_default_icons = true
    assign total_badges = 4
  else
    assign total_badges = 0
    if img_url_1 != blank
      assign total_badges = total_badges | plus: 1
    endif
    if img_url_2 != blank
      assign total_badges = total_badges | plus: 1
    endif
    if img_url_3 != blank
      assign total_badges = total_badges | plus: 1
    endif
    if img_url_4 != blank
      assign total_badges = total_badges | plus: 1
    endif
  endif
%}

{% if total_badges > 0 %}
  <div class="product-circle-features" aria-label="Product Key Benefits">
    <div class="product-circle-features__grid" style="grid-template-columns: repeat({{ total_badges }}, 1fr);">
      {% if show_default_icons %}
        <!-- Default Organic Feature Badges (Always Visible by Default) -->
        <div class="product-circle-features__item" title="Cold Pressed">
          <div class="product-circle-features__circle product-circle-features__circle--icon" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.15); border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #23421f;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
        </div>
        <div class="product-circle-features__item" title="100% Pure & Natural">
          <div class="product-circle-features__circle product-circle-features__circle--icon" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.15); border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #23421f;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
        </div>
        <div class="product-circle-features__item" title="No Chemical Additives">
          <div class="product-circle-features__circle product-circle-features__circle--icon" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.15); border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #23421f;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          </div>
        </div>
        <div class="product-circle-features__item" title="Farm Fresh Staples">
          <div class="product-circle-features__circle product-circle-features__circle--icon" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.15); border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #23421f;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/><line x1="12" y1="16" x2="12" y2="21"/></svg>
          </div>
        </div>
      {% else %}
        {% if img_url_1 != blank %}
          <div class="product-circle-features__item">
            <div class="product-circle-features__circle product-circle-features__circle--img">
              <img src="{{ img_url_1 }}" alt="{{ product.title | escape }} Benefit 1" loading="lazy" width="85" height="85">
            </div>
          </div>
        {% endif %}

        {% if img_url_2 != blank %}
          <div class="product-circle-features__item">
            <div class="product-circle-features__circle product-circle-features__circle--img">
              <img src="{{ img_url_2 }}" alt="{{ product.title | escape }} Benefit 2" loading="lazy" width="85" height="85">
            </div>
          </div>
        {% endif %}

        {% if img_url_3 != blank %}
          <div class="product-circle-features__item">
            <div class="product-circle-features__circle product-circle-features__circle--img">
              <img src="{{ img_url_3 }}" alt="{{ product.title | escape }} Benefit 3" loading="lazy" width="85" height="85">
            </div>
          </div>
        {% endif %}

        {% if img_url_4 != blank %}
          <div class="product-circle-features__item">
            <div class="product-circle-features__circle product-circle-features__circle--img">
              <img src="{{ img_url_4 }}" alt="{{ product.title | escape }} Benefit 4" loading="lazy" width="85" height="85">
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endif %}
