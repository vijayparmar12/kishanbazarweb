{% doc %}
  Renders feature badge icons dynamically purely from Shopify CSV / Product Metafields.
  Metafield keys supported:
  - product.metafields.custom.badge_image_1
  - product.metafields.custom.badge_image_2
  - product.metafields.custom.badge_image_3
  - product.metafields.custom.badge_image_4

  @param {object} [product] - The Shopify product object

  @example
  {% render 'product-circle-features', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  assign raw_1 = c_meta.badge_image_1.value | default: c_meta.badge_image_1 | default: c_meta.Badge_image_1.value | default: c_meta.Badge_image_1 | default: c_meta.feature_icon_1.value | default: c_meta.feature_icon_1
  assign img_url_1 = blank
  if raw_1 != blank
    if raw_1.src != blank
      assign img_url_1 = raw_1 | image_url: width: 600
    else
      assign img_url_1 = raw_1
    endif
  endif

  assign raw_2 = c_meta.badge_image_2.value | default: c_meta.badge_image_2 | default: c_meta.Badge_image_2.value | default: c_meta.Badge_image_2 | default: c_meta.feature_icon_2.value | default: c_meta.feature_icon_2
  assign img_url_2 = blank
  if raw_2 != blank
    if raw_2.src != blank
      assign img_url_2 = raw_2 | image_url: width: 600
    else
      assign img_url_2 = raw_2
    endif
  endif

  assign raw_3 = c_meta.badge_image_3.value | default: c_meta.badge_image_3 | default: c_meta.Badge_image_3.value | default: c_meta.Badge_image_3 | default: c_meta.feature_icon_3.value | default: c_meta.feature_icon_3
  assign img_url_3 = blank
  if raw_3 != blank
    if raw_3.src != blank
      assign img_url_3 = raw_3 | image_url: width: 600
    else
      assign img_url_3 = raw_3
    endif
  endif

  assign raw_4 = c_meta.badge_image_4.value | default: c_meta.badge_image_4 | default: c_meta.Badge_image_4.value | default: c_meta.Badge_image_4 | default: c_meta.feature_icon_4.value | default: c_meta.feature_icon_4
  assign img_url_4 = blank
  if raw_4 != blank
    if raw_4.src != blank
      assign img_url_4 = raw_4 | image_url: width: 600
    else
      assign img_url_4 = raw_4
    endif
  endif

  assign total_badges = 0
  if img_url_1 != blank
    assign total_badges = total_badges | plus: 1
  endif
  if img_url_2 != blank
    assign total_badges = total_badges | plus: 1
  endif
  if img_url_3 != blank
    assign total_badges = total_badges | plus: 1
  endif
  if img_url_4 != blank
    assign total_badges = total_badges | plus: 1
  endif
%}

{% if total_badges > 0 %}
  <div class="product-circle-features" aria-label="Product Key Benefits">
    <div class="product-circle-features__grid" style="grid-template-columns: repeat({{ total_badges }}, 1fr);">
      {% if img_url_1 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            <img src="{{ img_url_1 }}" alt="{{ product.title | escape }} Benefit 1" loading="lazy" width="85" height="85">
          </div>
        </div>
      {% endif %}

      {% if img_url_2 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            <img src="{{ img_url_2 }}" alt="{{ product.title | escape }} Benefit 2" loading="lazy" width="85" height="85">
          </div>
        </div>
      {% endif %}

      {% if img_url_3 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            <img src="{{ img_url_3 }}" alt="{{ product.title | escape }} Benefit 3" loading="lazy" width="85" height="85">
          </div>
        </div>
      {% endif %}

      {% if img_url_4 != blank %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img">
            <img src="{{ img_url_4 }}" alt="{{ product.title | escape }} Benefit 4" loading="lazy" width="85" height="85">
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
