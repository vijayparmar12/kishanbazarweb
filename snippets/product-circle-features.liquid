{% doc %}
  Renders feature badge icons dynamically purely from Shopify CSV / Product Metafields.
  Metafield keys supported:
  - product.metafields.custom.badge_image_1
  - product.metafields.custom.badge_image_2
  - product.metafields.custom.badge_image_3
  - product.metafields.custom.badge_image_4

  @param {object} [product] - The Shopify product object

  @example
  {% render 'product-circle-features', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  # Image 1 (Theme Setting / Block Setting override -> Metafield)
  assign img_url_1 = blank
  if benefit_image_1 != blank
    assign img_url_1 = benefit_image_1 | image_url: width: 300
  elsif block.settings.benefit_image_1 != blank
    assign img_url_1 = block.settings.benefit_image_1 | image_url: width: 300
  elsif section.settings.benefit_image_1 != blank
    assign img_url_1 = section.settings.benefit_image_1 | image_url: width: 300
  elsif c_meta.badge_image_1 != blank
    assign img_url_1 = c_meta.badge_image_1 | image_url: width: 300
  elsif c_meta.feature_icon_1 != blank
    assign img_url_1 = c_meta.feature_icon_1 | image_url: width: 300
  endif

  # Image 2
  assign img_url_2 = blank
  if benefit_image_2 != blank
    assign img_url_2 = benefit_image_2 | image_url: width: 300
  elsif block.settings.benefit_image_2 != blank
    assign img_url_2 = block.settings.benefit_image_2 | image_url: width: 300
  elsif section.settings.benefit_image_2 != blank
    assign img_url_2 = section.settings.benefit_image_2 | image_url: width: 300
  elsif c_meta.badge_image_2 != blank
    assign img_url_2 = c_meta.badge_image_2 | image_url: width: 300
  elsif c_meta.feature_icon_2 != blank
    assign img_url_2 = c_meta.feature_icon_2 | image_url: width: 300
  endif

  # Image 3
  assign img_url_3 = blank
  if benefit_image_3 != blank
    assign img_url_3 = benefit_image_3 | image_url: width: 300
  elsif block.settings.benefit_image_3 != blank
    assign img_url_3 = block.settings.benefit_image_3 | image_url: width: 300
  elsif section.settings.benefit_image_3 != blank
    assign img_url_3 = section.settings.benefit_image_3 | image_url: width: 300
  elsif c_meta.badge_image_3 != blank
    assign img_url_3 = c_meta.badge_image_3 | image_url: width: 300
  elsif c_meta.feature_icon_3 != blank
    assign img_url_3 = c_meta.feature_icon_3 | image_url: width: 300
  endif

  # Image 4
  assign img_url_4 = blank
  if benefit_image_4 != blank
    assign img_url_4 = benefit_image_4 | image_url: width: 300
  elsif block.settings.benefit_image_4 != blank
    assign img_url_4 = block.settings.benefit_image_4 | image_url: width: 300
  elsif section.settings.benefit_image_4 != blank
    assign img_url_4 = section.settings.benefit_image_4 | image_url: width: 300
  elsif c_meta.badge_image_4 != blank
    assign img_url_4 = c_meta.badge_image_4 | image_url: width: 300
  elsif c_meta.feature_icon_4 != blank
    assign img_url_4 = c_meta.feature_icon_4 | image_url: width: 300
  endif
%}

<div class="product-circle-features" aria-label="Product Key Benefits" style="margin: 0.6rem 0; width: 100%;">
  <div class="product-circle-features__grid" style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 0.5rem; width: 100%;">
    
    <!-- Benefit Icon 1 -->
    <div class="product-circle-features__item" title="Cold Pressed / 100% Organic">
      {% if img_url_1 != blank %}
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="{{ img_url_1 }}" alt="Benefit 1" loading="lazy" width="85" height="85">
        </div>
      {% else %}
        <div class="product-circle-features__circle" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.18); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: #23421f;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
      {% endif %}
    </div>

    <!-- Benefit Icon 2 -->
    <div class="product-circle-features__item" title="100% Pure & Natural">
      {% if img_url_2 != blank %}
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="{{ img_url_2 }}" alt="Benefit 2" loading="lazy" width="85" height="85">
        </div>
      {% else %}
        <div class="product-circle-features__circle" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.18); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: #23421f;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
      {% endif %}
    </div>

    <!-- Benefit Icon 3 -->
    <div class="product-circle-features__item" title="No Chemical Additives">
      {% if img_url_3 != blank %}
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="{{ img_url_3 }}" alt="Benefit 3" loading="lazy" width="85" height="85">
        </div>
      {% else %}
        <div class="product-circle-features__circle" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.18); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: #23421f;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
        </div>
      {% endif %}
    </div>

    <!-- Benefit Icon 4 -->
    <div class="product-circle-features__item" title="Farm Fresh Staples">
      {% if img_url_4 != blank %}
        <div class="product-circle-features__circle product-circle-features__circle--img">
          <img src="{{ img_url_4 }}" alt="Benefit 4" loading="lazy" width="85" height="85">
        </div>
      {% else %}
        <div class="product-circle-features__circle" style="background: #F7F5EC; border: 1px solid rgba(35, 66, 31, 0.18); border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; color: #23421f;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"/><line x1="12" y1="16" x2="12" y2="21"/></svg>
        </div>
      {% endif %}
    </div>

  </div>
</div>
