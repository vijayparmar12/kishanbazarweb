{% doc %}
  Renders feature badge icons dynamically purely from Shopify CSV / Product Metafields.
  Metafield keys supported:
  - product.metafields.custom.badge_image_1
  - product.metafields.custom.badge_image_2
  - product.metafields.custom.badge_image_3
  - product.metafields.custom.badge_image_4

  @param {object} [product] - The Shopify product object

  @example
  {% render 'product-circle-features', product: product %}
{% enddoc %}

{% liquid
  assign c_meta = product.metafields.custom

  # Image 1
  assign m_badge_1 = c_meta.badge_image_1.value | default: c_meta.badge_image_1 | default: c_meta.feature_icon_1.value | default: c_meta.feature_icon_1
  assign img_url_1 = blank
  if benefit_image_1 != blank
    assign img_url_1 = benefit_image_1 | image_url: width: 300
  elsif block.settings.benefit_image_1 != blank
    assign img_url_1 = block.settings.benefit_image_1 | image_url: width: 300
  elsif section.settings.benefit_image_1 != blank
    assign img_url_1 = section.settings.benefit_image_1 | image_url: width: 300
  elsif m_badge_1 != blank
    assign img_url_1 = m_badge_1 | image_url: width: 300
  endif

  # Image 2
  assign m_badge_2 = c_meta.badge_image_2.value | default: c_meta.badge_image_2 | default: c_meta.feature_icon_2.value | default: c_meta.feature_icon_2
  assign img_url_2 = blank
  if benefit_image_2 != blank
    assign img_url_2 = benefit_image_2 | image_url: width: 300
  elsif block.settings.benefit_image_2 != blank
    assign img_url_2 = block.settings.benefit_image_2 | image_url: width: 300
  elsif section.settings.benefit_image_2 != blank
    assign img_url_2 = section.settings.benefit_image_2 | image_url: width: 300
  elsif m_badge_2 != blank
    assign img_url_2 = m_badge_2 | image_url: width: 300
  endif

  # Image 3
  assign m_badge_3 = c_meta.badge_image_3.value | default: c_meta.badge_image_3 | default: c_meta.feature_icon_3.value | default: c_meta.feature_icon_3
  assign img_url_3 = blank
  if benefit_image_3 != blank
    assign img_url_3 = benefit_image_3 | image_url: width: 300
  elsif block.settings.benefit_image_3 != blank
    assign img_url_3 = block.settings.benefit_image_3 | image_url: width: 300
  elsif section.settings.benefit_image_3 != blank
    assign img_url_3 = section.settings.benefit_image_3 | image_url: width: 300
  elsif m_badge_3 != blank
    assign img_url_3 = m_badge_3 | image_url: width: 300
  endif

  # Image 4
  assign m_badge_4 = c_meta.badge_image_4.value | default: c_meta.badge_image_4 | default: c_meta.feature_icon_4.value | default: c_meta.feature_icon_4
  assign img_url_4 = blank
  if benefit_image_4 != blank
    assign img_url_4 = benefit_image_4 | image_url: width: 300
  elsif block.settings.benefit_image_4 != blank
    assign img_url_4 = block.settings.benefit_image_4 | image_url: width: 300
  elsif section.settings.benefit_image_4 != blank
    assign img_url_4 = section.settings.benefit_image_4 | image_url: width: 300
  elsif m_badge_4 != blank
    assign img_url_4 = m_badge_4 | image_url: width: 300
  endif
%}
  assign max_icons = limit | default: max_icons | default: block.settings.max_icons | default: 4

  assign uploaded_count = 0
  if img_url_1 != blank
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_2 != blank and max_icons >= 2
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_3 != blank and max_icons >= 3
    assign uploaded_count = uploaded_count | plus: 1
  endif
  if img_url_4 != blank and max_icons >= 4
    assign uploaded_count = uploaded_count | plus: 1
  endif

  assign current_icon_size = block.settings.icon_size | default: section.settings.icon_size | default: icon_size | default: 72
%}

{% if uploaded_count > 0 %}
  <div class="product-circle-features" aria-label="Product Key Benefits" style="margin: 0.6rem 0; width: 100%; --kb-benefit-icon-size: {{ current_icon_size }}px;">
    <div class="product-circle-features__grid" style="display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 0.75rem; width: 100%;">
      
      {% if img_url_1 != blank and max_icons >= 1 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_1 }}" alt="Benefit 1" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_2 != blank and max_icons >= 2 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_2 }}" alt="Benefit 2" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_3 != blank and max_icons >= 3 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_3 }}" alt="Benefit 3" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

      {% if img_url_4 != blank and max_icons >= 4 %}
        <div class="product-circle-features__item">
          <div class="product-circle-features__circle product-circle-features__circle--img" style="width: {{ current_icon_size }}px; height: {{ current_icon_size }}px;">
            <img src="{{ img_url_4 }}" alt="Benefit 4" loading="lazy" width="{{ current_icon_size }}" height="{{ current_icon_size }}" style="width: 100%; height: 100%; object-fit: contain;">
          </div>
        </div>
      {% endif %}

    </div>
  </div>
{% endif %}
