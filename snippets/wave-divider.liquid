{% doc %}
  Renders the white wave divider accent with dark green stroke.
{% enddoc %}
<div class="product-card__wave-divider" aria-hidden="true">
  <svg viewBox="0 0 500 36" preserveAspectRatio="none" fill="none">
    <path d="M0,14 C140,36 360,2 500,14 L500,36 L0,36 Z" fill="#ffffff"/>
    <path d="M0,14 C140,36 360,2 500,14" stroke="#23421f" stroke-width="3" stroke-linecap="round"/>
  </svg>
</div>
