{% doc %}
  Renders the right side product information column powered purely by product CSV data.

  @param {object} product - The Shopify product object
  @param {object} current_variant - The currently selected product variant
  @param {boolean} [sale] - Whether the current variant is on sale

  @example
  {% render 'product-info', product: product, current_variant: current_variant, sale: sale %}
{% enddoc %}

{% liquid
  assign has_separate_rating_block = false
  for b in section.blocks
    if b.type == 'rating' or b.type contains 'judge' or b.type contains 'preview_badge'
      assign has_separate_rating_block = true
      break
    endif
  endfor
  assign rating_already_rendered = false
%}

<div class="product-info" data-product-info>
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          {% if block.type contains 'judge' or block.type contains 'preview_badge' or block.type contains 'rating' %}
            {% unless rating_already_rendered %}
              {% render block %}
              {% assign rating_already_rendered = true %}
            {% endunless %}
          {% else %}
            {% render block %}
          {% endif %}

        {% when 'custom_badge' %}
          <div class="product-info__custom-badge-wrap" {{ block.shopify_attributes }}>
            <span class="product-card__badge" style="background-color: {{ block.settings.badge_bg }}; color: {{ block.settings.badge_color }}; margin-bottom: 0.5rem; display: inline-block;">
              {{ block.settings.badge_text }}
            </span>
          </div>

        {% when 'title' %}
          <div class="product-info__header-block" {{ block.shopify_attributes }}>
            <h1 class="product-info__title">{{ product.title }}</h1>
            {% if block.settings.show_subtitle %}
              <p class="product-info__subtitle">
                {% if product.type != blank %}{{ product.type }}{% else %}Organic Grocery{% endif %}
                {% if product.tags.size > 0 %}
                  &bull; {{ product.tags | join: ' &bull; ' }}
                {% endif %}
              </p>
            {% endif %}
          </div>

        {% when 'rating' %}
          {% unless rating_already_rendered %}
            {% liquid
              assign j_rating = product.metafields.judgeme.rating | default: product.metafields.custom.rating.value | default: product.metafields.custom.rating | default: product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: 4.9
              assign p_rating = j_rating | times: 1.0
              assign j_count = product.metafields.judgeme.review_count | default: product.metafields.custom.review_count.value | default: product.metafields.custom.review_count | default: product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 128
              assign p_reviews_count = j_count
            %}
            <div class="product-info__rating-block" {{ block.shopify_attributes }}>
              <div class="product-info__rating" aria-label="{{ p_rating }} star customer rating" style="display: flex !important; visibility: visible !important; opacity: 1 !important; align-items: center !important; justify-content: flex-start !important; gap: 0.4rem !important; margin-top: 0.35rem !important; margin-bottom: 0.35rem !important; margin-left: 0 !important; margin-right: auto !important; min-height: 24px !important; text-align: left !important;">
                {% if product.metafields.judgeme.badge != blank %}
                  <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" style="display: inline-flex !important; justify-content: flex-start !important; align-items: center !important; margin-left: 0 !important; text-align: left !important;">
                    {{ product.metafields.judgeme.badge }}
                  </div>
                {% else %}
                  <div class="product-info__stars-wrap" style="display: inline-flex !important; align-items: center !important; justify-content: flex-start !important; gap: 0.4rem !important; margin-left: 0 !important; text-align: left !important;">
                    {% render 'rating-stars', product: product, rating: p_rating %}
                    <span class="product-info__rating-score" style="font-weight: 700 !important; font-size: 0.95rem !important; color: #111827 !important; display: inline-block !important;">{{ p_rating | round: 1 }}</span>
                    <a href="#ProductReviews-{{ section.id }}" class="product-info__review-count" style="color: #1b4317 !important; font-size: 0.85rem !important; font-weight: 600 !important; text-decoration: none !important; display: inline-block !important;">({{ p_reviews_count }} reviews)</a>
                  </div>
                {% endif %}
              </div>
            </div>
            {% assign rating_already_rendered = true %}
          {% endunless %}

        {% when 'benefit_icons' %}
          <div class="product-info__benefits-block" {{ block.shopify_attributes }}>
            {% render 'product-circle-features', product: product, block: block, limit: 4 %}
          </div>

        {% when 'price' %}
          <div class="product-info__price-box" {{ block.shopify_attributes }}>
            <div class="product-info__prices">
              <span class="product-info__price-selling" data-product-price-selling>
                {{ current_variant.price | money_without_trailing_zeros }}
              </span>
              {% if sale %}
                <s class="product-info__price-mrp" data-product-price-mrp>
                  {{ current_variant.compare_at_price | money_without_trailing_zeros }}
                </s>
                <span class="product-info__discount-badge" data-product-discount-badge>
                  Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}% OFF
                </span>
              {% else %}
                <s class="product-info__price-mrp" data-product-price-mrp style="display: none;"></s>
                <span class="product-info__discount-badge" data-product-discount-badge style="display: none;"></span>
              {% endif %}
            </div>
            <p class="product-info__tax-note">MRP (Incl. of all taxes)</p>
          </div>

        {% when 'stock_status' %}
          <div class="product-info__availability" data-product-availability-status {{ block.shopify_attributes }}>
            {% if current_variant.available %}
              <span class="product-info__stock-dot is-in-stock"></span>
              <span class="product-info__stock-text">{{ block.settings.stock_text | default: "In Stock • Ready to Dispatch in 24 Hours" }}</span>
            {% else %}
              <span class="product-info__stock-dot is-out-of-stock"></span>
              <span class="product-info__stock-text">Temporarily Sold Out</span>
            {% endif %}
          </div>

        {% when 'variant_picker' %}
          {% if product.variants.size > 0 %}
            <fieldset class="product-info__variants-container" {{ block.shopify_attributes }}>
              <div class="product-info__variant-cards">
                {% for variant in product.variants %}
                  {% assign variant_sale = false %}
                  {% if variant.compare_at_price > variant.price %}
                    {% assign variant_sale = true %}
                    {% assign variant_disc = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
                  {% endif %}
                  {% assign v_custom_badge = variant.metafields.custom.badge.value | default: variant.metafields.custom.badge | default: variant.metafields.custom.custom_badge.value | default: variant.metafields.custom.custom_badge | default: variant.metafields.custom.badge_varient.value | default: variant.metafields.custom.badge_varient | default: variant.metafields.custom.custom_badge_varient.value | default: variant.metafields.custom.custom_badge_varient | default: variant.metafields.custom.badge_variant.value | default: variant.metafields.custom.badge_variant | default: variant.metafields.custom.badge_text.value | default: variant.metafields.custom.badge_text | default: variant.metafields.custom.variant_badge.value | default: variant.metafields.custom.variant_badge %}
                  <label class="product-info__variant-pill {% if variant == current_variant %}is-selected{% endif %}">
                    {% if v_custom_badge != blank %}
                      <span class="product-info__variant-badge">{{ v_custom_badge }}</span>
                    {% endif %}
                    <input
                      type="radio"
                      name="variant_id_option"
                      value="{{ variant.id }}"
                      data-variant-radio
                      data-variant-id="{{ variant.id }}"
                      data-variant-title="{{ variant.title | escape }}"
                      data-price="{{ variant.price | money_without_trailing_zeros | escape }}"
                      data-compare="{% if variant_sale %}{{ variant.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}"
                      data-discount="{% if variant_sale %}{{ variant_disc }}{% endif %}"
                      data-sku="{{ variant.sku | escape }}"
                      data-available="{% if variant.available %}true{% else %}false{% endif %}"
                      {% if variant.featured_media != blank %}data-image="{{ variant.featured_media | image_url: width: 1200 }}"{% endif %}
                      {% if variant == current_variant %}checked{% endif %}
                    >
                    <span class="product-info__variant-card-inner">
                      <span class="product-info__variant-title">{{ variant.title }}</span>
                      <span class="product-info__variant-price">{{ variant.price | money_without_trailing_zeros }}</span>
                      {% if variant_sale %}
                        <span class="product-info__variant-save">{{ variant_disc }}% OFF</span>
                      {% endif %}
                    </span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endif %}

        {% when 'buy_buttons' %}
          {% form 'product', product, class: 'product-info__form', data-product-main-form: '', data-product-card-form: '' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-selected-variant-id>
            <input type="hidden" name="quantity" value="1" data-quantity-input>
            <div class="product-info__purchase-row" {{ block.shopify_attributes }} style="width: 100%;">
              <!-- In-Place Morphing Button Container (Single Combined Button) -->
              <div class="product-card__btn-container" data-card-btn-container style="width: 100%;">
                <!-- Standard ADD TO CART Button -->
                <button
                  type="submit"
                  name="add"
                  class="product-info__btn product-info__btn--add-to-cart"
                  data-card-add-btn
                  data-add-to-cart-button
                  {% unless current_variant.available %}disabled{% endunless %}
                  style="width: 100%; height: 48px; min-height: 48px; border-radius: 10px; font-weight: 800; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; {% if block.settings.cart_btn_bg != blank %}background-color: {{ block.settings.cart_btn_bg }};{% else %}background-color: #166534;{% endif %}{% if block.settings.cart_btn_color != blank %}color: {{ block.settings.cart_btn_color }};{% else %}color: #ffffff;{% endif %}"
                >
                  <span data-add-to-cart-text style="letter-spacing: 0.04em;">
                    {% if current_variant.available %}
                      {{ block.settings.cart_btn_text | default: "ADD TO CART" }}
                    {% else %}
                      SOLD OUT
                    {% endif %}
                  </span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                </button>

                <!-- Morphing In-Place Stepper [- 1 +] Pill (Initially Hidden, replaces ADD TO CART button in-place) -->
                <div class="product-card__inline-stepper" data-card-inline-stepper style="display: none; width: 100%; height: 48px; min-height: 48px; border: 2px solid #166534; border-radius: 10px; background: #ffffff; align-items: center; justify-content: space-between; padding: 0 16px; box-sizing: border-box;">
                  <button type="button" class="product-card__inline-btn product-card__inline-btn--minus" data-inline-minus aria-label="Decrease quantity" style="width: 40px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.35rem; font-weight: 900; color: #166534; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">-</button>
                  <span class="product-card__inline-count" data-inline-count style="font-size: 1.1rem; font-weight: 900; color: #166534; text-align: center;">1</span>
                  <button type="button" class="product-card__inline-btn product-card__inline-btn--plus" data-inline-plus aria-label="Increase quantity" style="width: 40px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.35rem; font-weight: 900; color: #166534; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">+</button>
                </div>
              </div>
            </div>

            {% if block.settings.show_buy_now %}
              <div class="product-info__secondary-actions" style="margin-top: 0.75rem;">
                <button
                  type="button"
                  class="product-info__btn product-info__btn--buy-now"
                  data-buy-now-button
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  ⚡ BUY IT NOW (EXPRESS CHECKOUT)
                </button>
              </div>
            {% endif %}
          {% endform %}

        {% when 'description' %}
          <div class="product-info__description" {{ block.shopify_attributes }}>
            {{ product.description }}
          </div>

        {% when 'collapsible_tab' %}
          <details class="product-info__collapsible-tab" {{ block.shopify_attributes }} style="margin-top: 0.75rem; border: 1px solid #d4e5d2; border-radius: 12px; padding: 12px 14px; background: #ffffff;">
            <summary style="font-weight: 800; color: #23421f; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 0.92rem;">
              <span>{{ block.settings.heading | default: "Tab Heading" }}</span>
              <span style="font-size: 1.1rem;">+</span>
            </summary>
            <div style="margin-top: 8px; font-size: 0.88rem; color: #475569; line-height: 1.5;">
              {{ block.settings.content }}
            </div>
          </details>

        {% when 'trust_badges' %}
          <div class="product-info__trust-badges" {{ block.shopify_attributes }}>
            {% render 'product-highlights', product: product, block: block %}
          </div>

        {% when 'product_video' %}
          <div class="product-info__video-block" {{ block.shopify_attributes }}>
            {% render 'product-video-card', product: product, block: block %}
          </div>

      {% endcase %}
    {% endfor %}
  {% else %}
    <!-- Default Header Block -->
    <div class="product-info__header-block">
      <h1 class="product-info__title">{{ product.title }}</h1>
      <p class="product-info__subtitle">
        {% if product.type != blank %}{{ product.type }}{% else %}Organic Grocery{% endif %}
        {% if product.tags.size > 0 %}
          &bull; {{ product.tags | join: ' &bull; ' }}
        {% endif %}
      </p>
      <div class="product-info__rating" aria-label="5 star customer rating">
        <div class="product-info__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <span class="product-info__rating-score">4.9</span>
        <a href="#ProductReviews-{{ section.id }}" class="product-info__review-count">(128 Verified Ratings)</a>
      </div>
    </div>

    <div class="product-info__body-block">
      {% render 'product-circle-features', product: product, limit: 4 %}
      <div class="product-info__price-box">
        <div class="product-info__prices">
          <span class="product-info__price-selling" data-product-price-selling>{{ current_variant.price | money_without_trailing_zeros }}</span>
          {% if sale %}
            <s class="product-info__price-mrp" data-product-price-mrp>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
            <span class="product-info__discount-badge" data-product-discount-badge>Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}% OFF</span>
          {% endif %}
        </div>
        <p class="product-info__tax-note">Inclusive of all taxes &bull; Free Shipping on orders over ₹499</p>
      </div>

      <div class="product-info__availability" data-product-availability-status>
        {% if current_variant.available %}
          <span class="product-info__stock-dot is-in-stock"></span>
          <span class="product-info__stock-text">In Stock &bull; Ready to Dispatch in 24 Hours</span>
        {% else %}
          <span class="product-info__stock-dot is-out-of-stock"></span>
          <span class="product-info__stock-text">Temporarily Sold Out</span>
        {% endif %}
      </div>

      {% form 'product', product, class: 'product-info__form', data-product-main-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-selected-variant-id>
        {% if product.variants.size > 0 %}
          <fieldset class="product-info__variants-container">
            <div class="product-info__variant-cards">
              {% for variant in product.variants %}
                {% assign variant_sale = false %}
                {% if variant.compare_at_price > variant.price %}
                  {% assign variant_sale = true %}
                  {% assign variant_disc = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price %}
                {% endif %}
                {% assign v_custom_badge = variant.metafields.custom.badge.value | default: variant.metafields.custom.badge | default: variant.metafields.custom.custom_badge.value | default: variant.metafields.custom.custom_badge | default: variant.metafields.custom.badge_varient.value | default: variant.metafields.custom.badge_varient | default: variant.metafields.custom.custom_badge_varient.value | default: variant.metafields.custom.custom_badge_varient | default: variant.metafields.custom.badge_variant.value | default: variant.metafields.custom.badge_variant | default: variant.metafields.custom.badge_text.value | default: variant.metafields.custom.badge_text | default: variant.metafields.custom.variant_badge.value | default: variant.metafields.custom.variant_badge %}
                <label class="product-info__variant-pill {% if variant == current_variant %}is-selected{% endif %}">
                  {% if v_custom_badge != blank %}
                    <span class="product-info__variant-badge">{{ v_custom_badge }}</span>
                  {% endif %}
                  <input type="radio" name="variant_id_option" value="{{ variant.id }}" data-variant-radio data-variant-id="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}" data-price="{{ variant.price | money_without_trailing_zeros | escape }}" data-compare="{% if variant_sale %}{{ variant.compare_at_price | money_without_trailing_zeros | escape }}{% endif %}" data-discount="{% if variant_sale %}{{ variant_disc }}{% endif %}" data-sku="{{ variant.sku | escape }}" data-available="{% if variant.available %}true{% else %}false{% endif %}" {% if variant.featured_media != blank %}data-image="{{ variant.featured_media | image_url: width: 1200 }}"{% endif %} {% if variant == current_variant %}checked{% endif %}>
                  <span class="product-info__variant-card-inner">
                    <span class="product-info__variant-title">{{ variant.title }}</span>
                    <span class="product-info__variant-price">{{ variant.price | money_without_trailing_zeros }}</span>
                    {% if variant_sale %}<span class="product-info__variant-save">{{ variant_disc }}% OFF</span>{% endif %}
                  </span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endif %}

        <div class="product-info__purchase-row" style="width: 100%;">
          <div class="product-card__btn-container" data-card-btn-container style="width: 100%;">
            <button
              type="submit"
              name="add"
              class="product-info__btn product-info__btn--add-to-cart"
              data-card-add-btn
              data-add-to-cart-button
              {% unless current_variant.available %}disabled{% endunless %}
              style="width: 100%; height: 48px; min-height: 48px; border-radius: 10px; font-weight: 800; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #166534; color: #ffffff;"
            >
              <span data-add-to-cart-text style="letter-spacing: 0.04em;">{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
            <div class="product-card__inline-stepper" data-card-inline-stepper style="display: none; width: 100%; height: 48px; min-height: 48px; border: 2px solid #166534; border-radius: 10px; background: #ffffff; align-items: center; justify-content: space-between; padding: 0 16px; box-sizing: border-box;">
              <button type="button" class="product-card__inline-btn product-card__inline-btn--minus" data-inline-minus aria-label="Decrease quantity" style="width: 40px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.35rem; font-weight: 900; color: #166534; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">-</button>
              <span class="product-card__inline-count" data-inline-count style="font-size: 1.1rem; font-weight: 900; color: #166534; text-align: center;">1</span>
              <button type="button" class="product-card__inline-btn product-card__inline-btn--plus" data-inline-plus aria-label="Increase quantity" style="width: 40px; height: 100%; border: none; background: transparent; cursor: pointer; font-size: 1.35rem; font-weight: 900; color: #166534; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1;">+</button>
            </div>
          </div>
        </div>
      {% endform %}
    </div>
  {% endif %}
</div>
