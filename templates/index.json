    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "testimonial_eMW8K3": {
          "type": "testimonial",
          "settings": {
            "headline": "Light on stomach and improves daily digestion.",
            "review": "\"Regular refined wheat se mujhe hamesha bloating aur heaviness rehti thi, isliye maine is 100% stone ground Khapli Atta par switch kiya. Iska low gluten content aur high dietary fiber pet ke liye bohot light hai. Ab lunch ke baad bilkul lethargic feel nahi hota. Rotiyan garam-garam khane par behad soft rehti hain. Real, unpolished traditional grain quality jo aajkal market mein milna mushkil hai.\"",
            "image": "shopify://shop_images/1_e929495f-221e-4b09-a8de-29d4f7dbcd5f.png",
            "name": "Dr. Beena Kathawala",
            "role": "Verified Customer",
            "rating": 5
          }
        },
        "testimonial_PHME6q": {
          "type": "testimonial",
          "settings": {
            "headline": "Pure golden ghee with authentic traditional aroma.",
            "review": "\"Pehli baar dabba kholte hi gaon ke ghar jaisi soni khushbu aayi. Is Vedic Bilona Ghee ka granular yani daanedaar texture aur natural golden yellow color iski purity ka proof hai. Dal, khichdi aur roti par daal kar khane se taste next level ho jata hai. Commercial brands ke chemical processed ghee ke mukable yeh authentic A2 desi cow ghee har tarah se superior hai.\"",
            "image": "shopify://shop_images/3_3014848e-b2ba-4532-aea5-4e3cd0ed3baa.png",
            "name": "Amin Dhariwal",
            "role": "Verified Customer",
            "rating": 5
          }
        },
        "testimonial_BeTKfP": {
          "type": "testimonial",
          "settings": {
            "headline": "Reduces hair fall and deeply conditions scalp.",
            "review": "\"Dry scalp aur hair breakage se pareshan hokar maine yeh wood pressed coconut oil try kiya. Regular massage karne se dandruff kafi kam ho gaya hai aur baal pehle se bohot soft aur shiny ho gaye hain. Iska texture heavy ya sticky nahi hai, easily wash ho jata hai. Chemical-free natural hair care routine ke liye yeh virgin coconut oil best investment hai.\"",
            "image": "shopify://shop_images/2_b4cb5534-b530-48fb-b7e4-f6282323924e.png",
            "name": "Seema Banka",
            "role": "Verified Customer",
            "rating": 5
          }
        },
        "testimonial_cHnhC4": {
          "type": "testimonial",
          "settings": {
            "headline": "Instantly soothes sore throat and seasonal cough.",
            "review": "\"Seasonal badlav ki wajah se gale mein kharash aur dry cough ho gayi thi. Dadi ke nuskhe ke mutabiq maine traditional Palm Mishri ko kali mirch aur ginger ke sath liya, aur 2 din mein gale ko kafi relief mila. Iski natural cooling and healing properties pet aur gale dono ke liye bohot faydemand hain. Har ghar ki Ayurvedic first-aid kit mein yeh zaroor honi chahiye.\"",
            "image": "shopify://shop_images/4_5a9c10a0-7a64-46e9-8fb0-423d2eb35ec3.png",
            "name": "Vijay Shah",
            "role": "Verified Customer",
            "rating": 5
          }
        },
        "testimonial_CjVNyt": {
          "type": "testimonial",
          "settings": {
            "headline": "High curcumin haldi boosts daily body immunity.",
            "review": "\"Roz raat ko haldi doodh (Golden Milk) ke liye maine yeh high curcumin organic haldi powder mangwaya tha. Regular market wali haldi ke comparison mein iska deep golden-orange color aur strong earthy aroma iski natural potency dikhati hai. Kuch hi hafton mein meri body immunity aur morning energy levels mein clear improvement dikha hai. Bina kisi artificial color ya filler ke bilkul genuine product.\"",
            "image": "shopify://shop_images/5_cc3744ee-dca1-4b7d-8575-d46eca24391d.png",
            "name": "Mukesh Ji",
            "role": "Verified Customer",
            "rating": 5
          }
        }
      },
