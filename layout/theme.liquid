<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-family-base: 'Montserrat', sans-serif !important;
        --font-primary--family: 'Montserrat', sans-serif !important;
        --font-secondary--family: 'Montserrat', sans-serif !important;
        --font-heading-family: 'Montserrat', sans-serif !important;
        --font-body-family: 'Montserrat', sans-serif !important;
        --story-font: 'Montserrat', sans-serif !important;
      }

      *, *::before, *::after, html, body, button, input, select, textarea, optgroup, option, h1, h2, h3, h4, h5, h6, p, a, span, label, td, th, li, ul, ol, nav, header, footer, section, div, article, main, aside, summary, details {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      }
    </style>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'component-icon.css' | asset_url | stylesheet_tag }}
    {{ 'component-button.css' | asset_url | stylesheet_tag }}
    {{ 'component-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-badge.css' | asset_url | stylesheet_tag }}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-modal.css' | asset_url | stylesheet_tag }}
    {{ 'component-popup.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'section-membership.css' | asset_url | stylesheet_tag }}
    {{ 'component-quantity-selector.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-quick-view.css' | asset_url | stylesheet_tag }}
    {{ 'customer-auth.css' | asset_url | stylesheet_tag }}
    {{ 'customer-profile.css' | asset_url | stylesheet_tag }}
    {{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
    {{ 'section-our-story.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'logo.png' | asset_url }}">

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    {% sections 'header-group' %}

    {% section 'customer-profile' %}
    {% section 'wishlist-drawer' %}
    {% render 'predictive-search-drawer' %}
    
    <aside class="kb-membership-modal" id="MembershipModal" hidden data-membership-modal>
      <div class="kb-membership-modal__backdrop" data-close-membership></div>
      <div class="kb-membership-modal__container">
        <div class="kb-membership-modal__content">
          {% section 'header' %}
          {% section 'membership-hero' %}
          {% section 'membership-plans' %}
          {% section 'membership-faq' %}
          {% section 'membership-cta' %}
          {% sections 'footer-group' %}
        </div>
      </div>
    </aside>

    {% section 'cart-drawer' %}
    {% render 'express-checkout-modal' %}
    {% render 'product-quick-view-modal' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-quick-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'customer-auth.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'customer-profile.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-button.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-popup.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-card.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-quantity-selector.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'section-membership.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'section-our-story.js' | asset_url }}" defer="defer"></script>

    <script>
      (function() {
        var isReplacing = false;

        function replaceRupeeText(node) {
          if (!node) return;
          if (node.nodeType === 3) {
            var text = node.nodeValue;
            if (text) {
              var newText = text;
              if (/\bRs\.?\s*/i.test(newText)) {
                newText = newText.replace(/\bRs\.?\s*/gi, '₹');
              }
              if (/(\d+)\.00\b/.test(newText)) {
                newText = newText.replace(/(\d+)\.00\b/g, '$1');
              }
              if (newText !== text) {
                node.nodeValue = newText;
              }
            }
          } else if (node.nodeType === 1 && !['SCRIPT', 'STYLE', 'INPUT', 'TEXTAREA', 'OPTION'].includes(node.tagName)) {
            for (var i = 0; i < node.childNodes.length; i++) {
              replaceRupeeText(node.childNodes[i]);
            }
          }
        }

        function runReplace() {
          if (document.body && !isReplacing) {
            isReplacing = true;
            replaceRupeeText(document.body);
            isReplacing = false;
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', runReplace);
        } else {
          runReplace();
        }

        var observer = new MutationObserver(function(mutations) {
          if (isReplacing) return;
          isReplacing = true;
          mutations.forEach(function(mutation) {
            if (mutation.addedNodes) {
              mutation.addedNodes.forEach(function(node) {
                replaceRupeeText(node);
              });
            }
          });
          isReplacing = false;
        });

        document.addEventListener('DOMContentLoaded', function() {
          if (document.body) {
            observer.observe(document.body, { childList: true, subtree: true });
          }
        });
      })();
    </script>

    <!-- 🚨 JUDGE.ME WRITE A REVIEW MODAL: HIDE ALL STICKY HEADERS & ANNOUNCEMENT BARS 🚨 -->
    <script>
      (function() {
        function checkReviewModal() {
          var forms = document.querySelectorAll('.jdgm-form-wrapper, .jdgm-form, .jdgm-rev-widg__form-wrapper, .jdgm-modal');
          var isOpen = false;

          forms.forEach(function(f) {
            if (f) {
              var style = window.getComputedStyle(f);
              if (style.display !== 'none' && style.visibility !== 'hidden' && f.offsetHeight > 0) {
                isOpen = true;
              }
            }
          });

          if (!isOpen && document.querySelector('.jdgm-write-rev-btn.jdgm-btn--active, .jdgm-write-rev-btn[aria-expanded="true"]')) {
            isOpen = true;
          }

          if (isOpen) {
            document.documentElement.classList.add('review-modal-open');
            document.body.classList.add('review-modal-open');
          } else {
            document.documentElement.classList.remove('review-modal-open');
            document.body.classList.remove('review-modal-open');
          }
        }

        document.addEventListener('click', function(e) {
          if (e.target.closest('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn, [href*="write_review"]')) {
            var count = 0;
            var timer = setInterval(function() {
              checkReviewModal();
              count++;
              if (count > 30) clearInterval(timer);
            }, 100);
          }

          if (e.target.closest('.jdgm-cancel-rev, .jdgm-close-btn, .jdgm-form__close, .jdgm-modal-close')) {
            setTimeout(checkReviewModal, 50);
          }
        });

        if (window.MutationObserver) {
          var obs = new MutationObserver(checkReviewModal);
          if (document.body) {
            obs.observe(document.body, { childList: true, subtree: true, attributes: true });
          } else {
            document.addEventListener('DOMContentLoaded', function() {
              obs.observe(document.body, { childList: true, subtree: true, attributes: true });
            });
          }
        }
      })();
    </script>
  </body>
</html>
