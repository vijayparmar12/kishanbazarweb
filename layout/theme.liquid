<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-family-base: 'Montserrat', sans-serif !important;
        --font-primary--family: 'Montserrat', sans-serif !important;
        --font-secondary--family: 'Montserrat', sans-serif !important;
        --font-heading-family: 'Montserrat', sans-serif !important;
        --font-body-family: 'Montserrat', sans-serif !important;
        --story-font: 'Montserrat', sans-serif !important;
      }

      *, *::before, *::after, html, body, button, input, select, textarea, optgroup, option, h1, h2, h3, h4, h5, h6, p, a, span, label, td, th, li, ul, ol, nav, header, footer, section, div, article, main, aside, summary, details {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
      }
    </style>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'component-icon.css' | asset_url | stylesheet_tag }}
    {{ 'component-button.css' | asset_url | stylesheet_tag }}
    {{ 'component-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-badge.css' | asset_url | stylesheet_tag }}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-modal.css' | asset_url | stylesheet_tag }}
    {{ 'component-popup.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'section-membership.css' | asset_url | stylesheet_tag }}
    {{ 'component-quantity-selector.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-quick-view.css' | asset_url | stylesheet_tag }}
    {{ 'customer-auth.css' | asset_url | stylesheet_tag }}
    {{ 'customer-profile.css' | asset_url | stylesheet_tag }}
    {{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
    {{ 'section-our-story.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'logo.png' | asset_url }}">

    <!-- CRITICAL JUDGE.ME MODAL HEADER HIDE CSS & IMMEDIATE URL CHECK SCRIPT -->
    <style>
      /* HIDE STICKY HEADER & ANNOUNCEMENT BAR WHEN JUDGE.ME WRITE A REVIEW IS OPEN */
      html.jdgm-form-open #shopify-section-header,
      html.jdgm-form-open #shopify-section-announcement-bar,
      html.jdgm-form-open header,
      html.jdgm-form-open .header-wrapper,
      html.jdgm-form-open .sticky-header,
      html.jdgm-form-open section-header,
      html.jdgm-form-open .announcement-bar-section,
      body.jdgm-form-open #shopify-section-header,
      body.jdgm-form-open #shopify-section-announcement-bar,
      body.jdgm-form-open header,
      body.jdgm-form-open .header-wrapper,
      body.jdgm-form-open .sticky-header,
      body.jdgm-form-open section-header,
      body.jdgm-form-open .announcement-bar-section,
      body:has(.jdgm-form-wrapper) #shopify-section-header,
      body:has(.jdgm-form-wrapper) #shopify-section-announcement-bar,
      body:has(.jdgm-form-wrapper) header,
      body:has(.jdgm-form-wrapper) .header-wrapper,
      body:has(.jdgm-form-wrapper) .sticky-header,
      body:has(.jdgm-form) #shopify-section-header,
      body:has(.jdgm-form) #shopify-section-announcement-bar,
      body:has(.jdgm-form) header,
      body:has(.jdgm-form) .header-wrapper,
      body:has(.jdgm-form) .sticky-header,
      body:has(.jdgm-rev-widg__form-wrapper) #shopify-section-header,
      body:has(.jdgm-rev-widg__form-wrapper) #shopify-section-announcement-bar,
      body:has(.jdgm-rev-widg__form-wrapper) header {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        height: 0 !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        pointer-events: none !important;
      }

      /* CENTER JUDGE.ME MODAL DIALOG BELOW TOP HEADER */
      .jdgm-form-wrapper,
      .jdgm-form,
      .jdgm-rev-widg__form-wrapper,
      #jdgm-dialog,
      .jdgm-dialog {
        z-index: 999999999 !important;
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        max-height: 90vh !important;
        overflow-y: auto !important;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4) !important;
        border-radius: 20px !important;
      }
    </style>

    <script>
      (function() {
        function checkUrlAndForm() {
          var href = window.location.href;
          var isParamOpen = (href.indexOf('pb=') !== -1 || href.indexOf('write_review') !== -1 || href.indexOf('judgeme') !== -1);
          
          var form = document.querySelector('.jdgm-form-wrapper, .jdgm-form, .jdgm-rev-widg__form-wrapper, #jdgm-dialog, .jdgm-dialog');
          var isFormVisible = form && (
            form.offsetWidth > 0 || 
            form.offsetHeight > 0 || 
            window.getComputedStyle(form).display !== 'none'
          );

          if (isParamOpen || isFormVisible) {
            document.documentElement.classList.add('jdgm-form-open');
            if (document.body) {
              document.body.classList.add('jdgm-form-open');
              var headers = document.querySelectorAll('#shopify-section-header, #shopify-section-announcement-bar, header, .header-wrapper, .sticky-header, section-header');
              headers.forEach(function(h) {
                h.style.setProperty('display', 'none', 'important');
                h.style.setProperty('opacity', '0', 'important');
                h.style.setProperty('visibility', 'hidden', 'important');
              });
            }
          } else {
            document.documentElement.classList.remove('jdgm-form-open');
            if (document.body) {
              document.body.classList.remove('jdgm-form-open');
              var headers = document.querySelectorAll('#shopify-section-header, #shopify-section-announcement-bar, header, .header-wrapper, .sticky-header, section-header');
              headers.forEach(function(h) {
                h.style.removeProperty('display');
                h.style.removeProperty('opacity');
                h.style.removeProperty('visibility');
              });
            }
          }
        }

        // Run immediately in <head>
        checkUrlAndForm();

        // Run on DOM ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', checkUrlAndForm);
        } else {
          checkUrlAndForm();
        }

        // Event listener for click events
        document.addEventListener('click', function(e) {
          if (e.target.closest('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn')) {
            setTimeout(checkUrlAndForm, 50);
            setTimeout(checkUrlAndForm, 200);
            setTimeout(checkUrlAndForm, 500);
          }
          if (e.target.closest('.jdgm-cancel-rev, .jdgm-close-btn, .jdgm-form__close')) {
            setTimeout(checkUrlAndForm, 50);
          }
        });

        // Continuous interval check
        setInterval(checkUrlAndForm, 200);
      })();
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    {% sections 'header-group' %}

    {% section 'customer-profile' %}
    {% section 'wishlist-drawer' %}
    {% render 'predictive-search-drawer' %}
    
    <aside class="kb-membership-modal" id="MembershipModal" hidden data-membership-modal>
      <div class="kb-membership-modal__backdrop" data-close-membership></div>
      <div class="kb-membership-modal__container">
        <div class="kb-membership-modal__content">
          {% section 'header' %}
          {% section 'membership-hero' %}
          {% section 'membership-plans' %}
          {% section 'membership-faq' %}
          {% section 'membership-cta' %}
          {% sections 'footer-group' %}
        </div>
      </div>
    </aside>

    {% section 'cart-drawer' %}
    {% render 'express-checkout-modal' %}
    {% render 'product-quick-view-modal' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-quick-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'customer-auth.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'customer-profile.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-button.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-popup.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-card.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-quantity-selector.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'section-membership.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'section-our-story.js' | asset_url }}" defer="defer"></script>

    <script>
      (function() {
        var isReplacing = false;

        function replaceRupeeText(node) {
          if (!node) return;
          if (node.nodeType === 3) {
            var text = node.nodeValue;
            if (text) {
              var newText = text;
              if (/\bRs\.?\s*/i.test(newText)) {
                newText = newText.replace(/\bRs\.?\s*/gi, '₹');
              }
              if (/(\d+)\.00\b/.test(newText)) {
                newText = newText.replace(/(\d+)\.00\b/g, '$1');
              }
              if (newText !== text) {
                node.nodeValue = newText;
              }
            }
          } else if (node.nodeType === 1 && !['SCRIPT', 'STYLE', 'INPUT', 'TEXTAREA', 'OPTION'].includes(node.tagName)) {
            for (var i = 0; i < node.childNodes.length; i++) {
              replaceRupeeText(node.childNodes[i]);
            }
          }
        }

        function runReplace() {
          if (document.body && !isReplacing) {
            isReplacing = true;
            replaceRupeeText(document.body);
            isReplacing = false;
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', runReplace);
        } else {
          runReplace();
        }

        var observer = new MutationObserver(function(mutations) {
          if (isReplacing) return;
          isReplacing = true;
          mutations.forEach(function(mutation) {
            if (mutation.addedNodes) {
              mutation.addedNodes.forEach(function(node) {
                replaceRupeeText(node);
              });
            }
          });
          isReplacing = false;
        });

        document.addEventListener('DOMContentLoaded', function() {
          if (document.body) {
            observer.observe(document.body, { childList: true, subtree: true });
          }
        });
      })();
    </script>
  </body>
</html>
