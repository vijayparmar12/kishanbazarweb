    <script>
      (function() {
        // 1. Instantly sync cart count badge from Liquid on page load without downloading cart app JS/CSS/HTML
        function syncCartCountOnLoad() {
          var count = {{ cart.item_count | json }};
          document.querySelectorAll('[data-cart-count], .kb-header__action--cart .kb-header__badge').forEach(function(el) {
            el.textContent = String(count);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncCartCountOnLoad);
        } else {
          syncCartCountOnLoad();
        }

        // 2. On-demand loader for Cart application (loads cart.css, cart.js, and Cart Drawer HTML ONLY when customer interacts with cart)
        function loadCartApp(callback) {
          if (window.kbCartLoaded) {
            if (callback) callback();
            return;
          }
          if (window.kbCartLoading) {
            if (callback) {
              window.addEventListener('kb:cart:loaded', callback, { once: true });
            }
            return;
          }
          window.kbCartLoading = true;

          // Inject Cart CSS
          if (!document.querySelector('link[href*="cart.css"]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = "{{ 'cart.css' | asset_url }}";
            document.head.appendChild(link);
          }

          // Fetch Cart Drawer HTML if not present in DOM
          var fetchDrawerPromise = Promise.resolve();
          if (!document.querySelector('[data-cart-drawer]')) {
            var rootUrl = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';
            fetchDrawerPromise = fetch(rootUrl + '?sections=cart-drawer')
              .then(function(res) { return res.json(); })
              .then(function(data) {
                if (data && data['cart-drawer']) {
                  var div = document.createElement('div');
                  div.innerHTML = data['cart-drawer'];
                  var drawerEl = div.firstElementChild;
                  if (drawerEl) {
                    document.body.appendChild(drawerEl);
                  }
                }
              })
              .catch(function(err) { console.warn('Could not fetch cart drawer section', err); });
          }

          // Inject Cart JS after drawer HTML is ready
          fetchDrawerPromise.then(function() {
            if (!document.querySelector('script[src*="cart.js"]')) {
              var script = document.createElement('script');
              script.src = "{{ 'cart.js' | asset_url }}";
              script.defer = true;
              script.onload = function() {
                window.kbCartLoaded = true;
                window.kbCartLoading = false;
                window.dispatchEvent(new CustomEvent('kb:cart:loaded'));
                if (callback) callback();
              };
              document.body.appendChild(script);
            } else {
              window.kbCartLoaded = true;
              window.kbCartLoading = false;
              window.dispatchEvent(new CustomEvent('kb:cart:loaded'));
              if (callback) callback();
            }
          });
        }

        window.loadCartApp = loadCartApp;

        // 3. Intercept clicks and form submissions on Cart Triggers to load Cart App on customer demand
        document.addEventListener('click', function(event) {
          var trigger = event.target.closest('[data-cart-drawer-trigger], .kb-header__action--cart, [data-add-to-cart], [data-move-to-cart], .kb-cart-addon-add-btn');
          if (trigger && !window.kbCartLoaded) {
            event.preventDefault();
            event.stopPropagation();

            loadCartApp(function() {
              if (trigger.matches('[data-cart-drawer-trigger], .kb-header__action--cart')) {
                if (window.openDrawer) window.openDrawer();
              } else {
                trigger.click();
              }
            });
          }
        }, true);

        document.addEventListener('submit', function(event) {
          var form = event.target;
          if (form && form.action && form.action.indexOf('/cart/add') !== -1 && !window.kbCartLoaded) {
            event.preventDefault();
            event.stopPropagation();

            loadCartApp(function() {
              form.submit();
            });
          }
        }, true);
      })();
    </script>
    <script>
      (function() {
        // 1. Instantly update Wishlist Badge count from LocalStorage on page load without downloading wishlist app JS/CSS
        function syncWishlistBadgeOnLoad() {
          try {
            var raw = localStorage.getItem('kb_wishlist_items');
            var items = raw ? JSON.parse(raw) : [];
            var count = Array.isArray(items) ? items.length : 0;
            document.querySelectorAll('[data-wishlist-count-badge], .kb-header__action--wishlist .kb-header__badge').forEach(function(el) {
              el.textContent = String(count);
            });
          } catch(e) {}
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncWishlistBadgeOnLoad);
        } else {
          syncWishlistBadgeOnLoad();
        }

        // 2. On-demand loader for Wishlist application (loads component-wishlist.css & component-wishlist.js ONLY when customer opens/interacts with wishlist)
        function loadWishlistApp(callback) {
          if (window.kbWishlistLoaded) {
            if (callback) callback();
            return;
          }
          if (window.kbWishlistLoading) {
            if (callback) {
              window.addEventListener('kb:wishlist:loaded', callback, { once: true });
            }
            return;
          }
          window.kbWishlistLoading = true;

          // Inject Wishlist CSS
          if (!document.querySelector('link[href*="component-wishlist.css"]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = "{{ 'component-wishlist.css' | asset_url }}";
            document.head.appendChild(link);
          }

          // Inject Wishlist JS
          var script = document.createElement('script');
          script.src = "{{ 'component-wishlist.js' | asset_url }}";
          script.defer = true;
          script.onload = function() {
            window.kbWishlistLoaded = true;
            window.kbWishlistLoading = false;
            window.dispatchEvent(new CustomEvent('kb:wishlist:loaded'));
            if (callback) callback();
          };
          document.body.appendChild(script);
        }

        window.loadWishlistApp = loadWishlistApp;

        // 3. Click interceptor to load wishlist application on customer demand
        document.addEventListener('click', function(event) {
          var trigger = event.target.closest('[data-wishlist-drawer-trigger], .kb-header__action--wishlist, [data-wishlist-button]');
          if (trigger && !window.kbWishlistLoaded) {
            event.preventDefault();
            event.stopPropagation();

            loadWishlistApp(function() {
              if (trigger.matches('[data-wishlist-drawer-trigger], .kb-header__action--wishlist')) {
                if (window.openWishlistDrawer) window.openWishlistDrawer();
              } else if (trigger.matches('[data-wishlist-button]')) {
                trigger.click();
              }
            });
          }
        }, true);
      })();
    </script>
    <script src="{{ 'component-button.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-popup.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-card.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-quantity-selector.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'page' and template.suffix == 'our-story' %}
      <script src="{{ 'section-our-story.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    <script>
      (function() {
        function runReplace(scope) {
          var root = scope || document;
          var targets = root.querySelectorAll ? root.querySelectorAll('.product-card__price, .product-info__price-box, [data-product-price-selling], [data-product-price-mrp], .product-info__prices, .cart-drawer, .kb-cart-item, [data-price], [data-compare], .price, .money') : [];
          targets.forEach(function(el) {
            if (el.children && el.children.length > 0) {
              for (var i = 0; i < el.childNodes.length; i++) {
                var n = el.childNodes[i];
                if (n.nodeType === 3 && n.nodeValue) {
                  var v = n.nodeValue.replace(/\bRs\.?\s*/gi, '₹').replace(/(\d+)\.00\b/g, '$1');
                  if (v !== n.nodeValue) n.nodeValue = v;
                }
              }
            } else if (el.textContent) {
              var v = el.textContent.replace(/\bRs\.?\s*/gi, '₹').replace(/(\d+)\.00\b/g, '$1');
              if (v !== el.textContent) el.textContent = v;
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() { runReplace(); });
        } else {
          runReplace();
        }

        document.addEventListener('kb:cart:updated', function() { runReplace(); });
      })();
    </script>
  </body>
</html>
