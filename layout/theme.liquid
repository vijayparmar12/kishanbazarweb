<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-family-base: 'Montserrat', sans-serif !important;
        --font-primary--family: 'Montserrat', sans-serif !important;
        --font-secondary--family: 'Montserrat', sans-serif !important;
        --font-heading-family: 'Montserrat', sans-serif !important;
        --font-body-family: 'Montserrat', sans-serif !important;
        --story-font: 'Montserrat', sans-serif !important;
      }

      html, body, button, input, select, textarea, optgroup, option, h1, h2, h3, h4, h5, h6, p, a, span:not([class*="jdgm"]), label, td, th, li, ul, ol, nav, header, footer, section, div:not([class*="jdgm"]), article, main, aside, summary, details {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      /* Allow Judge.me star icons to render natively with JudgemeStar font */
      .jdgm-star,
      .jdgm-star:before,
      .jdgm-star:after,
      .jdgm-star *,
      .jdgm-histogram__star,
      .jdgm-histogram__star:before,
      .jdgm-histogram__star:after,
      .jdgm-histogram__star *,
      .jdgm-rev__rating .jdgm-star,
      .jdgm-form-rating .jdgm-star,
      .jdgm-prev-badge .jdgm-star,
      [class*="jdgm-star"],
      [class*="jdgm-star"]:before,
      [class*="jdgm-star"]:after {
        font-family: 'JudgemeStar', 'judgemeStar', 'Segoe UI Symbol', sans-serif !important;
      }
    </style>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'component-icon.css' | asset_url | stylesheet_tag }}
    {{ 'component-button.css' | asset_url | stylesheet_tag }}
    {{ 'component-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-badge.css' | asset_url | stylesheet_tag }}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-modal.css' | asset_url | stylesheet_tag }}
    {{ 'component-popup.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'section-membership.css' | asset_url | stylesheet_tag }}
    {{ 'component-quantity-selector.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-quick-view.css' | asset_url | stylesheet_tag }}
    {{ 'customer-auth.css' | asset_url | stylesheet_tag }}
    {{ 'customer-profile.css' | asset_url | stylesheet_tag }}
    {{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
    {{ 'section-our-story.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'logo.png' | asset_url }}">

    <!-- GLOBAL JUDGE.ME WRITE A REVIEW MODAL BACKDROP BLUR & HEADER-HIDE -->
    <style>
      /* BLUR ALL BACKGROUND & OVERLAY WHEN WRITE A REVIEW IS OPEN */
      body.jdgm-review-modal-active #JdgmBlurOverlay,
      html.jdgm-review-modal-active #JdgmBlurOverlay {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0, 0, 0, 0.82) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        z-index: 99999990 !important;
        display: block !important;
        pointer-events: all !important;
      }

      /* HIDE ALL HEADERS & ANNOUNCEMENT BARS 100% WHEN JUDGE.ME MODAL IS OPEN */
      :root:has(.jdgm-form-wrapper),
      :root:has(.jdgm-form),
      :root:has(.jdgm-rev-widg__form-wrapper),
      :root:has(.jdgm-rev-widg__form),
      :root:has(.jdgm-form-rating),
      :root:has([class*="jdgm-form"]),
      body:has(.jdgm-form-wrapper),
      body:has(.jdgm-form),
      body:has(.jdgm-rev-widg__form-wrapper),
      body:has(.jdgm-rev-widg__form),
      body:has(.jdgm-form-rating),
      body:has([class*="jdgm-form"]),
      body.jdgm-review-modal-active,
      html.jdgm-review-modal-active {
        overflow: hidden !important;
      }

      :root:has(.jdgm-form-wrapper) #shopify-section-header-group,
      :root:has(.jdgm-form-wrapper) .shopify-section-group-header-group,
      :root:has(.jdgm-form-wrapper) #shopify-section-header,
      :root:has(.jdgm-form-wrapper) #shopify-section-announcement-bar,
      :root:has(.jdgm-form-wrapper) header,
      :root:has(.jdgm-form-wrapper) .kb-header,
      :root:has(.jdgm-form-wrapper) .kb-header-top-sticky,
      :root:has(.jdgm-form-wrapper) .kb-header-top--fixed,
      :root:has(.jdgm-form-wrapper) .kb-header1,
      :root:has(.jdgm-form-wrapper) .kb-header2,
      :root:has(.jdgm-form-wrapper) [data-header-top-sticky],
      :root:has(.jdgm-form-wrapper) [data-premium-header],
      :root:has(.jdgm-form) #shopify-section-header-group,
      :root:has(.jdgm-form) .shopify-section-group-header-group,
      :root:has(.jdgm-form) #shopify-section-header,
      :root:has(.jdgm-form) #shopify-section-announcement-bar,
      :root:has(.jdgm-form) header,
      :root:has(.jdgm-form) .kb-header,
      :root:has(.jdgm-form) .kb-header-top-sticky,
      :root:has(.jdgm-form) .kb-header-top--fixed,
      :root:has(.jdgm-form) .kb-header1,
      :root:has(.jdgm-form) .kb-header2,
      :root:has(.jdgm-form) [data-header-top-sticky],
      :root:has(.jdgm-form) [data-premium-header],
      :root:has([class*="jdgm-form"]) #shopify-section-header-group,
      :root:has([class*="jdgm-form"]) .shopify-section-group-header-group,
      :root:has([class*="jdgm-form"]) #shopify-section-header,
      :root:has([class*="jdgm-form"]) #shopify-section-announcement-bar,
      :root:has([class*="jdgm-form"]) header,
      :root:has([class*="jdgm-form"]) .kb-header,
      :root:has([class*="jdgm-form"]) .kb-header-top-sticky,
      :root:has([class*="jdgm-form"]) .kb-header-top--fixed,
      :root:has([class*="jdgm-form"]) .kb-header1,
      :root:has([class*="jdgm-form"]) .kb-header2,
      :root:has([class*="jdgm-form"]) [data-header-top-sticky],
      :root:has([class*="jdgm-form"]) [data-premium-header],
      body:has(.jdgm-form-wrapper) #shopify-section-header-group,
      body:has(.jdgm-form-wrapper) .shopify-section-group-header-group,
      body:has(.jdgm-form-wrapper) #shopify-section-header,
      body:has(.jdgm-form-wrapper) #shopify-section-announcement-bar,
      body:has(.jdgm-form-wrapper) header,
      body:has(.jdgm-form-wrapper) .kb-header,
      body:has(.jdgm-form-wrapper) .kb-header-top-sticky,
      body:has(.jdgm-form-wrapper) .kb-header-top--fixed,
      body:has(.jdgm-form-wrapper) .kb-header1,
      body:has(.jdgm-form-wrapper) .kb-header2,
      body:has(.jdgm-form-wrapper) [data-header-top-sticky],
      body:has(.jdgm-form-wrapper) [data-premium-header],
      body:has(.jdgm-form) #shopify-section-header-group,
      body:has(.jdgm-form) .shopify-section-group-header-group,
      body:has(.jdgm-form) #shopify-section-header,
      body:has(.jdgm-form) #shopify-section-announcement-bar,
      body:has(.jdgm-form) header,
      body:has(.jdgm-form) .kb-header,
      body:has(.jdgm-form) .kb-header-top-sticky,
      body:has(.jdgm-form) .kb-header-top--fixed,
      body:has(.jdgm-form) .kb-header1,
      body:has(.jdgm-form) .kb-header2,
      body:has(.jdgm-form) [data-header-top-sticky],
      body:has(.jdgm-form) [data-premium-header],
      body:has([class*="jdgm-form"]) #shopify-section-header-group,
      body:has([class*="jdgm-form"]) .shopify-section-group-header-group,
      body:has([class*="jdgm-form"]) #shopify-section-header,
      body:has([class*="jdgm-form"]) #shopify-section-announcement-bar,
      body:has([class*="jdgm-form"]) header,
      body:has([class*="jdgm-form"]) .kb-header,
      body:has([class*="jdgm-form"]) .kb-header-top-sticky,
      body:has([class*="jdgm-form"]) .kb-header-top--fixed,
      body:has([class*="jdgm-form"]) .kb-header1,
      body:has([class*="jdgm-form"]) .kb-header2,
      body:has([class*="jdgm-form"]) [data-header-top-sticky],
      body:has([class*="jdgm-form"]) [data-premium-header],
      html.jdgm-review-modal-active .kb-header,
      html.jdgm-review-modal-active .kb-header-top-sticky,
      html.jdgm-review-modal-active [data-premium-header],
      html.jdgm-review-modal-active #shopify-section-header-group,
      html.jdgm-review-modal-active .shopify-section-group-header-group,
      html.jdgm-review-modal-active #shopify-section-header,
      html.jdgm-review-modal-active #shopify-section-announcement-bar,
      html.jdgm-review-modal-active header,
      html.jdgm-review-modal-active .header-wrapper,
      html.jdgm-review-modal-active .sticky-header,
      body.jdgm-review-modal-active .kb-header,
      body.jdgm-review-modal-active .kb-header-top-sticky,
      body.jdgm-review-modal-active [data-premium-header],
      body.jdgm-review-modal-active #shopify-section-header-group,
      body.jdgm-review-modal-active .shopify-section-group-header-group,
      body.jdgm-review-modal-active #shopify-section-header,
      body.jdgm-review-modal-active #shopify-section-announcement-bar,
      body.jdgm-review-modal-active header,
      body.jdgm-review-modal-active [id*="header"],
      body.jdgm-review-modal-active .header-wrapper,
      body.jdgm-review-modal-active .sticky-header {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        height: 0 !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        pointer-events: none !important;
        z-index: -999999 !important;
        position: static !important;
      }

      /* JUDGE.ME REVIEW MODAL POPUP CENTERED AT MAXIMUM Z-INDEX */
      .jdgm-form-wrapper,
      .jdgm-form,
      .jdgm-rev-widg__form-wrapper,
      .jdgm-widget .jdgm-form,
      .jdgm-write-rev-btn + .jdgm-form {
        z-index: 100000000 !important;
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: min(94vw, 680px) !important;
        max-height: 90vh !important;
        overflow-y: auto !important;
        background: #FFFFFF !important;
        border-radius: 24px !important;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        margin: 0 !important;
      }
    </style>

    <script>
      (function() {
        function toggleReviewModalState() {
          var form = document.querySelector('.jdgm-form-wrapper, .jdgm-form, .jdgm-rev-widg__form-wrapper, .jdgm-rev-widg__form');
          var overlay = document.getElementById('JdgmBlurOverlay');
          var isFormVisible = false;

          if (form) {
            var style = window.getComputedStyle(form);
            if (style.display !== 'none' && style.visibility !== 'hidden' && (form.offsetWidth > 0 || form.offsetHeight > 0)) {
              isFormVisible = true;
            }
          }

          if (window.location.search.indexOf('pb=0') !== -1 || window.location.search.indexOf('write') !== -1) {
            if (document.querySelector('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn')) {
              isFormVisible = true;
            }
          }

          var headerElements = document.querySelectorAll('.kb-header, .kb-header-top-sticky, .kb-header-top--fixed, [data-header-top-sticky], [data-header-top-placeholder], [data-premium-header], #shopify-section-header-group, .shopify-section-group-header-group, #shopify-section-header, #shopify-section-announcement-bar, header, .header-wrapper, .sticky-header, [id*="header"]');

          if (isFormVisible) {
            document.documentElement.classList.add('jdgm-review-modal-active');
            document.body.classList.add('jdgm-review-modal-active');
            if (overlay) {
              overlay.style.display = 'block';
              overlay.classList.add('is-active');
            }

            headerElements.forEach(function(h) {
              h.classList.remove('kb-header-top--fixed');
              h.style.setProperty('display', 'none', 'important');
              h.style.setProperty('opacity', '0', 'important');
              h.style.setProperty('visibility', 'hidden', 'important');
              h.style.setProperty('pointer-events', 'none', 'important');
              h.style.setProperty('z-index', '-999999', 'important');
            });
          } else {
            document.documentElement.classList.remove('jdgm-review-modal-active');
            document.body.classList.remove('jdgm-review-modal-active');
            if (overlay) {
              overlay.style.display = 'none';
              overlay.classList.remove('is-active');
            }

            headerElements.forEach(function(h) {
              h.style.removeProperty('display');
              h.style.removeProperty('opacity');
              h.style.removeProperty('visibility');
              h.style.removeProperty('pointer-events');
              h.style.removeProperty('z-index');
            });
          }
        }

        document.addEventListener('click', function(e) {
          if (e.target.closest('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn, [href*="write-review"], [href*="pb=0"]')) {
            setTimeout(toggleReviewModalState, 20);
            setTimeout(toggleReviewModalState, 100);
            setTimeout(toggleReviewModalState, 300);
          }
          if (e.target.closest('.jdgm-cancel-rev, .jdgm-close-btn, .jdgm-form__close, .jdgm-dialog__close')) {
            setTimeout(toggleReviewModalState, 20);
          }
        });

        var observer = new MutationObserver(toggleReviewModalState);
        if (document.body) {
          observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });
        }

        setInterval(toggleReviewModalState, 150);
      })();
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    <div id="JdgmBlurOverlay" style="display: none;"></div>
    {% sections 'header-group' %}

    {% section 'customer-profile' %}
    {% section 'wishlist-drawer' %}
    {% render 'predictive-search-drawer' %}
    
    <aside class="kb-membership-modal" id="MembershipModal" hidden data-membership-modal>
      <div class="kb-membership-modal__backdrop" data-close-membership></div>
      <div class="kb-membership-modal__container">
        <div class="kb-membership-modal__content">
          {% section 'header' %}
          {% section 'membership-hero' %}
          {% section 'membership-plans' %}
          {% section 'membership-faq' %}
          {% section 'membership-cta' %}
          {% sections 'footer-group' %}
        </div>
      </div>
    </aside>

    {% section 'cart-drawer' %}
    {% render 'express-checkout-modal' %}
    {% render 'product-quick-view-modal' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
