<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
	<!-- Added by APP PLAZA -->
	{% render 'app-plaza' %}
	<!-- /Added by APP PLAZA -->
	<!-- Added by AVADA SEO Suite -->
	{% render 'avada-seo' %}
	<!-- /Added by AVADA SEO Suite -->
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <!-- CDN & Fonts Resource Hints -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <style>
      :root {
        --font-family-base: 'Montserrat', sans-serif !important;
        --font-primary--family: 'Montserrat', sans-serif !important;
        --font-secondary--family: 'Montserrat', sans-serif !important;
        --font-heading-family: 'Montserrat', sans-serif !important;
        --font-body-family: 'Montserrat', sans-serif !important;
        --story-font: 'Montserrat', sans-serif !important;
      }

      html, body, button, input, select, textarea, optgroup, option, h1, h2, h3, h4, h5, h6, p, a, span:not([class*="jdgm"]), label, td, th, li, ul, ol, nav, header, footer, section, div:not([class*="jdgm"]), article, main, aside, summary, details {
        font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      /* Allow Judge.me star icons to render natively with JudgemeStar font */
      .jdgm-star,
      .jdgm-star:before,
      .jdgm-star:after,
      .jdgm-star *,
      .jdgm-histogram__star,
      .jdgm-histogram__star:before,
      .jdgm-histogram__star:after,
      .jdgm-histogram__star *,
      .jdgm-rev__rating .jdgm-star,
      .jdgm-form-rating .jdgm-star,
      .jdgm-prev-badge .jdgm-star,
      [class*="jdgm-star"],
      [class*="jdgm-star"]:before,
      [class*="jdgm-star"]:after {
        font-family: 'JudgemeStar', 'judgemeStar', 'Segoe UI Symbol', sans-serif !important;
      }
    </style>

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'component-icon.css' | asset_url | stylesheet_tag }}
    {{ 'component-button.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag: preload: true }}
    <link rel="stylesheet" href="{{ 'component-input.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-badge.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-quantity-selector.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-modal.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-popup.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-product-quick-view.css' | asset_url }}" media="print" onload="this.media='all'">
    {% if template.name == 'index' %}
      {{ 'section-hero.css' | asset_url | stylesheet_tag: preload: true }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'our-story' %}
      {{ 'section-our-story.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.design_mode %}
      {{ 'cart.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'logo.png' | asset_url }}">

    <!-- GLOBAL JUDGE.ME WRITE A REVIEW MODAL BACKDROP BLUR & UNBLURRED FORM -->
    <style>
      /* BLUR ALL BACKGROUND & OVERLAY WHEN WRITE A REVIEW IS OPEN */
      body.jdgm-review-modal-active #JdgmBlurOverlay,
      html.jdgm-review-modal-active #JdgmBlurOverlay {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0, 0, 0, 0.65) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        z-index: 99999990 !important;
        display: block !important;
        pointer-events: all !important;
      }

      /* HIDE HEADER AND STICKY BOTTOM BAR ONLY WHEN WRITE A REVIEW FORM IS ACTIVELY OPEN */
      body.jdgm-review-modal-active,
      html.jdgm-review-modal-active {
        overflow: hidden !important;
      }

      html.jdgm-review-modal-active .kb-header,
      html.jdgm-review-modal-active .kb-header-top-sticky,
      html.jdgm-review-modal-active [data-premium-header],
      html.jdgm-review-modal-active #shopify-section-header-group,
      html.jdgm-review-modal-active .shopify-section-group-header-group,
      html.jdgm-review-modal-active #shopify-section-header,
      html.jdgm-review-modal-active #shopify-section-announcement-bar,
      html.jdgm-review-modal-active header,
      html.jdgm-review-modal-active .header-wrapper,
      html.jdgm-review-modal-active .sticky-header,
      html.jdgm-review-modal-active .sticky-mobile-bar,
      html.jdgm-review-modal-active [data-sticky-mobile-bar],
      body.jdgm-review-modal-active .kb-header,
      body.jdgm-review-modal-active .kb-header-top-sticky,
      body.jdgm-review-modal-active [data-premium-header],
      body.jdgm-review-modal-active #shopify-section-header-group,
      body.jdgm-review-modal-active .shopify-section-group-header-group,
      body.jdgm-review-modal-active #shopify-section-header,
      body.jdgm-review-modal-active #shopify-section-announcement-bar,
      body.jdgm-review-modal-active header,
      body.jdgm-review-modal-active [id*="header"],
      body.jdgm-review-modal-active .header-wrapper,
      body.jdgm-review-modal-active .sticky-header,
      body.jdgm-review-modal-active .sticky-mobile-bar,
      body.jdgm-review-modal-active [data-sticky-mobile-bar] {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
        z-index: -999999 !important;
      }

      /* JUDGE.ME REVIEW MODAL POPUP COMPACT SIZE & REDUCED PADDING */
      .jdgm-form-wrapper,
      .jdgm-form,
      .jdgm-rev-widg__form-wrapper,
      .jdgm-widget .jdgm-form,
      .jdgm-write-rev-btn + .jdgm-form {
        z-index: 100000000 !important;
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: min(92vw, 480px) !important;
        max-height: 82vh !important;
        overflow-y: auto !important;
        background: #FFFFFF !important;
        border-radius: 16px !important;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.4) !important;
        border: 1px solid #e5e7eb !important;
        margin: 0 !important;
        padding: 1.25rem 1.5rem !important;
      }

      .jdgm-form-wrapper .jdgm-form__fieldset,
      .jdgm-form .jdgm-form__fieldset,
      .jdgm-rev-widg__form-wrapper .jdgm-form__fieldset {
        margin-bottom: 0.5rem !important;
        padding: 0 !important;
      }

      .jdgm-form-wrapper input[type="text"],
      .jdgm-form-wrapper input[type="email"],
      .jdgm-form-wrapper textarea,
      .jdgm-form input[type="text"],
      .jdgm-form input[type="email"],
      .jdgm-form textarea {
        padding: 0.5rem 0.75rem !important;
        font-size: 0.88rem !important;
        border-radius: 8px !important;
        margin-bottom: 0.35rem !important;
      }

      .jdgm-form-wrapper textarea,
      .jdgm-form textarea {
        height: 75px !important;
        min-height: 65px !important;
      }

      .jdgm-form-wrapper .jdgm-submit-rev-btn,
      .jdgm-form .jdgm-submit-rev-btn,
      .jdgm-form input[type="submit"] {
        padding: 0.6rem 1.25rem !important;
        font-size: 0.88rem !important;
        border-radius: 8px !important;
        margin-top: 0.4rem !important;
      }
    </style>

    <script>
      (function() {
        function toggleReviewModalState() {
          var form = document.querySelector('.jdgm-form-wrapper, .jdgm-form, .jdgm-rev-widg__form-wrapper, .jdgm-rev-widg__form');
          var overlay = document.getElementById('JdgmBlurOverlay');
          var isFormVisible = false;

          if (form) {
            var style = window.getComputedStyle(form);
            if (style.display !== 'none' && style.visibility !== 'hidden' && (form.offsetWidth > 0 || form.offsetHeight > 0)) {
              isFormVisible = true;
            }
          }

          if (window.location.search.indexOf('pb=0') !== -1 || window.location.search.indexOf('write') !== -1) {
            if (document.querySelector('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn')) {
              isFormVisible = true;
            }
          }

          var headerElements = document.querySelectorAll('.kb-header, .kb-header-top-sticky, .kb-header-top--fixed, [data-header-top-sticky], [data-header-top-placeholder], [data-premium-header], #shopify-section-header-group, .shopify-section-group-header-group, #shopify-section-header, #shopify-section-announcement-bar, header, .header-wrapper, .sticky-header, [id*="header"], .sticky-mobile-bar, [data-sticky-mobile-bar]');

          if (isFormVisible) {
            document.documentElement.classList.add('jdgm-review-modal-active');
            document.body.classList.add('jdgm-review-modal-active');
            if (overlay) {
              overlay.style.display = 'block';
              overlay.classList.add('is-active');
            }

            headerElements.forEach(function(h) {
              h.classList.remove('kb-header-top--fixed');
              h.style.setProperty('display', 'none', 'important');
              h.style.setProperty('opacity', '0', 'important');
              h.style.setProperty('visibility', 'hidden', 'important');
              h.style.setProperty('pointer-events', 'none', 'important');
              h.style.setProperty('z-index', '-999999', 'important');
            });
          } else {
            document.documentElement.classList.remove('jdgm-review-modal-active');
            document.body.classList.remove('jdgm-review-modal-active');
            if (overlay) {
              overlay.style.display = 'none';
              overlay.classList.remove('is-active');
            }

            headerElements.forEach(function(h) {
              h.style.removeProperty('display');
              h.style.removeProperty('opacity');
              h.style.removeProperty('visibility');
              h.style.removeProperty('pointer-events');
              h.style.removeProperty('z-index');
            });
          }
        }

        document.addEventListener('click', function(e) {
          if (e.target.closest('.jdgm-write-rev-btn, .jdgm-btn, .jdgm-all-reviews-rating-actions__write-btn, [href*="write-review"], [href*="pb=0"]')) {
            setTimeout(toggleReviewModalState, 20);
            setTimeout(toggleReviewModalState, 120);
            setTimeout(toggleReviewModalState, 350);
          }
          if (e.target.closest('.jdgm-cancel-rev, .jdgm-close-btn, .jdgm-form__close, .jdgm-dialog__close')) {
            setTimeout(toggleReviewModalState, 20);
          }
        });

        if (window.location.search.indexOf('pb=0') !== -1 || window.location.search.indexOf('write') !== -1) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', toggleReviewModalState);
          } else {
            toggleReviewModalState();
          }
        }
      })();
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    <div id="JdgmBlurOverlay" style="display: none;"></div>
    {% unless template.name == 'cart' %}
      {% sections 'header-group' %}
    {% endunless %}

    {% section 'wishlist-drawer' %}
    {% render 'predictive-search-drawer' %}
    
    {% render 'product-quick-view-modal' %}

    {{ content_for_layout }}

    {% unless template.name == 'cart' %}
      {% sections 'footer-group' %}
    {% endunless %}
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'cart' or request.design_mode %}
      {{ 'cart.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    <script src="{{ 'component-product-quick-view.js' | asset_url }}" defer="defer"></script>
    <script>
      (function() {
        // Instantly sync cart count badge from Liquid on page load
        function syncCartCountOnLoad() {
          var count = {{ cart.item_count | json }};
          document.querySelectorAll('[data-cart-count], .kb-header__action--cart .kb-header__badge').forEach(function(el) {
            el.textContent = String(count);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncCartCountOnLoad);
        } else {
          syncCartCountOnLoad();
        }
      })();
    </script>
    <script>
      (function() {
        // 1. Instantly update Wishlist Badge count from LocalStorage on page load without downloading wishlist app JS/CSS
        function syncWishlistBadgeOnLoad() {
          try {
            var raw = localStorage.getItem('kb_wishlist_items');
            var items = raw ? JSON.parse(raw) : [];
            var count = Array.isArray(items) ? items.length : 0;
            document.querySelectorAll('[data-wishlist-count-badge], .kb-header__action--wishlist .kb-header__badge').forEach(function(el) {
              el.textContent = String(count);
            });
          } catch(e) {}
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncWishlistBadgeOnLoad);
        } else {
          syncWishlistBadgeOnLoad();
        }

        // 2. On-demand loader for Wishlist application (loads component-wishlist.css & component-wishlist.js ONLY when customer opens/interacts with wishlist)
        function loadWishlistApp(callback) {
          if (window.kbWishlistLoaded) {
            if (callback) callback();
            return;
          }
          if (window.kbWishlistLoading) {
            if (callback) {
              window.addEventListener('kb:wishlist:loaded', callback, { once: true });
            }
            return;
          }
          window.kbWishlistLoading = true;

          // Inject Wishlist CSS
          if (!document.querySelector('link[href*="component-wishlist.css"]')) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = "{{ 'component-wishlist.css' | asset_url }}";
            document.head.appendChild(link);
          }

          // Inject Wishlist JS
          var script = document.createElement('script');
          script.src = "{{ 'component-wishlist.js' | asset_url }}";
          script.defer = true;
          script.onload = function() {
            window.kbWishlistLoaded = true;
            window.kbWishlistLoading = false;
            window.dispatchEvent(new CustomEvent('kb:wishlist:loaded'));
            if (callback) callback();
          };
          document.body.appendChild(script);
        }

        window.loadWishlistApp = loadWishlistApp;

        // 3. Click interceptor to load wishlist application on customer demand
        document.addEventListener('click', function(event) {
          var trigger = event.target.closest('[data-wishlist-drawer-trigger], .kb-header__action--wishlist, [data-wishlist-button]');
          if (trigger && !window.kbWishlistLoaded) {
            event.preventDefault();
            event.stopPropagation();

            loadWishlistApp(function() {
              if (trigger.matches('[data-wishlist-drawer-trigger], .kb-header__action--wishlist')) {
                if (window.openWishlistDrawer) window.openWishlistDrawer();
              } else if (trigger.matches('[data-wishlist-button]')) {
                trigger.click();
              }
            });
          }
        }, true);
      })();
    </script>
    <script src="{{ 'component-button.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-input.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-popup.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-product-card.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-quantity-selector.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'page' and template.suffix == 'our-story' %}
      <script src="{{ 'section-our-story.js' | asset_url }}" defer="defer"></script>
    {% endif %}


  </body>
</html>
